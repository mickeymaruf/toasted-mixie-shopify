{% comment %}
  Renders "Bundle Builder": a grid of bundle-product flavor cards on the
  left and a sticky "Your bundle" panel on the right with a spend-based
  discount progress bar, a horizontally scrollable tray of the shopper's
  current selections, a one-time/subscribe purchase-type picker, and an
  "Add to Cart" button that adds every selected line to the cart in a
  single request.
{% endcomment %}

<section
  class="bundle-builder full-width"
  style="background-color: {{ section.settings.background_color }};"
>
  <bundle-builder
    class="group/bundle-drawer mx-auto flex w-full max-w-[1920px] flex-col items-start gap-8 px-4 py-[40px] sm:gap-10 sm:px-8 sm:py-[60px] md:px-12 lg:flex-row lg:gap-[30px] lg:px-[80px] lg:py-[100px] xl:px-[120px]"
    data-remove-label-template="{{ 'bundle_builder.remove_item' | t: title: '__TITLE__' | escape }}"
    data-drawer-expand-label="{{ 'bundle_builder.expand' | t | escape }}"
    data-drawer-collapse-label="{{ 'bundle_builder.collapse' | t | escape }}"
    data-placeholder-count="8"
    data-discounts='[
      {"threshold": 5000, "discount": 500},
      {"threshold": 12500, "discount": 0},
      {"threshold": 15000, "discount": 1500},
      {"threshold": 20000, "discount": 3000},
      {"threshold": 25000, "discount": 5000},
      {"threshold": 50000, "discount": 12500}
    ]'
  >
    <template data-bundle-remove-icon>{{ 'icon-close.svg' | inline_asset_content }}</template>

    {% content_for 'block', id: 'bundle-product-list', type: 'bundle-product-list' %}

    <div
      class="pointer-events-none fixed inset-0 z-30 bg-[#212323]/40 opacity-0 transition-opacity duration-300 ease-out group-open/bundle-drawer:pointer-events-auto group-open/bundle-drawer:opacity-100 lg:hidden"
      data-bundle-drawer-close
      aria-hidden="true"
    ></div>

    <div
      class="fixed inset-x-0 bottom-0 z-40 flex w-full flex-col gap-6 rounded-t-[24px] p-5 shadow-[0px_0px_5px_rgba(0,0,0,0.05)] sm:rounded-t-[33px] sm:p-6 group-open/bundle-drawer:max-h-[85dvh] group-open/bundle-drawer:overflow-y-auto lg:sticky lg:top-8 lg:z-auto lg:inset-auto lg:w-[408px] lg:shrink-0 lg:max-h-none lg:overflow-visible lg:rounded-[33px]"
      style="background-color: {{ section.settings.panel_background_color }};"
      id="bundle-panel-{{ section.id }}"
      data-bundle-panel
    >
      <div class="flex w-full items-center gap-2">
        {% if section.settings.bundle_heading != blank %}
          <h2 class="flex-1 text-center text-[32px] leading-[1.2] font-bold tracking-[-1px] text-[#212323] sm:text-[36px] lg:text-[42px]">
            {{ section.settings.bundle_heading }}
          </h2>
        {% endif %}
        <button
          type="button"
          class="flex size-8 shrink-0 cursor-pointer items-center justify-center text-[#212323] lg:hidden"
          data-bundle-drawer-toggle
          aria-expanded="false"
          aria-controls="bundle-panel-{{ section.id }}"
        >
          <span class="block size-5 rotate-180 transition-transform duration-300 ease-out group-open/bundle-drawer:rotate-0">
            {{ 'icon-chevron-down.svg' | inline_asset_content }}
          </span>
        </button>
      </div>

      {% if section.settings.bundle_subtitle != blank %}
        <p class="hidden text-[14px] leading-normal text-[#212323] group-open/bundle-drawer:block lg:hidden">
          {{ section.settings.bundle_subtitle }}
        </p>
      {% endif %}

      {% content_for 'block', id: 'bundle-milestone-list', type: 'bundle-milestone-list' %}

      <div class="hidden w-full flex-col gap-6 group-open/bundle-drawer:flex lg:flex">
        <div class="relative flex w-full items-center">
          <div
            class="flex w-full gap-2 overflow-x-auto scroll-smooth pb-1"
            data-bundle-track
            aria-label="{{ 'bundle_builder.selected_products' | t }}"
          >
            {% for i in (1..6) %}
              <div class="h-[130px] w-[100px] shrink-0 rounded-xl border border-dashed border-black/50"></div>
            {% endfor %}
          </div>
        </div>

        <form class="flex w-full flex-col gap-6" data-bundle-form>
          <div
            class="flex w-full flex-col gap-2"
            role="radiogroup"
            aria-label="{{ 'products.main.purchase_option_group_label' | t }}"
          >
            <label class="flex w-full items-center justify-between gap-2">
              <span class="flex items-center gap-2">
                <span class="relative flex size-[18px] shrink-0 items-center justify-center rounded-full border border-[#212323]">
                  <input
                    type="radio"
                    name="bundle-purchase-type-{{ section.id }}"
                    value="one_time"
                    class="peer absolute inset-0 size-full cursor-pointer opacity-0"
                    data-bundle-purchase-type
                    checked
                  >
                  <span
                    class="pointer-events-none block size-[10px] rounded-full opacity-0 peer-checked:opacity-100"
                    style="background-color: {{ section.settings.purchase_selected_color }};"
                  ></span>
                </span>
                <span class="text-[16px] leading-normal text-[#212323]">{{ section.settings.one_time_label }}</span>
              </span>
              <div class="flex items-center gap-2">
                <span class="text-[13px] leading-normal text-[#999999] line-through" data-bundle-price-one-time-original>$0.00</span>
                <span class="text-[16px] leading-normal text-[#212323]" data-bundle-price-one-time>$0.00</span>
              </div>
            </label>

            <label class="flex w-full items-center justify-between gap-2">
              <span class="flex items-center gap-2">
                <span class="relative flex size-[18px] shrink-0 items-center justify-center rounded-full border border-[#212323]">
                  <input
                    type="radio"
                    name="bundle-purchase-type-{{ section.id }}"
                    value="subscribe"
                    class="peer absolute inset-0 size-full cursor-pointer opacity-0"
                    data-bundle-purchase-type
                  >
                  <span
                    class="pointer-events-none block size-[10px] rounded-full opacity-0 peer-checked:opacity-100"
                    style="background-color: {{ section.settings.purchase_selected_color }};"
                  ></span>
                </span>
                <span class="text-[16px] leading-normal text-[#212323]">{{ section.settings.subscribe_label }}</span>
              </span>
              <div class="flex items-center gap-2">
                <span class="text-[13px] leading-normal text-[#999999] line-through" data-bundle-price-subscribe-original>$0.00</span>
                <span class="text-[16px] leading-normal text-[#212323]" data-bundle-price-subscribe>$0.00</span>
              </div>
            </label>
          </div>

          <div class="flex w-full flex-col items-center justify-center gap-[10px]">
            <button
              type="submit"
              class="flex h-[58px] w-full items-center justify-center gap-[5px] rounded-[30px] px-8 py-4 text-center text-[20px] transition-opacity duration-150 hover:opacity-85 disabled:opacity-30"
              style="background-color: {{ section.settings.add_to_cart_background_color }}; color: {{ section.settings.add_to_cart_text_color }};"
              data-bundle-add-to-cart
              disabled
            >
              <span data-bundle-add-to-cart-label>{{ section.settings.add_to_cart_label }}</span>
              <span class="hidden" data-bundle-add-to-cart-loader aria-hidden="true">
                <span class="inline-block size-5 animate-spin rounded-full border-2 border-current border-t-transparent"></span>
              </span>
            </button>

            {% if section.settings.subscribe_note != blank %}
              <p class="text-center text-[16px] leading-normal text-[#212323]">{{ section.settings.subscribe_note }}</p>
            {% endif %}
          </div>
        </form>
      </div>
    </div>
  </bundle-builder>
</section>

{% stylesheet %}
  .bundle-builder [data-bundle-track]::-webkit-scrollbar {
    height: 16px;
  }

  .bundle-builder [data-bundle-track]::-webkit-scrollbar-track {
    background-color: rgba(0, 0, 0, 0.05);
    border-radius: 8px;
  }

  .bundle-builder [data-bundle-track]::-webkit-scrollbar-thumb {
    background-color: rgba(0, 0, 0, 0.4);
    border-radius: 8px;
  }

  .bundle-builder [data-bundle-track]::-webkit-scrollbar-thumb:hover {
    background-color: rgba(0, 0, 0, 0.6);
  }

  .bundle-builder [data-bundle-track] {
    scrollbar-color: rgba(0, 0, 0, 0.4) rgba(0, 0, 0, 0.05);
    scrollbar-width: auto;
  }
{% endstylesheet %}

{% javascript %}
  class BundleBuilder extends HTMLElement {
    connectedCallback() {
      this.items = new Map();
      this.itemIdCounter = 0;

      this.track = this.querySelector('[data-bundle-track]');
      this.milestones = Array.from(this.querySelectorAll('[data-bundle-milestone]'));
      this.progressFill = this.querySelector('[data-bundle-progress-fill]');
      this.addToCartButton = this.querySelector('[data-bundle-add-to-cart]');
      this.addToCartLabel = this.querySelector('[data-bundle-add-to-cart-label]');
      this.addToCartLoader = this.querySelector('[data-bundle-add-to-cart-loader]');
      this.priceOneTime = this.querySelector('[data-bundle-price-one-time]');
      this.priceSubscribe = this.querySelector('[data-bundle-price-subscribe]');
      this.priceOneTimeOriginal = this.querySelector('[data-bundle-price-one-time-original]');
      this.priceSubscribeOriginal = this.querySelector('[data-bundle-price-subscribe-original]');
      this.removeIconMarkup = this.querySelector('[data-bundle-remove-icon]')?.innerHTML || '&times;';
      this.removeLabelTemplate = this.dataset.removeLabelTemplate || 'Remove __TITLE__';
      this.placeholderCount = Number(this.dataset.placeholderCount || 6);
      this.discounts = JSON.parse(this.dataset.discounts || '[]');

      this.drawerToggle = this.querySelector('[data-bundle-drawer-toggle]');
      this.drawerExpandLabel = this.dataset.drawerExpandLabel || 'Expand your bundle';
      this.drawerCollapseLabel = this.dataset.drawerCollapseLabel || 'Collapse your bundle';
      this.setDrawerOpen(false);

      this.addEventListener('click', (event) => {
        const addButton = event.target.closest('[data-bundle-add]');
        if (addButton) {
          if (this.items.size < this.placeholderCount) {
            this.addItem(addButton.dataset);
          }
          return;
        }

        const removeButton = event.target.closest('[data-bundle-remove]');
        if (removeButton) {
          this.removeItem(Number(removeButton.dataset.itemId));
          return;
        }

        if (event.target.closest('[data-bundle-drawer-toggle]')) {
          this.setDrawerOpen(!this.hasAttribute('open'));
          return;
        }

        if (event.target.closest('[data-bundle-drawer-close]')) this.setDrawerOpen(false);
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && this.hasAttribute('open')) this.setDrawerOpen(false);
      });

      this.addEventListener('change', (event) => {
        if (event.target.matches('[data-bundle-purchase-type]')) this.render();
      });

      this.form = this.querySelector('[data-bundle-form]');
      this.form?.addEventListener('submit', (event) => this.handleSubmit(event));

      this.render();
    }

    setDrawerOpen(isOpen) {
      this.toggleAttribute('open', isOpen);
      if (this.drawerToggle) {
        this.drawerToggle.setAttribute('aria-expanded', String(isOpen));
        this.drawerToggle.setAttribute('aria-label', isOpen ? this.drawerCollapseLabel : this.drawerExpandLabel);
      }
    }

    addItem(dataset) {
      const itemId = ++this.itemIdCounter;
      this.items.set(itemId, {
        itemId,
        blockId: dataset.blockId,
        variantId: dataset.variantId,
        title: dataset.title,
        image: dataset.image,
        price: Number(dataset.price || 0),
        sellingPlanId: dataset.sellingPlanId || null,
        subscribePrice: dataset.subscribePrice ? Number(dataset.subscribePrice) : null,
      });

      this.render();
    }

    removeItem(itemId) {
      this.items.delete(itemId);
      this.render();
    }

    get isSubscribing() {
      return this.querySelector('[data-bundle-purchase-type]:checked')?.value === 'subscribe';
    }

    get subtotalCents() {
      let total = 0;
      for (const item of this.items.values()) {
        const unit = this.isSubscribing && item.subscribePrice ? item.subscribePrice : item.price;
        total += unit;
      }
      return total;
    }

    get totalQuantity() {
      return this.items.size;
    }

    render() {
      this.renderTrack();
      this.renderMilestones();
      this.renderPrices();
      if (this.addToCartButton) this.addToCartButton.disabled = this.totalQuantity === 0;
    }

    renderPrices() {
      let oneTimeSubtotal = 0;
      for (const item of this.items.values()) {
        oneTimeSubtotal += item.price;
      }
      let subscribeSubtotal = 0;
      for (const item of this.items.values()) {
        const price = item.subscribePrice || item.price;
        subscribeSubtotal += price;
      }

      const oneTimeDiscount = this.getAppliedDiscount(oneTimeSubtotal);
      const subscribeDiscount = this.getAppliedDiscount(subscribeSubtotal);

      const oneTimeDiscounted = Math.max(0, oneTimeSubtotal - oneTimeDiscount);
      const subscribeDiscounted = Math.max(0, subscribeSubtotal - subscribeDiscount);

      if (this.priceOneTimeOriginal) {
        this.priceOneTimeOriginal.textContent = this.formatPrice(oneTimeSubtotal);
      }
      if (this.priceOneTime) {
        this.priceOneTime.textContent = this.formatPrice(oneTimeDiscounted);
      }

      if (this.priceSubscribeOriginal) {
        this.priceSubscribeOriginal.textContent = this.formatPrice(subscribeSubtotal);
      }
      if (this.priceSubscribe) {
        this.priceSubscribe.textContent = this.formatPrice(subscribeDiscounted);
      }
    }

    getAppliedDiscount(subtotal) {
      let applicableDiscount = 0;
      for (const discount of this.discounts) {
        if (subtotal >= discount.threshold) {
          applicableDiscount = discount.discount;
        }
      }
      return applicableDiscount;
    }

    getOneTimeTotal() {
      let subtotal = 0;
      for (const item of this.items.values()) {
        subtotal += item.price;
      }
      const discount = this.getAppliedDiscount(subtotal);
      return Math.max(0, subtotal - discount);
    }

    getSubscribeTotal() {
      let subtotal = 0;
      for (const item of this.items.values()) {
        const price = item.subscribePrice || item.price;
        subtotal += price;
      }
      const discount = this.getAppliedDiscount(subtotal);
      return Math.max(0, subtotal - discount);
    }

    formatPrice(cents) {
      return '$' + (cents / 100).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    renderTrack() {
      if (!this.track) return;
      this.track.innerHTML = '';

      for (const item of this.items.values()) {
        const card = document.createElement('div');
        card.className =
          'relative h-[130px] w-[100px] shrink-0 overflow-hidden rounded-xl border border-[#212323]/10 bg-white';

        const img = document.createElement('img');
        img.src = item.image;
        img.alt = item.title;
        img.className = 'size-full object-cover';
        card.appendChild(img);

        const removeButton = document.createElement('button');
        removeButton.type = 'button';
        removeButton.className =
          'absolute right-1.5 top-1.5 flex size-6 items-center justify-center rounded-full bg-[#212323] text-[#F6F1EC] [&_svg]:size-3';
        removeButton.dataset.bundleRemove = '';
        removeButton.dataset.itemId = item.itemId;
        removeButton.setAttribute('aria-label', this.removeLabelTemplate.replace('__TITLE__', item.title));
        removeButton.innerHTML = this.removeIconMarkup;
        card.appendChild(removeButton);

        this.track.appendChild(card);
      }

      const placeholdersNeeded = Math.max(0, this.placeholderCount - this.items.size);
      for (let i = 0; i < placeholdersNeeded; i += 1) {
        const placeholder = document.createElement('div');
        placeholder.className = 'h-[130px] w-[100px] shrink-0 rounded-xl border border-dashed border-black/50';
        this.track.appendChild(placeholder);
      }
    }

    renderMilestones() {
      const subtotal = this.subtotalCents;

      if (this.progressFill) {
        this.progressFill.style.width = `${this.getProgressPercent(subtotal)}%`;
      }

      this.milestones.forEach((el) => {
        const pill = el.querySelector('[data-bundle-milestone-pill]');
        if (!pill) return;

        const achieved = Number(el.dataset.threshold) <= subtotal;

        pill.classList.toggle('bg-[#212323]', achieved);
        pill.classList.toggle('text-[#F6F1EC]', achieved);
        pill.classList.toggle('bg-white', !achieved);
        pill.classList.toggle('text-[#212323]', !achieved);
      });
    }

    getProgressPercent(subtotal) {
      const thresholds = this.milestones
        .map((el) => Number(el.dataset.threshold))
        .sort((a, b) => a - b);

      const count = thresholds.length;
      if (count === 0) return 0;
      if (subtotal <= 0) return 0;

      const positions = thresholds.map((_, index) => ((index + 0.75) / count) * 100);

      if (subtotal >= thresholds[count - 1]) return 100;

      let lowerIndex = -1;
      for (let i = 0; i < count; i += 1) {
        if (subtotal >= thresholds[i]) lowerIndex = i;
      }

      const lowerThreshold = lowerIndex >= 0 ? thresholds[lowerIndex] : 0;
      const lowerPosition = lowerIndex >= 0 ? positions[lowerIndex] : 0;
      const upperThreshold = thresholds[lowerIndex + 1];
      const upperPosition = positions[lowerIndex + 1];

      const ratio = (subtotal - lowerThreshold) / (upperThreshold - lowerThreshold);
      return lowerPosition + ratio * (upperPosition - lowerPosition);
    }

    async handleSubmit(event) {
      event.preventDefault();
      if (this.totalQuantity === 0) return;

      const subscribing = this.isSubscribing;
      const items = Array.from(this.items.values()).map((item) => {
        const payload = { id: item.variantId, quantity: 1 };
        if (subscribing && item.sellingPlanId) payload.selling_plan = item.sellingPlanId;
        return payload;
      });

      this.addToCartButton.disabled = true;
      this.addToCartLabel?.classList.add('invisible');
      this.addToCartLoader?.classList.remove('hidden');

      try {
        const response = await fetch('/cart/add.js', {
          method: 'POST',
          headers: { Accept: 'application/json', 'Content-Type': 'application/json' },
          body: JSON.stringify({ items }),
        });

        if (!response.ok) throw new Error('Failed to add bundle to cart');

        this.items.clear();
        this.render();
        this.setDrawerOpen(false);

        const drawer = document.querySelector('cart-drawer');
        if (drawer) {
          await drawer.refresh();
          drawer.open();
        }
      } catch (error) {
        this.addToCartButton.disabled = this.totalQuantity === 0;
      } finally {
        this.addToCartLabel?.classList.remove('invisible');
        this.addToCartLoader?.classList.add('hidden');
      }
    }
  }

  customElements.define('bundle-builder', BundleBuilder);
{% endjavascript %}

{% schema %}
{
  "name": "t:general.bundle_builder",
  "blocks": [{ "type": "bundle-product-list" }, { "type": "bundle-milestone-list" }],
  "settings": [
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "text",
      "id": "bundle_heading",
      "label": "t:labels.heading",
      "default": "Your bundle"
    },
    {
      "type": "text",
      "id": "bundle_subtitle",
      "label": "t:labels.subtitle",
      "info": "t:labels.bundle_subtitle_info",
      "default": "Add more products to save"
    },
    {
      "type": "header",
      "content": "t:general.purchase"
    },
    {
      "type": "text",
      "id": "one_time_label",
      "label": "t:labels.one_time_label",
      "default": "One-Time Order"
    },
    {
      "type": "text",
      "id": "subscribe_label",
      "label": "t:labels.subscribe_label",
      "default": "Subscribe & Save 20%"
    },
    {
      "type": "text",
      "id": "add_to_cart_label",
      "label": "t:labels.add_to_cart_label",
      "default": "Add to Cart"
    },
    {
      "type": "text",
      "id": "subscribe_note",
      "label": "t:labels.subscribe_note",
      "default": "Subscribe & Save is the best value."
    },
    {
      "type": "header",
      "content": "t:general.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.section_background",
      "default": "#C2CBD4"
    },
    {
      "type": "color",
      "id": "panel_background_color",
      "label": "t:labels.card_background",
      "default": "#F6F1EC"
    },
    {
      "type": "color",
      "id": "purchase_selected_color",
      "label": "t:labels.purchase_selected_color",
      "default": "#F9D5C0"
    },
    {
      "type": "color",
      "id": "add_to_cart_background_color",
      "label": "t:labels.button_background",
      "default": "#212323"
    },
    {
      "type": "color",
      "id": "add_to_cart_text_color",
      "label": "t:labels.button_text_color",
      "default": "#F6F1EC"
    }
  ],
  "presets": [
    {
      "name": "t:general.bundle_builder",
      "blocks": [
        {
          "type": "bundle-product-list",
          "static": true,
          "id": "bundle-product-list",
          "blocks": [
            {
              "type": "bundle-product",
              "settings": {
                "flavor_name": "Blood Orange",
                "pack_label": "12-pack",
                "flavor_style": "blood_orange",
                "card_background_color": "#85002C",
                "button_label": "Add to Bundle"
              }
            },
            {
              "type": "bundle-product",
              "settings": {
                "flavor_name": "Berry Acai",
                "pack_label": "12-pack",
                "flavor_style": "berry_acai",
                "card_background_color": "#391847",
                "button_label": "Add to Bundle"
              }
            },
            {
              "type": "bundle-product",
              "settings": {
                "flavor_name": "Ginger Lime",
                "pack_label": "12-pack",
                "flavor_style": "ginger_lime",
                "card_background_color": "#215332",
                "button_label": "Add to Bundle"
              }
            }
          ]
        },
        {
          "type": "bundle-milestone-list",
          "static": true,
          "id": "bundle-milestone-list",
          "blocks": [
            { "type": "bundle-milestone", "settings": { "threshold": 50, "reward_label": "$5" } },
            { "type": "bundle-milestone", "settings": { "threshold": 125, "reward_label": "Free Ship" } },
            { "type": "bundle-milestone", "settings": { "threshold": 150, "reward_label": "$15" } },
            { "type": "bundle-milestone", "settings": { "threshold": 200, "reward_label": "$30" } },
            { "type": "bundle-milestone", "settings": { "threshold": 250, "reward_label": "$50" } },
            { "type": "bundle-milestone", "settings": { "threshold": 500, "reward_label": "$125" } }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
