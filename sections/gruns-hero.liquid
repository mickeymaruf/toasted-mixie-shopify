<section
  class="gruns-hero full-width relative z-10 pt-[50px]"
  style="background-color: {{ section.settings.background_color }};"
>
  <div
    class="mx-auto flex w-full max-w-[1500px] flex-col gap-4 px-5 pb-[45px] sm:gap-12 sm:px-8 sm:pb-[60px] md:px-12 lg:grid lg:grid-cols-[9fr_11fr] lg:items-center lg:gap-x-0 lg:px-[80px] xl:px-[80px] xl:py-[50px]"
  >
    <div class="order-2 flex w-full flex-col items-center text-center lg:order-none lg:col-start-1 lg:items-start lg:text-left">
      {% if section.settings.heading != blank %}
        <div
          class="font-[family-name:var(--font-heading--family)] font-bold text-[32px] leading-[1.1] text-[color:var(--gruns-hero-heading-color)] sm:text-[36px] md:text-[44px] lg:text-[56px] xl:text-[72px]"
          style="--gruns-hero-heading-color: {{ section.settings.heading_color }};"
        >
          {{ section.settings.heading }}
        </div>
      {% endif %}

      {% if section.settings.description != blank %}
        <div
          class="mt-2 max-w-[350px] text-[14px] leading-[1.4] text-[color:var(--gruns-hero-heading-color)] sm:mt-4 sm:text-[16px] md:mt-5 md:text-[18px] -space-y-[12px]"
          style="--gruns-hero-heading-color: {{ section.settings.heading_color }};"
        >
          {{ section.settings.description }}
        </div>
      {% endif %}

      {% if section.settings.show_button and section.settings.button_label != blank %}
        <div class="mt-4 flex w-full max-w-[278px] flex-col items-center gap-[10px] sm:mt-8 lg:mt-[50px]">
          {% render 'button',
            label: section.settings.button_label,
            url: section.settings.button_link,
            background_color: section.settings.button_background_color,
            text_color: section.settings.button_text_color,
            class: 'whitespace-nowrap !px-6 !w-full'
          %}

          {% if section.settings.feature_1_text != blank or section.settings.feature_2_text != blank %}
            <div
              class="flex items-center justify-center gap-x-[15px] gap-y-2 text-[color:var(--gruns-hero-heading-color)]"
              style="--gruns-hero-heading-color: {{ section.settings.heading_color }};"
            >
              {% if section.settings.feature_1_text != blank %}
                <div class="flex items-center gap-[5px]">
                  <span class="block size-[15px] shrink-0">{{ 'icon-package.svg' | inline_asset_content }}</span>
                  <span class="text-[12px] leading-[1.5] whitespace-nowrap">{{ section.settings.feature_1_text }}</span>
                </div>
              {% endif %}

              {% if section.settings.feature_2_text != blank %}
                <div class="flex items-center gap-[5px]">
                  <span class="block h-[13px] w-[17px] shrink-0">{{ 'icon-shipping.svg' | inline_asset_content }}</span>
                  <span class="text-[12px] leading-[1.5] whitespace-nowrap">{{ section.settings.feature_2_text }}</span>
                </div>
              {% endif %}
            </div>
          {% endif %}
        </div>
      {% endif %}

      <div class="mt-8 sm:mt-8 lg:mt-[50px]">
        {% content_for 'blocks' %}
      </div>
    </div>

    {% if section.settings.can_image_1 or section.settings.can_image_2 or section.settings.can_image_3 %}
      <div class="order-1 w-full mx-auto mb-8 shrink-0 sm:mb-0 sm:max-w-[533px] lg:order-none lg:col-start-2 lg:max-w-none lg:self-stretch">
        <div class="relative mx-auto w-full" style="aspect-ratio: 624 / 477;">
          <div
            class="absolute overflow-hidden rounded-[24px] sm:rounded-[36px]"
            style="
              left: 3.49%;
              top: 7.55%;
              width: 91.87%;
              height: 84.9%;
              background-color: {{ section.settings.cans_background_color }};
            "
          >
            {% if section.settings.cans_background_image %}
              {{
                section.settings.cans_background_image
                | image_url: width: 1200
                | image_tag:
                  class: 'absolute inset-0 size-full max-w-none object-cover object-bottom',
                  widths: '600, 900, 1200',
                  loading: 'lazy',
                  alt: ''
              }}
            {% endif %}
          </div>

          {% render 'gruns-hero-can-image',
            image: section.settings.can_image_1,
            alt: section.settings.can_image_1_alt,
            modifier: 'back-right'
          %}
          {% render 'gruns-hero-can-image',
            image: section.settings.can_image_2,
            alt: section.settings.can_image_2_alt,
            modifier: 'back-left'
          %}
          {% render 'gruns-hero-can-image',
            image: section.settings.can_image_3,
            alt: section.settings.can_image_3_alt,
            modifier: 'front-center'
          %}
        </div>

        {% if section.settings.show_badge and section.settings.badge_text != blank %}
          <div
            class="absolute bottom-0 -left-[56px] z-10 origin-center -rotate-90 translate-y-1/2 flex items-center justify-center gap-[14px] rounded-[26px] px-[22px] py-[12px] drop-shadow-[0px_0px_2.5px_rgba(0,0,0,0.1)] lg:-left-14 lg:gap-[20px] lg:rounded-[30px] lg:px-[32px] lg:py-[16px]"
            style="background-color: {{ section.settings.badge_background_color }};"
          >
            <p
              class="text-[16px] leading-[1.5] font-medium whitespace-nowrap lg:text-[20px]"
              style="color: {{ section.settings.badge_text_color }};"
            >
              {{ section.settings.badge_text }}
            </p>
            <span class="block size-[14px] shrink-0 lg:size-[16px]">
              <img
                src="{{ 'icon-x-bold.svg' | asset_url }}"
                alt=""
                width="16"
                height="16"
                class="size-full"
              >
            </span>
          </div>
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "t:general.gruns_hero",
  "blocks": [{ "type": "badge-row" }],
  "settings": [
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "<p><em>The Chill Drink</em> For Moments Worth Remembering.</p>"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:labels.description"
    },
    {
      "type": "header",
      "content": "t:general.button"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "t:labels.show_button",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label",
      "default": "Get My Trial Pack",
      "visible_if": "{{ section.settings.show_button }}"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:labels.button_link",
      "visible_if": "{{ section.settings.show_button }}"
    },
    {
      "type": "color",
      "id": "button_background_color",
      "label": "t:labels.button_background",
      "default": "#212323",
      "visible_if": "{{ section.settings.show_button }}"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "t:labels.button_text_color",
      "default": "#F6F1EC",
      "visible_if": "{{ section.settings.show_button }}"
    },
    {
      "type": "text",
      "id": "feature_1_text",
      "label": "t:labels.feature_1_text",
      "default": "Free 3-flavor trial pack.",
      "visible_if": "{{ section.settings.show_button }}"
    },
    {
      "type": "text",
      "id": "feature_2_text",
      "label": "t:labels.feature_2_text",
      "default": "Just Pay Shipping",
      "visible_if": "{{ section.settings.show_button }}"
    },
    {
      "type": "header",
      "content": "t:general.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.background",
      "default": "#F6F1EC"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "t:labels.text_color",
      "default": "#212323"
    },
    {
      "type": "header",
      "content": "t:general.image"
    },
    {
      "type": "color",
      "id": "cans_background_color",
      "label": "t:labels.background_color",
      "default": "#F9D5C0"
    },
    {
      "type": "image_picker",
      "id": "cans_background_image",
      "label": "t:labels.background_image",
      "info": "t:labels.background_image_info"
    },
    {
      "type": "image_picker",
      "id": "can_image_1",
      "label": "t:labels.can_image_1"
    },
    {
      "type": "text",
      "id": "can_image_1_alt",
      "label": "t:labels.alt_text"
    },
    {
      "type": "image_picker",
      "id": "can_image_2",
      "label": "t:labels.can_image_2"
    },
    {
      "type": "text",
      "id": "can_image_2_alt",
      "label": "t:labels.alt_text"
    },
    {
      "type": "image_picker",
      "id": "can_image_3",
      "label": "t:labels.can_image_3"
    },
    {
      "type": "text",
      "id": "can_image_3_alt",
      "label": "t:labels.alt_text"
    },
    {
      "type": "header",
      "content": "t:general.badge"
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "t:labels.show_badge",
      "default": true
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "t:labels.badge_text",
      "default": "Get 50% Off",
      "visible_if": "{{ section.settings.show_badge }}"
    },
    {
      "type": "color",
      "id": "badge_background_color",
      "label": "t:labels.badge_background",
      "default": "#F9D5C0",
      "visible_if": "{{ section.settings.show_badge }}"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "t:labels.badge_text_color",
      "default": "#212323",
      "visible_if": "{{ section.settings.show_badge }}"
    }
  ],
  "presets": [
    {
      "name": "t:general.gruns_hero",
      "blocks": [
        {
          "type": "badge-row",
          "blocks": [
            { "type": "trust-badge", "settings": { "label": "0.4mg THC", "icon_style": "thc" } },
            { "type": "trust-badge", "settings": { "label": "Non-Carbonated", "icon_style": "carbonation" } },
            { "type": "trust-badge", "settings": { "label": "Lab Tested", "icon_style": "lab" } }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
