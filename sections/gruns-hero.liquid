<section
  class="gruns-hero full-width relative z-10 overflow-hidden pt-[12px] pb-[24px] sm:pt-[50px] sm:pb-[60px] lg:pb-[100px]"
  style="background-color: {{ section.settings.background_color }};"
>
  {% liquid
    assign description_desktop_visibility = ''
    assign description_mobile_visibility = ''

    if section.settings.description != blank and section.settings.description_mobile != blank
      assign description_desktop_visibility = 'hidden lg:block '
      assign description_mobile_visibility = 'lg:hidden '
    endif
  %}

  {% if section.settings.show_skyline_image %}
    <div class="pointer-events-none absolute inset-0 z-0 overflow-hidden opacity-40" aria-hidden="true">
      {% if section.settings.skyline_image %}
        {{
          section.settings.skyline_image
          | image_url: width: 1600
          | image_tag: class: 'size-full max-w-none object-contain object-bottom min-[1700px]:object-cover', widths: '800, 1200, 1600', loading: 'lazy', alt: ''
        }}
      {% else %}
        <img
          src="{{ 'bg-skyline-gruns-hero.png' | asset_url }}"
          alt=""
          class="size-full max-w-none object-contain object-bottom min-[1700px]:object-cover"
          loading="lazy"
          width="1472"
          height="730"
        >
      {% endif %}
    </div>
  {% endif %}

  <div
    class="relative z-10 mx-auto flex w-full max-w-[1500px] flex-col gap-3 px-5 sm:gap-12 sm:px-8 md:px-12 lg:grid lg:grid-cols-[43fr_57fr] lg:items-center lg:gap-x-[60px] lg:px-[80px] xl:px-[130px]"
  >
    <div class="order-2 flex w-full flex-col items-center text-center lg:order-none lg:col-start-1 lg:items-start lg:text-left">
      {% if section.settings.heading != blank %}
        <div
          class="font-[family-name:var(--font-heading--family)] font-bold text-[32px] leading-[95%] whitespace-nowrap text-[color:var(--gruns-hero-heading-color)] md:text-[52px] lg:text-[64px] xl:text-[85px]"
          style="--gruns-hero-heading-color: {{ section.settings.heading_color }};"
        >
          {{ section.settings.heading }}
        </div>
      {% endif %}

      {% if section.settings.description != blank %}
        <div
          class="{{ description_desktop_visibility }}mt-[5px] font-[family-name:var(--font-heading--family)] text-[18px] leading-[95%] tracking-[-3%] font-semibold text-[color:var(--gruns-hero-heading-color)] lg:text-[24px] xl:text-[30px]"
          style="--gruns-hero-heading-color: {{ section.settings.heading_color }};"
        >
          {{ section.settings.description }}
        </div>
      {% endif %}

      {% if section.settings.description_mobile != blank %}
        <div
          class="{{ description_mobile_visibility }}mt-4 font-[family-name:var(--font-heading--family)] text-[18px] leading-[1.2] font-semibold text-[color:var(--gruns-hero-heading-color)] sm:mt-5"
          style="--gruns-hero-heading-color: {{ section.settings.heading_color }};"
        >
          {{ section.settings.description_mobile }}
        </div>
      {% endif %}

      {% if section.settings.show_button and section.settings.button_label != blank %}
        <div class="mt-4 sm:mt-8 lg:mt-[30px]">
          {% render 'button',
            label: section.settings.button_label,
            url: section.settings.button_link,
            background_color: section.settings.button_background_color,
            text_color: section.settings.button_text_color,
            class: 'whitespace-nowrap !px-[42px] !py-[16px] !text-[18px] drop-shadow-[-2px_3px_2.85px_rgba(0,0,0,0.22)]'
          %}
        </div>
      {% endif %}

      <div class="gruns-hero-benefits mt-5 sm:mt-10 lg:mt-[50px]">
        {% content_for 'blocks' %}
      </div>
    </div>

    {% if section.settings.can_image_1 or section.settings.can_image_2 or section.settings.can_image_3 or section.settings.cans_background_image %}
      <div class="order-1 mx-auto mb-3 w-full shrink-0 sm:mb-0 sm:max-w-[533px] lg:order-none lg:col-start-2 lg:max-w-none">
        <div class="relative mx-auto w-full" style="aspect-ratio: 624 / 516;">
          <div
            class="absolute overflow-hidden rounded-[24px] sm:rounded-[32px] lg:rounded-[36px]"
            style="
              left: -0.24%;
              top: 0%;
              width: 98.88%;
              height: 92.44%;
              background-color: {{ section.settings.cans_background_color }};
            "
          >
            {% if section.settings.cans_background_image %}
              {{
                section.settings.cans_background_image
                | image_url: width: 1200
                | image_tag:
                  class: 'absolute inset-0 size-full max-w-none object-cover',
                  widths: '600, 900, 1200',
                  loading: 'lazy',
                  alt: ''
              }}
            {% endif %}
            <div
              class="pointer-events-none absolute inset-0"
              style="background-image: linear-gradient(143deg, rgba(0, 0, 0, 0.55) 3%, rgba(0, 0, 0, 0) 34%);"
            ></div>
          </div>

          {% if section.settings.show_badge %}
            <div
              class="absolute"
              style="left: 4.53%; top: 5.69%; width: 16.12%;"
            >
              {% if section.settings.badge_image %}
                {{
                  section.settings.badge_image
                  | image_url: width: 320
                  | image_tag: class: 'w-full h-auto object-contain', widths: '160, 240, 320', loading: 'lazy', alt: section.settings.badge_image_alt
                }}
              {% else %}
                <img
                  src="{{ 'built-on-trust-badge.png' | asset_url }}"
                  alt="{{ section.settings.badge_image_alt }}"
                  class="w-full h-auto object-contain"
                  loading="lazy"
                  width="266"
                  height="209"
                >
              {% endif %}
            </div>
          {% endif %}

          <div class="absolute" style="left: 57.81%; top: 47.48%; width: 42.55%; height: 52.43%;">
            {% render 'gruns-hero-can-image',
              image: section.settings.can_image_3,
              alt: section.settings.can_image_3_alt,
              modifier: 'compact-back-left'
            %}
            {% render 'gruns-hero-can-image',
              image: section.settings.can_image_2,
              alt: section.settings.can_image_2_alt,
              modifier: 'compact-back-right'
            %}
            {% render 'gruns-hero-can-image',
              image: section.settings.can_image_1,
              alt: section.settings.can_image_1_alt,
              modifier: 'compact-front-center'
            %}
          </div>
        </div>
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .gruns-hero-benefits .badge-row {
    display: flex;
    flex-wrap: nowrap;
    grid-template-columns: none;
    align-items: flex-start;
    justify-content: center;
    column-gap: 8px;
    row-gap: 16px;
  }

  .gruns-hero-benefits .trust-badge {
    flex: 1 1 0%;
    min-width: 0;
    width: auto;
  }

  @media (min-width: 40rem) {
    .gruns-hero-benefits .badge-row {
      flex-wrap: wrap;
      align-items: flex-end;
      justify-content: flex-start;
      column-gap: 21px;
    }

    .gruns-hero-benefits .trust-badge {
      flex: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.gruns_hero",
  "blocks": [{ "type": "badge-row" }],
  "settings": [
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "<p><em>The Chill Drink</em></p>"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description desktop",
      "default": "<p>A light, tasteful drink for the moments you want to relax, connect, and stay present.</p>"
    },
    {
      "type": "richtext",
      "id": "description_mobile",
      "label": "Description mobile",
      "info": "Optional. If left blank, the desktop description is used on mobile."
    },
    {
      "type": "header",
      "content": "t:general.button"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "t:labels.show_button",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label",
      "default": "Shop Toasted",
      "visible_if": "{{ section.settings.show_button }}"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:labels.button_link",
      "visible_if": "{{ section.settings.show_button }}"
    },
    {
      "type": "color",
      "id": "button_background_color",
      "label": "t:labels.button_background",
      "default": "#D4941F",
      "visible_if": "{{ section.settings.show_button }}"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "t:labels.button_text_color",
      "default": "#F6F1EC",
      "visible_if": "{{ section.settings.show_button }}"
    },
    {
      "type": "header",
      "content": "t:general.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.background",
      "default": "#9AB2D5"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "t:labels.text_color",
      "default": "#212323"
    },
    {
      "type": "header",
      "content": "t:general.image"
    },
    {
      "type": "checkbox",
      "id": "show_skyline_image",
      "label": "t:labels.show_background_image",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "skyline_image",
      "label": "t:labels.background_image",
      "info": "t:labels.background_image_info",
      "visible_if": "{{ section.settings.show_skyline_image }}"
    },
    {
      "type": "color",
      "id": "cans_background_color",
      "label": "t:labels.background_color",
      "default": "#F9D5C0"
    },
    {
      "type": "image_picker",
      "id": "cans_background_image",
      "label": "t:labels.lifestyle_image"
    },
    {
      "type": "image_picker",
      "id": "can_image_1",
      "label": "Can image 1 (front center)"
    },
    {
      "type": "text",
      "id": "can_image_1_alt",
      "label": "t:labels.alt_text"
    },
    {
      "type": "image_picker",
      "id": "can_image_2",
      "label": "Can image 2 (back right)"
    },
    {
      "type": "text",
      "id": "can_image_2_alt",
      "label": "t:labels.alt_text"
    },
    {
      "type": "image_picker",
      "id": "can_image_3",
      "label": "Can image 3 (back left)"
    },
    {
      "type": "text",
      "id": "can_image_3_alt",
      "label": "t:labels.alt_text"
    },
    {
      "type": "header",
      "content": "t:general.badge"
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "t:labels.show_badge",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "badge_image",
      "label": "t:labels.badge_image",
      "visible_if": "{{ section.settings.show_badge }}"
    },
    {
      "type": "text",
      "id": "badge_image_alt",
      "label": "t:labels.alt_text",
      "default": "America's most compliant badge",
      "visible_if": "{{ section.settings.show_badge }}"
    }
  ],
  "presets": [
    {
      "name": "t:general.gruns_hero",
      "blocks": [
        {
          "type": "badge-row",
          "blocks": [
            { "type": "trust-badge", "settings": { "label": "<p>Supports Clarity</p>", "description": "Smooth, present focus" } },
            { "type": "trust-badge", "settings": { "label": "<p>Balanced Mood</p>", "description": "Light, feel-good lift" } },
            { "type": "trust-badge", "settings": { "label": "<p>Promotes Calm</p>", "description": "Steady unwind" } }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
