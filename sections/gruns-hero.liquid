{% comment %}
  Renders the Gruns hero as a Swiper slideshow. Each gruns-hero-slide block is
  one full hero (background, text, button, perks, badge rows); the circular
  arrows at the bottom right move between slides (hidden on mobile, where
  slides are swiped).
{% endcomment %}

<section
  class="gruns-hero full-width relative z-10 overflow-hidden{% if section.settings.extend_behind_navbar %} -mt-[var(--corner-radius)]{% endif %}"
  {{ section.shopify_attributes }}
>
  <gruns-hero-slider
    class="relative block"
    role="region"
    aria-roledescription="carousel"
    aria-label="{{ 'general.accessibility.hero_slideshow' | t }}"
    data-autoplay="{{ section.settings.autoplay }}"
    data-autoplay-delay="{{ section.settings.autoplay_delay | times: 1000 }}"
    data-loop="{{ section.settings.loop }}"
  >
    <div class="swiper gruns-hero__swiper">
      <div class="swiper-wrapper">
        {% content_for 'blocks' %}
      </div>
    </div>

    {% if section.settings.show_arrows and section.blocks.size > 1 %}
      <div class="absolute right-4 bottom-[calc(var(--corner-radius)+1rem)] z-20 hidden items-center sm:flex gap-[13px] sm:right-8 sm:bottom-[calc(var(--corner-radius)+2rem)] lg:right-[2.7778vw] lg:bottom-[5.6944vw]">
        <button
          type="button"
          class="gruns-hero__arrow w-[40px] cursor-pointer transition-opacity duration-150 hover:opacity-75 sm:w-[46px] lg:w-[3.7142vw]"
          aria-label="{{ 'general.accessibility.previous_slide' | t }}"
          data-hero-prev
        >
          <img
            src="{{ 'icon-hero-arrow-prev.svg' | asset_url }}"
            alt=""
            width="53"
            height="52"
            class="h-auto w-full rotate-180"
            loading="lazy"
          >
        </button>
        <button
          type="button"
          class="gruns-hero__arrow w-[40px] cursor-pointer transition-opacity duration-150 hover:opacity-75 sm:w-[46px] lg:w-[3.7142vw]"
          aria-label="{{ 'general.accessibility.next_slide' | t }}"
          data-hero-next
        >
          <img
            src="{{ 'icon-hero-arrow-next.svg' | asset_url }}"
            alt=""
            width="53"
            height="52"
            class="h-auto w-full"
            loading="lazy"
          >
        </button>
      </div>
    {% endif %}
  </gruns-hero-slider>
</section>

{% stylesheet %}
  /* Shopify wraps every theme block in a .shopify-block div, so that wrapper
     is the Swiper slide; the hero slide inside it stretches to its height. */
  .gruns-hero__swiper .swiper-wrapper > .shopify-block {
    display: flex;
    flex-shrink: 0;
    width: 100%;
    height: auto;
    min-width: 0;
  }

  .gruns-hero__swiper .swiper-wrapper > .shopify-block > .gruns-hero-slide {
    flex: 1 1 auto;
    min-width: 0;
  }
{% endstylesheet %}

{% javascript %}
  class GrunsHeroSlider extends HTMLElement {
    connectedCallback() {
      if (typeof Swiper === 'undefined') {
        window.addEventListener('load', () => this.init(), { once: true });
        return;
      }
      this.init();
    }

    disconnectedCallback() {
      document.removeEventListener('shopify:block:select', this.handleBlockSelect);
      document.removeEventListener('shopify:block:deselect', this.handleBlockDeselect);
      if (this.swiper) {
        this.swiper.destroy(true, true);
        this.swiper = null;
      }
    }

    init() {
      const container = this.querySelector('.gruns-hero__swiper');
      if (!container || this.swiper || typeof Swiper === 'undefined') return;

      const wrapper = container.querySelector('.swiper-wrapper');
      const slideEls = Array.from(wrapper.children);
      slideEls.forEach((el) => el.classList.add('swiper-slide'));
      const multiple = slideEls.length > 1;
      const designMode = Boolean(window.Shopify && window.Shopify.designMode);
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const autoplayEnabled = this.dataset.autoplay === 'true' && multiple && !designMode && !reducedMotion;

      this.swiper = new Swiper(container, {
        slidesPerView: 1,
        speed: 600,
        effect: 'fade',
        fadeEffect: { crossFade: true },
        loop: this.dataset.loop === 'true' && multiple,
        allowTouchMove: multiple,
        grabCursor: multiple,
        keyboard: { enabled: true },
        a11y: { enabled: true },
        autoplay: autoplayEnabled
          ? {
              delay: parseInt(this.dataset.autoplayDelay, 10) || 5000,
              disableOnInteraction: false,
              pauseOnMouseEnter: true,
            }
          : false,
        navigation: {
          prevEl: this.querySelector('[data-hero-prev]'),
          nextEl: this.querySelector('[data-hero-next]'),
        },
      });

      this.handleBlockSelect = (event) => {
        const slide = event.target.closest('.swiper-slide');
        if (!slide || !this.contains(slide) || !this.swiper) return;
        const index = Array.from(this.swiper.slides).indexOf(slide);
        if (index < 0) return;
        if (this.swiper.params.loop) {
          this.swiper.slideToLoop(Number(slide.dataset.swiperSlideIndex ?? index), 0);
        } else {
          this.swiper.slideTo(index, 0);
        }
      };

      document.addEventListener('shopify:block:select', this.handleBlockSelect);
    }
  }

  if (!customElements.get('gruns-hero-slider')) {
    customElements.define('gruns-hero-slider', GrunsHeroSlider);
  }
{% endjavascript %}

{% schema %}
{
  "name": "t:general.gruns_hero",
  "blocks": [{ "type": "gruns-hero-slide" }],
  "settings": [
    {
      "type": "header",
      "content": "t:general.layout"
    },
    {
      "type": "checkbox",
      "id": "extend_behind_navbar",
      "label": "t:labels.extend_behind_navbar",
      "default": false
    },
    {
      "type": "header",
      "content": "t:general.slideshow"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "t:labels.show_arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "t:labels.loop_slides",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "t:labels.enable_autoplay",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_delay",
      "label": "t:labels.autoplay_speed",
      "min": 2,
      "max": 15,
      "step": 1,
      "unit": "s",
      "default": 6,
      "visible_if": "{{ section.settings.autoplay }}"
    }
  ],
  "presets": [
    {
      "name": "t:general.gruns_hero",
      "blocks": [{ "type": "gruns-hero-slide" }]
    }
  ]
}
{% endschema %}
