{% doc %}
  Renders a "How it Works" section: an eyebrow label, large heading, and a
  dynamic list of timeline steps on the left, paired with a bell-curve
  timeline illustration on the right showing the onset/peak/decline effect
  window.

  @example
  {% section 'how-it-works' %}
{% enddoc %}

<section
  class="how-it-works full-width"
  style="background-color: {{ section.settings.background_color }};"
  {{ section.shopify_attributes }}
>
  <div class="mx-auto flex w-full max-w-[1920px] flex-col items-center gap-10 px-5 py-[50px] sm:px-8 md:px-12 md:py-[70px] lg:flex-row lg:items-center lg:justify-between lg:gap-10 lg:px-[80px] lg:py-[100px] xl:px-[120px]">
    <div class="flex w-full flex-col items-start gap-2 lg:w-[458px] lg:shrink-0">
      {% if section.settings.eyebrow != blank %}
        <p
          class="w-full text-[18px] leading-[1.5] font-normal sm:text-[20px] lg:text-[22px]"
          style="color: {{ section.settings.text_color }};"
        >
          {{ section.settings.eyebrow }}
        </p>
      {% endif %}

      <div class="flex w-full flex-col items-start gap-4">
        {% if section.settings.heading != blank %}
          <h2
            class="w-full text-[32px] leading-[0.95] font-bold sm:text-[48px] md:text-[56px] lg:text-[72px] lg:tracking-[-2.16px]"
            style="color: {{ section.settings.heading_color }};"
          >
            {{ section.settings.heading }}
          </h2>
        {% endif %}

        {% if section.blocks.size > 0 %}
          <div class="flex w-full flex-col items-start gap-3">
            {% for block in section.blocks %}
              {% if block.type == 'step' and block.settings.text != blank %}
                <p
                  class="w-full text-[16px] leading-[1.5] font-normal lg:text-[18px]"
                  style="color: {{ section.settings.text_color }};"
                  {{ block.shopify_attributes }}
                >
                  {{ block.settings.text }}
                </p>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </div>

    <div class="w-full lg:w-[560px] lg:shrink-0">
      <img
        src="{{ 'how-it-works-graph.png' | asset_url }}"
        alt=""
        width="1123"
        height="714"
        loading="lazy"
        class="h-auto w-full"
      >
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:general.how_it_works",
  "settings": [
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "How it Work"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Our Dirnks Hit Different"
    },
    {
      "type": "header",
      "content": "t:general.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.background",
      "default": "#D7DEE5"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "t:labels.heading_color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:labels.text_color",
      "default": "#343434"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "t:general.step",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "t:labels.text",
          "default": "Minutes 10-20: feel A gentle Lift"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.how_it_works",
      "blocks": [
        { "type": "step", "settings": { "text": "Minutes 10-20: feel A gentle Lift" } },
        { "type": "step", "settings": { "text": "Minutes 20-40: Enjoy A Social Buzz" } },
        { "type": "step", "settings": { "text": "Minutes 45-65: Build Your Buzz or Enjoy A Subtle Decline" } }
      ]
    }
  ]
}
{% endschema %}
