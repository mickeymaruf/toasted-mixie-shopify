{% doc %}
  Renders a "3rd party-tested" trust banner: a heading and description on
  the left, and a responsive row of icon-badge-card blocks (e.g. Lab
  Tested, Low Dose) on the right. Add, remove, and reorder the nested
  icon-badge-card blocks to control which badges are shown.
{% enddoc %}

<section
  class="gruns-quality-badges full-width relative overflow-hidden"
  style="background-color: {{ section.settings.background_color }};"
>
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    {% if section.settings.background_image %}
      {{
        section.settings.background_image
        | image_url: width: 1600
        | image_tag: class: 'absolute size-full object-cover object-bottom', widths: '800, 1200, 1600', alt: '', style: 'opacity: 0.08; filter: saturate(0);'
      }}
    {% endif %}
    <div
      class="absolute inset-0"
      style="background: linear-gradient(89.98deg, {{ section.settings.background_color }} 16.829%, rgba(99, 109, 144, 0) 99.997%);"
    ></div>
  </div>

  <div
    class="relative mx-auto flex w-full max-w-[1200px] flex-col items-center gap-10 px-5 py-8 sm:px-8 sm:py-10 md:px-12 lg:flex-row lg:items-center lg:gap-[60px] lg:px-0 lg:py-[64px] xl:py-[80px]"
  >
    <div
      class="flex w-full flex-col items-start gap-5 text-left xl:w-[40%] xl:max-w-[40%] xl:shrink-0"
      style="color: {{ section.settings.heading_color }};"
    >
      {% if section.settings.heading != blank %}
        <div class="gruns-quality-badges__heading text-[36px] leading-[0.95] font-bold sm:text-[48px] md:text-[60px] lg:text-[62px]">
          {{ section.settings.heading }}
        </div>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="text-[18px] leading-[1.5] sm:text-[20px] lg:text-[24px]">
          {{ section.settings.description }}
        </div>
      {% endif %}
    </div>

    {% if section.blocks.size > 0 %}
      <div class="flex w-full flex-wrap gap-3 sm:gap-[10px] xl:w-[60%] xl:max-w-[60%] xl:shrink-0">
        {% content_for 'blocks' %}
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .gruns-quality-badges .shopify-block {
    display: contents;
  }
  .gruns-quality-badges__heading {
    font-family: var(--font-heading--family);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.quality_badges",
  "blocks": [{ "type": "icon-badge-card" }],
  "settings": [
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "<p>3rd party-tested for potency, purity, &amp; safety.</p>"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:labels.description",
      "default": "<p>We regularly test for all 20+ vitamins &amp; minerals to ensure claims are accurate &amp; clear of contaminants including:</p>"
    },
    {
      "type": "header",
      "content": "t:general.colors"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:labels.background_image"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.background",
      "default": "#636D90"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "t:labels.text_color",
      "default": "#F6F1EC"
    }
  ],
  "presets": [
    {
      "name": "t:general.quality_badges",
      "blocks": [
        { "type": "icon-badge-card", "settings": { "label": "Lab Tested" } },
        { "type": "icon-badge-card", "settings": { "label": "Low Dose" } },
        { "type": "icon-badge-card", "settings": { "label": "Low Calorie" } },
        { "type": "icon-badge-card", "settings": { "label": "Non-carbonated" } }
      ]
    }
  ]
}
{% endschema %}
