{% doc %}
  Renders a "3rd party-tested" trust banner: a heading and description on
  the left, and a responsive row of icon-badge-card blocks (e.g. Lab
  Tested, Low Dose) on the right. Add, remove, and reorder the nested
  icon-badge-card blocks to control which badges are shown.
{% enddoc %}

<section
  class="gruns-quality-badges full-width relative overflow-hidden"
  style="background-color: {{ section.settings.background_color }};"
>
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    {% if section.settings.background_image %}
      {{
        section.settings.background_image
        | image_url: width: 1600
        | image_tag: class: 'absolute size-full object-cover object-bottom', widths: '800, 1200, 1600', alt: '', style: 'opacity: 0.08; filter: saturate(0);'
      }}
    {% endif %}
    <div
      class="absolute inset-0"
      style="background: linear-gradient(89.98deg, {{ section.settings.background_color }} 16.829%, rgba(99, 109, 144, 0) 99.997%);"
    ></div>
  </div>

  <div
    class="relative mx-auto flex w-full max-w-[1200px] flex-col items-center gap-10 px-4 py-5 sm:px-6 sm:py-6 md:px-10 lg:flex-row lg:items-center lg:gap-[20px] lg:px-[60px] lg:py-8 xl:px-0 xl:py-10"
  >
    {% render 'quality-badges-content',
      heading: section.settings.heading,
      description: section.settings.description,
      heading_color: section.settings.heading_color,
      heading_class: 'section-heading lg:text-[58px]',
      content_class: 'w-full lg:w-auto lg:max-w-[560px] lg:shrink-0',
    %}

    {% if section.blocks.size > 0 %}
      <div
        class="relative grid w-full grid-cols-2 items-start gap-3 max-lg:[--icon-badge-card-aspect-ratio:1/1] max-lg:[--icon-badge-card-height:auto] max-lg:[--icon-badge-card-width:100%] min-[420px]:max-lg:grid-cols-3 min-[560px]:max-lg:grid-cols-4 sm:max-lg:grid-cols-[repeat(auto-fill,minmax(150px,1fr))] sm:gap-[10px] lg:min-w-0 lg:flex-[1_0_0] lg:grid-cols-4 lg:[--icon-badge-card-aspect-ratio:1/1] lg:[--icon-badge-card-height:auto] lg:[--icon-badge-card-width:100%]"
      >
        {% content_for 'blocks' %}
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .gruns-quality-badges .shopify-block {
    display: contents;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.quality_badges",
  "blocks": [{ "type": "icon-badge-card" }],
  "settings": [
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "<p>3rd party-tested for potency, purity, &amp; safety.</p>"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:labels.description",
      "default": "<p>We regularly test for all 20+ vitamins &amp; minerals to ensure claims are accurate &amp; clear of contaminants including:</p>"
    },
    {
      "type": "header",
      "content": "t:general.colors"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:labels.background_image"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.background",
      "default": "#636D90"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "t:labels.text_color",
      "default": "#F6F1EC"
    }
  ],
  "presets": [
    {
      "name": "t:general.quality_badges",
      "blocks": [
        { "type": "icon-badge-card", "settings": { "label": "Lab Tested" } },
        { "type": "icon-badge-card", "settings": { "label": "Low Dose" } },
        { "type": "icon-badge-card", "settings": { "label": "Low Calorie" } },
        { "type": "icon-badge-card", "settings": { "label": "Non-carbonated" } }
      ]
    }
  ]
}
{% endschema %}
