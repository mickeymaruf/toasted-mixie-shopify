{% comment %}
  Main product section: sticky media gallery on the left, purchase panel
  (highlights, flavor swatches, pack size + subscription picker, buy button,
  guarantee badges, accordions, promo banner) on the right.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/product
{% endcomment %}

{% liquid
  assign product = section.settings.product | default: product
  assign current_variant = product.selected_or_first_available_variant
  assign selling_plan_group = product.selling_plan_groups.first

  assign selling_plan = blank
  if selling_plan_group
    for plan in selling_plan_group.selling_plans
      assign has_current_variant = false
      for variant in product.variants
        if variant.selling_plan_allocations.first.selling_plan.id == plan.id and variant.id == current_variant.id
          assign has_current_variant = true
        endif
      endfor
      if has_current_variant
        assign selling_plan = plan
        break
      endif
    endfor
  endif

  assign rating_rounded = section.settings.rating | round
%}

<section class="product-main full-width bg-[#F6F1EC]">
  <div class="mx-auto flex w-full max-w-[1200px] flex-col items-start gap-8 px-5 pb-8 pt-5 sm:px-8 md:flex-row md:gap-6 md:px-12 lg:gap-[60px] lg:px-0 lg:py-[70px]">
    {% if product.media.size > 0 %}
      <product-gallery class="flex w-full flex-col gap-3 sm:gap-5 md:min-w-[300px] md:w-[350px] lg:sticky lg:top-8 lg:w-[585px] lg:flex-row lg:shrink-0">
        <div class="order-2 flex gap-1 overflow-x-auto sm:gap-3 lg:order-1 lg:w-[101px] lg:shrink-0 lg:flex-col lg:overflow-visible">
          {% for media in product.media %}
            <button
              type="button"
              class="product-gallery__thumb w-[80px] shrink-0 overflow-hidden rounded-lg outline-offset-2 outline-[#212323] sm:w-[101px] lg:w-full h-[100px] sm:h-[135px] m-1 {% if forloop.first %}outline-2{% endif %}"
              data-gallery-thumb
              data-index="{{ forloop.index0 }}"
              aria-label="{{ 'general.accessibility.view_media' | t: index: forloop.index }}"
            >
              {{
                media.preview_image
                | image_url: width: 200
                | image_tag: width: 200, height: 200, class: 'size-full object-cover', alt: media.alt
              }}
            </button>
          {% endfor %}
        </div>

        <div class="relative order-1 aspect-[3/4] w-full flex-1 overflow-hidden rounded-2xl sm:rounded-3xl lg:rounded-[40px] lg:order-2">
          <div class="swiper product-gallery__swiper size-full">
            <div class="swiper-wrapper">
              {% for media in product.media %}
                <div class="swiper-slide h-full" data-index="{{ forloop.index0 }}">
                  {% case media.media_type %}
                    {% when 'video', 'external_video' %}
                      {{ media | media_tag: image_size: '800x', controls: true, class: 'size-full object-cover' }}
                    {% when 'model' %}
                      {{ media | media_tag: image_size: '800x', class: 'size-full object-cover' }}
                    {% else %}
                      {{
                        media
                        | image_url: width: 800
                        | image_tag: width: 800, height: 1108, class: 'size-full object-cover', alt: media.alt
                      }}
                  {% endcase %}
                </div>
              {% endfor %}
            </div>
          </div>

          {% if product.media.size > 1 %}
            <button
              type="button"
              class="absolute bottom-[10px] left-[29%] z-10 flex size-8 items-center justify-center"
              data-gallery-prev
              aria-label="{{ 'general.accessibility.previous_slide' | t }}"
            >
              <span class="block size-4 rotate-90">{{ 'icon-chevron-down.svg' | inline_asset_content }}</span>
            </button>
            <button
              type="button"
              class="absolute right-[29%] bottom-[10px] z-10 flex size-8 items-center justify-center"
              data-gallery-next
              aria-label="{{ 'general.accessibility.next_slide' | t }}"
            >
              <span class="block size-4 -rotate-90">{{ 'icon-chevron-down.svg' | inline_asset_content }}</span>
            </button>
          {% endif %}
        </div>
      </product-gallery>
    {% endif %}

    <div class="flex w-full flex-1 flex-col gap-10">
      <div class="flex w-full flex-col gap-5">
        {% if section.settings.rating > 0 or section.settings.show_badge %}
          <div class="flex items-center gap-2">
            {% if section.settings.rating > 0 %}
              <div
                class="flex items-center gap-0 text-[#212323] leading-none"
                role="img"
                aria-label="{{ 'products.main.rating_label' | t: rating: section.settings.rating }}"
              >
                {% for i in (1..5) %}
                  <span
                    class="flex size-6 items-center justify-center -mx-[2.5px] {% unless i <= rating_rounded %}opacity-20{% endunless %}"
                    aria-hidden="true"
                    style="color: currentColor;"
                  >
                    {{ 'icon-star-thin-filled.svg' | inline_asset_content }}
                  </span>
                {% endfor %}
              </div>
            {% endif %}

            {% if section.settings.show_badge and section.settings.badge_text != blank %}
              <p class="mt-0.5 text-[12px] leading-none text-[#212323]">{{ section.settings.badge_text }}</p>
            {% endif %}
          </div>
        {% endif %}

        <h1 class="text-[32px] leading-[1.2] font-bold text-[#212323]">{{ product.title }}</h1>

        {% if product.description != blank %}
          <div class="text-[16px] leading-[1.3] text-[#212323]">{{ product.description }}</div>
        {% endif %}
      </div>

      {% content_for 'block', type: 'highlight-grid', id: 'highlight-grid' %}

      {% content_for 'block', type: 'flavor-swatch-row', id: 'flavor-swatch-row' %}

      {% content_for 'block', type: 'combo-offer', id: 'combo-offer' %}

      <script type="application/json" data-product-purchase-data>
        {
          "sellingPlanId": {{ selling_plan.id | default: 'null' }},
          "variants": {
            {% for variant in product.variants %}
              {% liquid
                assign allocation = variant.selling_plan_allocations.first

                assign savings_amount = 0
                assign savings_percent = 0
                if allocation
                  assign savings_amount = variant.price | minus: allocation.price
                  if variant.price > 0
                    assign savings_percent = savings_amount | times: 100.0 | divided_by: variant.price | round
                  endif
                endif
              %}
              "{{ variant.id }}": {
                "available": {{ variant.available | json }},
                "priceHtml": {%- capture formatted_price -%}{% render 'format-money', cents: variant.price %}{%- endcapture -%}{{ formatted_price | json }}
                {% if allocation %}
                  ,"hasSubscription": true,
                  "subscribePriceHtml": {%- capture formatted_subscribe_price -%}{% render 'format-money', cents: allocation.price %}{%- endcapture -%}{{ formatted_subscribe_price | json }},
                  "subscribeSavingsHtml": {%- capture formatted_savings -%}{% render 'format-money', cents: savings_amount %}{%- endcapture -%}{{ formatted_savings | json }},
                  "subscribePercent": {{ savings_percent }}
                {% else %}
                  ,"hasSubscription": false
                {% endif %}
              }{% unless forloop.last %},{% endunless %}
            {% endfor %}
          }
        }
      </script>

      <product-purchase id="product-buy-box" class="flex w-full flex-col gap-10 scroll-mt-24">
        {% form 'product', product %}
          {% if product.has_only_default_variant == true %}
            <input type="hidden" name="id" value="{{ current_variant.id }}">
          {% endif %}

          {% if product.has_only_default_variant == false %}
            {% liquid
              assign base_pack_count = null
              assign base_per_can_price = null
              for variant in product.variants
                assign pack_count = variant.title | split: ' ' | first | plus: 0
                if pack_count == 0
                  assign pack_count = 1
                endif
                assign variant_per_can_price = variant.price | divided_by: pack_count
                if base_pack_count == null or pack_count < base_pack_count
                  assign base_pack_count = pack_count
                  assign base_per_can_price = variant_per_can_price
                endif
              endfor
            %}
            <div class="flex w-full flex-col gap-4 mb-10">
              <p id="pack-size-heading-{{ section.id }}" class="text-[16px] leading-[1.3] font-medium text-[#212323]">
                {{ 'products.main.quantity' | t }}
              </p>

              <div
                class="flex flex-wrap gap-5 sm:gap-2"
                role="radiogroup"
                aria-labelledby="pack-size-heading-{{ section.id }}"
              >
                {% for variant in product.variants %}
                  {% liquid
                    assign pack_count = variant.title | split: ' ' | first | plus: 0
                    if pack_count == 0
                      assign pack_count = 1
                    endif
                    assign per_can_price = variant.price | divided_by: pack_count
                    capture per_can_money
                      render 'format-money', cents: per_can_price
                    endcapture

                    assign pill_percent = 0
                    if base_per_can_price > 0 and per_can_price < base_per_can_price
                      assign pill_percent = base_per_can_price | minus: per_can_price | times: 100.0 | divided_by: base_per_can_price | round
                      assign pill_percent = pill_percent | at_least: 0
                    endif
                  %}
                  <div class="relative flex flex-1 basis-[150px] flex-col items-center gap-2">
                    {% if pill_percent > 0 %}
                      <span
                        class="absolute -top-3 right-5 z-10 rounded-full px-3 py-1 text-[10px] font-medium whitespace-nowrap"
                        style="background-color: {{ section.settings.pack_pill_background_color }}; color: {{ section.settings.pack_pill_text_color }};"
                      >
                        {{ 'products.main.save_percent' | t: percent: pill_percent }}
                      </span>
                    {% endif %}

                    <label class="flex h-11 w-full cursor-pointer items-center justify-center rounded-full border border-[#212323] bg-[#F6F1EC] px-4 text-center text-[14px] font-medium whitespace-nowrap text-[#212323] has-[:checked]:bg-[#212323] has-[:checked]:text-[#F6F1EC] has-[:disabled]:cursor-not-allowed has-[:disabled]:opacity-30">
                      <input
                        type="radio"
                        name="id"
                        value="{{ variant.id }}"
                        class="sr-only"
                        {% if variant == current_variant %}
                          checked
                        {% endif %}
                        {% unless variant.available %}
                          disabled
                        {% endunless %}
                      >
                      {{ variant.title }}
                    </label>

                    <p class="text-center text-[14px] leading-[1.3] text-[#212323]">
                      {{ 'products.main.per_can' | t: price: per_can_money }}
                    </p>
                  </div>
                {% endfor %}
              </div>
            </div>
          {% endif %}

          {% if selling_plan %}
            {% liquid
              assign selected_allocation = blank
              for a in current_variant.selling_plan_allocations
                if a.selling_plan.id == selling_plan.id
                  assign selected_allocation = a
                endif
              endfor

              assign initial_savings = 0
              assign initial_percent = 0
              if selected_allocation
                assign initial_savings = current_variant.price | minus: selected_allocation.price
                if current_variant.price > 0
                  assign initial_percent = initial_savings | times: 100.0 | divided_by: current_variant.price | round
                endif
              endif
            %}
            <div
              class="flex w-full flex-col gap-3 sm:gap-5 mb-5"
              role="radiogroup"
              aria-label="{{ 'products.main.purchase_option_group_label' | t }}"
            >
              <label
                class="flex w-full flex-col gap-3 sm:gap-4 rounded-2xl px-3 py-3 sm:p-[18px]"
                style="background-color: {{ section.settings.subscribe_card_background_color }};"
              >
                <div class="flex w-full flex-col items-start gap-2 sm:flex-row sm:items-center sm:justify-between">
                  <div class="flex items-center gap-2 sm:gap-[3px]">
                    <div class="flex items-center gap-2">
                      <span class="relative flex size-5 shrink-0 items-center justify-center rounded-full border border-[#212323] p-1">
                        <input
                          type="radio"
                          name="selling_plan"
                          value="{{ selling_plan.id }}"
                          class="peer absolute inset-0 size-full cursor-pointer opacity-0"
                          checked
                        >
                        <span
                          class="pointer-events-none block size-full rounded-full bg-[#212323] opacity-0 peer-checked:opacity-100"
                        ></span>
                      </span>
                      <span class="text-[16px] font-medium whitespace-nowrap text-[#212323]">
                        {% if section.settings.subscribe_heading != blank %}
                          {{ section.settings.subscribe_heading }}
                        {% else %}
                          {{ 'products.main.subscribe_save' | t }}
                        {% endif %}
                      </span>
                    </div>
                    {% if selected_allocation %}
                      <span
                        class="rounded-full px-2 py-1 sm:px-3 text-[12px] sm:text-[14px] font-normal whitespace-nowrap"
                        style="background-color: {{ section.settings.subscribe_pill_background_color }}; color: {{ section.settings.subscribe_pill_text_color }};"
                        data-subscribe-percent-pill
                      >
                        {% if section.settings.save_badge_text != blank %}
                          {{ section.settings.save_badge_text | replace: '[percent]', initial_percent }}
                        {% else %}
                          {{ 'products.main.save_percent' | t: percent: initial_percent }}
                        {% endif %}
                      </span>
                    {% endif %}
                  </div>

                  <div class="flex flex-col items-start gap-1 sm:items-end sm:text-right">
                    <p class="text-[14px] sm:text-[16px] font-medium text-[#212323]" data-subscribe-price>
                      {% render 'format-money', cents: selected_allocation.price | default: current_variant.price %}
                    </p>
                    <p class="text-[11px] sm:text-[12px] text-[#212323]">
                      {% if section.settings.save_every_order_text != blank %}
                        {{ section.settings.save_every_order_text | replace: '[percent]', initial_percent }}
                      {% else %}
                        {{ 'products.main.save_percent_every_order' | t: percent: initial_percent }}
                      {% endif %}
                    </p>
                  </div>
                </div>

                <div class="flex w-full items-start justify-between gap-2 sm:gap-4">
                  <div class="flex flex-1 flex-col items-center gap-2 sm:gap-4">
                    {% if section.settings.benefit_1_icon %}
                      <img src="{{ section.settings.benefit_1_icon | image_url: width: 50 }}" alt="" class="size-5 sm:size-6">
                    {% else %}
                      <span class="block size-5 sm:size-6 text-[#212323]">
                        {{- 'icon-package.svg' | inline_asset_content -}}
                      </span>
                    {% endif %}
                    <p class="text-center text-[12px] sm:text-[14px] text-[#212323]">
                      {% if section.settings.benefit_1_text != blank %}
                        {{ section.settings.benefit_1_text }}
                      {% else %}
                        {{ 'products.main.delivered_every' | t: interval: '1 month' }}
                      {% endif %}
                    </p>
                  </div>

                  <div class="flex flex-1 flex-col items-center gap-2 sm:gap-4">
                    {% if section.settings.benefit_2_icon %}
                      <img src="{{ section.settings.benefit_2_icon | image_url: width: 50 }}" alt="" class="size-5 sm:size-6">
                    {% else %}
                      <span class="block size-5 sm:size-6 text-[#212323]">
                        {{- 'icon-shipping.svg' | inline_asset_content -}}
                      </span>
                    {% endif %}
                    <p class="text-center text-[12px] sm:text-[14px] text-[#212323]">
                      {% capture savings_pill %}<span class="inline-block rounded-full px-2 sm:px-3 py-[2px] text-xs mx-1" style="background-color: {{ section.settings.subscribe_pill_background_color }}; color: {{ section.settings.subscribe_pill_text_color }};" data-subscribe-savings>{% render 'format-money', cents: initial_savings %}</span>{% endcapture %}
                      {% if section.settings.benefit_2_text != blank %}
                        {{ section.settings.benefit_2_text | replace: '[amount]', savings_pill }}
                      {% else %}
                        {{ 'products.main.save_each_delivery_html' | t: amount: savings_pill }}
                      {% endif %}
                    </p>
                  </div>

                  <div class="flex flex-1 flex-col items-center gap-2 sm:gap-4">
                    {% if section.settings.benefit_3_icon %}
                      <img src="{{ section.settings.benefit_3_icon | image_url: width: 50 }}" alt="" class="size-5 sm:size-6">
                    {% else %}
                      <span class="block size-5 sm:size-6 text-[#212323]">
                        {{- 'icon-trust.svg' | inline_asset_content -}}
                      </span>
                    {% endif %}
                    <p class="text-center text-[12px] sm:text-[14px] text-[#212323]">
                      {% if section.settings.benefit_3_text != blank %}
                        {{ section.settings.benefit_3_text }}
                      {% else %}
                        {{ 'products.main.pause_skip_cancel' | t }}
                      {% endif %}
                    </p>
                  </div>
                </div>
              </label>

              <label
                class="flex w-full items-center justify-between rounded-2xl border border-[#212323] bg-[#F6F1EC] px-3 py-3 sm:p-4 has-[:checked]:border-2"
              >
                <div class="flex items-center gap-2">
                  <span class="relative flex size-5 shrink-0 items-center justify-center rounded-full border border-[#212323] bg-[#F6F1EC] p-1">
                    <input
                      type="radio"
                      name="selling_plan"
                      value=""
                      class="peer absolute inset-0 size-full cursor-pointer opacity-0"
                    >
                    <span
                      class="pointer-events-none block size-full rounded-full bg-[#212323] opacity-0 peer-checked:opacity-100"
                    ></span>
                  </span>
                  <span class="text-[16px] font-medium text-[#212323]">{{ 'products.main.one_time_order' | t }}</span>
                </div>

                <div class="flex flex-1 flex-col items-end gap-1 text-right">
                  <p class="text-[16px] font-medium text-[#212323]" data-one-time-price>
                    {% render 'format-money', cents: current_variant.price %}
                  </p>
                  <p class="text-[12px] whitespace-nowrap text-[#212323]">
                    {{ 'products.main.standard_purchase' | t }}
                  </p>
                </div>
              </label>
            </div>
          {% endif %}

          <button
            type="submit"
            name="add"
            class="flex h-[58px] w-full items-center justify-center gap-[5px] rounded-[30px] bg-[#212323] px-8 py-4 text-center text-[16px] sm:text-[20px] text-[#F6F1EC] transition-opacity duration-150 hover:opacity-85 disabled:opacity-30"
            data-buy-button
            {% unless current_variant.available %}
              disabled
            {% endunless %}
          >
            <span
              class="inline-flex items-center gap-[5px]"
              data-buy-button-content
            >
              <span
                data-buy-button-label
                data-subscribe-label="{{ 'products.main.buy_button_subscribe' | t }}"
                data-one-time-label="{{ 'products.main.buy_button_one_time' | t }}"
                data-sold-out-label="{{ 'products.main.sold_out' | t }}"
                data-has-custom-label="{% if section.settings.custom_button_text != blank %}true{% else %}false{% endif %}"
              >
                {% if section.settings.custom_button_text != blank %}
                  {{ section.settings.custom_button_text }}
                {% elsif current_variant.available == false %}
                  {{ 'products.main.sold_out' | t }}
                {% elsif selling_plan %}
                  {{ 'products.main.buy_button_subscribe' | t }}
                {% else %}
                  {{ 'products.main.buy_button_one_time' | t }}
                {% endif %}
              </span>
              <span
                class="font-medium"
                data-buy-button-price
                {% unless current_variant.available %}
                  hidden
                {% endunless %}
                {% if section.settings.custom_button_text != blank %}
                  hidden
                {% endif %}
              >
                {% if selling_plan %}
                  {% render 'format-money', cents: selected_allocation.price | default: current_variant.price %}
                {% else %}
                  {% render 'format-money', cents: current_variant.price %}
                {% endif %}
              </span>
            </span>
            <span
              class="hidden"
              data-buy-button-loader
              aria-hidden="true"
            >
              <span
                class="inline-block size-5 animate-spin rounded-full border-2 border-current border-t-transparent"
              ></span>
            </span>
          </button>
        {% endform %}
      </product-purchase>

      {% content_for 'block', type: 'badge-row', id: 'badge-row' %}

      {% content_for 'block', type: 'accordion-list', id: 'accordion-list' %}

      {% content_for 'block', type: 'promo-banner', id: 'promo-banner' %}
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const initProductGallery = () => {
      const galleryEl = document.querySelector('product-gallery');
      const swiperEl = galleryEl?.querySelector('.product-gallery__swiper');
      if (!galleryEl || !swiperEl || typeof Swiper === 'undefined') return;

      const prevEl = galleryEl.querySelector('[data-gallery-prev]');
      const nextEl = galleryEl.querySelector('[data-gallery-next]');
      const thumbs = Array.from(galleryEl.querySelectorAll('[data-gallery-thumb]'));

      const setActiveThumb = (realIndex) => {
        thumbs.forEach((thumb, index) => {
          thumb.classList.toggle('outline-2', index === realIndex);
        });
      };

      const gallerySwiper = new Swiper(swiperEl, {
        slidesPerView: 1,
        spaceBetween: 20,
        loop: true,
        grabCursor: true,
        navigation: {
          prevEl: prevEl,
          nextEl: nextEl,
        },
        on: {
          realIndexChange: (swiper) => setActiveThumb(swiper.realIndex),
        },
      });

      thumbs.forEach((thumb) => {
        thumb.addEventListener('click', () => {
          gallerySwiper.slideToLoop(Number(thumb.dataset.index));
        });
      });
    };

    initProductGallery();

    // Support Shopify Theme Editor re-initialization
    document.addEventListener('shopify:section:load', initProductGallery);
  });
</script>

{% stylesheet %}
  .product-gallery__swiper .swiper-slide {
    box-sizing: border-box;
  }
{% endstylesheet %}

{% javascript %}
  class ProductPurchase extends HTMLElement {
    connectedCallback() {
      const dataScript = document.querySelector('[data-product-purchase-data]');
      this.data = dataScript ? JSON.parse(dataScript.textContent) : { variants: {} };

      this.buyButton = this.querySelector('[data-buy-button]');
      this.buyButtonLabel = this.querySelector('[data-buy-button-label]');
      this.buyButtonPrice = this.querySelector('[data-buy-button-price]');
      this.subscribePrice = this.querySelector('[data-subscribe-price]');
      this.subscribeSavings = this.querySelector('[data-subscribe-savings]');
      this.subscribePercentPill = this.querySelector('[data-subscribe-percent-pill]');
      this.oneTimePrice = this.querySelector('[data-one-time-price]');
      this.form = this.querySelector('form');

      this.addEventListener('change', (event) => {
        if (event.target.matches('[name="id"], [name="selling_plan"]')) this.update();
      });

      this.form?.addEventListener('submit', (event) => this.handleSubmit(event));
    }

    async handleSubmit(event) {
      const drawer = document.querySelector('cart-drawer');
      if (!drawer) return;

      event.preventDefault();

      const buttonContent = this.buyButton.querySelector('[data-buy-button-content]');
      const buttonLoader = this.buyButton.querySelector('[data-buy-button-loader]');

      try {
        this.buyButton.disabled = true;
        buttonContent.classList.add('hidden');
        buttonLoader.classList.remove('hidden');

        await drawer.addItem(new FormData(this.form));
      } catch (error) {
        this.form.submit();
      } finally {
        this.buyButton.disabled = false;
        buttonContent.classList.remove('hidden');
        buttonLoader.classList.add('hidden');
      }
    }

    get currentVariant() {
      const id = this.querySelector('[name="id"]:checked')?.value;
      return id ? this.data.variants[id] : null;
    }

    get isSubscribing() {
      return Boolean(this.querySelector('[name="selling_plan"]:checked')?.value);
    }

    update() {
      const variant = this.currentVariant;
      if (!variant) return;

      if (this.oneTimePrice) this.oneTimePrice.textContent = variant.priceHtml;

      if (variant.hasSubscription) {
        if (this.subscribePrice) this.subscribePrice.textContent = variant.subscribePriceHtml;
        if (this.subscribeSavings) this.subscribeSavings.textContent = variant.subscribeSavingsHtml;
        if (this.subscribePercentPill) {
          const pillText = this.subscribePercentPill.textContent;
          const newText = pillText.replace(/\d+%/, `${variant.subscribePercent}%`);
          this.subscribePercentPill.textContent = newText;
        }
      }

      const subscribing = variant.hasSubscription && this.isSubscribing;

      if (this.buyButtonPrice) {
        const hasCustomLabel = this.buyButtonLabel?.dataset.hasCustomLabel === 'true';
        this.buyButtonPrice.hidden = true;
      }

      if (this.buyButtonLabel) {
        const hasCustomLabel = this.buyButtonLabel.dataset.hasCustomLabel === 'true';
        if (!hasCustomLabel) {
          if (!variant.available) {
            this.buyButtonLabel.textContent = this.buyButtonLabel.dataset.soldOutLabel;
          } else {
            const label = subscribing
              ? this.buyButtonLabel.dataset.subscribeLabel
              : this.buyButtonLabel.dataset.oneTimeLabel;
            const price = subscribing ? variant.subscribePriceHtml : variant.priceHtml;
            this.buyButtonLabel.innerHTML = `${label} ${price}`;
          }
        }
      }

      if (this.buyButton) this.buyButton.disabled = !variant.available;
    }
  }

  customElements.define('product-purchase', ProductPurchase);
{% endjavascript %}

