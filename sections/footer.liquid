{% comment %}
  Renders the site footer: logo and newsletter signup beside social icons and
  Shop/Help/About link columns (stacked below xl, with the link groups as accordions), plus a bottom
  legal bar.
{% endcomment %}

{% liquid
  assign newsletter_form_id = 'FooterNewsletterForm-' | append: section.id
  assign newsletter_email_id = newsletter_form_id | append: '-email'
%}

<footer
  class="gruns-footer full-width relative overflow-hidden"
  style="background-color: {{ section.settings.background_color }}; color: {{ section.settings.text_color }};"
>
  <div
    class="pointer-events-none absolute bottom-[-17.92vw] left-[9.976%] block aspect-square w-[149.69%] opacity-30 lg:top-[2.0778vw] lg:bottom-auto lg:left-[74.6528%] lg:w-[32.9861%]"
    aria-hidden="true"
  >
    <img
      src="{{ 'icon-footer-flamingo.svg' | asset_url }}"
      alt=""
      width="475"
      height="475"
      class="block size-full max-w-none"
      loading="lazy"
    >
  </div>

  <div class="relative mx-auto flex w-full max-w-[1920px] flex-col gap-10 px-5 py-14 sm:px-8 md:px-12 xl:gap-[50px] xl:px-[60px] xl:pt-[80px] xl:pb-[40px] 2xl:px-[100px]">
    <div class="flex w-full flex-col items-center gap-10 xl:flex-row xl:items-start xl:justify-between xl:gap-8">
      <div class="flex w-full flex-col items-center gap-10 xl:w-auto xl:items-start xl:gap-[50px]">
        <a
          href="{{ routes.root_url }}"
          class="block max-w-full xl:!w-[337px]"
          style="width: clamp(180px, 55vw, 206px);"
        >
          {% if section.settings.logo %}
            {{
              section.settings.logo
              | image_url: width: 800
              | image_tag: loading: 'lazy', widths: '200, 300, 400, 600, 800', alt: shop.name
            }}
          {% else %}
            {{ 'logo-toasted.svg' | inline_asset_content }}
          {% endif %}
        </a>

        <div class="flex w-full flex-col items-center gap-[15px] xl:w-[337px] xl:items-start xl:gap-[10px]">
          {% if section.settings.desktop_heading != blank %}
            <p class="text-[24px] leading-[1.2] font-medium">{{ section.settings.desktop_heading }}</p>
          {% endif %}

          {% form 'customer', id: newsletter_form_id, class: 'w-full max-w-[287px] xl:max-w-none' %}
            <input type="hidden" name="contact[tags]" value="newsletter">

            <div
              class="flex w-full items-center justify-between gap-2 rounded-full py-[6px] pr-[6px] pl-[24px]"
              style="
                --footer-newsletter-bg: {{ section.settings.newsletter_background_color }};
                --footer-newsletter-button-bg: {{ section.settings.newsletter_button_background_color }};
                --footer-newsletter-button-text: {{ section.settings.newsletter_button_text_color }};
                background-color: var(--footer-newsletter-bg);
              "
            >
              <label for="{{ newsletter_email_id }}" class="sr-only">{{ 'footer.email_label' | t }}</label>
              <input
                type="email"
                name="contact[email]"
                id="{{ newsletter_email_id }}"
                placeholder="{{ section.settings.email_placeholder }}"
                autocomplete="email"
                required
                class="min-w-0 flex-1 bg-transparent text-[16px] leading-[1.5] placeholder:text-[color:var(--footer-newsletter-button-bg)] focus:outline-none xl:text-[20px]"
                style="color: var(--footer-newsletter-button-bg);"
              >
              <button
                type="submit"
                class="inline-flex h-[58px] w-[56px] shrink-0 cursor-pointer items-center justify-center rounded-[30px] transition-opacity duration-150 hover:opacity-85 focus-visible:outline-2 focus-visible:outline-offset-2"
                style="background-color: var(--footer-newsletter-button-bg); color: var(--footer-newsletter-button-text); outline-color: var(--footer-newsletter-button-text);"
                aria-label="{{ section.settings.newsletter_button_label | escape }}"
              >
                <svg
                  width="24"
                  height="18"
                  viewBox="0 0 24 18"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.71429"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path d="M0 9H24M15 18L24 9L15 0" />
                </svg>
              </button>
            </div>

            {% if form.posted_successfully? %}
              <p class="mt-3 text-[14px]" role="status">{{ 'footer.newsletter_success' | t }}</p>
            {% elsif form.errors %}
              <p class="mt-3 text-[14px]" role="alert">{{ 'footer.newsletter_error' | t }}</p>
            {% endif %}
          {% endform %}
        </div>
      </div>

      <div class="flex w-full flex-col items-center gap-7 xl:w-auto xl:flex-row xl:items-start xl:gap-[50px]">
        <div class="flex flex-col items-center gap-[10px] xl:items-start xl:gap-[30px]">
          <p class="text-[28px] leading-[1.2] font-medium">{{ 'footer.follow_us' | t }}</p>
          <div class="flex items-center gap-[10px]">
            {% content_for 'blocks' %}
          </div>
        </div>

        <div class="w-full xl:flex xl:w-auto xl:gap-[50px]">
          {% assign footer_menus = 'shop,help,about' | split: ',' %}
          {% for menu_key in footer_menus %}
            {% liquid
              assign menu_title_key = menu_key | append: '_title'
              assign menu_id_key = menu_key | append: '_menu'
              assign menu_title = section.settings[menu_title_key]
              assign menu = section.settings[menu_id_key]
              assign panel_id = 'FooterMenu-' | append: section.id | append: '-' | append: menu_key
            %}
            {% if menu.links.size > 0 %}
              <div class="footer-accordion border-t border-current xl:flex xl:flex-col xl:items-start xl:gap-[30px] xl:border-t-0 {% if menu_key == 'about' %}xl:items-end xl:text-right{% endif %}">
                <button
                  type="button"
                  class="flex w-full cursor-pointer items-center justify-between py-7 text-left text-[28px] leading-[1.2] font-medium xl:pointer-events-none xl:cursor-default xl:p-0"
                  aria-expanded="false"
                  aria-controls="{{ panel_id }}"
                  data-footer-accordion-toggle
                >
                  <span>{{ menu_title }}</span>
                  <svg
                    class="footer-accordion__chevron shrink-0 xl:hidden"
                    width="20"
                    height="9"
                    viewBox="0 0 20 9"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path d="M1 1L10 8L19 1" />
                  </svg>
                </button>
                <div id="{{ panel_id }}" class="footer-accordion__panel">
                  <div class="overflow-hidden">
                    <ul class="flex flex-col items-start gap-[15px] pb-7 text-[18px] leading-[1.3] xl:pb-0 xl:text-[16px] {% if menu_key == 'about' %}xl:items-end{% endif %}">
                      {% for link in menu.links %}
                        <li>
                          <a href="{{ link.url }}" class="inline-flex items-center gap-1 transition-opacity duration-150 hover:opacity-70">
                            {{ link.title }}
                            {% if link.type == 'http_link' and link.url contains '://' %}
                              <svg width="12" height="12" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true" focusable="false">
                                <path d="M9.6 9.6V4.09197L1.69197 12H0V10.308L7.90803 2.4H2.4V0H12V9.6H9.6Z" />
                              </svg>
                            {% endif %}
                          </a>
                        </li>
                      {% endfor %}
                    </ul>
                  </div>
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>

    {% if section.settings.copyright_text != blank or section.settings.legal_menu.links.size > 0 or section.settings.show_payment_icons %}
      <div class="flex flex-col items-center gap-3 text-[14px] leading-[1.3] xl:flex-row xl:justify-between">
        {% if section.settings.copyright_text != blank %}
          <p class="text-center xl:max-w-[38%] xl:text-left">
            &copy; {{ 'now' | date: '%Y' }}
            {{ section.settings.copyright_text }}
          </p>
        {% endif %}

        {% if section.settings.show_payment_icons %}
          <div
            class="flex flex-wrap items-center justify-center gap-1.5 xl:shrink-0 xl:flex-nowrap"
            aria-label="{{ 'footer.payment_methods_label' | t }}"
          >
            {% assign payment_icons = 'visa,mastercard,amex,discover,dinersclub,applepay,googlepay' | split: ',' %}
            {% for icon in payment_icons %}
              {% if icon == 'amex' %}
                {% assign icon_size_class = 'h-[20.5px] w-[30px] [&>svg]:h-full [&>svg]:w-full' %}
              {% else %}
                {% assign icon_size_class = 'h-6 w-auto [&>svg]:h-full [&>svg]:w-auto' %}
              {% endif %}
              <span class="block shrink-0 [&>svg]:block {{ icon_size_class }}" aria-hidden="true">
                {{ 'icon-payment-' | append: icon | append: '.svg' | inline_asset_content }}
              </span>
            {% endfor %}
          </div>
        {% endif %}

        {% if section.settings.legal_menu.links.size > 0 %}
          <ul class="flex flex-wrap items-center justify-center gap-x-[10px] gap-y-1 xl:max-w-[38%] xl:justify-end">
            {% for link in section.settings.legal_menu.links %}
              <li class="flex items-center gap-x-[10px]">
                <a href="{{ link.url }}" class="transition-opacity duration-150 hover:opacity-70">{{ link.title }}</a>
                {% unless forloop.last %}
                  <span aria-hidden="true">|</span>
                {% endunless %}
              </li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>
    {% endif %}
  </div>
</footer>

{% stylesheet %}
  .footer-accordion__panel {
    display: grid;
    grid-template-rows: 0fr;
    visibility: hidden;
    transition:
      grid-template-rows 0.25s ease,
      visibility 0.25s;
  }
  .footer-accordion.is-open .footer-accordion__panel {
    grid-template-rows: 1fr;
    visibility: visible;
  }
  .footer-accordion.is-open .footer-accordion__chevron {
    transform: rotate(180deg);
  }
  .footer-accordion__chevron {
    transition: transform 0.25s ease;
  }
  @media (min-width: 80rem) {
    .footer-accordion__panel {
      grid-template-rows: 1fr;
      visibility: visible;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .footer-accordion__panel,
    .footer-accordion__chevron {
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  document.addEventListener('click', (event) => {
    const toggle = event.target.closest('[data-footer-accordion-toggle]');
    if (!toggle) return;
    const accordion = toggle.closest('.footer-accordion');
    const isOpen = accordion.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(isOpen));
  });
{% endjavascript %}

{% schema %}
{
  "name": "t:general.footer",
  "blocks": [{ "type": "social-icon" }],
  "settings": [
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "text",
      "id": "desktop_heading",
      "label": "t:labels.heading_desktop",
      "default": "Subscribe to our newsletter"
    },
    {
      "type": "header",
      "content": "t:general.newsletter"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "t:labels.email_placeholder",
      "default": "Email Address"
    },
    {
      "type": "text",
      "id": "newsletter_button_label",
      "label": "t:labels.button_label",
      "default": "Join the list"
    },
    {
      "type": "color",
      "id": "newsletter_background_color",
      "label": "t:labels.background",
      "default": "#F6F1EC"
    },
    {
      "type": "color",
      "id": "newsletter_button_background_color",
      "label": "t:labels.button_background",
      "default": "#212323"
    },
    {
      "type": "color",
      "id": "newsletter_button_text_color",
      "label": "t:labels.button_text_color",
      "default": "#F6F1EC"
    },
    {
      "type": "header",
      "content": "t:general.image"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:labels.logo"
    },
    {
      "type": "header",
      "content": "t:general.menus"
    },
    {
      "type": "text",
      "id": "shop_title",
      "label": "t:labels.title",
      "default": "Shop"
    },
    {
      "type": "link_list",
      "id": "shop_menu",
      "label": "t:labels.menu"
    },
    {
      "type": "text",
      "id": "help_title",
      "label": "t:labels.title",
      "default": "Help"
    },
    {
      "type": "link_list",
      "id": "help_menu",
      "label": "t:labels.menu"
    },
    {
      "type": "text",
      "id": "about_title",
      "label": "t:labels.title",
      "default": "About"
    },
    {
      "type": "link_list",
      "id": "about_menu",
      "label": "t:labels.menu"
    },
    {
      "type": "header",
      "content": "t:general.legal"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "t:labels.copyright_text",
      "default": "The Toasted Company, Inc. All Rights Reserved."
    },
    {
      "type": "link_list",
      "id": "legal_menu",
      "label": "t:labels.menu"
    },
    {
      "type": "header",
      "content": "t:general.payment_icons"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:labels.show_payment_icons",
      "default": true
    },
    {
      "type": "header",
      "content": "t:general.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.background",
      "default": "#C2CBD4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:labels.foreground",
      "default": "#212323"
    }
  ]
}
{% endschema %}
