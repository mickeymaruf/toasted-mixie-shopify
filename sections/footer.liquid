{% comment %}
  Renders the site footer: Shop/Help link columns, a centered logo and
  newsletter signup, a social icon row, and a bottom legal bar.
{% endcomment %}

{% liquid
  assign newsletter_form_id = 'FooterNewsletterForm-' | append: section.id
  assign newsletter_email_id = newsletter_form_id | append: '-email'
%}

<footer
  class="gruns-footer full-width relative overflow-hidden"
  style="background-color: {{ section.settings.background_color }}; color: {{ section.settings.text_color }};"
>
  {% if section.settings.background_mark %}
    <div
      class="pointer-events-none absolute bottom-0 right-0 hidden aspect-square w-[45vw] max-w-[717px] translate-y-[5%] translate-x-[7%] lg:block"
      aria-hidden="true"
    >
      {{
        section.settings.background_mark
        | image_url: width: 1434
        | image_tag: class: 'size-full object-contain'
      }}
    </div>
  {% endif %}

  <div class="relative mx-auto flex w-full max-w-[1920px] flex-col gap-10 px-5 py-14 sm:px-8 md:px-12 lg:gap-16 lg:px-[80px] lg:pt-[80px] lg:pb-[50px] xl:px-[120px]">
    <div class="flex w-full flex-col gap-[60px] items-center">
      <a
        href="{{ routes.root_url }}"
        class="block max-w-full"
        style="width: clamp(140px, 45vw, {{ section.settings.logo_width }}px);"
      >
        {% if section.settings.logo %}
          {{
            section.settings.logo
            | image_url: width: 800
            | image_tag: loading: 'lazy', widths: '200, 300, 400, 600, 800', alt: shop.name
          }}
        {% else %}
          {{ 'logo-toasted.svg' | inline_asset_content }}
        {% endif %}
      </a>

      <div class="flex w-full flex-col items-center gap-10 lg:flex-row lg:items-stretch lg:justify-between lg:gap-8">
        <div class="flex w-full flex-col gap-[30px] items-center text-center sm:items-start sm:text-left lg:w-auto lg:items-start">
          {% if section.settings.heading != blank or section.settings.subheading != blank %}
            <div class="flex flex-col gap-[10px]">
              {% if section.settings.heading != blank %}
                <p class="text-[28px] leading-[1.2] font-bold sm:text-[32px]">{{ section.settings.heading }}</p>
              {% endif %}
              {% if section.settings.subheading != blank %}
                <p class="text-[16px] leading-[1.5] sm:text-[20px]">{{ section.settings.subheading }}</p>
              {% endif %}
            </div>
          {% endif %}

          {% form 'customer', id: newsletter_form_id, class: 'w-full' %}
            <input type="hidden" name="contact[tags]" value="newsletter">

            <div
              class="flex w-full items-center justify-between gap-2 rounded-full py-[6px] pr-[6px] pl-[24px] sm:pl-[38px]"
              style="
                --footer-newsletter-bg: {{ section.settings.newsletter_background_color }};
                --footer-newsletter-button-bg: {{ section.settings.newsletter_button_background_color }};
                --footer-newsletter-button-text: {{ section.settings.newsletter_button_text_color }};
                background-color: var(--footer-newsletter-bg);
              "
            >
              <label for="{{ newsletter_email_id }}" class="sr-only">{{ 'footer.email_label' | t }}</label>
              <input
                type="email"
                name="contact[email]"
                id="{{ newsletter_email_id }}"
                placeholder="{{ section.settings.email_placeholder }}"
                autocomplete="email"
                required
                class="min-w-0 flex-1 bg-transparent text-[16px] leading-[1.5] placeholder:text-[color:var(--footer-newsletter-button-bg)] focus:outline-none sm:text-[20px]"
                style="color: var(--footer-newsletter-button-bg);"
              >
              <button
                type="submit"
                class="inline-flex h-[58px] shrink-0 items-center justify-center rounded-[30px] px-6 text-center text-[16px] leading-[1.5] font-medium whitespace-nowrap transition-opacity duration-150 hover:opacity-85 focus-visible:outline-2 focus-visible:outline-offset-2 sm:px-8 sm:text-[20px]"
                style="background-color: var(--footer-newsletter-button-bg); color: var(--footer-newsletter-button-text); outline-color: var(--footer-newsletter-button-text);"
              >
                {{ section.settings.newsletter_button_label }}
              </button>
            </div>

            {% if form.posted_successfully? %}
              <p class="mt-3 text-[14px]" role="status">{{ 'footer.newsletter_success' | t }}</p>
            {% elsif form.errors %}
              <p class="mt-3 text-[14px]" role="alert">{{ 'footer.newsletter_error' | t }}</p>
            {% endif %}
          {% endform %}

          <div class="flex items-center gap-[15px]">
            {% content_for 'blocks' %}
          </div>
        </div>

        <div class="flex w-full flex-row flex-wrap items-start justify-center gap-10 sm:gap-16 lg:w-auto lg:gap-[60px]">
          {% if section.settings.shop_menu.links.size > 0 %}
            <div class="flex flex-1 flex-col gap-[30px] items-center text-center sm:flex-none sm:items-start sm:text-left">
              {% if section.settings.shop_title != blank %}
                <p class="text-[28px] leading-[1.2] font-bold">{{ section.settings.shop_title }}</p>
              {% endif %}
              <ul class="flex flex-col items-start gap-[15px] text-[16px] leading-[1.3]">
                {% for link in section.settings.shop_menu.links %}
                  <li>
                    <a href="{{ link.url }}" class="transition-opacity duration-150 hover:opacity-70">{{ link.title }}</a>
                  </li>
                {% endfor %}
              </ul>
            </div>
          {% endif %}

          {% if section.settings.help_menu.links.size > 0 %}
            <div class="flex flex-1 flex-col gap-[30px] items-center text-center sm:flex-none sm:items-start sm:text-left">
              {% if section.settings.help_title != blank %}
                <p class="text-[28px] leading-[1.2] font-bold">{{ section.settings.help_title }}</p>
              {% endif %}
              <ul class="flex flex-col items-start gap-[15px] text-[16px] leading-[1.3]">
                {% for link in section.settings.help_menu.links %}
                  <li>
                    <a href="{{ link.url }}" class="transition-opacity duration-150 hover:opacity-70">{{ link.title }}</a>
                  </li>
                {% endfor %}
              </ul>
            </div>
          {% endif %}

          {% if section.settings.about_menu.links.size > 0 %}
            <div class="flex flex-1 flex-col gap-[30px] items-center text-center sm:flex-none sm:items-start sm:text-left lg:items-end lg:text-right">
              {% if section.settings.about_title != blank %}
                <p class="text-[28px] leading-[1.2] font-bold">{{ section.settings.about_title }}</p>
              {% endif %}
              <ul class="flex flex-col items-center gap-[15px] text-[16px] leading-[1.3] sm:items-start lg:items-end">
                {% for link in section.settings.about_menu.links %}
                  <li>
                    <a
                      href="{{ link.url }}"
                      class="inline-flex items-center gap-[8px] transition-opacity duration-150 hover:opacity-70"
                    >
                      {{ link.title }}
                      {% if forloop.last %}
                        <span class="block size-[12px]">{{ 'arrow-tr.svg' | inline_asset_content }}</span>
                      {% endif %}
                    </a>
                  </li>
                {% endfor %}
              </ul>
            </div>
          {% endif %}
        </div>
      </div>
    </div>

    {% if section.settings.copyright_text != blank or section.settings.legal_menu.links.size > 0 %}
      <div class="flex flex-col items-center gap-3 text-[14px] leading-[1.3] lg:flex-row lg:items-center lg:justify-between">
        {% if section.settings.copyright_text != blank %}
          <p class="text-center lg:text-left">
            &copy; {{ 'now' | date: '%Y' }}
            {{ section.settings.copyright_text }}
          </p>
        {% endif %}

        {% if section.settings.legal_menu.links.size > 0 %}
          <ul class="flex flex-wrap items-center justify-center gap-x-[10px] gap-y-1">
            {% for link in section.settings.legal_menu.links %}
              <li class="flex items-center gap-x-[10px]">
                <a href="{{ link.url }}" class="transition-opacity duration-150 hover:opacity-70">{{ link.title }}</a>
                {% unless forloop.last %}
                  <span aria-hidden="true">|</span>
                {% endunless %}
              </li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>
    {% endif %}
  </div>
</footer>

{% schema %}
{
  "name": "t:general.footer",
  "blocks": [{ "type": "social-icon" }],
  "settings": [
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Be first to know."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:labels.subheading",
      "default": "Get launch updates, first drops, and new flavor news."
    },
    {
      "type": "header",
      "content": "t:general.newsletter"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "t:labels.email_placeholder",
      "default": "Email Address"
    },
    {
      "type": "text",
      "id": "newsletter_button_label",
      "label": "t:labels.button_label",
      "default": "Join the list"
    },
    {
      "type": "color",
      "id": "newsletter_background_color",
      "label": "t:labels.background",
      "default": "#F6F1EC"
    },
    {
      "type": "color",
      "id": "newsletter_button_background_color",
      "label": "t:labels.button_background",
      "default": "#212323"
    },
    {
      "type": "color",
      "id": "newsletter_button_text_color",
      "label": "t:labels.button_text_color",
      "default": "#F6F1EC"
    },
    {
      "type": "header",
      "content": "t:general.image"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:labels.logo"
    },
    {
      "type": "image_picker",
      "id": "background_mark",
      "label": "t:labels.background_mark"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 160,
      "max": 400,
      "step": 4,
      "unit": "px",
      "label": "t:labels.logo_width",
      "default": 280
    },
    {
      "type": "header",
      "content": "t:general.menus"
    },
    {
      "type": "text",
      "id": "shop_title",
      "label": "t:labels.title",
      "default": "Shop"
    },
    {
      "type": "link_list",
      "id": "shop_menu",
      "label": "t:labels.menu"
    },
    {
      "type": "text",
      "id": "help_title",
      "label": "t:labels.title",
      "default": "Help"
    },
    {
      "type": "link_list",
      "id": "help_menu",
      "label": "t:labels.menu"
    },
    {
      "type": "text",
      "id": "about_title",
      "label": "t:labels.title",
      "default": "About"
    },
    {
      "type": "link_list",
      "id": "about_menu",
      "label": "t:labels.menu"
    },
    {
      "type": "header",
      "content": "t:general.legal"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "t:labels.copyright_text",
      "default": "The Toasted Company, Inc. All Rights Reserved."
    },
    {
      "type": "link_list",
      "id": "legal_menu",
      "label": "t:labels.menu"
    },
    {
      "type": "header",
      "content": "t:general.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.background",
      "default": "#C2CBD4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:labels.foreground",
      "default": "#212323"
    }
  ]
}
{% endschema %}
