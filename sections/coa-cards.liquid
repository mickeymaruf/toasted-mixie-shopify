{% doc %}
  Renders a responsive grid of COA (Certificate of Analysis) card blocks.
  Each card displays a product/batch title with a "View Batches" link and icon.
  Fully customizable with dynamic content and soft peach background styling.

  @example
  {% section 'coa-cards' %}
{% enddoc %}

<section
  class="coa-cards full-width"
  style="background-color: {{ section.settings.background_color }};"
  {{ section.shopify_attributes }}
>
  <div
    class="mx-auto w-full max-w-[1920px] px-5 sm:px-8 md:px-12 lg:px-[80px] xl:px-[120px] py-[50px] md:py-[100px]"
  >
    {% if section.blocks.size > 0 %}
      <div class="grid w-full grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 lg:gap-[20px] items-start">
        {% for block in section.blocks %}
          <div
            class="coa-cards__card-wrapper rounded-[16px] overflow-hidden"
            style="background-color: {{ block.settings.card_background_color }}"
            {{ block.shopify_attributes }}
          >
            <button
              class="coa-cards__card w-full flex flex-col items-center justify-center gap-5 px-[37px] py-[30px] transition-all duration-200 cursor-pointer"
              data-card-toggle
            >
              <div class="flex flex-col items-center gap-5">
                <!-- Title -->
                <h3 class="text-center text-[32px] font-semibold leading-[1.2] text-[#212323]">
                  {{ block.settings.title }}
                </h3>

                <!-- Link with Icon -->
                <div class="flex flex-col items-center gap-[15px]">
                  <p class="coa-cards__link-text text-center text-xl font-normal leading-[1.2] text-[#212323] underline decoration-from-font transition-opacity duration-200">
                    {{ block.settings.link_text }}
                  </p>
                  <!-- Dropdown Icon -->
                  <div class="coa-cards__icon flex h-[22px] w-[22px] items-center justify-center transition-transform duration-200">
                    <img src="{{ 'icon-arrow-down-1.svg' | asset_url }}" alt="" class="h-full w-full" />
                  </div>
                </div>
              </div>
            </button>

            <!-- Expanded Content -->
            <div class="coa-cards__expanded hidden">
              {% for i in (1..3) %}
                {% assign batch_num_key = 'batch_' | append: i | append: '_number' %}
                {% assign batch_date_key = 'batch_' | append: i | append: '_date' %}
                {% assign batch_url_key = 'batch_' | append: i | append: '_url' %}

                {% if block.settings[batch_num_key] %}
                  <div class="flex flex-col gap-[34px] px-[37px] py-[30px] items-start">
                    <div class="flex flex-col gap-[10px] w-full">
                      <p class="text-[24px] font-semibold leading-[1.2] text-[#212323]">
                        Batch Number: {{ block.settings[batch_num_key] }}
                      </p>
                      {% if block.settings[batch_date_key] %}
                        <p class="text-[24px] font-normal leading-[1.2] text-[#212323]">
                          Batch Date: {{ block.settings[batch_date_key] }}
                        </p>
                      {% endif %}
                      {% if block.settings[batch_url_key] %}
                        <div class="flex gap-[6px] items-center">
                          <a href="{{ block.settings[batch_url_key] }}" target="_blank" rel="noopener noreferrer" class="text-[20px] font-normal leading-[1.3] text-[#212323] underline decoration-from-font">
                            COA PDF
                          </a>
                          <svg class="w-[12px] h-[12px]" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M1 11L11 1M11 1H6M11 1V6" stroke="#212323" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        </div>
                      {% endif %}
                    </div>
                    {% if forloop.last == false and block.settings[batch_num_key] and forloop.index < 3 %}
                      {% assign next_batch = forloop.index | plus: 1 %}
                      {% assign next_key = 'batch_' | append: next_batch | append: '_number' %}
                      {% if block.settings[next_key] %}
                        <hr class="w-full border-t border-[#212323] border-opacity-15" />
                      {% endif %}
                    {% endif %}
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .coa-cards__expanded {
    border-top: 1px solid rgba(33, 35, 35, 0.15);
  }

  .coa-cards__expanded.visible {
    display: block;
  }

  .coa-cards__icon {
    transform: scaleY(1);
  }

  .coa-cards__card.open .coa-cards__icon {
    transform: scaleY(-1);
  }

  .coa-cards__link-text {
    transition: opacity 0.2s ease, height 0.2s ease, margin 0.2s ease;
    overflow: hidden;
  }

  .coa-cards__card.open .coa-cards__link-text {
    opacity: 0;
    height: 0;
    margin: 0;
  }
{% endstylesheet %}

{% javascript %}
  document.addEventListener('DOMContentLoaded', function() {
    const toggleButtons = document.querySelectorAll('[data-card-toggle]');

    toggleButtons.forEach(button => {
      button.addEventListener('click', function(e) {
        const card = this;
        const expanded = card.parentElement.querySelector('.coa-cards__expanded');

        if (!expanded) return;

        e.preventDefault();

        card.classList.toggle('open');
        expanded.classList.toggle('visible');
      });
    });
  });
{% endjavascript %}

