{% doc %}
  Renders a responsive grid of COA (Certificate of Analysis) card blocks.
  Each card displays a product/batch title with a "View Batches" link and icon.
  Fully customizable with dynamic content and soft peach background styling.

  @example
  {% section 'coa-cards' %}
{% enddoc %}

<section
  class="coa-cards full-width"
  style="background-color: {{ section.settings.background_color }};"
  {{ section.shopify_attributes }}
>
  <div
    class="mx-auto w-full max-w-[1920px] px-5 sm:px-8 md:px-12 lg:px-[80px] xl:px-[120px] py-[50px] md:py-[100px]"
  >
    {% if section.blocks.size > 0 %}
      <div class="grid w-full grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 lg:gap-[20px]">
        {% for block in section.blocks %}
          <button
            class="coa-cards__card flex flex-col items-center justify-center gap-5 rounded-[16px] px-[37px] py-[30px] transition-all duration-200 cursor-pointer"
            style="background-color: {{ block.settings.card_background_color }}"
            {{ block.shopify_attributes }}
            onclick="{% if block.settings.link %}window.location.href='{{ block.settings.link }}'{% endif %}"
          >
            <div class="flex flex-col items-center gap-5">
              <!-- Title -->
              <h3 class="text-center text-[32px] font-semibold leading-[1.2] text-[#212323]">
                {{ block.settings.title }}
              </h3>

              <!-- Link with Icon -->
              <div class="flex flex-col items-center gap-[15px]">
                <p class="text-center text-xl font-normal leading-[1.2] text-[#212323] underline decoration-from-font">
                  {{ block.settings.link_text }}
                </p>
                <!-- Dropdown Icon -->
                <div class="flex h-[22px] w-[22px] items-center justify-center">
                  <img src="{{ 'icon-arrow-down-1.svg' | asset_url }}" alt="" class="h-full w-full" />
                </div>
              </div>
            </div>
          </button>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "t:general.coa_cards",
  "blocks": [
    {
      "type": "coa-card",
      "name": "t:general.coa_card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:labels.title",
          "default": "Blood Orange COA"
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "t:labels.link_text",
          "default": "View Batches"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:labels.link"
        },
        {
          "type": "color",
          "id": "card_background_color",
          "label": "t:labels.card_background",
          "default": "#F9D5C0"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:general.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.background",
      "default": "#FFFFFF"
    },
  ],
  "presets": [
    {
      "name": "t:general.coa_cards",
      "blocks": [
        {
          "type": "coa-card",
          "settings": {
            "title": "Blood Orange COA",
            "link_text": "View Batches",
            "card_background_color": "#F9D5C0"
          }
        },
        {
          "type": "coa-card",
          "settings": {
            "title": "Ginger Lime COA",
            "link_text": "View Batches",
            "card_background_color": "#F9D5C0"
          }
        },
        {
          "type": "coa-card",
          "settings": {
            "title": "Berry Acai COA",
            "link_text": "View Batches",
            "card_background_color": "#F9D5C0"
          }
        }
      ]
    }
  ]
}
{% endschema %}
