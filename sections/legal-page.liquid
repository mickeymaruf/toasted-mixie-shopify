{% comment %}
  Renders long-form legal content (Privacy policy, Terms of service, etc.):
  the page title as a large heading, followed by the page's rich text body
  styled for legal documents (section headings, paragraphs, lists, links,
  and tables).

  Assign a page template that uses this section (e.g.
  templates/page.privacy-policy.json) to any Page created in
  Online Store > Pages.
{% endcomment %}

<section class="legal-page full-width">
  <div class="legal-page__container mx-auto w-full max-w-[1920px] px-5 pt-[50px] pb-[60px] sm:px-8 sm:pt-[60px] sm:pb-[80px] md:px-12 lg:px-[80px] lg:pt-[70px] lg:pb-[100px] xl:px-[120px]">
    {% if page.title != blank %}
      <h1 class="legal-page__title mb-8 text-[36px] leading-[0.95] font-bold sm:text-[44px] md:text-[56px] lg:text-[64px] xl:text-[72px] xl:tracking-[-2.16px]">
        {{ page.title }}
      </h1>
    {% endif %}

    <div class="legal-page__content">
      {{ page.content }}
    </div>
  </div>
</section>

{% stylesheet %}
  .legal-page__title {
    font-family: var(--font-heading--family);
    color: #212323;
  }

  .legal-page__content {
    display: flex;
    flex-direction: column;
    gap: 24px;
    font-family: var(--font-primary--family);
    color: #212323;
  }

  .legal-page__content h2,
  .legal-page__content h3 {
    font-family: var(--font-primary--family);
    font-weight: 500;
    font-size: 24px;
    line-height: 1.2;
  }

  .legal-page__content p,
  .legal-page__content li {
    font-size: 16px;
    line-height: 1.5;
  }

  .legal-page__content ul,
  .legal-page__content ol {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-left: 24px;
    list-style: disc;
  }

  .legal-page__content ol {
    list-style: decimal;
  }

  .legal-page__content a {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .legal-page__content table {
    width: 100%;
    border-collapse: collapse;
  }

  .legal-page__content th,
  .legal-page__content td {
    border-top: 1px solid #212323;
    padding: 16px;
    font-size: 14px;
    line-height: 1.3;
    text-align: left;
    vertical-align: top;
  }

  .legal-page__content th {
    font-weight: 500;
  }

  .legal-page__content tr:last-child > th,
  .legal-page__content tr:last-child > td {
    border-bottom: 1px solid #212323;
  }

  .legal-page__content th:first-child,
  .legal-page__content td:first-child {
    border-right: 1px solid #212323;
  }

  @media (min-width: 1024px) {
    .legal-page__content {
      gap: 30px;
    }

    .legal-page__content h2,
    .legal-page__content h3 {
      font-size: 32px;
    }

    .legal-page__content p,
    .legal-page__content li {
      font-size: 20px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.legal_page",
  "settings": [],
  "presets": [
    {
      "name": "t:general.legal_page"
    }
  ]
}
{% endschema %}
