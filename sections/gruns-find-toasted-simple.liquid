{% doc %}
  Renders "Find Toasted (simple)" — a heading, description, and CTA button
  next to a billboard image, set inside a rounded panel with a plain
  background color (no gradient) that can take a background image, and the
  billboard image bleeds out of the panel on larger screens.
{% enddoc %}

<section
  class="gruns-find-toasted-simple full-width"
  style="background-color: {{ section.settings.background_color }};"
>
  <div class="mx-auto flex w-full max-w-[1200px] flex-col px-5 p-14 pb-[120px] sm:pb-[156px] sm:px-8 md:px-12 md:pb-14 lg:px-[80px] lg:pb-[150px] xl:px-0">
    <div
      class="relative flex flex-col-reverse items-center gap-5 md:gap-8 overflow-visible md:overflow-hidden rounded-[40px] px-6 py-10 text-center sm:px-10 sm:py-14 lg:flex-row lg:items-center lg:overflow-visible lg:px-[80px] lg:py-[88px] lg:text-left"
      style="background-color: {{ section.settings.panel_background_color }}; position: relative;"
    >
      {% if section.settings.panel_background_image %}
        <div
          class="pointer-events-none absolute inset-0 overflow-hidden rounded-[40px]"
          aria-hidden="true"
        >
          <div class="absolute left-[-11.25%] top-[-23.73%] w-[85.25%] h-[169.9%] rotate-[7.22deg]">
            {{ section.settings.panel_background_image | image_url: width: 1200 | image_tag: class: 'block w-full h-full object-cover' }}
          </div>
        </div>
      {% else %}
        <div
          class="pointer-events-none absolute inset-0 overflow-hidden rounded-[40px]"
          aria-hidden="true"
        >
          <img
            src="{{ 'find-toasted-pattern.svg' | asset_url }}"
            alt=""
            class="absolute top-[-48.66%] right-0 h-[149%] w-[66%] max-w-none"
            loading="lazy"
            width="797"
            height="498"
          >
        </div>
      {% endif %}

      <div class="group relative z-30 pointer-events-none flex w-full h-auto justify-end md:w-full md:h-auto -mb-[115px] md:mb-0 lg:absolute lg:top-1/2 lg:right-12 lg:w-[480px] lg:h-auto" style="max-width: none; overflow: visible;" id="billboard-container">
        <div class="relative pointer-events-auto">
          {% if section.settings.billboard_image %}
            {{
              section.settings.billboard_image
              | image_url: width: 1440
              | image_tag:
                class: 'size-full object-contain transition-transform duration-500 ease group-hover:scale-[1.02]',
                widths: '400, 700, 1000, 1440',
                sizes: '(min-width: 64rem) 530px, 100vw',
                alt: section.settings.billboard_image_alt
              | default: section.settings.billboard_image.alt
            }}
          {% else %}
            <img
              src="{{ 'find-toasted-billboard.png' | asset_url }}"
              alt="{{ section.settings.billboard_image_alt }}"
              class="size-full object-contain transition-transform duration-500 ease group-hover:scale-[1.02]"
              loading="lazy"
              width="719"
              height="430"
            >
          {% endif %}

          {% if section.settings.billboard_sticker %}
            {{
              section.settings.billboard_sticker
              | image_url: width: 400
              | image_tag:
                class: 'find-toasted-billboard__sticker pointer-events-none absolute h-auto transition-transform duration-500 ease group-hover:scale-[1.02]',
                loading: 'lazy',
                widths: '200, 300, 400',
                alt: ''
            }}
          {% endif %}

          {% if section.settings.billboard_badge %}
            {{
              section.settings.billboard_badge
              | image_url: width: 300
              | image_tag:
                class: 'find-toasted-billboard__badge pointer-events-none absolute h-auto transition-transform duration-500 ease group-hover:scale-[1.02]',
                loading: 'lazy',
                widths: '150, 220, 300',
                alt: ''
            }}
          {% endif %}
        </div>
      </div>

      <div class="relative z-10 flex w-full flex-col items-center gap-5 lg:w-[40%] lg:max-w-[477px] lg:shrink-0 lg:items-start lg:gap-[50px]">
        <div class="flex flex-col items-center gap-2 lg:items-start lg:gap-5">
          {% if section.settings.heading != blank %}
            <h2
              class="w-full text-[36px] leading-[0.95] font-bold [text-shadow:4px_4px_6px_rgba(0,0,0,0.1)] sm:text-[44px] md:text-[56px] lg:text-[64px] xl:text-[72px]"
              style="color: {{ section.settings.heading_color }};"
            >
              {{ section.settings.heading }}
            </h2>
          {% endif %}

          {% if section.settings.description != blank %}
            <p
              class="w-full text-[16px] leading-[1.5] sm:text-[18px] xl:text-[24px]"
              style="color: {{ section.settings.heading_color }};"
            >
              {{ section.settings.description }}
            </p>
          {% endif %}
        </div>

        {% if section.settings.show_button and section.settings.button_label != blank %}
          <div class="flex justify-center lg:justify-start">
            {% render 'button',
              label: section.settings.button_label,
              url: section.settings.button_link,
              background_color: section.settings.button_background_color,
              text_color: section.settings.button_text_color,
              class: 'whitespace-nowrap'
            %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  @media (min-width: 1024px) {
    #billboard-container {
      transform: translateY(-50%);
    }
  }

  /* Sticker/badge positions are ported 1:1 from the Figma "Frame 2147236090"
     node (fileKey mPnZFgOy032whTzJGzGdND), relative to the billboard image's
     own box. No fixed widths/heights are set — each image keeps its natural
     aspect ratio at the given width. */

  .find-toasted-billboard__sticker {
    left: -4.6%;
    top: 25.16%;
    width: 29.72%;
  }

  .find-toasted-billboard__badge {
    left: 79.83%;
    top: 64.5%;
    width: 23.97%;
  }

  @media (prefers-reduced-motion: reduce) {
    #billboard-container img {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.gruns_find_toasted_simple",
  "settings": [
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Find Toasted"
    },
    {
      "type": "text",
      "id": "description",
      "label": "t:labels.description",
      "default": "Coming to select venues and retailers."
    },
    {
      "type": "header",
      "content": "t:general.button"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "t:labels.show_button",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label",
      "default": "Find near you",
      "visible_if": "{{ section.settings.show_button }}"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:labels.button_link",
      "visible_if": "{{ section.settings.show_button }}"
    },
    {
      "type": "color",
      "id": "button_background_color",
      "label": "t:labels.button_background",
      "default": "#212323",
      "visible_if": "{{ section.settings.show_button }}"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "t:labels.button_text_color",
      "default": "#F6F1EC",
      "visible_if": "{{ section.settings.show_button }}"
    },
    {
      "type": "header",
      "content": "t:general.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.background",
      "default": "#F6F1EC"
    },
    {
      "type": "color",
      "id": "panel_background_color",
      "label": "t:labels.card_background",
      "default": "#551F36"
    },
    {
      "type": "image_picker",
      "id": "panel_background_image",
      "label": "t:labels.panel_background_image"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "t:labels.text_color",
      "default": "#F6F1EC"
    },
    {
      "type": "header",
      "content": "t:general.image"
    },
    {
      "type": "image_picker",
      "id": "billboard_image",
      "label": "t:labels.image"
    },
    {
      "type": "text",
      "id": "billboard_image_alt",
      "label": "t:labels.alt_text"
    },
    {
      "type": "header",
      "content": "t:general.sticker"
    },
    {
      "type": "image_picker",
      "id": "billboard_sticker",
      "label": "t:labels.sticker_image"
    },
    {
      "type": "image_picker",
      "id": "billboard_badge",
      "label": "t:labels.badge_image"
    }
  ],
  "presets": [
    {
      "name": "t:general.gruns_find_toasted_simple"
    }
  ]
}
{% endschema %}
