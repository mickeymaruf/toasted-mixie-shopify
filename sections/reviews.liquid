{% doc %}
  Reviews section with image carousel, rating display, and testimonial card.
  Features a swiper-based image carousel with navigation controls and a single review card.
{% enddoc %}

<div class="reviews-section px-4 py-8 sm:px-6 sm:py-12 md:px-10 md:py-16 lg:px-[120px] lg:py-[100px]" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }}">
  <div class="flex flex-col gap-8 sm:gap-10 md:gap-12 w-full max-w-[1200px] mx-auto">
    <!-- Heading -->
    <div class="text-center">
      <h1 class="text-[36px] leading-[0.95] font-bold sm:text-[44px] md:text-[56px] lg:text-[64px] xl:text-[72px]" style="color: {{ section.settings.text_color }}">
        <span>{{ section.settings.heading_prefix }}</span>
      </h1>
    </div>

    <!-- Rating Display Section - Aligned Left (with carousel toggle) -->
    {%- if section.settings.show_carousel -%}
      <div class="flex justify-start -mb-4 sm:-mb-6 md:-mb-7">
        <div class="flex items-center gap-2 sm:gap-3 md:gap-4">
          <!-- Rating Number -->
          <div class="text-[14px] sm:text-[16px] md:text-[18px] font-medium" style="color: {{ section.settings.text_color }}">
            {{ section.settings.rating }}
          </div>

          <!-- Star Rating (Floor Value Only) -->
          <div class="flex items-center gap-0">
            {%- assign rating_int = section.settings.rating | floor -%}

            {%- for i in (1..5) -%}
              {%- if i <= rating_int -%}
                <!-- Filled Star -->
                <div class="relative w-[14px] h-[14px] sm:w-[16px] sm:h-[16px] md:w-[18px] md:h-[18px]">
                  <svg class="w-full h-full" viewBox="0 0 24 24" fill="currentColor" style="color: {{ section.settings.text_color }}">
                    <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2l-2.81 6.63L2 9.24l5.46 4.73L5.82 21 12 17.27z"/>
                  </svg>
                </div>
              {%- else -%}
                <!-- Empty Star -->
                <div class="relative w-[14px] h-[14px] sm:w-[16px] sm:h-[16px] md:w-[18px] md:h-[18px]">
                  <svg class="w-full h-full" viewBox="0 0 24 24" fill="currentColor" style="color: #d0d0d0">
                    <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2l-2.81 6.63L2 9.24l5.46 4.73L5.82 21 12 17.27z"/>
                  </svg>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>

          <!-- Rating Text -->
          <div class="text-[10px] sm:text-[11px] md:text-[12px]" style="color: {{ section.settings.text_color }}">
            {{ section.settings.rating_text }}
          </div>
        </div>
      </div>
    {%- endif -%}

    <!-- Image Carousel Section -->
    {%- assign review_images = section.blocks | where: 'type', 'review-image' -%}
    {%- if review_images.size > 0 and section.settings.show_carousel -%}
      <div class="flex flex-col gap-4 sm:gap-5 md:gap-6">
        <div class="flex items-center justify-center gap-3 sm:gap-4 md:gap-6">
          <!-- Previous Button -->
          <button
            type="button"
            class="flex items-center justify-center shrink-0"
            data-carousel-prev
            aria-label="Previous"
          >
            <svg class="w-5 h-5 sm:w-6 sm:h-6 md:w-7 md:h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: {{ section.settings.text_color }}">
              <path d="M15 18l-6-6 6-6"/>
            </svg>
          </button>

          <!-- Carousel Container -->
          <div class="flex-1 overflow-hidden">
            <div class="reviews-carousel swiper w-full">
              <div class="swiper-wrapper">
                {%- for block in review_images -%}
                  <div class="swiper-slide" {{ block.shopify_attributes }}>
                    <div class="aspect-square rounded-[15px] sm:rounded-[20px] md:rounded-[25px] overflow-hidden bg-gray-200">
                      {% if block.settings.image %}
                        {{ block.settings.image | image_url: width: 500 | image_tag: class: 'w-full h-full object-cover', alt: block.settings.image.alt }}
                      {% endif %}
                    </div>
                  </div>
                {%- endfor -%}
              </div>
            </div>
          </div>

          <!-- Next Button -->
          <button
            type="button"
            class="flex items-center justify-center shrink-0"
            data-carousel-next
            aria-label="Next"
          >
            <svg class="w-5 h-5 sm:w-6 sm:h-6 md:w-7 md:h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: {{ section.settings.text_color }}">
              <path d="M9 18l6-6-6-6"/>
            </svg>
          </button>
        </div>
      </div>
    {%- endif -%}

    <!-- Testimonials Section with Blocks -->
    {%- assign review_testimonials = section.blocks | where: 'type', 'review-testimonial' -%}
    {%- if review_testimonials.size > 0 -%}
      {%- for block in review_testimonials -%}
        <div class="border-t border-b py-6 sm:py-8 md:py-10 lg:py-12" style="border-color: {{ section.settings.text_color }};" {{ block.shopify_attributes }}>
          <div class="flex flex-col lg:flex-row gap-6 sm:gap-8 md:gap-10 items-start lg:items-center">
            <!-- User Profile Card -->
            <div class="bg-[#c2cbd4] rounded-lg sm:rounded-xl md:rounded-2xl p-4 sm:p-5 md:p-6 shrink-0 w-full lg:w-auto">
              <div class="flex gap-3 sm:gap-4 md:gap-5 items-center">
                <!-- Avatar -->
                <div class="w-8 h-8 sm:w-9 sm:h-9 md:w-10 md:h-10 rounded-full bg-[#9ca8b5] flex items-center justify-center shrink-0">
                  {% if block.settings.avatar_image %}
                    {{ block.settings.avatar_image | image_url: width: 40, height: 40 | image_tag: class: 'w-full h-full rounded-full object-cover' }}
                  {% else %}
                    {%- liquid
                      assign name_parts = block.settings.reviewer_name | strip | split: ' '
                      assign avatar_initials = name_parts | first | slice: 0
                      if name_parts.size > 1
                        assign avatar_initials = avatar_initials | append: name_parts.last | slice: 0, 2
                      endif
                    -%}
                    <span class="text-[10px] sm:text-[11px] md:text-[12px] font-medium uppercase text-white" aria-hidden="true">
                      {{ avatar_initials }}
                    </span>
                  {% endif %}
                </div>

                <!-- Profile Info -->
                <div class="flex flex-col gap-0.5 sm:gap-1">
                  <p class="text-[10px] sm:text-[11px] md:text-[12px]" style="color: {{ section.settings.text_color }}">
                    {{ block.settings.reviewer_name }}
                  </p>
                  <div class="flex items-center gap-1">
                    <span class="text-[12px] sm:text-[13px] md:text-[14px] font-medium" style="color: {{ section.settings.text_color }}">
                      {{ block.settings.reviewer_title }}
                    </span>
                    <svg class="w-2.5 h-2.5 sm:w-3 sm:h-3" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"/>
                    </svg>
                  </div>
                </div>
              </div>
            </div>

            <!-- Review Content -->
            <div class="flex flex-col gap-2 sm:gap-2.5 md:gap-3 flex-1">
              <!-- Star Rating -->
              <div class="flex gap-0.5">
                {%- for i in (1..5) -%}
                  <svg class="w-4 h-4 sm:w-4 sm:h-4 md:w-5 md:h-5 {% if i <= block.settings.rating %}text-[#D4941F]{% else %}text-[#e0e0e0]{% endif %}" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2l-2.81 6.63L2 9.24l5.46 4.73L5.82 21 12 17.27z"/>
                  </svg>
                {%- endfor -%}
              </div>

              <!-- Testimonial Text -->
              <div class="flex flex-col gap-1 sm:gap-1.5 md:gap-2">
                <p class="text-[12px] sm:text-[13px] md:text-[14px] font-medium" style="color: {{ section.settings.text_color }}">
                  {{ block.settings.testimonial_title }}
                </p>
                <p class="text-[13px] sm:text-[14px] md:text-[16px] leading-[1.5]" style="color: {{ section.settings.text_color }}">
                  {{ block.settings.testimonial_text }}
                </p>
              </div>
            </div>
          </div>
        </div>
      {%- endfor -%}
    {%- endif -%}

    <!-- CTA Button -->
    {%- if section.settings.button_label != blank -%}
      {%- assign button_href = section.settings.button_link | default: '#product-buy-box' -%}
      <div class="flex justify-center pt-4 sm:pt-6 md:pt-8">
        <a href="{{ button_href }}" class="inline-flex items-center justify-center px-8 sm:px-12 md:px-16 py-3 sm:py-3.5 md:py-4 rounded-full font-medium text-[14px] sm:text-[15px] md:text-[16px] transition-opacity hover:opacity-85" style="background-color: {{ section.settings.button_bg_color }}; color: {{ section.settings.button_text_color }}; box-shadow: 0px 0px 7.5px rgba(0,0,0,0.1);">
          {{ section.settings.button_label }}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const initCarousel = () => {
      const swiperEl = document.querySelector('.reviews-carousel');
      const prevBtn = document.querySelector('[data-carousel-prev]');
      const nextBtn = document.querySelector('[data-carousel-next]');

      if (!swiperEl || typeof Swiper === 'undefined') return;

      const swiper = new Swiper(swiperEl, {
        slidesPerView: 2,
        spaceBetween: 16,
        loop: true,
        grabCursor: true,
        breakpoints: {
          1024: {
            slidesPerView: 3,
            spaceBetween: 16
          },
          1280: {
            slidesPerView: 4,
            spaceBetween: 16
          },
          1536: {
            slidesPerView: 5,
            spaceBetween: 16
          }
        },
        navigation: {
          prevEl: prevBtn,
          nextEl: nextBtn
        }
      });
    };

    initCarousel();
    document.addEventListener('shopify:section:load', initCarousel);
  });
</script>

{% schema %}
{
  "name": "Reviews",
  "blocks": [
    {
      "type": "review-image",
      "name": "Review Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    },
    {
      "type": "review-testimonial",
      "name": "Review Testimonial",
      "settings": [
        {
          "type": "image_picker",
          "id": "avatar_image",
          "label": "Avatar image"
        },
        {
          "type": "text",
          "id": "reviewer_name",
          "label": "Reviewer name",
          "default": "Toasted"
        },
        {
          "type": "text",
          "id": "reviewer_title",
          "label": "Reviewer title",
          "default": "Verified Buyer"
        },
        {
          "type": "range",
          "id": "rating",
          "min": 0,
          "max": 5,
          "step": 1,
          "label": "Star rating",
          "default": 5
        },
        {
          "type": "text",
          "id": "testimonial_title",
          "label": "Testimonial title",
          "default": "First Toasted reviews coming soon."
        },
        {
          "type": "text",
          "id": "testimonial_text",
          "label": "Testimonial text",
          "default": "Reviews open after first drop. Be one of the first to try Toasted."
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#212323"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading_prefix",
      "label": "Heading prefix",
      "default": "First comments"
    },
    {
      "type": "header",
      "content": "Rating Display"
    },
    {
      "type": "range",
      "id": "rating",
      "min": 0,
      "max": 5,
      "step": 0.1,
      "label": "Rating",
      "default": 4.9
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating text",
      "default": "Be among the first to review."
    },
    {
      "type": "checkbox",
      "id": "show_carousel",
      "label": "Show carousel gallery",
      "default": true
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Join the First Drop"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button background color",
      "default": "#212323"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#f6f1ec"
    }
  ],
  "presets": [
    {
      "name": "Reviews",
      "blocks": [
        {
          "type": "review-image"
        },
        {
          "type": "review-image"
        },
        {
          "type": "review-image"
        },
        {
          "type": "review-image"
        },
        {
          "type": "review-image"
        },
        {
          "type": "review-testimonial"
        }
      ]
    }
  ]
}
{% endschema %}
