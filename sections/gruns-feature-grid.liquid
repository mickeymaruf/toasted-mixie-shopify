{% doc %}
  Renders "Made for moments that matter." — an editable heading followed by a
  responsive row of feature-card blocks. Add feature-card blocks to populate
  the grid.
{% enddoc %}

<section
  class="gruns-feature-grid full-width"
  style="background-color: {{ section.settings.background_color }};"
>
  <div
    class="mx-auto flex w-full max-w-[1920px] flex-col items-center gap-8 px-5 pt-[40px] pb-[40px] sm:px-8 sm:pt-[60px] md:px-12 lg:gap-[50px] lg:px-[80px] lg:pt-[100px] xl:px-[120px]"
  >
    {% if section.settings.heading != blank %}
      <h2
        class="w-full text-center text-[36px] leading-[0.95] font-bold text-[color:var(--gruns-feature-grid-heading-color)] sm:text-[44px] md:text-[56px] lg:text-[64px] xl:text-[72px] "
        style="--gruns-feature-grid-heading-color: {{ section.settings.heading_color }};"
      >
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="grid w-full grid-cols-1 gap-4 sm:grid-cols-2 sm:gap-[10px] lg:grid-cols-3">
        {% content_for 'blocks' %}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "t:general.feature_grid",
  "blocks": [{ "type": "feature-card" }],
  "settings": [
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Made for moments that matter."
    },
    {
      "type": "header",
      "content": "t:general.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.background",
      "default": "#F6F1EC"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "t:labels.text_color",
      "default": "#212323"
    },
  ],
  "presets": [
    {
      "name": "t:general.feature_grid",
      "blocks": [
        {
          "type": "feature-card",
          "settings": {
            "title": "Supports Clarity",
            "subtitle": "smooth, present focus"
          }
        },
        {
          "type": "feature-card",
          "settings": {
            "title": "Balances Mood",
            "subtitle": "light, feel-good lift"
          }
        },
        {
          "type": "feature-card",
          "settings": {
            "title": "Promotes Calm",
            "subtitle": "easy, steady unwind"
          }
        }
      ]
    }
  ]
}
{% endschema %}
