{% doc %}
  Renders a centered heading followed by a fully responsive grid of collapsible
  faq-item pills. Configurable columns for mobile (1-2), tablet (2-3), and
  desktop (2-3). Add faq-item blocks to populate the grid.
{% enddoc %}

{% liquid
  case section.settings.columns_mobile
    when '2'
      assign columns_mobile_class = 'grid-cols-2'
    else
      assign columns_mobile_class = 'grid-cols-1'
  endcase

  case section.settings.columns_tablet
    when '2'
      assign columns_tablet_class = 'md:grid-cols-2'
    when '3'
      assign columns_tablet_class = 'md:grid-cols-3'
    else
      assign columns_tablet_class = 'md:grid-cols-2'
  endcase

  case section.settings.columns_desktop
    when '2'
      assign columns_desktop_class = 'lg:grid-cols-2'
    else
      assign columns_desktop_class = 'lg:grid-cols-3'
  endcase
%}

<section
  class="faq-pills-grid full-width px-4 sm:px-6 md:px-10 lg:px-[60px] xl:px-0"
  style="
    background-color: {{ section.settings.section_background }};
    --faq-pills-grid-border-color: {{ section.settings.border_color }};
    --faq-pills-grid-bg-color: {{ section.settings.card_background }};
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div
    class="faq-pills-grid__inner mx-auto flex w-full max-w-[1200px] flex-col items-center gap-4 sm:gap-6 md:gap-8 lg:gap-[60px]"
    style="
      padding: 24px;
      background-color: var(--faq-pills-grid-bg-color);
      border: 3px solid var(--faq-pills-grid-border-color);
      border-radius: 33px;
    "
  >
    {% if section.settings.heading != blank %}
      <h2
        class="w-full text-center text-[28px] leading-[1.15] font-bold text-[color:var(--faq-pills-grid-heading-color)] sm:text-[36px] md:text-[48px] lg:text-[56px] xl:text-[72px] xl:tracking-[-2.16px]"
        style="--faq-pills-grid-heading-color: {{ section.settings.heading_color }};"
      >
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="grid w-full gap-3 sm:gap-4 md:gap-5 lg:gap-6 {{ columns_mobile_class }} {{ columns_tablet_class }} {{ columns_desktop_class }}">
        {% content_for 'blocks' %}
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  @media (min-width: 768px) {
    .faq-pills-grid__inner {
      padding: 40px !important;
    }
  }

  @media (min-width: 1024px) {
    .faq-pills-grid {
      padding-top: {{ section.settings.padding_top }}px !important;
      padding-bottom: {{ section.settings.padding_bottom }}px !important;
    }

    .faq-pills-grid__inner {
      padding: {{ section.settings.padding_top }}px !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.faq_pills_grid",
  "blocks": [{ "type": "faq-item" }],
  "settings": [
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Frequently asked questions"
    },
    {
      "type": "header",
      "content": "t:general.colors"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "t:labels.section_background",
      "default": "#f6f1ec"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "t:labels.card_background",
      "default": "#9ab2d5"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "t:labels.text_color",
      "default": "#212323"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:labels.border_color",
      "default": "#212323"
    },
    {
      "type": "color",
      "id": "faq_item_background",
      "label": "t:labels.faq_item_background",
      "default": "#636D90"
    },
    {
      "type": "color",
      "id": "faq_item_text_color",
      "label": "t:labels.faq_item_text_color",
      "default": "#F6F1EC"
    },
    {
      "type": "header",
      "content": "t:general.layout"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:labels.columns_mobile",
      "default": "1",
      "options": [
        { "value": "1", "label": "t:options.columns.one" },
        { "value": "2", "label": "t:options.columns.two" }
      ]
    },
    {
      "type": "select",
      "id": "columns_tablet",
      "label": "t:labels.columns_tablet",
      "default": "2",
      "options": [
        { "value": "2", "label": "t:options.columns.two" },
        { "value": "3", "label": "t:options.columns.three" }
      ]
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "t:labels.columns_desktop",
      "default": "3",
      "options": [
        { "value": "2", "label": "t:options.columns.two" },
        { "value": "3", "label": "t:options.columns.three" }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:labels.padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:labels.padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "t:general.faq_pills_grid",
      "blocks": [
        { "type": "faq-item", "settings": { "question": "What is Toasted?" } },
        { "type": "faq-item", "settings": { "question": "Ingredients & Allergies" } },
        { "type": "faq-item", "settings": { "question": "What to Expect" } },
        { "type": "faq-item", "settings": { "question": "How is it dosed?" } },
        { "type": "faq-item", "settings": { "question": "Is it legal to ship?" } },
        { "type": "faq-item", "settings": { "question": "Lab Results" } }
      ]
    }
  ]
}
{% endschema %}
