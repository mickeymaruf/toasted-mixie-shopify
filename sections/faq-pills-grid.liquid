{% doc %}
  Renders a two-column "Good Questions" FAQ section: a heading and "Shop Now"
  CTA on the left, paired with a stacked list of collapsible faq-item pills
  on the right. Columns stack on smaller screens. Add faq-item blocks to
  populate the list.
{% enddoc %}

<section
  class="faq-pills-grid full-width"
  style="
    background-color: {{ section.settings.section_background }};
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  "
  {{ section.shopify_attributes }}
>
  <div class="faq-pills-grid__inner mx-auto flex w-full max-w-[1200px] flex-col items-start gap-8 px-4 sm:px-6 md:px-10 lg:flex-row lg:items-start lg:justify-between lg:gap-[60px] lg:px-[60px] xl:gap-[140px] xl:px-0">
    <div class="flex w-full flex-col items-start gap-5 lg:w-auto lg:shrink-0">
      {% if section.settings.heading != blank %}
        <h2
          class="w-full text-[40px] leading-[0.95] font-bold tracking-[-1.2px] text-[color:var(--faq-pills-grid-heading-color)] sm:text-[48px] md:text-[56px] lg:text-[64px] xl:text-[72px] xl:tracking-[-2.16px]"
          style="--faq-pills-grid-heading-color: {{ section.settings.heading_color }};"
        >
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.show_button and section.settings.button_label != blank %}
        {% render 'button', label: section.settings.button_label, url: section.settings.button_link, default: '#product-buy-box', background_color: section.settings.button_background_color, text_color: section.settings.button_text_color, class: 'w-auto whitespace-nowrap' %}
      {% endif %}
    </div>

    {% if section.blocks.size > 0 %}
      <div class="flex w-full flex-col gap-3 sm:gap-[15px] lg:flex-1">
        {% content_for 'blocks' %}
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  @media (min-width: 1024px) {
    .faq-pills-grid {
      padding-top: {{ section.settings.padding_top }}px !important;
      padding-bottom: {{ section.settings.padding_bottom }}px !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.faq_pills_grid",
  "blocks": [{ "type": "faq-item" }],
  "settings": [
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Good Questions"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "t:labels.show_button",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label",
      "default": "Shop Now",
      "visible_if": "{{ section.settings.show_button }}"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:labels.button_link",
      "visible_if": "{{ section.settings.show_button }}"
    },
    {
      "type": "header",
      "content": "t:general.colors"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "t:labels.section_background",
      "default": "#9ab2d5"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "t:labels.text_color",
      "default": "#212323"
    },
    {
      "type": "color",
      "id": "button_background_color",
      "label": "t:labels.button_background",
      "default": "#212323",
      "visible_if": "{{ section.settings.show_button }}"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "t:labels.button_text_color",
      "default": "#f6f1ec",
      "visible_if": "{{ section.settings.show_button }}"
    },
    {
      "type": "color",
      "id": "faq_item_background",
      "label": "t:labels.faq_item_background",
      "default": "#636D90"
    },
    {
      "type": "color",
      "id": "faq_item_text_color",
      "label": "t:labels.faq_item_text_color",
      "default": "#F6F1EC"
    },
    {
      "type": "header",
      "content": "t:general.layout"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:labels.padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:labels.padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "t:general.faq_pills_grid",
      "blocks": [
        { "type": "faq-item", "settings": { "question": "Is Toasted for me?" } },
        { "type": "faq-item", "settings": { "question": "When is the best time for Toasted?" } },
        { "type": "faq-item", "settings": { "question": "What does it feel like?" } },
        { "type": "faq-item", "settings": { "question": "Will it make me anxious or paranoid?" } },
        { "type": "faq-item", "settings": { "question": "Is it like an edible?" } },
        { "type": "faq-item", "settings": { "question": "Are these drinks legal?" } }
      ]
    }
  ]
}
{% endschema %}
