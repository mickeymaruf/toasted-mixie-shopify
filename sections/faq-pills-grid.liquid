{% doc %}
  Renders a centered heading followed by a responsive grid of collapsible
  faq-item pills (3 columns desktop by default, 2 columns tablet, 1 column
  mobile). Add faq-item blocks to populate the grid.
{% enddoc %}

{% liquid
  case section.settings.columns_desktop
    when '2'
      assign columns_class = 'lg:grid-cols-2'
    else
      assign columns_class = 'lg:grid-cols-3'
  endcase
%}

<section
  class="faq-pills-grid full-width px-[50px] md:px-[80px] lg:px-[120px]"
  style="
    background-color: {{ section.settings.section_background }};
    --faq-pills-grid-border-color: {{ section.settings.border_color }};
    --faq-pills-grid-bg-color: {{ section.settings.card_background }};
  "
>
  <div
    class="faq-pills-grid__inner mx-auto flex w-full max-w-[1440px] flex-col items-center gap-8 lg:gap-[60px]"
    style="
      padding: 50px;
      background-color: var(--faq-pills-grid-bg-color);
      border: 3px solid var(--faq-pills-grid-border-color);
      border-radius: 33px;
    "
  >
    {% if section.settings.heading != blank %}
      <h2
        class="w-full text-center text-[36px] leading-[0.95] font-bold text-[color:var(--faq-pills-grid-heading-color)] sm:text-[44px] md:text-[56px] lg:text-[64px] xl:text-[72px] xl:tracking-[-2.16px]"
        style="--faq-pills-grid-heading-color: {{ section.settings.heading_color }};"
      >
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2 {{ columns_class }}">
        {% content_for 'blocks' %}
      </div>
    {% endif %}
  </div>
</section>


{% schema %}
{
  "name": "t:general.faq_pills_grid",
  "blocks": [{ "type": "faq-item" }],
  "settings": [
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Frequently asked questions"
    },
    {
      "type": "header",
      "content": "t:general.colors"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "t:labels.section_background",
      "default": "#f6f1ec"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "t:labels.card_background",
      "default": "#9ab2d5"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "t:labels.text_color",
      "default": "#212323"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:labels.border_color",
      "default": "#212323"
    },
    {
      "type": "color",
      "id": "faq_item_background",
      "label": "t:labels.faq_item_background",
      "default": "#636D90"
    },
    {
      "type": "color",
      "id": "faq_item_text_color",
      "label": "t:labels.faq_item_text_color",
      "default": "#F6F1EC"
    },
    {
      "type": "header",
      "content": "t:general.layout"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "t:labels.columns_desktop",
      "default": "3",
      "options": [
        { "value": "2", "label": "t:options.columns.two" },
        { "value": "3", "label": "t:options.columns.three" }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:labels.padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:labels.padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "t:general.faq_pills_grid",
      "blocks": [
        { "type": "faq-item", "settings": { "question": "What is Toasted?" } },
        { "type": "faq-item", "settings": { "question": "Ingredients & Allergies" } },
        { "type": "faq-item", "settings": { "question": "What to Expect" } },
        { "type": "faq-item", "settings": { "question": "How is it dosed?" } },
        { "type": "faq-item", "settings": { "question": "Is it legal to ship?" } },
        { "type": "faq-item", "settings": { "question": "Lab Results" } }
      ]
    }
  ]
}
{% endschema %}
