{% comment %}
  This section is used in the 404 template to render page shown when customers
  enter an invalid store URL.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/404
{% endcomment %}

{% liquid
  assign button_url = section.settings.button_link | default: routes.root_url
%}

<section
  class="not-found full-width"
  style="background-color: {{ section.settings.background_color }};"
  {{ section.shopify_attributes }}
>
  <div class="mx-auto w-full max-w-[1920px] px-5 py-[80px] sm:px-8 md:px-12 md:py-[120px] lg:px-[80px] lg:py-[160px] xl:px-[120px]">
    <div class="mx-auto flex w-full max-w-[479px] flex-col items-center gap-8 text-center sm:gap-10 lg:gap-[50px]">
      <div class="flex flex-col items-center gap-5 sm:gap-6 lg:gap-[30px]">
        <span
          class="not-found__icon block h-auto w-[220px] sm:w-[260px] md:w-[300px] lg:w-[325px]"
          aria-hidden="true"
        >
          {% if section.settings.icon_image %}
            {{ section.settings.icon_image | image_url: width: 650 | image_tag }}
          {% else %}
            {{ 'icon-404-not-found.svg' | inline_asset_content }}
          {% endif %}
        </span>

        {% if section.settings.heading != blank %}
          <h1
            class="font-[family-name:var(--font-heading--family)] text-[36px] leading-[0.95] font-bold tracking-[-1.08px] sm:text-[44px] sm:tracking-[-1.32px] md:text-[54px] lg:text-[62px] lg:tracking-[-1.86px]"
            style="color: {{ section.settings.heading_color }};"
          >
            {{ section.settings.heading }}
          </h1>
        {% endif %}
      </div>

      {% if section.settings.description != blank %}
        <div
          class="text-[18px] leading-[1.5] sm:text-[20px] md:text-[24px] lg:text-[28px]"
          style="color: {{ section.settings.text_color }};"
        >
          {{ section.settings.description }}
        </div>
      {% endif %}

      {% if section.settings.show_button and section.settings.button_label != blank %}
        {% render 'button',
          label: section.settings.button_label,
          url: button_url,
          background_color: section.settings.button_background_color,
          text_color: section.settings.button_text_color,
          class: 'w-full drop-shadow-[0px_0px_7.5px_rgba(0,0,0,0.1)]'
        %}
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .not-found__icon svg,
  .not-found__icon img {
    display: block;
    width: 100%;
    height: auto;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.404",
  "settings": [
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "image_picker",
      "id": "icon_image",
      "label": "t:labels.icon"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "not found"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:labels.description",
      "default": "<p><strong>Looks like you took a wrong turn.</strong><br>No worries. The good stuff is still this way.</p>"
    },
    {
      "type": "header",
      "content": "t:general.button"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "t:labels.show_button",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label",
      "default": "Continue Shopping"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:labels.button_link"
    },
    {
      "type": "color",
      "id": "button_background_color",
      "label": "t:labels.button_background",
      "default": "#212323"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "t:labels.button_text_color",
      "default": "#F6F1EC"
    },
    {
      "type": "header",
      "content": "t:general.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.section_background",
      "default": "#9ab2d5"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "t:labels.heading_color",
      "default": "#212323"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:labels.text_color",
      "default": "#212323"
    }
  ]
}
{% endschema %}
