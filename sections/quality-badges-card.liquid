{% doc %}
  Renders a "3rd party-tested" trust banner as a card: a heading and description on
  the left, and a responsive row of icon-badge-card blocks (e.g. Lab
  Tested, Low Dose) on the right. Add, remove, and reorder the nested
  icon-badge-card blocks to control which badges are shown.
{% enddoc %}

<section
  class="quality-badges-card relative overflow-hidden"
  style="background-color: {{ section.settings.page_background_color }};"
>
  <div class="mx-auto w-full max-w-[1200px] px-5 sm:px-8 md:px-12 lg:px-[60px] xl:px-0 py-10 sm:py-12 md:py-12 lg:py-[80px] xl:py-[100px]">
    <div
      class="relative flex w-full flex-col items-center gap-10 rounded-[33px] px-6 py-12 sm:px-8 sm:py-14 md:px-12 md:py-16 lg:flex-row lg:items-center lg:gap-[20px] lg:px-[50px] lg:py-[50px]"
      style="background-color: {{ section.settings.background_color }};"
    >
      <div class="pointer-events-none absolute inset-0 overflow-hidden rounded-[33px]" aria-hidden="true">
        {% if section.settings.background_image %}
          {{
            section.settings.background_image
            | image_url: width: section.settings.background_image.width
            | image_tag: class: 'absolute size-full object-cover object-bottom', widths: '800, 1200, 1600', alt: ''
          }}
        {% endif %}
      </div>

      {% render 'quality-badges-content',
        heading: section.settings.heading,
        description: section.settings.description,
        heading_color: section.settings.heading_color,
      %}

      {% if section.blocks.size > 0 %}
        <div
          class="relative inline-grid w-fit grid-cols-[repeat(2,max-content)] items-start gap-3 [--icon-badge-card-height:130px] [--icon-badge-card-width:130px] sm:grid sm:w-full sm:grid-cols-[repeat(auto-fill,150px)] sm:gap-[10px] sm:[--icon-badge-card-height:150px] sm:[--icon-badge-card-width:150px] lg:min-w-0 lg:flex-[1_0_0] lg:grid-cols-4 lg:[--icon-badge-card-aspect-ratio:1/1] lg:[--icon-badge-card-height:auto] lg:[--icon-badge-card-width:100%]"
        >
          {% content_for 'blocks' %}
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .quality-badges-card .shopify-block {
    display: contents;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.quality_badges_card",
  "blocks": [{ "type": "icon-badge-card" }],
  "settings": [
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "<p>3rd party-tested for potency, purity, &amp; safety.</p>"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:labels.description",
      "default": "<p>We regularly test for all 20+ vitamins &amp; minerals to ensure claims are accurate &amp; clear of contaminants including:</p>"
    },
    {
      "type": "header",
      "content": "t:general.colors"
    },
    {
      "type": "color",
      "id": "page_background_color",
      "label": "t:labels.page_background",
      "default": "#F6F1EC"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:labels.background_image"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.card_background",
      "default": "#636D90"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "t:labels.text_color",
      "default": "#F6F1EC"
    }
  ],
  "presets": [
    {
      "name": "t:general.quality_badges_card",
      "blocks": [
        { "type": "icon-badge-card", "settings": { "label": "Lab Tested" } },
        { "type": "icon-badge-card", "settings": { "label": "Low Dose" } },
        { "type": "icon-badge-card", "settings": { "label": "Low Calorie" } },
        { "type": "icon-badge-card", "settings": { "label": "Non-carbonated" } }
      ]
    }
  ]
}
{% endschema %}
