{% doc %}
  Renders an FAQ section with grouped accordion items. Merchants can add custom
  FAQ items and organize them by category. Toggle functionality is provided
  via JavaScript.
{% enddoc %}

<section class="faq-accordion full-width" style="background-color: {{ section.settings.background_color }};" {{ section.shopify_attributes }}>
  <div class="mx-auto w-full max-w-[1200px] px-5 pt-[60px] pb-[50px] sm:px-8 sm:py-[100px] md:px-12 lg:px-0 lg:py-[120px] xl:px-0">
    <div class="flex flex-col gap-[16px] w-full">
      {% if section.blocks.size > 0 %}
        {% assign current_group = blank %}
        {% assign groups_shown = false %}

        {% for block in section.blocks %}
          {% if block.type == 'faq_item' %}
            {% if block.settings.category != current_group %}
              {% if groups_shown %}
                </div>
              </div>
              {% endif %}
              {% assign current_group = block.settings.category %}
              {% assign groups_shown = true %}
              <div class="faq-group">
                {% if current_group != blank %}
                  <h2 class="font-bold text-[32px] leading-[0.95] tracking-[-0.96px] text-[#212323] text-center w-full mb-[16px] sm:text-[40px] sm:tracking-[-1.2px] md:text-[44px] md:tracking-[-1.32px] lg:text-[48px] lg:tracking-[-1.44px]">
                    {{ current_group }}
                  </h2>
                {% endif %}
                <div class="flex flex-col gap-[16px]">
            {% endif %}

            <div class="faq-item" data-faq-item {{ block.shopify_attributes }}>
              <div class="faq-item-container bg-[#f6f1ec] border-2 border-[#212323] overflow-hidden">
                <button
                  class="faq-item-toggle w-full flex items-center justify-between px-[24px] py-[18px] text-left hover:bg-[rgba(33,35,35,0.05)] transition-colors"
                  aria-expanded="false"
                  aria-controls="faq-answer-{{ block.id }}"
                >
                  <span class="font-medium text-[18px] leading-[1.5] text-[#212323] flex-1 sm:text-[15px] md:text-[16px] lg:text-[24px]">
                    {{ block.settings.question }}
                  </span>
                  <div class="faq-chevron ml-4 flex-shrink-0 transition-transform duration-300 flex h-[14px] w-[14px] items-center justify-center sm:h-[16px] sm:w-[16px] md:h-[18px] md:w-[18px]">
                    <img src="{{ 'icon-arrow-down-1.svg' | asset_url }}" alt="" class="h-full w-full" />
                  </div>
                </button>

                <div
                  id="faq-answer-{{ block.id }}"
                  class="faq-item-answer"
                  role="region"
                  aria-labelledby="faq-question-{{ block.id }}"
                >
                  <div class="faq-item-answer-inner overflow-hidden">
                    <div class="px-[24px] py-[18px] text-[16px] leading-[1.6] text-[#212323] sm:text-[15px] md:text-[16px] lg:text-[20px]">
                      {{ block.settings.answer }}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          {% endif %}
        {% endfor %}

        {% if groups_shown %}
          </div>
        </div>
        {% endif %}
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .faq-item-container {
    border-radius: 36px;
  }

  .faq-item-toggle:focus-visible {
    outline: 2px solid #212323;
    outline-offset: 2px;
  }

  .faq-item-toggle[aria-expanded="true"] .faq-chevron {
    transform: rotate(180deg);
  }

  .faq-item-toggle[aria-expanded="true"] {
    background-color: rgba(33, 35, 35, 0.05);
  }

  .faq-item-answer {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 250ms ease;
  }

  .faq-item-answer.show {
    grid-template-rows: 1fr;
  }
{% endstylesheet %}

{% javascript %}
  document.querySelectorAll('.faq-item-toggle').forEach(button => {
    button.addEventListener('click', function() {
      const isExpanded = this.getAttribute('aria-expanded') === 'true';
      const answerId = this.getAttribute('aria-controls');
      const answerElement = document.getElementById(answerId);

      this.setAttribute('aria-expanded', !isExpanded);
      answerElement.classList.toggle('show', !isExpanded);
    });
  });
{% endjavascript %}

