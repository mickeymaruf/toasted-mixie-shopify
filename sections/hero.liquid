<hero-carousel
  class="hero full-width"
  style="--hero-height: {{ section.settings.height }}px;"
  data-autoplay-interval="{{ section.settings.autoplay_speed | times: 1000 }}"
  {{ section.shopify_attributes }}
>

  <div class="hero__slides" role="region" aria-label="{{ 'general.accessibility.hero_slideshow' | t }}" aria-roledescription="carousel">
    {% for block in section.blocks %}
      {% render block %}
    {% endfor %}
  </div>
</hero-carousel>

{% stylesheet %}
  .hero {
    position: relative;
    display: block;
    min-height: clamp(25rem, 100svh, var(--hero-height));
    overflow: hidden;
  }

  .hero__slides {
    position: absolute;
    inset: 0;
  }

  @media screen and (max-width: 47.9375rem) {
    .hero {
      height: calc(100svh - var(--announcement-bar-height-mobile, 48px) - var(--navbar-height-mobile, 64px));
    }
  }
{% endstylesheet %}

{% javascript %}
  class HeroCarousel extends HTMLElement {
    connectedCallback() {
      this.slides = Array.from(this.querySelectorAll('[data-hero-slide]'));
      this.activeIndex = 0;
      this.interval = parseInt(this.dataset.autoplayInterval, 10) || 5000;
      this.timer = null;
      this.prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (this.slides.length === 0) return;

      this.slides.forEach((slide, index) => {
        const isActive = index === 0;
        slide.classList.toggle('is-active', isActive);
        slide.inert = !isActive;
      });

      if (this.slides.length <= 1) return;

      this.handlePause = () => this.stop();
      this.handleFocusOut = (event) => {
        if (!this.contains(event.relatedTarget)) this.start();
      };
      this.handleBlockSelect = (event) => {
        const slide = event.target.closest('[data-hero-slide]');
        if (!slide || !this.contains(slide)) return;
        this.stop();
        this.goTo(this.slides.indexOf(slide));
      };
      this.handleBlockDeselect = () => this.start();

      this.addEventListener('focusin', this.handlePause);
      this.addEventListener('focusout', this.handleFocusOut);
      document.addEventListener('shopify:block:select', this.handleBlockSelect);
      document.addEventListener('shopify:block:deselect', this.handleBlockDeselect);

      this.start();
    }

    disconnectedCallback() {
      this.stop();
      document.removeEventListener('shopify:block:select', this.handleBlockSelect);
      document.removeEventListener('shopify:block:deselect', this.handleBlockDeselect);
    }

    start() {
      if (this.prefersReducedMotion || this.slides.length <= 1) return;
      this.stop();
      this.timer = window.setInterval(() => this.next(), this.interval);
    }

    stop() {
      if (this.timer) {
        window.clearInterval(this.timer);
        this.timer = null;
      }
    }

    next() {
      this.goTo((this.activeIndex + 1) % this.slides.length);
    }

    goTo(index) {
      const current = this.slides[this.activeIndex];
      const next = this.slides[index];
      if (!current || !next || current === next) return;

      current.classList.remove('is-active');
      current.inert = true;
      next.classList.add('is-active');
      next.inert = false;
      this.activeIndex = index;
    }
  }

  customElements.define('hero-carousel', HeroCarousel);
{% endjavascript %}

{% schema %}
{
  "name": "t:general.hero",
  "blocks": [{ "type": "hero-slide" }],
  "settings": [
    {
      "type": "range",
      "id": "height",
      "min": 400,
      "max": 900,
      "step": 10,
      "unit": "px",
      "label": "t:labels.height",
      "default": 780
    },
    {
      "type": "header",
      "content": "t:general.carousel"
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "t:labels.autoplay_speed",
      "default": 3
    }
  ],
  "presets": [
    {
      "name": "t:general.hero",
      "blocks": [
        {
          "type": "hero-slide",
          "settings": {
            "heading": "The Chill Drink",
            "subheading": "Present  in the moment.",
            "heading_color": "#F6F1EC",
            "background_image": "shopify://shop_images/hero_2.png",
            "overlay_color": "#000000",
            "overlay_opacity": 60,
            "show_button": true,
            "button_label": "Subscribe & Save",
            "button_link": "",
            "button_background_color": "#F9D5C0",
            "button_text_color": "#212323"
          }
        },
        {
          "type": "hero-slide",
          "settings": {
            "heading": "Try all 3 flavors.",
            "subheading": "Free 3-flavor trial pack. Just pay shipping.",
            "heading_color": "#F6F1EC",
            "background_image": "shopify://shop_images/hero_2.png",
            "overlay_color": "#000000",
            "overlay_opacity": 60,
            "show_button": true,
            "button_label": "Claim Trial Pack",
            "button_link": "",
            "button_background_color": "#F9D5C0",
            "button_text_color": "#212323"
          }
        }
      ]
    }
  ]
}
{% endschema %}
