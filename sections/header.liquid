<header
  class="navbar full-width"
  style="
    --navbar-background: {{ section.settings.background_color }};
    --navbar-text: {{ section.settings.text_color }};
    --navbar-logo-width: {{ section.settings.logo_width }}px;
  "
>
  <div class="navbar__bar">
    <nav class="navbar__menu" aria-label="{{ 'general.accessibility.navigation' | t }}">
      {% for link in section.settings.menu.links %}
        <a href="{{ link.url }}" class="navbar__menu-item">
          <span>{{ link.title }}</span>
          {% if link.links.size > 0 %}
            {{ 'icon-chevron-down.svg' | inline_asset_content }}
          {% endif %}
        </a>
      {% endfor %}
    </nav>

    <a href="{{ routes.root_url }}" class="navbar__logo">
      {% if section.settings.logo %}
        {{ section.settings.logo | image_url: width: section.settings.logo_width | image_tag: loading: 'eager', alt: shop.name }}
      {% else %}
        {{ 'logo-toasted.svg' | inline_asset_content }}
      {% endif %}
    </a>

    <div class="navbar__actions">
      {% if section.settings.secondary_link_text != blank %}
        <a
          {% if section.settings.secondary_link_url != blank %}
            href="{{ section.settings.secondary_link_url }}"
          {% endif %}
          class="navbar__link"
        >
          {{ section.settings.secondary_link_text }}
        </a>
      {% endif %}

      {% if section.settings.show_search %}
        <a
          href="{{ routes.search_url }}"
          class="navbar__icon-link navbar__icon-link--search"
          aria-label="{{ 'general.accessibility.search' | t }}"
        >
          {{ 'icon-search.svg' | inline_asset_content }}
        </a>
      {% endif %}

      {% if section.settings.show_cart %}
        <a
          href="{{ routes.cart_url }}"
          class="navbar__icon-link navbar__icon-link--cart"
          aria-label="{{ 'general.accessibility.cart' | t }}"
        >
          {{ 'icon-cart.svg' | inline_asset_content }}
        </a>
      {% endif %}
    </div>
  </div>
</header>

{% stylesheet %}
  .navbar {
    width: 100%;
    background-color: var(--navbar-background);
    color: var(--navbar-text);
  }

  .navbar__bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    padding-block: 1.375rem;
    padding-inline: clamp(var(--page-margin), 6vw, 6.25rem);
  }

  .navbar__menu {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
    justify-self: start;
  }

  .navbar__menu-item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: currentColor;
    text-decoration: none;
    font-size: clamp(0.9375rem, 0.75rem + 1vw, 1.25rem);
    font-weight: 500;
    white-space: nowrap;
  }

  .navbar__menu-item svg {
    width: 0.75rem;
    height: auto;
    flex-shrink: 0;
  }

  .navbar__logo {
    display: block;
    justify-self: center;
    line-height: 0;
  }

  .navbar__logo img,
  .navbar__logo svg {
    display: block;
    width: var(--navbar-logo-width);
    height: auto;
    max-width: 100%;
  }

  .navbar__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: clamp(0.75rem, 0.4rem + 1.5vw, 1.5rem);
    justify-self: end;
  }

  .navbar__link {
    color: currentColor;
    text-decoration: none;
    text-transform: capitalize;
    font-size: clamp(0.9375rem, 0.75rem + 1vw, 1.25rem);
    font-weight: 500;
    white-space: nowrap;
  }

  .navbar__icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: currentColor;
  }

  .navbar__icon-link--search {
    width: 2.375rem;
    height: 2.375rem;
  }

  .navbar__icon-link--search svg {
    width: 75%;
    height: 75%;
  }

  .navbar__icon-link--cart {
    width: 2rem;
    height: 2rem;
  }

  .navbar__icon-link--cart svg {
    width: 100%;
    height: 100%;
  }

  .navbar__menu-item:hover,
  .navbar__link:hover,
  .navbar__icon-link:hover {
    opacity: 0.7;
  }

  .navbar__menu-item:focus-visible,
  .navbar__link:focus-visible,
  .navbar__icon-link:focus-visible,
  .navbar__logo:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:labels.logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 80,
      "max": 300,
      "step": 4,
      "unit": "px",
      "label": "t:labels.logo_width",
      "default": 184
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "main-menu"
    },
    {
      "type": "text",
      "id": "secondary_link_text",
      "label": "t:labels.secondary_link_text",
      "default": "Find Toasted"
    },
    {
      "type": "url",
      "id": "secondary_link_url",
      "label": "t:labels.secondary_link_url"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "t:labels.show_search",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cart",
      "label": "t:labels.show_cart",
      "default": true
    },
    {
      "type": "header",
      "content": "t:general.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.background",
      "default": "#F6F1EC"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:labels.foreground",
      "default": "#212323"
    }
  ]
}
{% endschema %}
