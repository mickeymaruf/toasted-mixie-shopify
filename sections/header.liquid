{% liquid
  assign navbar_bg = section.settings.default_background_color

  # Parse page URLs and check if current page matches
  if section.settings.alternate_pages != blank
    assign page_urls = section.settings.alternate_pages | split: ' '
    assign current_path = request.path

    for url in page_urls
      if current_path contains url
        assign navbar_bg = section.settings.alternate_background_color
        break
      endif
    endfor
  endif
%}

<header
  class="navbar full-width"
  style="
    --navbar-background: {{ navbar_bg }};
    --navbar-text: #212323;
    --navbar-actions-background: {{ section.settings.navbar_actions_background }};
    --navbar-dropdown-background: {{ section.settings.mega_menu_background_color }};
    --navbar-dropdown-heading: {{ section.settings.dropdown_heading_color }};
    --navbar-height: 80px;
    --navbar-height-mobile: 64px;
    --navbar-logo-width: {{ section.settings.logo_width }}px;
    --navbar-logo-width-mobile: {{ section.settings.logo_width_mobile }}px;
  "
  data-navbar
>
  <div class="navbar__bar">
    <button
      type="button"
      class="navbar__dropdown-toggle navbar__dropdown-toggle--desktop"
      aria-label="{{ 'general.accessibility.menu' | t }}"
      aria-expanded="false"
      aria-controls="navbar-dropdown-{{ section.id }}"
      data-navbar-toggle
    >
      <span class="navbar__dropdown-toggle-icon navbar__dropdown-toggle-icon--open">
        {{ 'icon-menu-bars.svg' | inline_asset_content }}
      </span>
      <span class="navbar__dropdown-toggle-icon navbar__dropdown-toggle-icon--close">
        {{ 'icon-close-bold.svg' | inline_asset_content }}
      </span>
    </button>

    <a href="{{ routes.root_url }}" class="navbar__logo">
      {% if section.settings.logo %}
        {{
          section.settings.logo
          | image_url: width: 800
          | image_tag: loading: 'eager', alt: shop.name
        }}
      {% else %}
        {{ 'logo-toasted.svg' | inline_asset_content }}
      {% endif %}
    </a>

    <div class="navbar__actions">
      {% if section.settings.show_right_side_button %}
        <a
          href="{{ section.settings.right_side_button_link | default: '#' }}"
          class="navbar__right-button border-[3px] py-2 rounded-full px-8"
          style="
            --right-button-background: {{ section.settings.right_side_button_background_color }};
            --right-button-border: {{ section.settings.right_side_button_border_color }};
            --right-button-text: {{ section.settings.right_side_button_text_color }};
          "
        >
          {{- section.settings.right_side_button_text -}}
        </a>
      {% endif %}

      {% if section.settings.show_search_button %}
        <button
          type="button"
          class="navbar__search-button"
          aria-label="{{ 'general.accessibility.search' | t }}"
          data-search-open
        >
          {{ 'icon-search.svg' | inline_asset_content }}
        </button>
      {% endif %}

      <button
        type="button"
        class="navbar__icon-link navbar__icon-link--cart"
        aria-label="{{ 'general.accessibility.cart' | t }}"
        data-cart-drawer-open
      >
        {{ 'icon-cart.svg' | inline_asset_content }}
        <span
          class="navbar__cart-count"
          data-cart-count
          {% if cart.item_count == 0 %}
            hidden
          {% endif %}
        >
          {{ cart.item_count }}
        </span>
      </button>

      <button
        type="button"
        class="navbar__dropdown-toggle navbar__dropdown-toggle--mobile"
        aria-label="{{ 'general.accessibility.menu' | t }}"
        aria-expanded="false"
        aria-controls="navbar-dropdown-{{ section.id }}"
        data-navbar-toggle
      >
        <span class="navbar__dropdown-toggle-icon navbar__dropdown-toggle-icon--open">
          {{ 'icon-menu-bars.svg' | inline_asset_content }}
        </span>
        <span class="navbar__dropdown-toggle-icon navbar__dropdown-toggle-icon--close">
          {{ 'icon-close-bold.svg' | inline_asset_content }}
        </span>
      </button>
    </div>
  </div>

  <div class="navbar__dropdown" id="navbar-dropdown-{{ section.id }}" data-navbar-dropdown>
    <div class="navbar__dropdown-panel">
      <div class="navbar__dropdown-shop">
        {% render 'button',
          label: section.settings.mega_menu_button_text,
          url: section.settings.mega_menu_button_link,
          background_color: section.settings.mega_menu_button_background,
          text_color: section.settings.mega_menu_button_text_color,
          icon: 'icon-arrow-narrow-right.svg',
          class: '!px-8 !py-4 !text-[18px] max-md:!w-full max-md:!px-5 max-md:!py-2.5 max-md:!text-[14px] navbar__dropdown-shop-button'
        %}

        <div class="navbar__dropdown-products">
          {% render 'mega-menu-card',
            product: section.settings.card_1_product,
            image: section.settings.card_1_image,
            name: section.settings.card_1_name,
            url: section.settings.card_1_link,
            background_color: section.settings.mega_menu_card_background_color
          %}
          {% render 'mega-menu-card',
            product: section.settings.card_2_product,
            image: section.settings.card_2_image,
            name: section.settings.card_2_name,
            url: section.settings.card_2_link,
            background_color: section.settings.mega_menu_card_background_color
          %}
          {% render 'mega-menu-card',
            product: section.settings.card_3_product,
            image: section.settings.card_3_image,
            name: section.settings.card_3_name,
            url: section.settings.card_3_link,
            background_color: section.settings.mega_menu_card_background_color
          %}
          {% render 'mega-menu-card',
            product: section.settings.card_4_product,
            image: section.settings.card_4_image,
            name: section.settings.card_4_name,
            url: section.settings.card_4_link,
            background_color: section.settings.mega_menu_card_background_color
          %}
        </div>
      </div>

      {% if section.settings.dropdown_menu_one.links.size > 0 or section.settings.dropdown_menu_two.links.size > 0 %}
        <div class="navbar__dropdown-links">
          {% if section.settings.dropdown_menu_one.links.size > 0 %}
            <div class="navbar__dropdown-links-column">
              <p class="navbar__dropdown-links-heading">{{ section.settings.dropdown_menu_one_title }}</p>
              {% for link in section.settings.dropdown_menu_one.links %}
                <a href="{{ link.url }}" class="navbar__dropdown-link">{{ link.title }}</a>
              {% endfor %}
            </div>
          {% endif %}

          {% if section.settings.dropdown_menu_two.links.size > 0 %}
            <div class="navbar__dropdown-links-column">
              <p class="navbar__dropdown-links-heading">{{ section.settings.dropdown_menu_two_title }}</p>
              {% for link in section.settings.dropdown_menu_two.links %}
                <a href="{{ link.url }}" class="navbar__dropdown-link">{{ link.title }}</a>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      {% endif %}

      {% liquid
        assign instagram_label = 'general.accessibility.instagram' | t
        assign youtube_label = 'general.accessibility.youtube' | t
        assign tiktok_label = 'general.accessibility.tiktok' | t
      %}
      <div class="navbar__dropdown-social">
        {% render 'header-social-icon',
          icon: section.settings.instagram_icon,
          link: section.settings.instagram_link,
          label: instagram_label
        %}
        {% render 'header-social-icon',
          icon: section.settings.youtube_icon,
          link: section.settings.youtube_link,
          label: youtube_label
        %}
        {% render 'header-social-icon',
          icon: section.settings.tiktok_icon,
          link: section.settings.tiktok_link,
          label: tiktok_label
        %}
      </div>
    </div>
  </div>
</header>

{% stylesheet %}
  .navbar {
    width: 100%;
    background-color: var(--navbar-background);
    color: var(--navbar-text);
    position: relative;
  }

  .navbar__bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    padding-block: 1.375rem;
    padding-inline: 60px;
    position: relative;
  }

  .navbar__dropdown-toggle {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    position: relative;
    width: 3.1875rem;
    height: 1.8125rem;
    color: currentColor;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .navbar__dropdown-toggle--mobile {
    display: none;
  }

  .navbar__dropdown-toggle-icon {
    display: block;
    position: absolute;
    inset: 0;
    margin: auto;
  }

  .navbar__dropdown-toggle-icon--open {
    width: 100%;
    height: 100%;
  }

  .navbar__dropdown-toggle-icon--close {
    width: 1.8125rem;
    height: 1.8125rem;
    display: none;
  }

  .navbar__dropdown-toggle-icon--close svg {
    width: 100%;
    height: 100%;
  }

  .navbar--menu-open .navbar__dropdown-toggle-icon--open {
    display: none;
  }

  .navbar--menu-open .navbar__dropdown-toggle-icon--close {
    display: block;
  }

  @media (max-width: 47.9375rem) {
    .navbar {
      z-index: 60;
      min-height: var(--navbar-bar-height, var(--navbar-height-mobile));
    }

    .navbar.navbar--mobile-fixed .navbar__bar {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 60;
      background-color: var(--navbar-background);
      transform: translateY(0);
      transition: transform 0.22s ease;
      will-change: transform;
    }

    .navbar.navbar--sticky-hidden .navbar__bar {
      transform: translateY(-100%);
    }

    .navbar__bar {
      display: flex;
      justify-content: space-between;
      padding-block: 0.875rem;
      padding-inline: var(--page-margin);
      gap: 0.75rem;
    }

    .navbar__dropdown-toggle--desktop {
      display: none;
    }

    .navbar__dropdown-toggle--mobile {
      display: inline-flex;
    }

    .navbar__dropdown-toggle {
      width: 1.5rem;
      height: 0.875rem;
    }

    .navbar__dropdown-toggle-icon--close {
      width: 0.875rem;
      height: 0.875rem;
    }

    .navbar__dropdown {
      position: absolute;
      top: 100%;
      z-index: 59;
    }

    .navbar.navbar--mobile-fixed .navbar__dropdown {
      position: fixed;
      top: var(--navbar-bar-height, var(--navbar-height-mobile));
    }
  }

  .navbar__logo {
    display: block;
    justify-self: center;
    line-height: 0;
  }

  .navbar__logo img,
  .navbar__logo svg {
    display: block;
    width: var(--navbar-logo-width);
    height: auto;
    max-width: 100%;
  }

  @media (max-width: 47.9375rem) {
    .navbar__logo {
      justify-self: start;
      flex-shrink: 0;
    }

    .navbar__logo img,
    .navbar__logo svg {
      width: var(--navbar-logo-width-mobile);
    }
  }

  .navbar__actions {
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
    justify-content: flex-end;
    gap: clamp(1.25rem, 0.4rem + 2.5vw, 1.5rem);
    justify-self: end;
  }

  @media (min-width: 48rem) {
    .navbar__actions {
      background-color: var(--navbar-actions-background);
      padding: 10px 32px 10px 12px;
      border-radius: 999px;
    }

    .navbar__actions:not(:has(.navbar__right-button)) {
      padding: 10px 24px;
    }
  }

  .navbar__icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: currentColor;
    cursor: pointer;
  }

  .navbar__search-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: currentColor;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .navbar__search-button svg {
    width: 1.75rem;
    height: 1.75rem;
    flex-shrink: 0;
  }

  .navbar__right-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background-color: var(--right-button-background);
    border-color: var(--right-button-border);
    color: var(--right-button-text);
    text-decoration: none;
    font-size: clamp(0.9375rem, 0.75rem + 1vw, 1.25rem);
    font-weight: 500;
    white-space: nowrap;
    cursor: pointer;
  }

  @media (max-width: 768px) {
    .navbar__actions {
      justify-self: end;
      gap: 0.875rem;
      padding: 0.375rem 1rem 0.375rem 0.375rem;
      border-radius: 999px;
      background-color: var(--navbar-actions-background);
    }

    .navbar__right-button {
      display: inline-flex;
      padding: 0.5rem 1rem;
      border: 2px solid var(--right-button-border);
      border-radius: 999px;
      font-size: 0.9375rem;
      line-height: 1;
    }

    .navbar__search-button svg {
      width: 1.25rem;
      height: 1.25rem;
    }

    .navbar__icon-link--cart {
      width: 1.5rem;
      height: 1.5rem;
    }

    .navbar__icon-link--cart svg {
      width: 1.5rem !important;
      height: 1.5rem !important;
    }
  }

  @media (max-width: 25rem) {
    .navbar__actions {
      gap: 0.625rem;
      padding: 0.375rem 1rem 0.375rem 0.375rem;
    }

    .navbar__right-button {
      padding: 0.5625rem 0.875rem;
      font-size: 0.8125rem;
    }

    .navbar__search-button svg {
      width: 1rem;
      height: 1rem;
    }

    .navbar__icon-link--cart {
      width: 1.125rem;
      height: 1.125rem;
    }

    .navbar__icon-link--cart svg {
      width: 1.125rem !important;
      height: 1.125rem !important;
    }
  }

  .navbar__icon-link--cart {
    position: relative;
    width: 1.75rem;
    height: 1.75rem;
  }

  .navbar__icon-link--cart svg {
    width: 100%;
    height: 100%;
  }

  .navbar__cart-count {
    position: absolute;
    top: -0.25rem;
    right: -0.375rem;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 1rem;
    height: 1rem;
    padding-inline: 0.1875rem;
    border-radius: 999px;
    background-color: #ffffff;
    color: #212323;
    font-size: 0.625rem;
    line-height: 1;
    font-weight: 500;
  }

  .navbar__icon-link:hover,
  .navbar__dropdown-toggle:hover {
    opacity: 0.7;
  }

  .navbar__icon-link:focus-visible,
  .navbar__logo:focus-visible,
  .navbar__dropdown-toggle:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  /* Dropdown menu */
  .navbar__dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    z-index: 50;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-10px) scale(0.9);
    transform-origin: top left;
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s ease;
  }

  .navbar--menu-open .navbar__dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
  }

  .navbar__dropdown-panel {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2rem;
    max-width: calc(100% - 2 * clamp(var(--page-margin), 6vw, 6.25rem));
    margin-inline-start: clamp(var(--page-margin), 6vw, 6.25rem);
    margin-block-end: 1.5rem;
    padding: 2.25rem;
    border: 3px solid #212323;
    border-radius: 2.0625rem;
    background-color: var(--navbar-dropdown-background);
    pointer-events: none;
  }

  .navbar--menu-open .navbar__dropdown-panel {
    pointer-events: auto;
  }

  @media (max-width: 47.9375rem) {
    .navbar__dropdown-panel {
      display: flex;
      width: calc(100% - 1.5rem);
      max-width: calc(100% - 1.5rem);
      margin-inline-start: 0.75rem;
      margin-inline-end: 0.75rem;
      padding: 1rem;
      border-radius: 1.25rem;
      gap: 1.25rem;
    }
  }

  .navbar__dropdown-shop {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.9375rem;
    width: 100%;
  }

  @media (max-width: 47.9375rem) {
    .navbar__dropdown-shop {
      gap: 0.625rem;
    }
  }

  .navbar__dropdown-shop-button {
    gap: 0.875rem;
  }

  .navbar__dropdown-shop-button .button__icon svg {
    width: 1.4em;
    height: 1.4em;
  }

  .navbar__dropdown-products {
    display: grid;
    grid-template-columns: repeat(2, minmax(10.5rem, 1fr));
    gap: 0.625rem;
    width: 100%;
  }

  @media (max-width: 47.9375rem) {
    .navbar__dropdown-products {
      gap: 0.375rem;
    }
  }

  @media (max-width: 25rem) {
    .navbar__dropdown-products {
      grid-template-columns: 1fr;
    }
  }

  .navbar__dropdown-links {
    display: flex;
    flex-wrap: wrap;
    column-gap: 3.75rem;
    row-gap: 1.875rem;
    width: 100%;
  }

  .navbar__dropdown-links-column {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.875rem;
  }

  .navbar__dropdown-links-heading {
    font-family: var(--font-heading--family);
    color: var(--navbar-dropdown-heading);
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.5;
    text-box-trim: trim-both;
    text-box-edge: cap alphabetic;
    margin: 0;
  }

  .navbar__dropdown-link {
    display: block;
    color: #212323;
    text-decoration: none;
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.5;
    text-box-trim: trim-both;
    text-box-edge: cap alphabetic;
  }

  .navbar__dropdown-link:hover {
    opacity: 0.7;
  }

  .navbar__dropdown-social {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.9375rem;
  }

  .navbar__dropdown-social-icon {
    display: inline-flex;
    flex-shrink: 0;
    transition: opacity 0.15s ease;
  }

  .navbar__dropdown-social-icon:hover {
    opacity: 0.85;
  }

  .navbar__dropdown-social-icon-img {
    width: 50px;
    height: 50px;
    object-fit: contain;
  }

  @media (max-width: 47.9375rem) {
    .navbar__dropdown-links-heading {
      font-size: 1.125rem;
    }

    .navbar__dropdown-link {
      font-size: 0.9375rem;
    }

    .navbar__dropdown-social-icon-img {
      width: 36px;
      height: 36px;
    }

    .navbar__dropdown-links {
      column-gap: 2rem;
      row-gap: 1rem;
    }

    .navbar__dropdown-links-column {
      gap: 1rem;
    }
  }
{% endstylesheet %}

{% javascript %}
  const mobileStickyQuery = window.matchMedia('(max-width: 47.9375rem)');
  let lastScrollY = window.scrollY;
  let stickyTicking = false;

  const updateMobileStickyNavbar = () => {
    const currentScrollY = window.scrollY;

    document.querySelectorAll('[data-navbar]').forEach((navbar) => {
      if (!mobileStickyQuery.matches) {
        navbar.classList.remove('navbar--mobile-fixed');
        navbar.classList.remove('navbar--sticky-hidden');
        return;
      }

      const navbarBar = navbar.querySelector('.navbar__bar');
      const navbarBarHeight = navbarBar ? navbarBar.offsetHeight : 0;
      if (navbarBarHeight) {
        navbar.style.setProperty('--navbar-bar-height', `${navbarBarHeight}px`);
      }

      const navbarStart = navbar.offsetTop;
      const isFixed = currentScrollY >= navbarStart;

      navbar.classList.toggle('navbar--mobile-fixed', isFixed);

      if (!isFixed || navbar.classList.contains('navbar--menu-open') || currentScrollY <= 80) {
        navbar.classList.remove('navbar--sticky-hidden');
        return;
      }

      if (currentScrollY > lastScrollY + 8) {
        navbar.classList.add('navbar--sticky-hidden');
      }

      if (currentScrollY < lastScrollY - 8) {
        navbar.classList.remove('navbar--sticky-hidden');
      }
    });

    lastScrollY = currentScrollY;
    stickyTicking = false;
  };

  window.addEventListener(
    'scroll',
    () => {
      if (stickyTicking) return;

      stickyTicking = true;
      window.requestAnimationFrame(updateMobileStickyNavbar);
    },
    { passive: true }
  );

  mobileStickyQuery.addEventListener('change', updateMobileStickyNavbar);
  updateMobileStickyNavbar();

  document.addEventListener('click', function (event) {
    const navbar = event.target.closest('[data-navbar]');
    const toggle = event.target.closest('[data-navbar-toggle]');

    const setToggleState = (currentNavbar, isOpen) => {
      currentNavbar.querySelectorAll('[data-navbar-toggle]').forEach((navbarToggle) => {
        navbarToggle.setAttribute('aria-expanded', String(isOpen));
      });
    };

    if (toggle) {
      const currentNavbar = toggle.closest('[data-navbar]');
      const isOpen = currentNavbar.classList.contains('navbar--menu-open');

      currentNavbar.classList.toggle('navbar--menu-open', !isOpen);
      setToggleState(currentNavbar, !isOpen);
      currentNavbar.classList.remove('navbar--sticky-hidden');
      return;
    }

    document.querySelectorAll('[data-navbar].navbar--menu-open').forEach((openNavbar) => {
      if (openNavbar !== navbar || !event.target.closest('[data-navbar-dropdown]')) {
        openNavbar.classList.remove('navbar--menu-open');
        setToggleState(openNavbar, false);
      }
    });
  });

  document.addEventListener('keydown', function (event) {
    if (event.key !== 'Escape') return;

    document.querySelectorAll('[data-navbar].navbar--menu-open').forEach((openNavbar) => {
      openNavbar.classList.remove('navbar--menu-open');
      openNavbar.querySelectorAll('[data-navbar-toggle]').forEach((navbarToggle) => {
        navbarToggle.setAttribute('aria-expanded', 'false');
      });
    });
  });

  // Cart update listener
  document.addEventListener('cart:updated', async () => {
    const response = await fetch('/cart.js');
    if (!response.ok) return;

    const cart = await response.json();
    document.querySelectorAll('[data-cart-count]').forEach((el) => {
      el.textContent = cart.item_count;
      el.hidden = cart.item_count === 0;
    });
  });
{% endjavascript %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:labels.logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 100,
      "max": 320,
      "step": 4,
      "unit": "px",
      "label": "Desktop logo width",
      "default": 184
    },
    {
      "type": "range",
      "id": "logo_width_mobile",
      "min": 80,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Mobile logo width",
      "default": 116
    },
    {
      "type": "header",
      "content": "t:general.right_side_button"
    },
    {
      "type": "checkbox",
      "id": "show_right_side_button",
      "label": "t:labels.show",
      "default": true
    },
    {
      "type": "text",
      "id": "right_side_button_text",
      "label": "t:labels.text",
      "default": "Shop Now"
