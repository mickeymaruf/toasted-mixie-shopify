<header
  class="navbar full-width"
  style="
    --navbar-background: {{ section.settings.background_color }};
    --navbar-text: {{ section.settings.text_color }};
    --navbar-height: 80px;
    --navbar-height-mobile: 64px;
  "
>
  <div class="navbar__bar">
    <nav class="navbar__menu" aria-label="{{ 'general.accessibility.navigation' | t }}">
      {% for link in section.settings.menu.links %}
        {% assign has_mega_menu = false %}
        {% if section.settings.mega_menu_link_title != blank and link.title == section.settings.mega_menu_link_title %}
          {% assign has_mega_menu = true %}
        {% endif %}

        <div class="navbar__menu-item-wrapper {% if has_mega_menu %}navbar__menu-item-wrapper--has-mega-menu{% endif %}">
          {% if has_mega_menu %}
            {% render 'button',
              label: link.title,
              url: link.url,
              icon: 'icon-chevron-down.svg',
              class: '!w-auto navbar__mega-menu-trigger whitespace-nowrap !text-sm md:!text-xl !px-4 md:!px-[36px] py-[5px] md:!py-3.5 gap-[8px]',
              attributes: 'data-mega-menu-trigger'
            %}
          {% else %}
            <a href="{{ link.url }}" class="navbar__menu-item">
              <span>{{ link.title }}</span>
              {% if link.links.size > 0 %}
                {{ 'icon-chevron-down.svg' | inline_asset_content }}
              {% endif %}
            </a>
          {% endif %}

          {% if has_mega_menu %}
            <!-- Mega Menu Drawer -->
            <div class="navbar__mega-menu-drawer" data-mega-menu-drawer>
              <div class="navbar__mega-menu-content">
                <div class="grid grid-cols-1 md:grid-cols-2 md:grid-cols-4 items-start gap-x-0 gap-y-3 md:gap-5 lg:gap-6 px-4 md:px-6 lg:px-[60px] py-6 sm:py-8">
                  <!-- Mega Menu Button/Trigger - Left -->
                  <a
                    href="{{ section.settings.mega_menu_button_link }}"
                    class="navbar__mega-menu-button col-span-1 md:col-span-2 lg:col-span-1 flex items-center justify-between gap-4 rounded-full px-8 py-4 font-medium transition-all duration-200 hover:shadow-lg no-underline whitespace-nowrap"
                    style="background-color: {{ section.settings.mega_menu_button_background }}; color: {{ section.settings.mega_menu_button_text_color }};"
                  >
                    <span class="text-base sm:text-lg">{{ section.settings.mega_menu_button_text }}</span>
                    <svg class="h-6 w-6 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                    </svg>
                  </a>

                  <!-- Mega Menu Cards - Right -->
                  <div class="col-span-1 md:col-span-2 lg:col-span-3 flex flex-1 flex-wrap gap-3 md:gap-5 lg:gap-6">
                    {% if section.blocks.size > 0 %}
                      {% for block in section.blocks %}
                        {% if block.settings.product != blank %}
                          <div
                            class="navbar__mega-menu-card flex items-center gap-4 rounded-2xl p-4 flex-1 lg:flex-none"
                            style="background-color: {{ block.settings.card_background_color }}"
                            {{ block.shopify_attributes }}
                          >
                            <!-- Product Image -->
                            <div class="shrink-0 overflow-hidden rounded-lg" style="width: 75px; height: 75px;">
                              {% if block.settings.product.featured_image %}
                                {{
                                  block.settings.product.featured_image
                                  | image_url: width: 200, height: 200
                                  | image_tag: class: 'h-full w-full object-cover', alt: block.settings.product.title
                                }}
                              {% else %}
                                <div class="flex h-full w-full items-center justify-center bg-gray-200">
                                  <span class="text-xs text-gray-400">No image</span>
                                </div>
                              {% endif %}
                            </div>

                            <!-- Product Info -->
                            <div class="flex flex-1 flex-col justify-start gap-1">
                              <!-- Rating and Reviews -->
                              <div class="flex items-center gap-1">
                                <div
                                  class="flex items-center gap-0.5 leading-none -space-x-[3px]"
                                  style="color: {{ block.settings.star_color }};"
                                >
                                  {% for i in (1..5) %}
                                    <span
                                      class="flex size-4 items-center justify-center {% unless i <= block.settings.rating %}opacity-20{% endunless %}"
                                      aria-hidden="true"
                                    >
                                      {{ 'icon-star-thin-filled.svg' | inline_asset_content }}
                                    </span>
                                  {% endfor %}
                                </div>
                                <p class="text-xs leading-none whitespace-nowrap">
                                  {{ block.settings.review_count }}
                                </p>
                              </div>

                              <!-- Product Name -->
                              <h3 class="text-sm font-bold sm:text-lg">
                                {{ block.settings.product.title }}
                              </h3>
                            </div>
                          </div>
                        {% endif %}
                      {% endfor %}
                    {% endif %}
                  </div>
                </div>
              </div>
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </nav>

    <a href="{{ routes.root_url }}" class="navbar__logo">
      {% if section.settings.logo %}
        {{
          section.settings.logo
          | image_url: width: section.settings.logo_width
          | image_tag: loading: 'eager', alt: shop.name
        }}
      {% else %}
        {{ 'logo-toasted.svg' | inline_asset_content }}
      {% endif %}
    </a>

    <div class="navbar__actions">
      <button
        type="button"
        class="navbar__search-button"
        aria-label="{{ 'general.accessibility.search' | t }}"
        data-search-open
      >
        <span class="navbar__search-button-text border-[3px] py-2 rounded-full px-8">
          {{- section.settings.search_button_text -}}
        </span>
        {% comment %} {{ 'icon-search.svg' | inline_asset_content }} {% endcomment %}
      </button>

      <button
        type="button"
        class="navbar__icon-link navbar__icon-link--cart"
        aria-label="{{ 'general.accessibility.cart' | t }}"
        data-cart-drawer-open
      >
        {{ 'icon-cart.svg' | inline_asset_content }}
        <span
          class="navbar__cart-count"
          data-cart-count
          {% if cart.item_count == 0 %}
            hidden
          {% endif %}
        >
          {{ cart.item_count }}
        </span>
      </button>
    </div>
  </div>
</header>

{% stylesheet %}
  .navbar {
    width: 100%;
    background-color: var(--navbar-background);
    color: var(--navbar-text);
    position: relative;
  }

  .navbar__bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    padding-block: 1.375rem;
    padding-inline: clamp(var(--page-margin), 6vw, 6.25rem);
    position: relative;
  }

  .navbar__menu {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
    justify-self: start;
  }

  .navbar__menu-item-wrapper {
    display: contents;
  }

  .navbar__menu-item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: currentColor;
    text-decoration: none;
    font-size: clamp(0.9375rem, 0.75rem + 1vw, 1.25rem);
    font-weight: 500;
    white-space: nowrap;
  }

  .navbar__menu-item svg {
    width: 0.75rem;
    height: auto;
    flex-shrink: 0;
    transition: transform 0.3s ease;
  }

  .navbar__mega-menu-trigger svg {
    width: 0.75rem;
    height: auto;
    flex-shrink: 0;
    transition: transform 0.3s ease;
  }

  .navbar__menu-item-wrapper--has-mega-menu:hover .navbar__mega-menu-trigger svg,
  .navbar__menu-item-wrapper--has-mega-menu.active .navbar__mega-menu-trigger svg {
    transform: rotate(180deg);
  }

  /* Mega Menu Drawer */
  .navbar__mega-menu-drawer {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background-color: #f9d5c0;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-10px);
    transition: all 0.3s ease;
    pointer-events: none;
    z-index: 50;
  }

  .navbar__menu-item-wrapper--has-mega-menu:hover .navbar__mega-menu-drawer,
  .navbar__menu-item-wrapper--has-mega-menu.active .navbar__mega-menu-drawer {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
  }

  .navbar__mega-menu-content {
    padding: 1.5rem 0;
  }

  .navbar__mega-menu-button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    white-space: nowrap;
    border: none;
    cursor: pointer;
    font-family: inherit;
  }

  .navbar__mega-menu-button:hover {
    opacity: 0.9;
  }

  .navbar__mega-menu-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    transition: all 0.2s ease;
  }

  a[data-mega-menu-trigger] {
    position: relative;
  }

  a[data-mega-menu-trigger]:hover::after {
    content: '';
    position: absolute;
    top: 0;
    left: -20px;
    width: 300%;
    height: 200%;
  }

  .navbar__logo {
    display: block;
    justify-self: center;
    line-height: 0;
  }

  .navbar__logo img,
  .navbar__logo svg {
    display: block;
    width: 184px;
    height: auto;
    max-width: 100%;
  }

  @media (max-width: 47.9375rem) {
    .navbar__logo img,
    .navbar__logo svg {
      width: 116px;
    }
  }

  @media (max-width: 25rem) {
    .navbar__logo img,
    .navbar__logo svg {
      width: 100px;
    }
  }

  .navbar__actions {
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
    justify-content: flex-end;
    gap: clamp(1.25rem, 0.4rem + 2.5vw, 1.5rem);
    justify-self: end;
  }

  @media (min-width: 48rem) {
    .navbar__actions {
      background-color: rgba(194, 203, 212, 0.5);
      padding: 10px 32px 10px 12px;
      border-radius: 999px;
    }
  }

  .navbar__link {
    color: currentColor;
    text-decoration: none;
    text-transform: capitalize;
    font-size: clamp(0.9375rem, 0.75rem + 1vw, 1.25rem);
    font-weight: 500;
    white-space: nowrap;
  }

  .navbar__icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: currentColor;
  }

  .navbar__search-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: clamp(0.75rem, 0.4rem + 1.5vw, 1.5rem);
    flex-shrink: 0;
    color: currentColor;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .navbar__search-button svg {
    width: 1.75rem;
    height: 1.75rem;
    flex-shrink: 0;
  }

  .navbar__search-button-text {
    font-size: clamp(0.9375rem, 0.75rem + 1vw, 1.25rem);
    font-weight: 500;
    white-space: nowrap;
  }

  @media (max-width: 768px) {
    a.navbar__mega-menu-trigger[data-mega-menu-trigger] {
      padding: 0.25rem 0.5rem !important;
      font-size: 1.25rem !important;
      gap: 0.25rem !important;
    }

    a.navbar__mega-menu-trigger[data-mega-menu-trigger] svg {
      width: 0.875rem !important;
      height: 0.875rem !important;
    }

    .navbar__search-button-text {
      display: none;
    }

    .navbar__search-button svg {
      width: 1.25rem;
      height: 1.25rem;
    }

    .navbar__icon-link--cart {
      width: 1.5rem;
      height: 1.5rem;
    }

    .navbar__icon-link--cart svg {
      width: 1.5rem !important;
      height: 1.5rem !important;
    }
  }

  @media (max-width: 25rem) {
    .navbar__actions {
      gap: clamp(0.75rem, 0.4rem + 1.5vw, 1rem);
    }

    .navbar__search-button svg {
      width: 1rem;
      height: 1rem;
    }

    .navbar__icon-link--cart {
      width: 1.125rem;
      height: 1.125rem;
    }

    .navbar__icon-link--cart svg {
      width: 1.125rem !important;
      height: 1.125rem !important;
    }
  }

  .navbar__icon-link--cart {
    position: relative;
    width: 1.75rem;
    height: 1.75rem;
  }

  .navbar__icon-link--cart svg {
    width: 100%;
    height: 100%;
  }

  .navbar__cart-count {
    position: absolute;
    top: -0.25rem;
    right: -0.375rem;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 1rem;
    height: 1rem;
    padding-inline: 0.1875rem;
    border-radius: 999px;
    background-color: #ffffff;
    color: #212323;
    font-size: 0.625rem;
    line-height: 1;
    font-weight: 500;
  }

  .navbar__menu-item:hover,
  .navbar__link:hover,
  .navbar__icon-link:hover {
    opacity: 0.7;
  }

  .navbar__menu-item:focus-visible,
  .navbar__link:focus-visible,
  .navbar__icon-link:focus-visible,
  .navbar__logo:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  @media (max-width: 1024px) {
    .navbar__mega-menu-drawer {
      opacity: 0;
      visibility: hidden;
      transform: translateY(-10px);
      pointer-events: none;
    }

    .navbar__menu-item-wrapper--has-mega-menu.active .navbar__mega-menu-drawer {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
      pointer-events: auto;
    }
  }
{% endstylesheet %}

{% javascript %}
  // Mega Menu functionality
  document.addEventListener('DOMContentLoaded', () => {
    const megaMenuWrappers = document.querySelectorAll('[data-mega-menu-trigger]');

    megaMenuWrappers.forEach((trigger) => {
      const wrapper = trigger.closest('.navbar__menu-item-wrapper');

      // Close mega menu when clicking outside
      document.addEventListener('click', (e) => {
        if (!wrapper.contains(e.target)) {
          wrapper.classList.remove('active');
        }
      });

      // Toggle on click (mobile support)
      trigger.addEventListener('click', (e) => {
        const isActive = wrapper.classList.contains('active');
        document.querySelectorAll('.navbar__menu-item-wrapper.active').forEach((el) => {
          el.classList.remove('active');
        });
        if (!isActive) {
          wrapper.classList.add('active');
        }
        e.preventDefault();
      });
    });
  });

  // Cart update listener
  document.addEventListener('cart:updated', async () => {
    const response = await fetch('/cart.js');
    if (!response.ok) return;

    const cart = await response.json();
    document.querySelectorAll('[data-cart-count]').forEach((el) => {
      el.textContent = cart.item_count;
      el.hidden = cart.item_count === 0;
    });
  });
{% endjavascript %}

{% schema %}
{
  "name": "t:general.header",
  "blocks": [
    {
      "type": "mega-menu-product",
      "name": "t:general.product_card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "t:labels.product"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "t:labels.star_rating",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "review_count",
          "label": "t:labels.review_count",
          "default": "9,176 Reviews"
        },
        {
          "type": "header",
          "content": "t:general.colors"
        },
        {
          "type": "color",
          "id": "card_background_color",
          "label": "t:labels.card_background",
          "default": "#F6F1EC"
        },
        {
          "type": "color",
          "id": "star_color",
          "label": "t:labels.star_color",
          "default": "#D4941F"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:labels.logo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "main-menu"
    },
    {
      "type": "text",
      "id": "search_button_text",
      "label": "t:labels.search_button_text",
      "default": "Search",
      "info": "t:labels.search_button_text_info"
    },
    {
      "type": "header",
      "content": "t:general.mega_menu"
    },
    {
      "type": "text",
      "id": "mega_menu_link_title",
      "label": "t:labels.menu_item_title",
      "info": "t:labels.mega_menu_link_info",
      "placeholder": "Shop",
      "default": "Shop"
    },
    {
      "type": "text",
      "id": "mega_menu_button_text",
      "label": "t:labels.button_text",
      "default": "Shop Drinks"
    },
    {
      "type": "url",
      "id": "mega_menu_button_link",
      "label": "t:labels.button_link"
    },
    {
      "type": "color",
      "id": "mega_menu_button_background",
      "label": "t:labels.button_background",
      "default": "#212323"
    },
    {
      "type": "color",
      "id": "mega_menu_button_text_color",
      "label": "t:labels.button_text_color",
      "default": "#F6F1EC"
    },
    {
      "type": "header",
      "content": "t:general.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.background",
      "default": "#F6F1EC"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:labels.foreground",
      "default": "#212323"
    }
  ]
}
{% endschema %}
