{% assign form_type = section.settings.form_type %}
{% assign bg_color = section.settings.background_color %}
{% assign text_color = section.settings.text_color %}
{% assign button_bg_color = section.settings.button_background_color %}
{% assign button_text_color = section.settings.button_text_color %}

<div class="contact-form-section" style="
  --form-bg: {{ bg_color }};
  --form-text: {{ text_color }};
  --form-button-bg: {{ button_bg_color }};
  --form-button-text: {{ button_text_color }};
">
  <div class="contact-form-container">
    {% if section.settings.heading != blank %}
      <div class="contact-form-header">
        <h2 class="contact-form-heading">{{ section.settings.heading }}</h2>
        {% if section.settings.subheading != blank %}
          <p class="contact-form-subheading">{{ section.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="contact-form-wrapper">
      {% if form_type == 'shopify_contact' %}
        {% form 'contact' %}
          {% if form.errors %}
            <div class="form-errors">
              {{ form.errors | default_errors }}
            </div>
          {% endif %}

          <div class="form-fields">
            {% for block in section.blocks %}
              {% case block.type %}
                {% when 'field' %}
                  {% assign field_type = block.settings.field_type %}
                  {% assign field_name = block.settings.field_name %}
                  {% assign field_label = block.settings.field_label %}
                  {% assign field_required = block.settings.field_required %}
                  {% assign field_column_span = block.settings.column_span %}

                  <div class="form-field" data-field-type="{{ field_type }}" data-column-span="{{ field_column_span }}">
                    <label for="contact-{{ field_name }}" class="form-label">
                      {{ field_label }}
                    </label>

                    {% case field_type %}
                      {% when 'text' %}
                        <input
                          type="text"
                          id="contact-{{ field_name }}"
                          name="contact[{{ field_name }}]"
                          class="form-input"
                          {% if field_required %}required{% endif %}
                          placeholder=""
                        />
                      {% when 'email' %}
                        <input
                          type="email"
                          id="contact-{{ field_name }}"
                          name="contact[{{ field_name }}]"
                          class="form-input"
                          {% if field_required %}required{% endif %}
                          placeholder=""
                        />
                      {% when 'phone' %}
                        <input
                          type="tel"
                          id="contact-{{ field_name }}"
                          name="contact[{{ field_name }}]"
                          class="form-input"
                          {% if field_required %}required{% endif %}
                          placeholder=""
                        />
                    {% endcase %}
                  </div>
              {% endcase %}
            {% endfor %}
          </div>

          <button type="submit" class="contact-form-button">
            {{ section.settings.button_text }}
          </button>
        {% endform %}
      {% elsif form_type == 'custom' %}
        <form
          class="contact-form"
          data-form-handler="{{ section.settings.form_endpoint }}"
          data-success-message="{{ 'sections.contact_form.success_message' | t }}"
          data-error-message="{{ 'sections.contact_form.error_message' | t }}"
        >
          <div class="form-fields">
            {% for block in section.blocks %}
              {% case block.type %}
                {% when 'field' %}
                  {% assign field_type = block.settings.field_type %}
                  {% assign field_name = block.settings.field_name %}
                  {% assign field_label = block.settings.field_label %}
                  {% assign field_required = block.settings.field_required %}
                  {% assign field_column_span = block.settings.column_span %}

                  <div class="form-field" data-field-type="{{ field_type }}" data-column-span="{{ field_column_span }}">
                    <label for="custom-{{ field_name }}" class="form-label">
                      {{ field_label }}
                      {% if field_required %}<span class="form-required">*</span>{% endif %}
                    </label>

                    {% case field_type %}
                      {% when 'text' %}
                        <input
                          type="text"
                          id="custom-{{ field_name }}"
                          name="{{ field_name }}"
                          class="form-input"
                          {% if field_required %}required{% endif %}
                          placeholder=""
                        />
                      {% when 'email' %}
                        <input
                          type="email"
                          id="custom-{{ field_name }}"
                          name="{{ field_name }}"
                          class="form-input"
                          {% if field_required %}required{% endif %}
                          placeholder=""
                        />
                      {% when 'phone' %}
                        <input
                          type="tel"
                          id="custom-{{ field_name }}"
                          name="{{ field_name }}"
                          class="form-input"
                          {% if field_required %}required{% endif %}
                          placeholder=""
                        />
                    {% endcase %}
                  </div>
              {% endcase %}
            {% endfor %}
          </div>

          <button type="submit" class="contact-form-button">
            {{ section.settings.button_text }}
          </button>
        </form>
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  .contact-form-section {
    background-color: var(--form-bg);
    color: var(--form-text);
    padding: 100px 120px;
    width: 100%;
  }

  .contact-form-container {
    max-width: 100%;
    margin: 0 auto;
  }

  .contact-form-header {
    display: flex;
    flex-direction: column;
    gap: 20px;
    align-items: center;
    text-align: center;
    margin-bottom: 80px;
    width: 100%;
  }

  .contact-form-heading {
    font-size: 72px;
    font-weight: 700;
    letter-spacing: -2.16px;
    margin: 0;
    line-height: 1.2;
  }

  .contact-form-subheading {
    font-size: 24px;
    font-weight: 400;
    line-height: 1.3;
    margin: 0;
  }

  .contact-form-wrapper {
    display: flex;
    flex-direction: column;
    gap: 64px;
  }

  .contact-form-wrapper form {
    display: flex;
    flex-direction: column;
    gap: 64px;
  }

  .form-fields {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    width: 100%;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 10px;
    grid-column: span 1;
    min-width: 0;
  }

  .form-field[data-column-span="2"] {
    grid-column: 1 / -1;
  }

  .form-label {
    display: block;
    font-size: 24px;
    font-weight: 400;
    line-height: 1.2;
    margin: 0;
  }

  .form-input {
    width: 100%;
    border: none;
    border-bottom: 1px solid var(--form-text);
    background: transparent;
    color: var(--form-text);
    font-size: 16px;
    line-height: 1.5;
    padding: 8px 0;
    font-family: inherit;
    outline: none;
    transition: border-color 0.15s ease;
  }

  .form-input::placeholder {
    color: var(--form-text);
    opacity: 0.5;
  }

  .form-input:focus {
    border-bottom-color: var(--form-text);
  }

  .form-errors {
    background-color: #fee;
    border: 1px solid #fcc;
    border-radius: 4px;
    color: #c00;
    margin-bottom: 20px;
    padding: 12px 16px;
    font-size: 14px;
  }

  .contact-form-button {
    background-color: var(--form-button-bg);
    color: var(--form-button-text);
    border: none;
    border-radius: 30px;
    padding: 16px 32px;
    font-size: 20px;
    font-weight: 500;
    line-height: 1.5;
    cursor: pointer;
    transition: opacity 0.15s ease;
    width: 100%;
    height: 58px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .contact-form-button:hover {
    opacity: 0.85;
  }

  .contact-form-button:focus-visible {
    outline: 2px solid var(--form-button-text);
    outline-offset: 2px;
  }

  @media screen and (max-width: 768px) {
    .contact-form-section {
      padding: 60px 20px;
    }

    .contact-form-header {
      margin-bottom: 40px;
    }

    .contact-form-heading {
      font-size: 40px;
      letter-spacing: -1.2px;
    }

    .contact-form-subheading {
      font-size: 16px;
    }

    .contact-form-wrapper {
      gap: 40px;
    }

    .form-fields {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .form-field {
      gap: 16px;
    }

    .form-label {
      font-size: 18px;
    }
  }
{% endstylesheet %}

{% javascript %}
  document.addEventListener('DOMContentLoaded', function() {
    const forms = document.querySelectorAll('.contact-form');

    forms.forEach(form => {
      form.addEventListener('submit', async function(e) {
        e.preventDefault();

        const formData = new FormData(form);
        const endpoint = form.getAttribute('data-form-handler');
        const successMessage = form.getAttribute('data-success-message');
        const errorMessage = form.getAttribute('data-error-message');

        try {
          const response = await fetch(endpoint, {
            method: 'POST',
            body: formData,
            headers: {
              'Accept': 'application/json'
            }
          });

          if (response.ok) {
            form.reset();
            alert(successMessage);
          } else {
            alert(errorMessage);
          }
        } catch (error) {
          console.error('Form submission error:', error);
          alert(errorMessage);
        }
      });
    });
  });
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.contact_form.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Partner with us"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:labels.subheading",
      "default": "Tell us about your venue, store, or event."
    },
    {
      "type": "select",
      "id": "form_type",
      "label": "t:sections.contact_form.form_type",
      "options": [
        { "value": "shopify_contact", "label": "t:sections.contact_form.shopify_form" },
        { "value": "custom", "label": "t:sections.contact_form.custom_form" }
      ],
      "default": "shopify_contact"
    },
    {
      "type": "url",
      "id": "form_endpoint",
      "label": "t:sections.contact_form.form_endpoint",
      "info": "t:sections.contact_form.form_endpoint_info",
      "visible_if": "{{ section.settings.form_type == 'custom' }}"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "t:labels.button_text",
      "default": "Submit inquiry"
    },
    {
      "type": "header",
      "content": "t:general.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.background",
      "default": "#F6F1EC"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:labels.text_color",
      "default": "#212323"
    },
    {
      "type": "color",
      "id": "button_background_color",
      "label": "t:labels.button_background",
      "default": "#212323"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "t:labels.button_text_color",
      "default": "#F6F1EC"
    }
  ],
  "blocks": [
    {
      "type": "field",
      "name": "t:sections.contact_form.field",
      "settings": [
        {
          "type": "text",
          "id": "field_label",
          "label": "t:labels.field_label",
          "default": "Field Name"
        },
        {
          "type": "text",
          "id": "field_name",
          "label": "t:sections.contact_form.field_name",
          "default": "field",
          "info": "t:sections.contact_form.field_name_info"
        },
        {
          "type": "select",
          "id": "field_type",
          "label": "t:labels.field_type",
          "options": [
            { "value": "text", "label": "t:sections.contact_form.field_type_text" },
            { "value": "email", "label": "t:sections.contact_form.field_type_email" },
            { "value": "phone", "label": "t:sections.contact_form.field_type_phone" }
          ],
          "default": "text"
        },
        {
          "type": "checkbox",
          "id": "field_required",
          "label": "t:sections.contact_form.field_required",
          "default": false
        },
        {
          "type": "select",
          "id": "column_span",
          "label": "t:sections.contact_form.column_span",
          "options": [
            { "value": "1", "label": "t:sections.contact_form.column_span_half" },
            { "value": "2", "label": "t:sections.contact_form.column_span_full" }
          ],
          "default": "1"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.contact_form.name",
      "blocks": [
        { "type": "field", "settings": { "field_label": "Name", "field_name": "name", "field_type": "text", "field_required": true } },
        { "type": "field", "settings": { "field_label": "Email", "field_name": "email", "field_type": "email", "field_required": true } },
        { "type": "field", "settings": { "field_label": "Business name", "field_name": "business_name", "field_type": "text" } },
        { "type": "field", "settings": { "field_label": "Phone number", "field_name": "phone", "field_type": "phone" } },
        { "type": "field", "settings": { "field_label": "Business type", "field_name": "business_type", "field_type": "text", "column_span": "2" } },
        { "type": "field", "settings": { "field_label": "City", "field_name": "city", "field_type": "text" } },
        { "type": "field", "settings": { "field_label": "Message", "field_name": "message", "field_type": "text" } },
        { "type": "field", "settings": { "field_label": "Country", "field_name": "country", "field_type": "text" } },
        { "type": "field", "settings": { "field_label": "Website (Leave Blank If N/A)", "field_name": "website", "field_type": "text" } },
        { "type": "field", "settings": { "field_label": "Number of locations", "field_name": "locations", "field_type": "text" } },
        { "type": "field", "settings": { "field_label": "EIN", "field_name": "ein", "field_type": "text" } }
      ]
    }
  ]
}
{% endschema %}
