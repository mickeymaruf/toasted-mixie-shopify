      "id": "disclaimer",
      "label": "Disclaimer text",
      "default": "<p>By entering this site you are agreeing to the <a href=\"/pages/terms-of-service\">Terms of Service</a> and <a href=\"/pages/privacy-policy\">Privacy Policy</a>.</p>",
      "info": "Link any text to your store's actual policy pages."
    },
    {
      "type": "header",
      "content": "t:general.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.background_color",
      "default": "#F6F1EC"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "t:labels.text_color",
      "default": "#212323"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Secondary text color",
      "default": "#626262"
    },
    {
      "type": "color",
      "id": "button_border_color",
      "label": "Button border color",
      "default": "#212323"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "t:labels.button_text_color",
      "default": "#212323"
    },
    {
      "type": "header",
      "content": "Right side image (synced from Gruns Hero)"
    },
    {
      "type": "color",
      "id": "cans_background_color",
      "label": "t:labels.background_color",
      "default": "#F9D5C0"
    },
    {
      "type": "image_picker",
      "id": "cans_background_image",
      "label": "t:labels.background_image"
    },
    {
      "type": "image_picker",
      "id": "can_image_1",
      "label": "t:labels.can_image_1"
    },
    {
      "type": "image_picker",
      "id": "can_image_2",
      "label": "t:labels.can_image_2"
    },
    {
      "type": "image_picker",
      "id": "can_image_3",
      "label": "t:labels.can_image_3"
    }
  ]
