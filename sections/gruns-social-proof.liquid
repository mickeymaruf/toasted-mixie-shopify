{% doc %}
  Renders a social-proof banner: a star-rating strip with review/member
  counts, a large heading and description, a CTA button, and a single
  product collage image on the right.
{% enddoc %}


<section
  class="gruns-social-proof full-width overflow-hidden relative"
  style="background-color: {{ section.settings.background_color }}; border-color: {{ section.settings.heading_color }};"
>
  {% if section.settings.background_image %}
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      {{
        section.settings.background_image
        | image_url: width: section.settings.background_image.width
        | image_tag: class: 'absolute inset-0 w-full h-full object-cover object-right-bottom', alt: ''
      }}
    </div>
  {% endif %}
  <div
    class="relative z-10 mx-auto flex w-full max-w-[1200px] flex-col items-center gap-10 px-4 pt-10 sm:px-6 sm:pt-12 md:px-10 lg:flex-row lg:items-end lg:justify-start lg:gap-[110px] lg:px-[60px] lg:pt-[50px] xl:px-0"
  >
    <div
      class="flex w-full flex-col items-start gap-5 pb-10 text-left sm:pb-12 lg:w-[456px] lg:shrink-0 lg:pb-[51px]"
      style="color: {{ section.settings.heading_color }};"
    >
      {% if section.settings.show_rating_section %}
        <div class="flex flex-wrap items-center gap-x-1.5 gap-y-1 sm:gap-x-[10px] sm:gap-y-2">
          {% if section.settings.star_count > 0 %}
            <div class="flex items-center gap-px sm:gap-[2px]">
              {% for i in (1..5) %}
                <span class="block size-3.5 sm:size-[18px] {% unless i <= section.settings.star_count %}opacity-20{% endunless %}" aria-hidden="true">
                  <img
                    src="{{ 'icon-star-social-proof.svg' | asset_url }}"
                    alt=""
                    width="20"
                    height="19"
                    class="size-full"
                  >
                </span>
              {% endfor %}
            </div>
          {% endif %}
          {% if section.settings.rating_text != blank %}
            <div class="text-[14px] leading-none sm:text-[20px] sm:leading-[1.5]">
              {{ section.settings.rating_text }}
            </div>
          {% endif %}
        </div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <div
          class="font-[family-name:var(--font-heading--family)] text-[40px] leading-[0.95] font-bold sm:text-[48px] md:text-[60px] lg:text-[70px] xl:text-[72px] xl:tracking-[-2.16px] {% if section.settings.heading_mobile != blank %}hidden sm:block{% endif %}"
        >
          {{ section.settings.heading }}
        </div>
      {% endif %}

      {% if section.settings.heading_mobile != blank %}
        <div class="block font-[family-name:var(--font-heading--family)] text-[40px] leading-[0.95] font-bold sm:hidden">
          {{ section.settings.heading_mobile }}
        </div>
      {% endif %}

      {% if section.settings.description != blank %}
        <div
          class="text-[18px] leading-[1.5] sm:text-[20px] lg:text-[24px] {% if section.settings.mobile_description != blank %}hidden sm:block{% endif %}"
        >
          {{ section.settings.description }}
        </div>
      {% endif %}

      {% if section.settings.mobile_description != blank %}
        <div class="block text-[18px] leading-[1.5] sm:hidden">
          {{ section.settings.mobile_description }}
        </div>
      {% endif %}

      {% if section.settings.show_button and section.settings.button_label != blank %}
        {% render 'button',
          label: section.settings.button_label,
          url: section.settings.button_link,
          background_color: section.settings.button_background_color,
          text_color: section.settings.button_text_color,
          class: '!w-auto whitespace-nowrap'
        %}
      {% endif %}
    </div>

    {% if section.settings.image %}
      <div class="relative mx-auto w-full lg:mx-0 lg:w-[629px] lg:shrink-0">
        {{
          section.settings.image
          | image_url: width: 1200
          | image_tag:
            class: 'w-full h-auto object-contain',
            widths: '400, 700, 1000, 1200',
            alt: section.settings.image_alt
          | default: section.settings.image.alt
        }}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "t:general.social_proof",
  "settings": [
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "checkbox",
      "id": "show_rating_section",
      "label": "t:labels.show_rating_section",
      "default": true
    },
    {
      "type": "range",
      "id": "star_count",
      "label": "t:labels.star_count",
      "min": 0,
      "max": 5,
      "step": 1,
      "default": 5,
      "visible_if": "{{ section.settings.show_rating_section }}"
    },
    {
      "type": "richtext",
      "id": "rating_text",
      "label": "t:labels.rating_text",
      "default": "<p><strong>4.8</strong> Rating<br><strong>100,000</strong> Reviews<br><strong>1,000,000+</strong> Members</p>",
      "visible_if": "{{ section.settings.show_rating_section }}"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "<p>See what all the hype is about.</p>"
    },
    {
      "type": "richtext",
      "id": "heading_mobile",
      "label": "t:labels.heading_mobile",
      "info": "t:labels.heading_mobile_info"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:labels.description",
      "default": "<p>We regularly test for all 20+ vitamins & minerals to ensure claims are accurate & clear of contaminants including:</p>"
    },
    {
      "type": "richtext",
      "id": "mobile_description",
      "label": "t:labels.mobile_description",
      "info": "t:labels.mobile_description_info"
    },
    {
      "type": "header",
      "content": "t:general.button"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "t:labels.show_button",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label",
      "default": "Shop Now",
      "visible_if": "{{ section.settings.show_button }}"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:labels.button_link",
      "visible_if": "{{ section.settings.show_button }}"
    },
    {
      "type": "color",
      "id": "button_background_color",
      "label": "t:labels.button_background",
      "default": "#F9D5C0",
      "visible_if": "{{ section.settings.show_button }}"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "t:labels.button_text_color",
      "default": "#212323",
      "visible_if": "{{ section.settings.show_button }}"
    },
    {
      "type": "header",
      "content": "t:general.image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "t:labels.alt_text"
    },
    {
      "type": "header",
      "content": "t:general.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.background",
      "default": "#551F36"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:labels.background_image"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "t:labels.text_color",
      "default": "#F6F1EC"
    }
  ],
  "presets": [
    {
      "name": "t:general.social_proof"
    }
  ]
}
{% endschema %}
