<div class="testimonials-section px-[50px] py-[50px] md:p-[80px] lg:px-[120px] lg:py-[100px]">
  {%- capture heading_prefix -%}
    {{ section.settings.heading_prefix }}
  {%- endcapture -%}

  <div class="flex flex-col gap-12 w-full">
    <!-- Heading -->
    <div class="text-center">
      <h1 class="text-[72px] font-bold leading-tight tracking-[-2.16px] text-[#212323]">
        <span>{{ heading_prefix }}</span>
        <em class="italic">{{ section.settings.heading_suffix }}</em>
      </h1>
    </div>

    <!-- Testimonial Container -->
    {%- if section.settings.show_testimonial -%}
      <div class="border-t border-b border-[#212323] flex flex-col lg:flex-row gap-10 items-start lg:items-center py-8">
        <!-- User Profile Card -->
        <div class="bg-[#c2cbd4] rounded-2xl p-6 shrink-0 w-full lg:w-auto">
          <div class="flex gap-5 items-center">
            <!-- Avatar -->
            <div class="w-10 h-10 rounded-full bg-[#9ca8b5] flex items-center justify-center shrink-0">
              {% if section.settings.avatar_image %}
                {{ section.settings.avatar_image | image_url: width: 40, height: 40 | image_tag: class: 'w-full h-full rounded-full object-cover' }}
              {% else %}
                <svg class="w-6 h-6 text-[#666]" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                </svg>
              {% endif %}
            </div>

            <!-- Profile Info -->
            <div class="flex flex-col gap-1">
              <p class="text-[12px] font-['Neue_Haas_Grotesk_Display_Pro'] text-[#212323]">
                {{ section.settings.reviewer_name }}
              </p>
              <div class="flex items-center gap-1.5">
                <span class="text-[14px] font-['Neue_Haas_Grotesk_Display_Pro'] font-medium text-[#212323]">
                  {{ section.settings.reviewer_title }}
                </span>
                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"/>
                </svg>
              </div>
            </div>
          </div>
        </div>

        <!-- Review Content -->
        <div class="flex flex-col gap-1.5 flex-1">
          <!-- Star Rating -->
          <div class="flex gap-0.5">
            {%- for i in (1..5) -%}
              <svg class="w-5 h-5 {% if i <= section.settings.rating %}text-[#D4941F]{% else %}text-[#e0e0e0]{% endif %}" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2l-2.81 6.63L2 9.24l5.46 4.73L5.82 21 12 17.27z"/>
              </svg>
            {%- endfor -%}
          </div>

          <!-- Testimonial Text -->
          <div class="flex flex-col gap-2">
            <p class="text-[14px] font-['Neue_Haas_Grotesk_Display_Pro'] font-medium text-[#212323]">
              {{ section.settings.testimonial_title }}
            </p>
            <p class="text-[16px] font-['Neue_Haas_Grotesk_Display_Pro'] text-[#212323]">
              {{ section.settings.testimonial_text }}
            </p>
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Testimonials Coming Soon",
  "settings": [
    {
      "type": "text",
      "id": "heading_prefix",
      "label": "Heading prefix",
      "default": "First comments"
    },
    {
      "type": "text",
      "id": "heading_suffix",
      "label": "Heading suffix (italic)",
      "default": "coming soon."
    },
    {
      "type": "checkbox",
      "id": "show_testimonial",
      "label": "Show testimonial card",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "avatar_image",
      "label": "Avatar image"
    },
    {
      "type": "text",
      "id": "reviewer_name",
      "label": "Reviewer name",
      "default": "Toasted"
    },
    {
      "type": "text",
      "id": "reviewer_title",
      "label": "Reviewer title",
      "default": "Verified Buyer"
    },
    {
      "type": "range",
      "id": "rating",
      "min": 0,
      "max": 5,
      "step": 1,
      "label": "Star rating",
      "default": 5
    },
    {
      "type": "text",
      "id": "testimonial_title",
      "label": "Testimonial title",
      "default": "First Toasted reviews coming soon."
    },
    {
      "type": "text",
      "id": "testimonial_text",
      "label": "Testimonial text",
      "default": "Reviews open after first drop. Be one of the first to try Toasted."
    }
  ],
  "presets": [
    {
      "name": "Testimonials Coming Soon"
    }
  ]
}
{% endschema %}
