{% doc %}
  Renders "First Drops. Good Moments." — a heading and an infinite scrolling 
  Swiper carousel of gallery-image blocks, with previous/next controls 
  and 2 items per view on mobile.
{% enddoc %}

{{ 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css' | stylesheet_tag }}

<section
  class="gruns-gallery full-width"
  style="background-color: {{ section.settings.background_color }};"
>
  <div class="mx-auto flex w-full max-w-[1920px] flex-col items-center gap-8 pt-[40px] pb-[60px] sm:py-[60px] lg:gap-[60px] lg:py-[100px] xl:pb-[150px] lg:px-[120px]">
    {% if section.settings.heading != blank %}
      <div
        class="max-w-4xl text-center text-[36px] leading-[0.95] font-bold text-[color:var(--gruns-gallery-heading-color)] px-5 sm:text-[44px] md:text-[56px] lg:text-[64px] xl:text-[72px]"
        style="--gruns-gallery-heading-color: {{ section.settings.heading_color }};"
      >
        {{ section.settings.heading }}
      </div>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <gruns-gallery-carousel class="relative flex w-full items-center gap-1 sm:gap-4">
        {% comment %}
          <button
            type="button"
            class="hidden sm:flex size-[48px] shrink-0 items-center justify-center text-[#212323] disabled:opacity-30 z-10 cursor-pointer"
            data-gallery-prev
            aria-label="{{ 'general.accessibility.previous_slide' | t }}"
          >
            <span class="block size-[28px]">{{ 'icon-chevron-left.svg' | inline_asset_content }}</span>
          </button>
        {% endcomment %}

        <div class="swiper gruns-gallery__swiper flex-1 overflow-hidden min-w-0">
          <div class="swiper-wrapper gruns-gallery__track">
            {%- for block in section.blocks -%}
              <div class="swiper-slide h-auto" {{ block.shopify_attributes }}>
                {% render block %}
              </div>
            {%- endfor -%}
          </div>
        </div>

        {% comment %}
          <button
            type="button"
            class="hidden sm:flex size-[48px] shrink-0 items-center justify-center text-[#212323] disabled:opacity-30 z-10 cursor-pointer"
            data-gallery-next
            aria-label="{{ 'general.accessibility.next_slide' | t }}"
          >
            <span class="block size-[28px]">{{ 'icon-chevron-right.svg' | inline_asset_content }}</span>
          </button>
        {% endcomment %}
      </gruns-gallery-carousel>
    {% endif %}
  </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" defer="defer"></script>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const initSwiper = () => {
      const carouselEl = document.querySelector('gruns-gallery-carousel');
      if (!carouselEl || typeof Swiper === 'undefined') return;

      const prevEl = carouselEl.querySelector('[data-gallery-prev]');
      const nextEl = carouselEl.querySelector('[data-gallery-next]');

      new Swiper(carouselEl.querySelector('.swiper'), {
        slidesPerView: 1.8,
        loop: true,
        grabCursor: true,
        {% comment %} navigation: {
          prevEl: prevEl,
          nextEl: nextEl,
        }, {% endcomment %}
        autoplay: {
          delay: 3000,
          disableOnInteraction: false,
        },
        breakpoints: {
          425: {
            slidesPerView: 2.5,
          },
          640: {
            slidesPerView: 4,
          },
          1024: {
            slidesPerView: 4,
          },
          1280: {
            slidesPerView: 5,
          },
        },
      });
    };

    initSwiper();

    // Support Shopify Theme Editor re-initialization
    document.addEventListener('shopify:section:load', initSwiper);
  });
</script>

{% stylesheet %}
  .gruns-gallery__track {
    box-sizing: border-box;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.gruns_gallery",
  "blocks": [{ "type": "gallery-image" }],
  "settings": [
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "<p>First drops. Good moments. <em>@drinktoasted</em></p>"
    },
    {
      "type": "header",
      "content": "t:general.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.background",
      "default": "#F6F1EC"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "t:labels.text_color",
      "default": "#212323"
    }
  ],
  "presets": [
    {
      "name": "t:general.gruns_gallery"
    }
  ]
}
{% endschema %}
