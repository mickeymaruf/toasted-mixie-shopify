{% doc %}
  Renders "First Drops. Good Moments." — a heading and an infinite scrolling 
  Swiper carousel of gallery-image blocks, with previous/next controls 
  and 2 items per view on mobile.
{% enddoc %}

<section
  class="gruns-gallery full-width relative overflow-hidden"
  style="background-color: {{ section.settings.background_color }};"
>
  {% if section.settings.background_image %}
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute inset-0 bg-[color:var(--gruns-gallery-overlay-color)]" style="--gruns-gallery-overlay-color: {{ section.settings.background_color }};"></div>
      {{ section.settings.background_image | image_url: width: 1920 | image_tag: class: 'absolute inset-0 w-full h-full object-bottom opacity-8' }}
      <div class="absolute inset-0" style="background: linear-gradient(to bottom, {{ section.settings.background_color }} 9%, transparent 99%);"></div>
    </div>
  {% endif %}
  <div class="relative z-10 mx-auto flex w-full max-w-[1920px] flex-col items-center gap-8 pt-[40px] pb-[60px] sm:py-[60px] lg:gap-[60px] lg:py-[100px] xl:pb-[100px] lg:px-[120px]">
    {% if section.settings.heading != blank %}
      <div
        class="order-1 max-w-4xl text-center text-[36px] leading-[0.95] font-bold text-[color:var(--gruns-gallery-heading-color)] px-5 sm:order-none sm:text-[44px] md:text-[56px] lg:text-[64px] xl:text-[72px]"
        style="--gruns-gallery-heading-color: {{ section.settings.heading_color }};"
      >
        {{ section.settings.heading }}
      </div>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <gruns-gallery-carousel class="order-3 relative flex w-full items-center gap-1 sm:order-none sm:gap-4">
        {% comment %}
          <button
            type="button"
            class="hidden sm:flex size-[48px] shrink-0 items-center justify-center text-[#212323] disabled:opacity-30 z-10 cursor-pointer"
            data-gallery-prev
            aria-label="{{ 'general.accessibility.previous_slide' | t }}"
          >
            <span class="block size-[28px]">{{ 'icon-chevron-left.svg' | inline_asset_content }}</span>
          </button>
        {% endcomment %}

        <div class="swiper gruns-gallery__swiper flex-1 overflow-hidden min-w-0">
          <div class="swiper-wrapper gruns-gallery__track">
            {%- for block in section.blocks -%}
              <div class="swiper-slide h-auto" {{ block.shopify_attributes }}>
                {% render block %}
              </div>
            {%- endfor -%}
          </div>
        </div>

        {% comment %}
          <button
            type="button"
            class="hidden sm:flex size-[48px] shrink-0 items-center justify-center text-[#212323] disabled:opacity-30 z-10 cursor-pointer"
            data-gallery-next
            aria-label="{{ 'general.accessibility.next_slide' | t }}"
          >
            <span class="block size-[28px]">{{ 'icon-chevron-right.svg' | inline_asset_content }}</span>
          </button>
        {% endcomment %}
      </gruns-gallery-carousel>
    {% endif %}

    {% if section.settings.social_icon_1_image or section.settings.social_icon_2_image or section.settings.social_icon_3_image %}
      <div class="order-2 flex items-center justify-center gap-[18px] sm:order-none">
        {% if section.settings.social_icon_1_image and section.settings.social_icon_1_link != blank %}
          <a
            href="{{ section.settings.social_icon_1_link }}"
            class="shrink-0 transition-opacity duration-150 hover:opacity-85"
          >
            {{
              section.settings.social_icon_1_image
              | image_url: width: 100
              | image_tag: class: 'size-9 object-contain sm:size-[60px]', alt: section.settings.social_icon_1_image.alt
            }}
          </a>
        {% endif %}

        {% if section.settings.social_icon_2_image and section.settings.social_icon_2_link != blank %}
          <a
            href="{{ section.settings.social_icon_2_link }}"
            class="shrink-0 transition-opacity duration-150 hover:opacity-85"
          >
            {{
              section.settings.social_icon_2_image
              | image_url: width: 100
              | image_tag: class: 'size-9 object-contain sm:size-[60px]', alt: section.settings.social_icon_2_image.alt
            }}
          </a>
        {% endif %}

        {% if section.settings.social_icon_3_image and section.settings.social_icon_3_link != blank %}
          <a
            href="{{ section.settings.social_icon_3_link }}"
            class="shrink-0 transition-opacity duration-150 hover:opacity-85"
          >
            {{
              section.settings.social_icon_3_image
              | image_url: width: 100
              | image_tag: class: 'size-9 object-contain sm:size-[60px]', alt: section.settings.social_icon_3_image.alt
            }}
          </a>
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const initSwiper = () => {
      const carouselEl = document.querySelector('gruns-gallery-carousel');
      if (!carouselEl || typeof Swiper === 'undefined') return;

      const prevEl = carouselEl.querySelector('[data-gallery-prev]');
      const nextEl = carouselEl.querySelector('[data-gallery-next]');

      new Swiper(carouselEl.querySelector('.swiper'), {
        slidesPerView: 1.8,
        loop: true,
        grabCursor: true,
        {% comment %} navigation: {
          prevEl: prevEl,
          nextEl: nextEl,
        }, {% endcomment %}
        autoplay: {
          delay: 3000,
          disableOnInteraction: false,
        },
        breakpoints: {
          425: {
            slidesPerView: 2.5,
          },
          640: {
            slidesPerView: 4,
          },
          1024: {
            slidesPerView: 4,
          },
          1280: {
            slidesPerView: 5,
          },
        },
      });
    };

    initSwiper();

    // Support Shopify Theme Editor re-initialization
    document.addEventListener('shopify:section:load', initSwiper);
  });
</script>

{% stylesheet %}
  .gruns-gallery__track {
    box-sizing: border-box;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.gruns_gallery",
  "blocks": [{ "type": "gallery-image" }],
  "settings": [
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "<p>First drops. Good moments. <em>@drinktoasted</em></p>"
    },
    {
      "type": "header",
      "content": "t:general.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.background",
      "default": "#F6F1EC"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:labels.background_image"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "t:labels.text_color",
      "default": "#212323"
    },
    {
      "type": "header",
      "content": "t:general.social_icons"
    },
    {
      "type": "image_picker",
      "id": "social_icon_1_image",
      "label": "t:labels.social_icon_1"
    },
    {
      "type": "url",
      "id": "social_icon_1_link",
      "label": "t:labels.link",
      "info": "t:labels.social_link_info"
    },
    {
      "type": "image_picker",
      "id": "social_icon_2_image",
      "label": "t:labels.social_icon_2"
    },
    {
      "type": "url",
      "id": "social_icon_2_link",
      "label": "t:labels.link",
      "info": "t:labels.social_link_info"
    },
    {
      "type": "image_picker",
      "id": "social_icon_3_image",
      "label": "t:labels.social_icon_3"
    },
    {
      "type": "url",
      "id": "social_icon_3_link",
      "label": "t:labels.link",
      "info": "t:labels.social_link_info"
    }
  ],
  "presets": [
    {
      "name": "t:general.gruns_gallery",
      "blocks": [
        {
          "type": "gallery-image",
          "settings": {
            "placeholder_text": "Image coming soon"
          }
        },
        {
          "type": "gallery-image",
          "settings": {
            "placeholder_text": "Image coming soon"
          }
        }
      ]
    }
  ]
}
{% endschema %}
