{% doc %}
  Renders "Drops, Events & Good moments. @drinktoasted" — a heading and an
  infinite scrolling Swiper carousel of gallery-image and gallery-video
  blocks, with previous/next controls and 2 items per view on mobile.
{% enddoc %}

<section
  class="gruns-gallery full-width relative overflow-hidden"
  style="background-color: {{ section.settings.background_color }};"
>
  {% if section.settings.background_image %}
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute inset-0 bg-[color:var(--gruns-gallery-overlay-color)]" style="--gruns-gallery-overlay-color: {{ section.settings.background_color }};"></div>
      {{ section.settings.background_image | image_url: width: 1920 | image_tag: class: 'absolute inset-0 w-full h-full object-bottom opacity-8', style: 'filter: saturate(0);' }}
      <div class="absolute inset-0" style="background: linear-gradient(to bottom, {{ section.settings.background_color }} 9%, transparent 99%);"></div>
    </div>
  {% endif %}
  <div class="relative z-10 mx-auto flex w-full max-w-[1920px] flex-col items-center gap-8 pt-[40px] pb-[60px] sm:py-[60px] lg:gap-[60px] lg:py-[100px] xl:pb-[100px] lg:px-[120px]">
    {% if section.settings.heading_mobile != blank %}
      <div
        class="section-heading font-[family-name:var(--font-heading--family)] order-1 mx-auto max-w-[305px] min-[470px]:max-w-[460px] text-center text-[color:var(--gruns-gallery-heading-color)] px-5 sm:hidden"
        style="--gruns-gallery-heading-color: {{ section.settings.heading_color }};"
      >
        {{ section.settings.heading_mobile }}
      </div>
    {% endif %}

    {% if section.settings.heading != blank %}
      <div
        class="section-heading font-[family-name:var(--font-heading--family)] order-1 max-w-none text-center text-[color:var(--gruns-gallery-heading-color)] px-5 sm:order-none md:whitespace-nowrap {% if section.settings.heading_mobile != blank %}hidden sm:block{% endif %}"
        style="--gruns-gallery-heading-color: {{ section.settings.heading_color }};"
      >
        {{ section.settings.heading }}
      </div>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <gruns-gallery-carousel
        class="order-3 relative flex w-full items-center gap-1 sm:order-none sm:gap-4"
        data-autoplay="{{ section.settings.enable_autoplay }}"
      >
        {% if section.settings.show_navigation %}
          <button
            type="button"
            class="gruns-gallery__nav-button gruns-gallery__nav-button--prev hidden size-[48px] shrink-0 items-center justify-center text-[#212323] disabled:opacity-30 lg:flex"
            data-gallery-prev
            aria-label="{{ 'general.accessibility.previous_slide' | t }}"
          >
            <span class="block size-[28px]" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 14 8" fill="none" aria-hidden="true" focusable="false">
                <path stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" d="M1 1L7 7L13 1"></path>
              </svg>
            </span>
          </button>
        {% endif %}

        <div class="swiper gruns-gallery__swiper flex-1 overflow-hidden min-w-0">
          <div class="swiper-wrapper gruns-gallery__track">
            {%- for block in section.blocks -%}
              <div class="swiper-slide h-auto" {{ block.shopify_attributes }}>
                {% render block %}
              </div>
            {%- endfor -%}
          </div>
        </div>

        {% if section.settings.show_navigation %}
          <button
            type="button"
            class="gruns-gallery__nav-button gruns-gallery__nav-button--next hidden size-[48px] shrink-0 items-center justify-center text-[#212323] disabled:opacity-30 lg:flex"
            data-gallery-next
            aria-label="{{ 'general.accessibility.next_slide' | t }}"
          >
            <span class="block size-[28px]" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 14 8" fill="none" aria-hidden="true" focusable="false">
                <path stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" d="M1 1L7 7L13 1"></path>
              </svg>
            </span>
          </button>
        {% endif %}
      </gruns-gallery-carousel>
    {% endif %}

    {% if section.settings.social_icon_1_image or section.settings.social_icon_2_image or section.settings.social_icon_3_image %}
      <div class="order-2 flex items-center justify-center gap-[18px] sm:order-none xl:gap-[15px]">
        {% if section.settings.social_icon_1_image and section.settings.social_icon_1_link != blank %}
          <a
            href="{{ section.settings.social_icon_1_link }}"
            class="shrink-0 transition-opacity duration-150 hover:opacity-85"
          >
            {{
              section.settings.social_icon_1_image
              | image_url: width: 100
              | image_tag: class: 'size-[50px] object-contain sm:size-[60px] xl:size-[76px]', alt: section.settings.social_icon_1_image.alt
            }}
          </a>
        {% endif %}

        {% if section.settings.social_icon_2_image and section.settings.social_icon_2_link != blank %}
          <a
            href="{{ section.settings.social_icon_2_link }}"
            class="shrink-0 transition-opacity duration-150 hover:opacity-85"
          >
            {{
              section.settings.social_icon_2_image
              | image_url: width: 100
              | image_tag: class: 'size-[50px] object-contain sm:size-[60px] xl:size-[76px]', alt: section.settings.social_icon_2_image.alt
            }}
          </a>
        {% endif %}

        {% if section.settings.social_icon_3_image and section.settings.social_icon_3_link != blank %}
          <a
            href="{{ section.settings.social_icon_3_link }}"
            class="shrink-0 transition-opacity duration-150 hover:opacity-85"
          >
            {{
              section.settings.social_icon_3_image
              | image_url: width: 100
              | image_tag: class: 'size-[50px] object-contain sm:size-[60px] xl:size-[76px]', alt: section.settings.social_icon_3_image.alt
            }}
          </a>
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const initSwiper = (carouselEl) => {
      if (!carouselEl || carouselEl.swiper || typeof Swiper === 'undefined') return;

      const prevEl = carouselEl.querySelector('[data-gallery-prev]');
      const nextEl = carouselEl.querySelector('[data-gallery-next]');
      const autoplayEnabled = carouselEl.dataset.autoplay === 'true';

      const swiperOptions = {
        slidesPerView: 1.8,
        loop: true,
        grabCursor: true,
        autoplay: autoplayEnabled
          ? {
              delay: 3000,
              disableOnInteraction: false,
            }
          : false,
        breakpoints: {
          425: {
            slidesPerView: 2.5,
          },
          640: {
            slidesPerView: 4,
          },
          1024: {
            slidesPerView: 4,
          },
          1280: {
            slidesPerView: 5,
          },
        },
      };

      if (prevEl && nextEl) {
        swiperOptions.navigation = {
          prevEl: prevEl,
          nextEl: nextEl,
        };
      }

      new Swiper(carouselEl.querySelector('.swiper'), swiperOptions);
    };

    const initAllSwipers = () => {
      document.querySelectorAll('gruns-gallery-carousel').forEach((carouselEl) => initSwiper(carouselEl));
    };

    initAllSwipers();

    // Support Shopify Theme Editor re-initialization
    document.addEventListener('shopify:section:load', initAllSwipers);
  });
</script>

{% stylesheet %}
  .gruns-gallery__track {
    box-sizing: border-box;
  }

  .gruns-gallery__nav-button {
    color: #212323;
    cursor: pointer;
    transition:
      opacity 150ms ease,
      transform 150ms ease;
  }

  .gruns-gallery__nav-button:hover {
    opacity: 0.75;
  }

  .gruns-gallery__nav-button--prev svg {
    transform: rotate(90deg);
  }

  .gruns-gallery__nav-button--next svg {
    transform: rotate(-90deg);
  }

{% endstylesheet %}

{% schema %}
{
  "name": "t:general.gruns_gallery",
  "blocks": [{ "type": "gallery-image" }, { "type": "gallery-video" }],
  "settings": [
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "<p>Drops, Events &amp; Good moments.</p><p><em>@drinktoasted</em></p>"
    },
    {
      "type": "richtext",
      "id": "heading_mobile",
      "label": "t:labels.heading_mobile",
      "info": "t:labels.heading_mobile_info"
    },
    {
      "type": "checkbox",
      "id": "enable_slide_border",
      "label": "t:labels.enable_slide_border",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_autoplay",
      "label": "t:labels.enable_autoplay",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_navigation",
      "label": "Show navigation arrows",
      "default": true
    },
    {
      "type": "header",
      "content": "t:general.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.background",
      "default": "#F6F1EC"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:labels.background_image"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "t:labels.text_color",
      "default": "#212323"
    },
    {
      "type": "header",
      "content": "t:general.social_icons"
    },
    {
      "type": "image_picker",
      "id": "social_icon_1_image",
      "label": "t:labels.social_icon_1"
    },
    {
      "type": "url",
      "id": "social_icon_1_link",
      "label": "t:labels.link",
      "info": "t:labels.social_link_info"
    },
    {
      "type": "image_picker",
      "id": "social_icon_2_image",
      "label": "t:labels.social_icon_2"
    },
    {
      "type": "url",
      "id": "social_icon_2_link",
      "label": "t:labels.link",
      "info": "t:labels.social_link_info"
    },
    {
      "type": "image_picker",
      "id": "social_icon_3_image",
      "label": "t:labels.social_icon_3"
    },
    {
      "type": "url",
      "id": "social_icon_3_link",
      "label": "t:labels.link",
      "info": "t:labels.social_link_info"
    }
  ],
  "presets": [
    {
      "name": "t:general.gruns_gallery",
      "blocks": [
        {
          "type": "gallery-image",
          "settings": {
            "placeholder_text": "Image coming soon"
          }
        },
        {
          "type": "gallery-image",
          "settings": {
            "placeholder_text": "Image coming soon"
          }
        }
      ]
    }
  ]
}
{% endschema %}
