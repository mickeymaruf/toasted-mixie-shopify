{% doc %}
  Renders "Find Toasted" — a centered heading, subtext and CTA button
  surrounded by three polaroid-style photos (already rotated in the source
  images) arranged as a collage. On smaller screens the collage collapses
  into a simple photo strip below the text.
{% enddoc %}

<section
  class="gruns-collage-callout full-width overflow-x-hidden"
  style="background-color: {{ section.settings.background_color }};"
>
  <div
    class="mx-auto w-full max-w-[1920px] px-5 sm:px-8 md:px-12 lg:px-[80px] xl:px-[120px]"
    style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
  >
    <div class="relative hidden w-full lg:block" style="aspect-ratio: 1120.47 / 683.49;">
      {% if section.settings.photo_1 %}
        {{
          section.settings.photo_1
          | image_url: width: 800
          | image_tag:
            class: 'absolute aspect-square object-cover',
            style: 'left: 1.27%; top: 1.47%; width: 27.97%;',
            alt: section.settings.photo_1_alt
          | default: section.settings.photo_1.alt
        }}
      {% endif %}

      {% if section.settings.photo_2 %}
        {{
          section.settings.photo_2
          | image_url: width: 800
          | image_tag:
            class: 'absolute aspect-square object-cover',
            style: 'left: -5.78%; top: 42.15%; width: 32.6%;',
            alt: section.settings.photo_2_alt
          | default: section.settings.photo_2.alt
        }}
      {% endif %}

      {% if section.settings.photo_3 %}
        {{
          section.settings.photo_3
          | image_url: width: 800
          | image_tag:
            class: 'absolute aspect-square object-cover',
            style: 'left: 65.08%; top: 14.35%; width: 43.6%;',
            alt: section.settings.photo_3_alt
          | default: section.settings.photo_3.alt
        }}
      {% endif %}

      <div class="absolute top-1/2 left-1/2 flex w-[42%] max-w-[477px] -translate-x-1/2 -translate-y-1/2 flex-col items-center gap-[50px] text-center">
        {% if section.settings.heading != blank or section.settings.subtext != blank %}
          <div
            class="flex w-full flex-col gap-[10px] text-[color:var(--gruns-collage-callout-heading-color)]"
            style="--gruns-collage-callout-heading-color: {{ section.settings.heading_color }};"
          >
            {% if section.settings.heading != blank %}
              <h2 class="text-[64px] leading-[0.95] font-bold tracking-[-1.9px] xl:text-[72px] xl:tracking-[-2.16px]">
                {{ section.settings.heading }}
              </h2>
            {% endif %}

            {% if section.settings.subtext != blank %}
              <p class="text-[20px] leading-[1.5] xl:text-[24px]">
                {{ section.settings.subtext }}
              </p>
            {% endif %}
          </div>
        {% endif %}

        {% if section.settings.show_button and section.settings.button_label != blank %}
          {% render 'button',
            label: section.settings.button_label,
            url: section.settings.button_link,
            background_color: section.settings.button_background_color,
            text_color: section.settings.button_text_color,
            class: 'w-auto whitespace-nowrap'
          %}
        {% endif %}
      </div>
    </div>

    <div class="flex flex-col items-center gap-8 text-center lg:hidden">
      {% if section.settings.heading != blank or section.settings.subtext != blank %}
        <div
          class="flex w-full flex-col gap-[10px] text-[color:var(--gruns-collage-callout-heading-color)]"
          style="--gruns-collage-callout-heading-color: {{ section.settings.heading_color }};"
        >
          {% if section.settings.heading != blank %}
            <h2 class="text-[36px] leading-[0.95] font-bold tracking-[-1.1px] sm:text-[44px] sm:tracking-[-1.3px] md:text-[56px] md:tracking-[-1.7px]">
              {{ section.settings.heading }}
            </h2>
          {% endif %}

          {% if section.settings.subtext != blank %}
            <p class="text-[18px] leading-[1.5] sm:text-[20px]">
              {{ section.settings.subtext }}
            </p>
          {% endif %}
        </div>
      {% endif %}

      {% if section.settings.show_button and section.settings.button_label != blank %}
        {% render 'button',
          label: section.settings.button_label,
          url: section.settings.button_link,
          background_color: section.settings.button_background_color,
          text_color: section.settings.button_text_color,
          class: 'w-auto whitespace-nowrap'
        %}
      {% endif %}

      {% if section.settings.photo_1 or section.settings.photo_2 or section.settings.photo_3 %}
        <div class="flex w-full items-center justify-center gap-3 pt-4 sm:gap-6">
          {% if section.settings.photo_1 %}
            {{
              section.settings.photo_1
              | image_url: width: 400
              | image_tag: class: 'aspect-square w-1/3 object-cover', alt: section.settings.photo_1_alt
              | default: section.settings.photo_1.alt
            }}
          {% endif %}

          {% if section.settings.photo_2 %}
            {{
              section.settings.photo_2
              | image_url: width: 400
              | image_tag: class: 'aspect-square w-1/3 object-cover', alt: section.settings.photo_2_alt
              | default: section.settings.photo_2.alt
            }}
          {% endif %}

          {% if section.settings.photo_3 %}
            {{
              section.settings.photo_3
              | image_url: width: 400
              | image_tag: class: 'aspect-square w-1/3 object-cover', alt: section.settings.photo_3_alt
              | default: section.settings.photo_3.alt
            }}
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:general.collage_callout",
  "settings": [
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Find Toasted"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "t:labels.subtext",
      "default": "Coming to select venues and retailers."
    },
    {
      "type": "header",
      "content": "t:general.button"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "t:labels.show_button",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label",
      "default": "Find near you",
      "visible_if": "{{ section.settings.show_button }}"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:labels.button_link",
      "visible_if": "{{ section.settings.show_button }}"
    },
    {
      "type": "color",
      "id": "button_background_color",
      "label": "t:labels.button_background",
      "default": "#212323",
      "visible_if": "{{ section.settings.show_button }}"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "t:labels.button_text_color",
      "default": "#F6F1EC",
      "visible_if": "{{ section.settings.show_button }}"
    },
    {
      "type": "header",
      "content": "t:general.image"
    },
    {
      "type": "image_picker",
      "id": "photo_1",
      "label": "t:labels.photo_1"
    },
    {
      "type": "text",
      "id": "photo_1_alt",
      "label": "t:labels.alt_text"
    },
    {
      "type": "image_picker",
      "id": "photo_2",
      "label": "t:labels.photo_2"
    },
    {
      "type": "text",
      "id": "photo_2_alt",
      "label": "t:labels.alt_text"
    },
    {
      "type": "image_picker",
      "id": "photo_3",
      "label": "t:labels.photo_3"
    },
    {
      "type": "text",
      "id": "photo_3_alt",
      "label": "t:labels.alt_text"
    },
    {
      "type": "header",
      "content": "t:general.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.background",
      "default": "#F6F1EC"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "t:labels.text_color",
      "default": "#212323"
    },
    {
      "type": "header",
      "content": "t:general.layout"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "t:general.collage_callout"
    }
  ]
}
{% endschema %}
