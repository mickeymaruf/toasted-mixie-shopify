<announcement-bar-carousel
  class="announcement-bar full-width"
  data-autoplay-interval="{{ section.settings.autoplay_speed | times: 1000 }}"
>
  {% for block in section.blocks %}
    {% render block %}
  {% endfor %}
</announcement-bar-carousel>

{% stylesheet %}
  .announcement-bar {
    position: relative;
    display: block;
    width: 100%;
  }
{% endstylesheet %}

{% javascript %}
  class AnnouncementBarCarousel extends HTMLElement {
    connectedCallback() {
      this.items = Array.from(this.querySelectorAll('[data-announcement-bar-item]'));
      this.activeIndex = 0;
      this.interval = parseInt(this.dataset.autoplayInterval, 10) || 3000;
      this.timer = null;
      this.prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (this.items.length === 0) return;

      this.items.forEach((item, index) => {
        const isActive = index === 0;
        item.classList.toggle('is-active', isActive);
        item.inert = !isActive;
      });

      if (this.items.length <= 1) return;

      this.handlePause = () => this.stop();
      this.handleFocusOut = (event) => {
        if (!this.contains(event.relatedTarget)) this.start();
      };
      this.handleBlockSelect = (event) => {
        const item = event.target.closest('[data-announcement-bar-item]');
        if (!item || !this.contains(item)) return;
        this.stop();
        this.goTo(this.items.indexOf(item));
      };
      this.handleBlockDeselect = () => this.start();

      this.addEventListener('focusin', this.handlePause);
      this.addEventListener('focusout', this.handleFocusOut);
      document.addEventListener('shopify:block:select', this.handleBlockSelect);
      document.addEventListener('shopify:block:deselect', this.handleBlockDeselect);

      this.start();
    }

    disconnectedCallback() {
      this.stop();
      document.removeEventListener('shopify:block:select', this.handleBlockSelect);
      document.removeEventListener('shopify:block:deselect', this.handleBlockDeselect);
    }

    start() {
      if (this.prefersReducedMotion || this.items.length <= 1) return;
      this.stop();
      this.timer = window.setInterval(() => this.next(), this.interval);
    }

    stop() {
      if (this.timer) {
        window.clearInterval(this.timer);
        this.timer = null;
      }
    }

    next() {
      this.goTo((this.activeIndex + 1) % this.items.length);
    }

    goTo(index) {
      const current = this.items[this.activeIndex];
      const next = this.items[index];
      if (!current || !next || current === next) return;

      current.classList.remove('is-active');
      current.inert = true;
      next.classList.add('is-active');
      next.inert = false;
      this.activeIndex = index;
    }
  }

  customElements.define('announcement-bar-carousel', AnnouncementBarCarousel);
{% endjavascript %}

{% schema %}
{
  "name": "t:general.announcement_bar",
  "blocks": [{ "type": "announcement-bar-item" }],
  "settings": [
    {
      "type": "header",
      "content": "t:general.carousel"
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "t:labels.autoplay_speed",
      "default": 3
    }
  ],
  "presets": [
    {
      "name": "t:general.announcement_bar",
      "blocks": [
        {
          "type": "announcement-bar-item",
          "settings": {
            "text": "<p>Free 3-flavor trial pack. Just pay shipping.</p>",
            "show_button": true,
            "button_style": "button",
            "button_label": "Claim Your Trial",
            "background_color": "#F9D5C0",
            "text_color": "#212323",
            "button_background_color": "#212323",
            "button_text_color": "#F6F1EC"
          }
        }
      ]
    }
  ]
}
{% endschema %}
