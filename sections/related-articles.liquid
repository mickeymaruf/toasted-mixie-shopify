{% comment %}
  Renders a "Related articles" row of article cards from the current article's blog,
  excluding the article being viewed. Falls back to the first blog when used outside
  an article template.
{% endcomment %}

{%- liquid
  assign source_blog = blog
  if source_blog == blank
    assign source_blog = blogs.first
  endif
  assign shown = 0
-%}

{%- if source_blog.articles_count > 1 or source_blog.articles_count > 0 and article == blank -%}
  <section class="related-articles full-width" style="background-color: {{ section.settings.background_color }};">
    <div class="mx-auto flex w-full max-w-[1440px] flex-col items-center gap-[50px] px-5 py-[60px] sm:px-8 md:px-12 lg:py-[100px] xl:px-[100px]">
      {%- if section.settings.heading != blank -%}
        <h2
          class="w-full text-center font-[family-name:var(--font-heading--family)] text-[40px] leading-[0.95] font-bold tracking-[-0.03em] sm:text-[56px] lg:text-[72px]"
          style="color: {{ section.settings.heading_color }};"
        >
          {{ section.settings.heading }}
        </h2>
      {%- endif -%}

      <ul class="grid w-full grid-cols-1 justify-items-center gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {%- for related in source_blog.articles limit: 4 -%}
          {%- if related.id != article.id and shown < section.settings.article_count -%}
            {%- assign shown = shown | plus: 1 -%}
            <li class="w-full max-w-[400px]">
              {% render 'article-card', article: related %}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "t:general.related_articles",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Related articles"
    },
    {
      "type": "range",
      "id": "article_count",
      "label": "t:labels.article_count",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 3
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.background_color",
      "default": "#F9D5C0"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "t:labels.text_color",
      "default": "#212323"
    }
  ],
  "presets": [
    {
      "name": "t:general.related_articles"
    }
  ]
}
{% endschema %}
