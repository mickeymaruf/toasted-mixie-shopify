{% comment %}
  Global search modal, rendered once from layout/theme.liquid (not tied to a
  template). Opens via any [data-search-open] trigger (see the "Find
  Toasted" button in sections/header.liquid). Mirrors the cart-drawer
  section's <cart-drawer> custom element pattern.

  Styled after the header's mega-menu dropdown (sections/header.liquid): a
  single bordered, rounded floating card anchored under the navbar, instead
  of a full-width bar. It's anchored to the right edge and slides in from
  the right (translate-x) rather than the header's top-drop animation.

  Typing into the input fetches this same section (?section_id=search-modal)
  scoped to products only via resources[type]=product, and swaps the
  #search-modal-results markup into the results list inside the same card.
{% endcomment %}

<search-modal
  class="group pointer-events-none absolute inset-0 z-50"
  data-search-modal
  data-predictive-search-url="{{ routes.predictive_search_url }}"
  data-loading-text="{{ 'search_modal.loading' | t }}"
>
  <div
    class="pointer-events-none absolute inset-0 group-open:pointer-events-auto"
    data-search-close
    aria-hidden="true"
  ></div>

  <div
    class="pointer-events-none absolute inset-x-3 flex justify-center pb-4 sm:inset-x-auto sm:right-0 sm:justify-end sm:pr-[clamp(var(--page-margin),6vw,6.25rem)] sm:pb-6"
    role="dialog"
    aria-modal="true"
    aria-label="{{ 'search_modal.heading' | t }}"
    data-search-panel
  >
    <div
      class="pointer-events-none flex w-full origin-top -translate-y-3 scale-90 opacity-0 transition-all duration-200 ease-[ease] will-change-transform group-open:pointer-events-auto group-open:translate-y-0 group-open:scale-100 group-open:opacity-100 sm:w-[min(92vw,560px)] sm:origin-top-right"
    >
      <div
        class="flex w-full flex-col overflow-hidden rounded-[1.5rem] border-[3px] border-[#212323] shadow-[0_20px_40px_rgba(33,35,35,0.15)] sm:rounded-[2.0625rem]"
        style="background-color: {{ section.settings.background_color }};"
        data-search-box
      >
        <form
          action="{{ routes.search_url }}"
          method="get"
          role="search"
          class="flex w-full items-center gap-2 p-4 sm:gap-3 sm:p-9"
          data-search-form
        >
          <div class="relative flex-1">
            <span class="pointer-events-none absolute top-1/2 left-3 block size-4 -translate-y-1/2 text-[#212323] sm:left-4 sm:size-5">
              {{ 'icon-search.svg' | inline_asset_content }}
            </span>
            <input
              type="search"
              name="q"
              id="SearchModalInput"
              value="{{ search.terms | escape }}"
              placeholder="{{ 'search_modal.placeholder' | t }}"
              autocomplete="off"
              autocorrect="off"
              autocapitalize="off"
              spellcheck="false"
              class="w-full rounded-full border-[3px] border-[#212323] bg-transparent py-2 pr-9 pl-9 text-[16px] text-[#212323] placeholder:text-[#212323]/50 focus:outline-none sm:py-3 sm:pr-11 sm:pl-11"
              data-search-input
            >
            <button
              type="button"
              class="absolute top-1/2 right-2 flex size-5 -translate-y-1/2 items-center justify-center rounded-md border border-[#212323]/30 text-[#212323]/60 sm:right-3 sm:size-6{% if search.terms == blank %} hidden{% endif %}"
              aria-label="{{ 'search_modal.clear' | t }}"
              data-search-clear
            >
              <span class="block size-2.5 sm:size-3">{{ 'icon-close.svg' | inline_asset_content }}</span>
            </button>
          </div>

          <button
            type="button"
            class="flex size-9 shrink-0 items-center justify-center rounded-full text-[#212323] sm:size-11"
            aria-label="{{ 'general.accessibility.close' | t }}"
            data-search-close
          >
            <span class="block size-4 sm:size-5">{{ 'icon-close-bold.svg' | inline_asset_content }}</span>
          </button>
        </form>

        <div
          id="search-modal-results"
          class="{% if predictive_search.performed %}flex{% else %}hidden{% endif %} w-full flex-col overflow-hidden"
          data-search-results
        >
          {%- if predictive_search.performed -%}
            {%- if predictive_search.resources.products.size > 0 -%}
              <p class="px-4 text-[11px] font-medium tracking-[0.08em] text-[#212323]/60 uppercase sm:px-9 sm:text-[12px]">
                {{- 'search_modal.products_heading' | t -}}
              </p>
              <div class="mt-2 h-px w-full bg-[#212323]/10"></div>
              <ul class="flex max-h-[45vh] flex-col overflow-y-auto" role="list">
                {%- for product in predictive_search.resources.products -%}
                  <li>
                    <a
                      href="{{ product.url }}"
                      class="flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-[#212323]/5 sm:gap-4 sm:px-9 sm:py-3"
                    >
                      <span class="block size-10 shrink-0 overflow-hidden rounded-lg bg-white sm:size-12">
                        {%- if product.featured_image -%}
                          {{
                            product.featured_image
                            | image_url: width: 96
                            | image_tag: class: 'size-full object-cover', alt: product.featured_image.alt, width: 48, height: 48
                          }}
                        {%- endif -%}
                      </span>
                      <span class="text-[14px] leading-[1.3] font-medium text-[#212323] sm:text-[15px]">
                        {{- product.title | escape -}}
                      </span>
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            {%- else -%}
              <p class="px-4 pb-4 text-center text-[13px] text-[#212323]/70 sm:px-9 sm:pb-6 sm:text-[14px]">
                {{ 'search_modal.no_results_html' | t: terms: predictive_search.terms }}
              </p>
            {%- endif -%}
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</search-modal>

{% stylesheet %}
  #SearchModalInput::-webkit-search-cancel-button,
  #SearchModalInput::-webkit-search-decoration {
    appearance: none;
    -webkit-appearance: none;
    display: none;
  }

  #SearchModalInput::-ms-clear {
    display: none;
  }
{% endstylesheet %}

{% javascript %}
  class SearchModal extends HTMLElement {
    connectedCallback() {
      this.panel = this.querySelector('[data-search-panel]');
      this.form = this.querySelector('[data-search-form]');
      this.input = this.querySelector('[data-search-input]');
      this.clearButton = this.querySelector('[data-search-clear]');
      this.resultsContainer = this.querySelector('[data-search-results]');
      this.lastTrigger = null;
      this.abortController = null;

      this.form?.addEventListener('submit', (event) => {
        event.preventDefault();
      });

      document.addEventListener('click', (event) => {
        const opener = event.target.closest('[data-search-open]');
        if (opener) {
          event.preventDefault();
          this.lastTrigger = opener;
          this.open();
          return;
        }

        if (event.target.closest('[data-search-close]')) {
          this.close();
        }
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && this.hasAttribute('open')) this.close();
      });

      this.input.addEventListener('input', this.debounce(() => this.onQueryChange(), 300));

      this.clearButton?.addEventListener('click', () => {
        this.input.value = '';
        this.input.focus();
        this.onQueryChange();
      });

      this.onResize = () => this.positionPanel();
    }

    positionPanel() {
      const navbar = document.querySelector('.navbar');
      if (!navbar) return;
      const rect = navbar.getBoundingClientRect();
      this.panel.style.top = `${rect.bottom + window.scrollY}px`;
    }

    debounce(callback, wait) {
      let timeout;
      return (...args) => {
        clearTimeout(timeout);
        timeout = setTimeout(() => callback(...args), wait);
      };
    }

    open() {
      this.positionPanel();
      this.setAttribute('open', '');
      this.input.focus({ preventScroll: true });
      window.addEventListener('resize', this.onResize);
    }

    close() {
      this.removeAttribute('open');
      this.abortController?.abort();
      this.input.value = '';
      this.hideResults();
      this.clearButton?.classList.add('hidden');
      this.lastTrigger?.focus({ preventScroll: true });
      window.removeEventListener('resize', this.onResize);
    }

    hideResults() {
      this.resultsContainer.innerHTML = '';
      this.resultsContainer.classList.add('hidden');
      this.resultsContainer.classList.remove('flex');
    }

    showResults(html) {
      this.resultsContainer.innerHTML = html;
      this.resultsContainer.classList.remove('hidden');
      this.resultsContainer.classList.add('flex');
    }

    onQueryChange() {
      const term = this.input.value.trim();
      this.clearButton?.classList.toggle('hidden', term.length === 0);

      this.abortController?.abort();

      if (!term.length) {
        this.hideResults();
        return;
      }

      this.abortController = new AbortController();
      this.showResults(
        `<p class="px-6 pb-6 text-center text-[14px] text-[#212323]/70 sm:px-9">${this.dataset.loadingText || ''}</p>`
      );

      const url = `${this.dataset.predictiveSearchUrl}?q=${encodeURIComponent(term)}&resources[type]=product&resources[limit]=6&section_id=search-modal`;

      fetch(url, { signal: this.abortController.signal })
        .then((response) => {
          if (!response.ok) throw new Error(response.status);
          return response.text();
        })
        .then((text) => {
          const parsed = new DOMParser().parseFromString(text, 'text/html');
          const next = parsed.getElementById('search-modal-results');
          const html = next ? next.innerHTML : '';
          if (html.trim()) {
            this.showResults(html);
          } else {
            this.hideResults();
          }
        })
        .catch((error) => {
          if (error.name === 'AbortError') return;
          this.hideResults();
        });
    }
  }

  customElements.define('search-modal', SearchModal);
{% endjavascript %}

{% schema %}
{
  "name": "t:general.search_modal",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.background",
      "default": "#c2cbd4"
    }
  ]
}
{% endschema %}
