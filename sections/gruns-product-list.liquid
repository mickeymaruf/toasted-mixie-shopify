{% comment %}
  Renders "Choose your flavor." — an editable heading followed by a
  responsive grid of product-card blocks. Add product-card blocks and
  select a product on each to populate the grid.
{% endcomment %}

<section
  class="gruns-product-list full-width"
  style="background-color: {{ section.settings.background_color }};"
>
  <div
    class="mx-auto flex w-full max-w-[1200px] flex-col items-center gap-6 px-4 py-[40px] sm:gap-8 sm:px-8 sm:py-[60px] md:px-12 lg:gap-[50px] lg:px-[60px] lg:py-[100px] xl:px-0"
  >
    {% if section.settings.heading != blank %}
      <h2
        class="section-heading w-full text-center text-[color:var(--gruns-product-list-heading-color)]"
        style="--gruns-product-list-heading-color: {{ section.settings.heading_color }};"
      >
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="gruns-product-list__grid{% if section.blocks.size == 3 %} gruns-product-list__grid--three{% endif %} grid w-full grid-cols-2 gap-4 sm:grid-cols-2 sm:gap-6 lg:grid-cols-4 lg:gap-[20px]">
        {% content_for 'blocks' %}
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  /* TEMP: centered layout when only 3 cards are shown */
  .gruns-product-list__grid--three > .shopify-block:last-child {
    grid-column: 1 / -1;
    justify-self: center;
    width: calc((100% - 1rem) / 2);
  }
  @media (min-width: 640px) {
    .gruns-product-list__grid--three > .shopify-block:last-child { width: calc((100% - 1.5rem) / 2); }
  }
  @media (min-width: 1024px) {
    .gruns-product-list__grid.gruns-product-list__grid--three {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      max-width: calc(75% - 5px);
      margin-left: auto;
      margin-right: auto;
    }
    .gruns-product-list__grid--three > .shopify-block:last-child { grid-column: auto; width: 100%; }
  }
  .gruns-product-list__grid {
    align-items: stretch;
  }

  .gruns-product-list .shopify-block {
    display: flex;
    width: 100%;
    height: 100%;
    align-self: stretch;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.product_list",
  "blocks": [{ "type": "product-card" }],
  "settings": [
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Choose your flavor."
    },
    {
      "type": "header",
      "content": "t:general.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.background",
      "default": "#F6F1EC"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "t:labels.text_color",
      "default": "#212323"
    }
  ],
  "presets": [
    {
      "name": "t:general.product_list",
      "blocks": [
        {
          "type": "product-card",
          "settings": {
            "flavor_name": "Blood Orange",
            "flavor_name_color": "#B70141",
            "description": "Bright. Smooth. Golden-hour ready.",
            "price_text": "From $9.99",
            "button_label": "Shop Blood Orange",
            "learn_more_label": ""
          }
        },
        {
          "type": "product-card",
          "settings": {
            "flavor_name": "Berry Acai",
            "flavor_name_color": "#5E1A79",
            "description": "Deep. Juicy. Easy to enjoy.",
            "price_text": "From $9.99",
            "button_label": "Shop Berry Acai",
            "learn_more_label": ""
          }
        },
        {
          "type": "product-card",
          "settings": {
            "flavor_name": "Ginger Lime",
            "flavor_name_color": "#215332",
            "description": "Crisp. Lively. Clean finish.",
            "price_text": "From $9.99",
            "button_label": "Shop Ginger Lime",
            "use_lottie_animation": true,
            "learn_more_label": ""
          }
        }
      ]
    }
  ]
}
{% endschema %}
