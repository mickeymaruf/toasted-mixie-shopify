{% doc %}
  Renders a "How to Read a COA" guide with a heading and a two-column table
  of label/description rows, styled to match the legal-page rich-text
  table (row dividers, vertical divider between columns, horizontal scroll
  on narrow viewports). Each row is a block so merchants can add, remove,
  and reorder items.
{% enddoc %}

<section
  class="coa-guide full-width"
  style="background-color: {{ section.settings.background_color }};"
  {{ section.shopify_attributes }}
>
  <div
    class="mx-auto w-full max-w-[1920px] px-5 sm:px-8 md:px-12 lg:px-[80px] xl:px-[120px]"
    style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
  >
    {% if section.settings.heading != blank %}
      <h2 class="coa-guide__heading mb-10 text-center text-[40px] font-bold leading-[0.95] tracking-[-1.2px] text-[#212323] sm:text-[56px] sm:tracking-[-1.68px] md:mb-[50px] md:text-[72px] md:tracking-[-2.16px]">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="coa-guide__table-wrap mx-auto w-full max-w-[988px] overflow-x-auto">
        <table class="block w-full max-w-full border-collapse">
          <tbody>
            {% for block in section.blocks %}
              <tr {{ block.shopify_attributes }} class="coa-guide__row">
                <th scope="row" class="w-[220px] p-3 text-[18px] font-medium leading-[1.5] text-left whitespace-nowrap align-bottom border-r border-[#212323] md:w-[280px] md:text-[24px] lg:w-[368px] lg:p-4 lg:whitespace-normal">{{ block.settings.title }}</th>
                <td class="p-3 text-[16px] font-normal leading-[1.5] text-left align-top md:text-[24px] lg:p-4">{{ block.settings.description }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .coa-guide__table-wrap {
    -webkit-overflow-scrolling: touch;
  }

  .coa-guide__row + .coa-guide__row > * {
    border-top: 1px solid #212323;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.coa_guide",
  "blocks": [
    {
      "type": "row",
      "name": "t:general.row",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:labels.title",
          "default": "Summary Page"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "t:labels.description",
          "default": "CBD content, THC detection*, total cannabinoids, and terpene content."
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "How to Read a COA"
    },
    {
      "type": "header",
      "content": "t:general.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.background",
      "default": "#F6F1EC"
    },
    {
      "type": "header",
      "content": "t:general.layout"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "t:general.coa_guide",
      "blocks": [
        {
          "type": "row",
          "settings": {
            "title": "Summary Page",
            "description": "CBD content, THC detection*, total cannabinoids, and terpene content."
          }
        },
        {
          "type": "row",
          "settings": {
            "title": "Safety Standards",
            "description": "Tested for residual solvents, pesticides, heavy metals, and biological impurities."
          }
        },
        {
          "type": "row",
          "settings": {
            "title": "Detailed Reports",
            "description": "Full cannabinoid profile and terpene analysis are provided on the following pages."
          }
        },
        {
          "type": "row",
          "settings": {
            "title": "Reference Guide",
            "description": "A glossary of abbreviations and acronyms is included for easy understanding."
          }
        }
      ]
    }
  ]
}
{% endschema %}
