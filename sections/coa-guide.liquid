{% doc %}
  Renders a "How to Read a COA" guide with a heading and a two-column table
  of label/description rows, styled to match the legal-page rich-text
  table (row dividers, vertical divider between columns, horizontal scroll
  on narrow viewports). Each row is a block so merchants can add, remove,
  and reorder items.
{% enddoc %}

<section
  class="coa-guide full-width"
  style="background-color: {{ section.settings.background_color }};"
  {{ section.shopify_attributes }}
>
  <div
    class="mx-auto w-full max-w-[1920px] px-5 sm:px-8 md:px-12 lg:px-[80px] xl:px-[120px] py-[50px] md:py-[100px]"
  >
    {% if section.settings.heading != blank %}
      <h2 class="coa-guide__heading mb-10 text-center text-[40px] font-bold leading-[0.95] tracking-[-1.2px] text-[#212323] sm:text-[56px] sm:tracking-[-1.68px] md:mb-[50px] md:text-[72px] md:tracking-[-2.16px]">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="coa-guide__table-wrap mx-auto w-full max-w-[988px] overflow-x-auto">
        <table class="block w-full max-w-full border-collapse">
          <tbody>
            {% for block in section.blocks %}
              <tr {{ block.shopify_attributes }} class="coa-guide__row">
                <th
                  scope="row"
                  class="w-[90px] p-2 text-[13px] font-medium leading-[1.5] text-left whitespace-normal align-middle border-r border-[#212323] sm:w-[150px] sm:p-3 sm:text-[16px] md:w-[280px] md:text-[24px] lg:w-[320px] lg:p-4 lg:whitespace-normal"
                >
                  {{ block.settings.title }}
                </th>
                <td class="p-2 text-[13px] font-normal leading-[1.5] text-left align-middle sm:p-3 sm:text-[15px] md:text-[24px] lg:p-4 lg:pl-[130px]">
                  {{ block.settings.description }}
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .coa-guide__table-wrap {
    -webkit-overflow-scrolling: touch;
  }

  .coa-guide__row + .coa-guide__row > * {
    border-top: 1px solid #212323;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.coa_guide",
  "blocks": [
    {
      "type": "row",
      "name": "t:general.row",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:labels.title",
          "default": "Summary Page"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "t:labels.description",
          "default": "CBD content, THC detection*, total cannabinoids, and terpene content."
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "How to Read a COA"
    },
    {
      "type": "header",
      "content": "t:general.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.background",
      "default": "#F6F1EC"
    },
  ],
  "presets": [
    {
      "name": "t:general.coa_guide",
      "blocks": [
        {
          "type": "row",
          "settings": {
            "title": "THC / Total THC / Delta-9",
            "description": "Shows cannabinoid potency and confirms hemp-derived THC compliance."
          }
        },
        {
          "type": "row",
          "settings": {
            "title": "Safety Microbials",
            "description": "Tests for microorganisms, including bacteria, yeast, and mold."
          }
        },
        {
          "type": "row",
          "settings": {
            "title": "Pesticide Heavy Metals",
            "description": "Tests for pesticide residue and heavy metals."
          }
        },
        {
          "type": "row",
          "settings": {
            "title": "Residual Solvents",
            "description": "Tests for extraction-related solvent residue."
          }
        }
      ]
    }
  ]
}
{% endschema %}
