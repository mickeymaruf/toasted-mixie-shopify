{% doc %}
  Renders "Functional by Design" — a centered heading and description above a
  center product image flanked by two columns of icon + title feature
  blocks. The left/right column layout is kept at all breakpoints, scaling
  down in size on smaller screens.
{% enddoc %}

<section class="ingredient-highlights relative w-full overflow-hidden bg-[#F6F1EC]">
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    {% if section.settings.background_image %}
      {{
        section.settings.background_image
        | image_url: width: section.settings.background_image.width
        | image_tag:
          class: 'absolute top-[13.62%] left-[-13.13%] h-full w-[126.22%] max-w-none object-cover opacity-[0.06] min-[1920px]:left-0 min-[1920px]:h-[86.38%] min-[1920px]:w-full min-[1920px]:object-contain min-[1920px]:object-bottom',
          widths: '750, 1100, 1500, 2000',
          sizes: '100vw',
          loading: 'lazy',
          alt: ''
      }}
    {% else %}
      <img
        src="{{ 'ingredient-highlights-background.png' | asset_url }}"
        alt=""
        class="absolute top-[13.62%] left-[-13.13%] h-full w-[126.22%] max-w-none object-cover opacity-[0.06] min-[1920px]:left-0 min-[1920px]:h-[86.38%] min-[1920px]:w-full min-[1920px]:object-contain min-[1920px]:object-bottom"
        loading="lazy"
        width="3483"
        height="1960"
      >
    {% endif %}
    <div class="absolute inset-0 bg-gradient-to-b from-[#F6F1EC] from-[44.639%] to-[rgba(246,241,236,0)] to-[70.205%]"></div>
  </div>

  <div class="relative mx-auto flex w-full max-w-[1440px] flex-col items-center gap-10 px-5 py-8 sm:py-14 sm:px-8 md:px-12 lg:gap-[60px] lg:px-[80px] lg:pt-[80px] lg:pb-[100px] xl:px-[120px]">
    {% if section.settings.heading != blank or section.settings.description != blank or section.settings.mobile_description != blank %}
      <div class="flex w-full flex-col items-center gap-5 text-center text-[#212323] lg:gap-[20px]">
        {% if section.settings.heading != blank %}
          <h2 class="w-full text-[40px] leading-[0.95] font-bold sm:text-[48px] md:text-[60px] lg:text-[68px] xl:text-[76px]">
            {{ section.settings.heading }}
          </h2>
        {% endif %}

        {% if section.settings.description != blank %}
          <div
            class="w-full max-w-[960px] text-[16px] leading-[1.5] sm:text-[18px] xl:text-[24px] xl:leading-[1.3] {% if section.settings.mobile_description != blank %}hidden sm:block{% endif %}"
          >
            {{ section.settings.description }}
          </div>
        {% endif %}

        {% if section.settings.mobile_description != blank %}
          <div class="block w-full max-w-[960px] text-[16px] leading-[1.5] sm:hidden">
            {{ section.settings.mobile_description }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    <div class="flex w-full max-w-[600px] flex-row items-center justify-center gap-[6px] sm:max-w-[700px] sm:gap-6 lg:w-auto lg:max-w-none lg:gap-[10px]">
      <div>
        {% content_for 'block', type: 'feature-column', id: 'feature-column-left' %}
      </div>

      <div class="flex justify-center">
        <div class="relative aspect-[484/515] w-[212px] sm:w-[320px] lg:w-[576px]">
          {% liquid
            assign center_image = section.settings.center_image
            assign center_image_alt = section.settings.center_image_alt | default: center_image.alt
          %}
          {% if center_image %}
            {{
              center_image
              | image_url: width: 1728
              | image_tag:
                class: 'relative size-full object-contain',
                widths: '212, 320, 424, 576, 640, 960, 1152, 1728',
                sizes: '(min-width: 64rem) 576px, (min-width: 40rem) 320px, 212px',
                loading: 'eager',
                alt: center_image_alt
            }}
          {% endif %}
        </div>
      </div>

      <div>
        {% content_for 'block', type: 'feature-column', id: 'feature-column-right' %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:general.ingredient_highlights",
  "settings": [
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Functional by Design."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:labels.description",
      "default": "<p>Crafted with L-theanine, rhodiola, and 0.4mg hemp-derived THC in a non-carbonated drink made for a lighter social experience.</p>"
    },
    {
      "type": "richtext",
      "id": "mobile_description",
      "label": "t:labels.mobile_description",
      "info": "t:labels.mobile_description_info"
    },
    {
      "type": "header",
      "content": "t:general.image"
    },
    {
      "type": "image_picker",
      "id": "center_image",
      "label": "t:labels.center_product_image",
      "info": "t:labels.center_product_image_info"
    },
    {
      "type": "text",
      "id": "center_image_alt",
      "label": "t:labels.alt_text"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:labels.background"
    }
  ],
  "blocks": [{ "type": "feature-column" }],
  "presets": [
    {
      "name": "t:general.ingredient_highlights",
      "blocks": [
        {
          "type": "feature-column",
          "static": true,
          "id": "feature-column-left",
          "blocks": [
            { "type": "feature-highlight" },
            { "type": "feature-highlight" },
            { "type": "feature-highlight" },
            { "type": "feature-highlight" }
          ]
        },
        {
          "type": "feature-column",
          "static": true,
          "id": "feature-column-right",
          "blocks": [
            { "type": "feature-highlight" },
            { "type": "feature-highlight" },
            { "type": "feature-highlight" },
            { "type": "feature-highlight" }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
