{% doc %}
  Renders "Functional by Design" — a centered heading and description above a
  center product image flanked by two columns of icon + title feature
  blocks. On smaller screens the product image moves above a 2-column grid
  of features (left column / right column).
{% enddoc %}

<section class="ingredient-highlights relative w-full overflow-hidden bg-[#F6F1EC]">
  <div class="hidden lg:block pointer-events-none absolute inset-0" aria-hidden="true">
    {% if section.settings.background_image %}
      {{
        section.settings.background_image
        | image_url: width: 2000
        | image_tag:
          class: 'absolute size-full bottom-0 object-cover opacity-10 saturate-0',
          widths: '750, 1100, 1500, 2000',
          sizes: '100vw',
          loading: 'lazy',
          alt: ''
      }}
    {% else %}
      <img
        src="{{ 'ingredient-highlights-background.png' | asset_url }}"
        alt=""
        class="absolute size-full bottom-0 object-cover opacity-10 saturate-0"
        loading="lazy"
        width="1600"
        height="1044"
      >
    {% endif %}

    <div class="absolute inset-0 bg-gradient-to-b from-[#F8F1EA] to-[rgba(248,241,234,0)]"></div>

    <div class="absolute inset-0 bg-[#F6F1EC]/40"></div>
  </div>

  <div class="relative mx-auto flex w-full max-w-[1440px] flex-col items-center gap-10 px-5 py-8 sm:py-14 sm:px-8 md:px-12 lg:gap-[60px] lg:px-[80px] lg:pt-[80px] lg:pb-[100px] xl:px-[120px]">
    {% if section.settings.heading != blank or section.settings.description != blank %}
      <div class="flex w-full flex-col items-center gap-5 text-center text-[#212323] lg:gap-[20px]">
        {% if section.settings.heading != blank %}
          <h2 class="w-full text-[36px] leading-[0.95] font-bold [text-shadow:4px_4px_6px_rgba(0,0,0,0.1)] sm:text-[44px] md:text-[56px] lg:text-[64px] xl:text-[72px] xl:tracking-[-2.16px]">
            {{ section.settings.heading }}
          </h2>
        {% endif %}

        {% if section.settings.description != blank %}
          <p class="w-full max-w-[820px] text-[16px] leading-[1.5] sm:text-[18px] xl:text-[24px] xl:leading-[1.3]">
            {{ section.settings.description }}
          </p>
        {% endif %}
      </div>
    {% endif %}

    <div class="grid w-full max-w-[600px] grid-cols-2 items-start gap-x-6 gap-y-10 sm:max-w-[700px] lg:flex lg:w-auto lg:max-w-none lg:flex-row lg:items-center lg:justify-center lg:gap-[70px]">
      <div class="order-2 lg:order-none">
        {% content_for 'block', type: 'feature-column', id: 'feature-column-left' %}
      </div>

      <div class="order-1 col-span-2 flex justify-center lg:order-none lg:col-span-1">
        <div class="relative w-[190px] sm:w-[240px] lg:w-[300px] flex items-center">
          {% if section.settings.center_image %}
            {{
              section.settings.center_image
              | image_url: width: 1400
              | image_tag:
                class: 'relative size-full object-contain',
                widths: '190, 240, 380, 480, 680, 960, 1400',
                sizes: '(min-width: 64rem) 340px, (min-width: 40rem) 240px, 190px',
                loading: 'eager',
                alt: section.settings.center_image_alt
              | default: section.settings.center_image.alt
            }}
          {% endif %}
        </div>
      </div>

      <div class="order-3 lg:order-none">
        {% content_for 'block', type: 'feature-column', id: 'feature-column-right' %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:general.ingredient_highlights",
  "settings": [
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Functional by Design."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:labels.description",
      "default": "Crafted with L-theanine, rhodiola, and 0.4mg hemp-derived THC in a non-carbonated drink made for a lighter social experience."
    },
    {
      "type": "header",
      "content": "t:general.image"
    },
    {
      "type": "image_picker",
      "id": "center_image",
      "label": "t:labels.center_product_image"
    },
    {
      "type": "text",
      "id": "center_image_alt",
      "label": "t:labels.alt_text"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:labels.background"
    }
  ],
  "blocks": [{ "type": "feature-column" }],
  "presets": [
    {
      "name": "t:general.ingredient_highlights",
      "blocks": [
        {
          "type": "feature-column",
          "static": true,
          "id": "feature-column-left",
          "blocks": [
            { "type": "feature-highlight" },
            { "type": "feature-highlight" },
            { "type": "feature-highlight" },
            { "type": "feature-highlight" }
          ]
        },
        {
          "type": "feature-column",
          "static": true,
          "id": "feature-column-right",
          "blocks": [
            { "type": "feature-highlight" },
            { "type": "feature-highlight" },
            { "type": "feature-highlight" },
            { "type": "feature-highlight" }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
