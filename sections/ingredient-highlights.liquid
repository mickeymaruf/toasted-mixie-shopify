{% doc %}
  Renders "Functional by Design" — a centered heading and description above a
  center cluster of four animated fruit images (lime, blackberry, grapefruit,
  ginger) flanked by two columns of icon + title feature blocks. The
  left/right column layout is kept at all breakpoints, scaling down in size
  on smaller screens.
{% enddoc %}

<section class="ingredient-highlights relative w-full overflow-hidden bg-[#F6F1EC]">
  <div class="hidden lg:block pointer-events-none absolute inset-0" aria-hidden="true">
    {% if section.settings.background_image %}
      {{
        section.settings.background_image
        | image_url: width: 2000
        | image_tag:
          class: 'absolute size-full bottom-0 object-cover opacity-10 saturate-0',
          widths: '750, 1100, 1500, 2000',
          sizes: '100vw',
          loading: 'lazy',
          alt: ''
      }}
    {% else %}
      <img
        src="{{ 'ingredient-highlights-background.png' | asset_url }}"
        alt=""
        class="absolute size-full bottom-0 object-cover opacity-10 saturate-0"
        loading="lazy"
        width="1600"
        height="1044"
      >
    {% endif %}

    <div class="absolute inset-0 bg-gradient-to-b from-[#F8F1EA] to-[rgba(248,241,234,0)]"></div>

    <div class="absolute inset-0 bg-[#F6F1EC]/40"></div>
  </div>

  <div class="relative mx-auto flex w-full max-w-[1440px] flex-col items-center gap-10 px-5 py-8 sm:py-14 sm:px-8 md:px-12 lg:gap-[60px] lg:px-[80px] lg:pt-[80px] lg:pb-[100px] xl:px-[120px]">
    {% if section.settings.heading != blank or section.settings.description != blank %}
      <div class="flex w-full flex-col items-center gap-5 text-center text-[#212323] lg:gap-[20px]">
        {% if section.settings.heading != blank %}
          <h2 class="w-full text-[40px] leading-[0.95] font-bold sm:text-[48px] md:text-[60px] lg:text-[68px] xl:text-[76px]">
            {{ section.settings.heading }}
          </h2>
        {% endif %}

        {% if section.settings.description != blank %}
          <p class="w-full max-w-[960px] text-[16px] leading-[1.5] sm:text-[18px] xl:text-[24px] xl:leading-[1.3]">
            {{ section.settings.description }}
          </p>
        {% endif %}
      </div>
    {% endif %}

    <div class="flex w-full max-w-[600px] flex-row items-center justify-center gap-8 sm:max-w-[700px] sm:gap-6 lg:w-auto lg:max-w-none lg:gap-[70px] xl:gap-[90px]">
      <div>
        {% content_for 'block', type: 'feature-column', id: 'feature-column-left' %}
      </div>

      <div class="flex justify-center">
        <div class="relative aspect-[448/543] w-[165px] sm:w-[240px] lg:w-[380px] xl:w-[448px]">
          {% render 'ingredient-fruit-image', name: 'lime' %}
          {% render 'ingredient-fruit-image', name: 'blackberry' %}
          {% render 'ingredient-fruit-image', name: 'grapefruit' %}
          {% render 'ingredient-fruit-image', name: 'ginger' %}
        </div>
      </div>

      <div>
        {% content_for 'block', type: 'feature-column', id: 'feature-column-right' %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:general.ingredient_highlights",
  "settings": [
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Functional by Design."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:labels.description",
      "default": "Crafted with L-theanine, rhodiola, and 0.4mg hemp-derived THC in a non-carbonated drink made for a lighter social experience."
    },
    {
      "type": "header",
      "content": "t:general.image"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:labels.background"
    }
  ],
  "blocks": [{ "type": "feature-column" }],
  "presets": [
    {
      "name": "t:general.ingredient_highlights",
      "blocks": [
        {
          "type": "feature-column",
          "static": true,
          "id": "feature-column-left",
          "blocks": [
            { "type": "feature-highlight" },
            { "type": "feature-highlight" },
            { "type": "feature-highlight" },
            { "type": "feature-highlight" }
          ]
        },
        {
          "type": "feature-column",
          "static": true,
          "id": "feature-column-right",
          "blocks": [
            { "type": "feature-highlight" },
            { "type": "feature-highlight" },
            { "type": "feature-highlight" },
            { "type": "feature-highlight" }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
