<section class="hero-banner full-width">
  <div class="mx-auto w-full max-w-[1920px] px-5">
    <div
      class="relative flex min-h-[380px] w-full flex-col items-center justify-end gap-[10px] overflow-hidden rounded-[40px] px-6 pb-10 text-center sm:min-h-[440px] sm:px-10 sm:pb-14 md:min-h-[520px] md:px-16 md:pb-16 lg:min-h-[619px] lg:px-[120px] lg:pb-[70px]"
      style="background-color: {{ section.settings.background_color }};"
    >
      <div class="pointer-events-none absolute inset-0 overflow-hidden rounded-[40px]" aria-hidden="true">
        {% if section.settings.background_image %}
          {{
            section.settings.background_image
            | image_url: width: 3200
            | image_tag:
              class: 'absolute inset-0 size-full object-cover',
              loading: 'eager',
              fetchpriority: 'high',
              sizes: '100vw',
              widths: '750, 1100, 1500, 2000, 2600, 3200',
              alt: ''
          }}
        {% endif %}

        <div class="absolute inset-0 bg-gradient-to-b from-black/0 from-[20%] to-black/75"></div>
      </div>

      <div class="relative z-10 flex flex-col gap-[10px]">
        {% if section.settings.heading != blank %}
          <h2
            class="mx-auto w-full max-w-[708px] text-[36px] leading-[0.95] font-bold [text-shadow:4px_4px_6px_rgba(0,0,0,0.4)] sm:text-[44px] md:text-[56px] lg:text-[64px] xl:text-[72px] xl:tracking-[-2.16px]"
            style="color: {{ section.settings.heading_color }};"
          >
            {{ section.settings.heading }}
          </h2>
        {% endif %}

        {% if section.settings.subheading != blank %}
          <p
            class="mx-auto w-full max-w-[708px] text-[16px] leading-[1.5] [text-shadow:4px_4px_6px_rgba(0,0,0,0.4)] sm:text-[18px] xl:text-[24px]"
            style="color: {{ section.settings.heading_color }};"
          >
            {{ section.settings.subheading }}
          </p>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:general.hero_banner",
  "settings": [
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Choose your Flavor."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:labels.subheading",
      "default": "Three fruit-forward flavors. One light way to relax, connect, and stay present."
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "t:labels.text_color",
      "default": "#F6F1EC"
    },
    {
      "type": "header",
      "content": "t:general.image"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:labels.image"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.background",
      "default": "#E5E5E5"
    }
  ],
  "presets": [
    {
      "name": "t:general.hero_banner"
    }
  ]
}
{% endschema %}
