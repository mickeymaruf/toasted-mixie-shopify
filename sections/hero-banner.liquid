<section class="hero-banner full-width" style="background-color: {{ section.settings.background_color }};">
  <div class="mx-auto w-full max-w-[1200px] px-4 sm:px-8 md:px-12 lg:px-[60px] xl:px-0">
    <div
      class="relative flex min-h-[320px] w-full flex-col items-center justify-end gap-[10px] overflow-hidden rounded-2xl px-4 pb-6 text-center sm:min-h-[440px] sm:rounded-[40px] sm:px-10 sm:pb-14 md:min-h-[520px] md:px-16 md:pb-16 lg:min-h-[435px] lg:px-[120px] lg:pb-[70px]"
    >
      <div class="pointer-events-none absolute inset-0 overflow-hidden rounded-[40px]" aria-hidden="true">
        {% if section.settings.background_image_mobile and section.settings.background_image %}
          <picture>
            <source
              media="(max-width: 47.9375rem)"
              srcset="{{ section.settings.background_image_mobile | image_url: width: 750 }} 750w, {{ section.settings.background_image_mobile | image_url: width: 1100 }} 1100w"
            >
            {{
              section.settings.background_image
              | image_url: width: section.settings.background_image.width
              | image_tag:
                class: 'absolute inset-0 size-full object-cover',
                loading: 'eager',
                fetchpriority: 'high',
                sizes: '100vw',
                widths: '750, 1100, 1500, 2000, 2600, 3200',
                alt: ''
            }}
          </picture>
        {% elsif section.settings.background_image %}
          {{
            section.settings.background_image
            | image_url: width: section.settings.background_image.width
            | image_tag:
              class: 'absolute inset-0 size-full object-cover',
              loading: 'eager',
              fetchpriority: 'high',
              sizes: '100vw',
              widths: '750, 1100, 1500, 2000, 2600, 3200',
              alt: ''
          }}
        {% endif %}

        {% if section.settings.show_gradient_overlay %}
          <div class="absolute inset-0 bg-gradient-to-b from-black/0 from-[20%] to-black/75"></div>
        {% endif %}
      </div>

      <div class="relative z-10 flex flex-col gap-[10px]">
        {% if section.settings.heading != blank %}
          <h2
            class="mx-auto w-full max-w-[900px] text-[25px] leading-[0.95] font-bold [text-shadow:4px_4px_6px_rgba(0,0,0,0.4)] sm:text-[44px] md:text-[56px] lg:text-[64px] xl:text-[72px] {% if section.settings.heading_mobile != blank %}hidden sm:block{% endif %}"
            style="color: {{ section.settings.heading_color }};"
          >
            {{ section.settings.heading }}
          </h2>
        {% endif %}

        {% if section.settings.heading_mobile != blank %}
          <h2
            class="mx-auto block w-full max-w-[900px] text-[25px] leading-[0.95] font-bold [text-shadow:4px_4px_6px_rgba(0,0,0,0.4)] sm:hidden"
            style="color: {{ section.settings.heading_color }};"
          >
            {{ section.settings.heading_mobile }}
          </h2>
        {% endif %}

        {% if section.settings.subheading != blank %}
          <div
            class="mx-auto w-full max-w-[900px] text-[14px] leading-[1.5] [text-shadow:4px_4px_6px_rgba(0,0,0,0.4)] sm:text-[18px] xl:text-[24px] {% if section.settings.subheading_mobile != blank %}hidden sm:block{% endif %}"
            style="color: {{ section.settings.heading_color }};"
          >
            {{ section.settings.subheading }}
          </div>
        {% endif %}

        {% if section.settings.subheading_mobile != blank %}
          <div
            class="mx-auto block w-full max-w-[900px] text-[14px] leading-[1.5] [text-shadow:4px_4px_6px_rgba(0,0,0,0.4)] sm:hidden"
            style="color: {{ section.settings.heading_color }};"
          >
            {{ section.settings.subheading_mobile }}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:general.hero_banner",
  "settings": [
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "<p>Choose your Flavor.</p>"
    },
    {
      "type": "richtext",
      "id": "heading_mobile",
      "label": "t:labels.heading_mobile",
      "info": "t:labels.heading_mobile_info"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "t:labels.subheading",
      "default": "<p>Three fruit-forward flavors. One light way to relax, connect, and stay present.</p>"
    },
    {
      "type": "richtext",
      "id": "subheading_mobile",
      "label": "t:labels.subheading_mobile",
      "info": "t:labels.subheading_mobile_info"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "t:labels.text_color",
      "default": "#F6F1EC"
    },
    {
      "type": "header",
      "content": "t:general.image"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:labels.image"
    },
    {
      "type": "image_picker",
      "id": "background_image_mobile",
      "label": "t:labels.background_mobile",
      "info": "t:labels.background_mobile_info"
    },
    {
      "type": "checkbox",
      "id": "show_gradient_overlay",
      "label": "t:labels.show_gradient_overlay",
      "default": true
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.background",
      "default": "#E5E5E5"
    }
  ],
  "presets": [
    {
      "name": "t:general.hero_banner"
    }
  ]
}
{% endschema %}
