{% doc %}
  Renders one animated fruit image inside the Ingredient Highlights center
  cluster (lime, blackberry, grapefruit, ginger). Position, rotation, scale,
  and the floating loop animation are all driven by the
  `ingredient-fruit--{name}` modifier class defined below, reproducing the
  exact per-layer placement and motion from the Figma source. DOM order
  across the four renders controls stacking, so keep the render order in
  `sections/ingredient-highlights.liquid` unchanged.

  @param {string} name - Fruit identifier; must be one of 'lime', 'blackberry', 'grapefruit', 'ginger'. Matches the CSS modifier and the bundled `ingredient-highlight-{name}-main.png` / `-overlay.png` assets.

  @example
  {% render 'ingredient-fruit-image', name: 'lime' %}
{% enddoc %}

<div class="ingredient-fruit ingredient-fruit--{{ name }}">
  <div class="ingredient-fruit__frame">
    <div class="ingredient-fruit__object">
      <img
        class="ingredient-fruit__image"
        src="{{ 'ingredient-highlight-' | append: name | append: '-main.png' | asset_url }}"
        alt=""
        loading="lazy"
        width="600"
        height="600"
      >
      <div class="ingredient-fruit__texture">
        <img
          class="ingredient-fruit__image"
          src="{{ 'ingredient-highlight-' | append: name | append: '-overlay.png' | asset_url }}"
          alt=""
          loading="lazy"
          width="600"
          height="600"
        >
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .ingredient-fruit {
    position: absolute;
    top: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ingredient-fruit__frame {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .ingredient-fruit__object {
    position: relative;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .ingredient-fruit__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    user-select: none;
    -webkit-user-drag: none;
  }

  .ingredient-fruit__texture {
    position: absolute;
    inset: 0;
    overflow: hidden;
    opacity: 0.1;
  }

  /* Positions, rotation/scale, and motion below are ported 1:1 from the
     Figma "Frame 2147236104" node (fileKey mPnZFgOy032whTzJGzGdND). */

  .ingredient-fruit--lime {
    left: 14.62%;
    right: 24.9%;
    top: calc(50% + 16.427%);
    aspect-ratio: 289.06 / 276.47;
    transform: translateY(-50%);
    animation: ingredient-fruit-float-lime 6s linear infinite;
  }

  .ingredient-fruit--lime .ingredient-fruit__frame {
    transform: rotate(3.08deg);
  }

  .ingredient-fruit--blackberry {
    left: 0.98%;
    right: 70.89%;
    top: calc(50% - 14.144%);
    aspect-ratio: 134.43 / 146.8;
    transform: translateY(-50%);
    animation: ingredient-fruit-float-blackberry 6s linear infinite;
  }

  .ingredient-fruit--blackberry .ingredient-fruit__frame {
    transform: rotate(-8.67deg);
  }

  .ingredient-fruit--grapefruit {
    left: 34.25%;
    right: 5.51%;
    top: calc(50% - 27.556%);
    aspect-ratio: 286.14 / 278.21;
    transform: translateY(-50%);
    animation: ingredient-fruit-float-grapefruit 6s linear infinite;
  }

  .ingredient-fruit--grapefruit .ingredient-fruit__frame {
    transform: scaleX(-1);
  }

  .ingredient-fruit--ginger {
    left: 57.07%;
    right: -5.2%;
    top: calc(50% + 34.978%);
    aspect-ratio: 230.06 / 261.25;
    transform: translateY(-50%);
    animation: ingredient-fruit-float-ginger 6s linear infinite;
  }

  .ingredient-fruit--ginger .ingredient-fruit__frame {
    transform: rotate(17.53deg) scale(0.85);
  }

  @keyframes ingredient-fruit-float-lime {
    0% {
      animation-timing-function: cubic-bezier(0.37, 0, 0.63, 1);
      translate: 0px 0px;
    }
    30% {
      animation-timing-function: cubic-bezier(0.37, 0, 0.63, 1);
      translate: 0px -10px;
    }
    60% {
      animation-timing-function: cubic-bezier(0.37, 0, 0.63, 1);
      translate: 0px 0px;
    }
    83.333% {
      animation-timing-function: cubic-bezier(0.37, 0, 0.63, 1);
      translate: 0px -5px;
    }
    100% {
      translate: 0px 0px;
    }
  }

  @keyframes ingredient-fruit-float-blackberry {
    0% {
      animation-timing-function: cubic-bezier(0.37, 0, 0.63, 1);
      translate: 0px -3px;
    }
    16.667% {
      animation-timing-function: cubic-bezier(0.37, 0, 0.63, 1);
      translate: 0px -8px;
    }
    40% {
      animation-timing-function: cubic-bezier(0.37, 0, 0.63, 1);
      translate: 0px 0px;
    }
    63.333% {
      animation-timing-function: cubic-bezier(0.37, 0, 0.63, 1);
      translate: 0px -7px;
    }
    86.667% {
      animation-timing-function: cubic-bezier(0.37, 0, 0.63, 1);
      translate: 0px 0px;
    }
    100% {
      translate: 0px -3px;
    }
  }

  @keyframes ingredient-fruit-float-grapefruit {
    0% {
      animation-timing-function: cubic-bezier(0.37, 0, 0.63, 1);
      translate: 0px 0px;
    }
    23.333% {
      animation-timing-function: cubic-bezier(0.37, 0, 0.63, 1);
      translate: 0px -7px;
    }
    50% {
      animation-timing-function: cubic-bezier(0.37, 0, 0.63, 1);
      translate: 0px 0px;
    }
    76.667% {
      animation-timing-function: cubic-bezier(0.37, 0, 0.63, 1);
      translate: 0px -8px;
    }
    100% {
      translate: 0px 0px;
    }
  }

  @keyframes ingredient-fruit-float-ginger {
    0% {
      animation-timing-function: cubic-bezier(0.37, 0, 0.63, 1);
      translate: 0px -5px;
    }
    10% {
      animation-timing-function: cubic-bezier(0.37, 0, 0.63, 1);
      translate: 0px -9px;
    }
    33.333% {
      animation-timing-function: cubic-bezier(0.37, 0, 0.63, 1);
      translate: 0px 0px;
    }
    60% {
      animation-timing-function: cubic-bezier(0.37, 0, 0.63, 1);
      translate: 0px -6px;
    }
    83.333% {
      animation-timing-function: cubic-bezier(0.37, 0, 0.63, 1);
      translate: 0px 0px;
    }
    100% {
      translate: 0px -5px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ingredient-fruit--lime,
    .ingredient-fruit--blackberry,
    .ingredient-fruit--grapefruit,
    .ingredient-fruit--ginger {
      animation: none;
    }
  }
{% endstylesheet %}
