{% doc %}
  Renders the shared heading/description markup used by both
  quality-badges sections (the card variant and the full-width variant),
  so their inner content stays visually identical.

  @param {string} heading - Rich text heading markup
  @param {string} [description] - Rich text description markup
  @param {string} [heading_color] - Text color for the heading and description
  @param {string} [heading_class] - Classes controlling the heading's font size/weight/line-height; defaults to the card variant's smaller scale
  @param {string} [content_class] - Classes controlling the wrapper's width/shrink behavior; defaults to the card variant's fixed max-width column

  @example
  {% render 'quality-badges-content',
    heading: section.settings.heading,
    description: section.settings.description,
    heading_color: section.settings.heading_color,
  %}
{% enddoc %}

<div
  class="relative flex flex-col items-start gap-5 text-left {{ content_class | default: 'w-full lg:w-auto lg:max-w-[476px] lg:shrink-0' }}"
  style="color: {{ heading_color }};"
>
  {% if heading != blank %}
    <div class="font-[family-name:var(--font-heading--family)] {{ heading_class | default: 'text-[28px] leading-[0.95] font-bold sm:text-[36px] md:text-[48px] lg:text-[62px]' }}">
      {{ heading }}
    </div>
  {% endif %}

  {% if description != blank %}
    <div class="text-[16px] leading-[1.5] sm:text-[18px] lg:text-[20px]">
      {{ description }}
    </div>
  {% endif %}
</div>
