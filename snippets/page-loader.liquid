{% doc %}
  Page loader snippet with animated "TOASTED" text
  Shows during page transitions with staggered letter animation

  @example
  {% render 'page-loader' %}
{% enddoc %}

<div id="page-loader" class="fixed inset-0 bg-[#f4efe9] flex items-center justify-center z-[9999]">
  <div class="relative w-[172px] h-[39px]">
    <!-- T -->
    <img class="letter-svg absolute" data-letter="0" src="{{ 'loader-letter-t-1.svg' | asset_url }}" alt="" style="width: 24px; height: 39px; left: 0; top: 0;"/>

    <!-- O -->
    <img class="letter-svg absolute" data-letter="1" src="{{ 'loader-letter-a.svg' | asset_url }}" alt="" style="width: 22px; height: 39px; left: 28px; top: 0;"/>

    <!-- A -->
    <img class="letter-svg absolute" data-letter="2" src="{{ 'loader-letter-s.svg' | asset_url }}" alt="" style="width: 24px; height: 39px; left: 54px; top: 0;"/>

    <!-- S -->
    <img class="letter-svg absolute" data-letter="3" src="{{ 'loader-letter-t-2.svg' | asset_url }}" alt="" style="width: 21px; height: 39px; left: 82px; top: 0;"/>

    <!-- T -->
    <img class="letter-svg absolute" data-letter="4" src="{{ 'loader-letter-o.svg' | asset_url }}" alt="" style="width: 24px; height: 39px; left: 107px; top: 0;"/>

    <!-- E -->
    <img class="letter-svg absolute" data-letter="5" src="{{ 'loader-letter-e.svg' | asset_url }}" alt="" style="width: 21px; height: 39px; left: 135px; top: 0;"/>

    <!-- D -->
    <img class="letter-svg absolute" data-letter="6" src="{{ 'loader-letter-d.svg' | asset_url }}" alt="" style="width: 22px; height: 39px; left: 160px; top: 0;"/>
  </div>
</div>

{% stylesheet %}
  @keyframes letterPulse {
    0% {
      opacity: 0;
      transform: scale(0.4);
    }
    50% {
      opacity: 1;
      transform: scale(1.1);
    }
    100% {
      opacity: 1;
      transform: scale(1);
    }
  }

  .letter-svg {
    transform-origin: center;
    opacity: 0.3;
    transition: opacity 0.3s ease;
  }

  .letter-svg.animate {
    animation: letterPulse 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }

  .letter-svg[data-letter="0"].animate {
    animation-delay: 0s;
  }

  .letter-svg[data-letter="1"].animate {
    animation-delay: 0.1s;
  }

  .letter-svg[data-letter="2"].animate {
    animation-delay: 0.2s;
  }

  .letter-svg[data-letter="3"].animate {
    animation-delay: 0.3s;
  }

  .letter-svg[data-letter="4"].animate {
    animation-delay: 0.4s;
  }

  .letter-svg[data-letter="5"].animate {
    animation-delay: 0.5s;
  }

  .letter-svg[data-letter="6"].animate {
    animation-delay: 0.6s;
  }
{% endstylesheet %}

{% javascript %}
  class PageLoader {
    constructor() {
      this.loader = document.getElementById('page-loader');
      this.letters = Array.from(document.querySelectorAll('.letter-svg'));
      this.isVisible = true;
      this.animationTimeout = null;
      this.init();
    }

    init() {
      document.addEventListener('DOMContentLoaded', () => this.hide());
      document.addEventListener('click', (e) => this.handleNavigation(e));
    }

    startAnimation() {
      this.letters.forEach((letter) => {
        letter.classList.remove('animate');
      });

      setTimeout(() => {
        this.letters.forEach((letter) => {
          letter.classList.add('animate');
        });
      }, 10);

      this.animationTimeout = setTimeout(() => {
        this.startAnimation();
      }, 1400);
    }

    show() {
      this.loader.style.display = 'flex';
      this.isVisible = true;
      this.startAnimation();
    }

    hide() {
      this.loader.style.display = 'none';
      this.isVisible = false;
      if (this.animationTimeout) {
        clearTimeout(this.animationTimeout);
      }
      this.letters.forEach((letter) => {
        letter.classList.remove('animate');
      });
    }

    handleNavigation(e) {
      const link = e.target.closest('a');
      if (link && link.href) {
        if (link.target === '_blank' || link.target === '_parent') return;

        try {
          const linkUrl = new URL(link.href, window.location.origin);
          const isExternal = linkUrl.origin !== window.location.origin;
          const isAnchor = link.href.startsWith('#');
          const isDownload = link.hasAttribute('download');

          if (!isExternal && !isAnchor && !isDownload) {
            this.show();
          }
        } catch (e) {
          // Invalid URL, ignore
        }
      }
    }
  }

  new PageLoader();
{% endjavascript %}
