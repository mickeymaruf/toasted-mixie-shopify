{% doc %}
  Renders one cart line item row for the cart drawer: image, title, variant
  title, purchase type (one-time or subscription), price, quantity
  stepper, and a remove button.

  @param {object} item - A `cart.items` line item
  @param {number} line - The 1-based index of `item` within `cart.items`, used for `/cart/change.js`

  @example
  {% for item in cart.items %}
    {% render 'cart-drawer-item', item: item, line: forloop.index %}
  {% endfor %}
{% enddoc %}

{% liquid
  assign variant_title = item.variant.title
  if variant_title == 'Default Title'
    assign variant_title = blank
  endif

  if item.selling_plan_allocation
    assign purchase_type = item.selling_plan_allocation.selling_plan.name
  else
    assign purchase_type = 'cart_drawer.one_time' | t
  endif
%}

<div class="flex w-full items-start gap-[14px]" data-line="{{ line }}">
  <div class="size-[99px] shrink-0 overflow-hidden rounded-lg border border-[#F6F1EC] bg-[#F6F1EC]">
    {{
      item.image
      | image_url: width: 200
      | image_tag: width: 200, height: 200, class: 'size-full object-contain', alt: item.image.alt
    }}
  </div>

  <div class="flex h-[99px] flex-1 flex-col items-start justify-between">
    <div class="flex w-full items-start justify-between gap-2">
      <div class="flex flex-col gap-px text-[#212323]">
        <p class="text-[16px] leading-[1.3] font-medium">{{ item.product.title }}</p>
        <div class="flex flex-col gap-[2px] text-[12px] leading-[1.3]">
          {% if variant_title != blank %}
            <p>{{ variant_title }}</p>
          {% endif %}
          <p>{{ purchase_type }}</p>
        </div>
      </div>

      <a
        href="{{ item.url_to_remove }}"
        class="flex size-5 shrink-0 items-center justify-center text-[#212323]"
        data-cart-remove
        aria-label="{{ 'cart_drawer.remove_item' | t: title: item.product.title }}"
      >
        {{ 'icon-trash.svg' | inline_asset_content }}
      </a>
    </div>

    <div class="flex w-full items-center justify-between">
      <p class="text-[24px] leading-[1.5] font-medium text-[#212323]">{% render 'format-money', cents: item.final_line_price %}</p>
      {% render 'quantity-stepper', quantity: item.quantity, min: 0 %}
    </div>
  </div>
</div>
