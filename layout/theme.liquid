<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="scroll-smooth">
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% comment %}
      Font preloading:
      1. Preload only the critical font variants (Neue Haas Display Roman for body,
         Degular Display Regular for headings)
      2. Additional variants load on-demand via @font-face
    {% endcomment %}
    {{ 'NeueHaasDisplayRoman.ttf' | asset_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {{ 'DegularDisplay-Regular.otf' | asset_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {% # Load the Tailwind CSS build %}
    {{ 'tailwind.css' | asset_url | stylesheet_tag }}

    {% # Swiper carousel vendor library, shared by any section/snippet that renders a carousel %}
    {{ 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css' | stylesheet_tag }}
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" defer="defer"></script>

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}
  </head>

  <body>
    {% comment %}{% render 'page-loader' %}{% endcomment %}

    {% sections 'header-group' %}

    {{ content_for_layout }}

    {% sections 'footer-group' %}

    {% section 'cart-drawer' %}
  </body>
</html>
