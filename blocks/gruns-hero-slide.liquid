{% doc %}
  Renders a single Gruns hero slide: background image with optional overlay
  image, a foreground product image, heading, description,
  button, perks row, optional trust-badge rows and an optional right side
  image block. Nest inside the Gruns hero section, which runs the Swiper
  slideshow and its arrow navigation.

  @example
  {% content_for 'block', id: block.id, type: 'gruns-hero-slide' %}
{% enddoc %}

{% liquid
  assign mobile_frame = block.settings.mobile_frame | default: 'none'
  assign has_frame = false
  assign frame_top = 344
  assign frame_text_width = 309
  case mobile_frame
    when 'chill'
      assign has_frame = true
      assign frame_top = 302
    when 'trial'
      assign has_frame = true
    when 'subscribe'
      assign has_frame = true
      assign frame_text_width = 335
  endcase
  assign frame_bg = 'hero-mobile-frame-' | append: mobile_frame | append: '.jpg'
%}

<div
  class="gruns-hero-slide relative flex min-h-[var(--hero-min-height,100svh)] w-full flex-col justify-end overflow-hidden pt-[12px] pb-[calc(var(--corner-radius)+1.5rem)] sm:flex sm:min-h-[var(--hero-min-height,46.875vw)] sm:flex-col sm:justify-center sm:py-[var(--hero-pad-y,11.7vw)]{% if has_frame %} gruns-hero-slide--frame gruns-hero-slide--frame-{{ mobile_frame }}{% endif %}"
  style="background-color: {{ block.settings.background_color }};{% if has_frame %} --frame-top: {{ frame_top }}; --frame-text-w: {{ frame_text_width }};{% endif %}"
  {{ block.shopify_attributes }}
>
  {% liquid
    assign description_desktop_visibility = ''
    assign description_mobile_visibility = ''

    if block.settings.description != blank and block.settings.description_mobile != blank
      assign description_desktop_visibility = 'hidden sm:block '
      assign description_mobile_visibility = 'sm:hidden '
    endif

    assign badge_desktop_visibility = ''
    assign badge_mobile_visibility = ''

    if block.settings.badge_image != blank and block.settings.badge_image_mobile != blank
      assign badge_desktop_visibility = 'hidden sm:block '
      assign badge_mobile_visibility = 'sm:hidden '
    endif

    assign image_loading = 'lazy'
    assign image_priority = 'auto'
    if section.blocks.first.id == block.id
      assign image_loading = 'eager'
      assign image_priority = 'high'
    endif

    assign overlay_image_class = 'absolute inset-0 size-full max-w-none object-cover'
    if block.settings.overlay_blend == 'multiply'
      assign overlay_image_class = overlay_image_class | append: ' mix-blend-multiply'
    endif
    assign overlay_opacity = block.settings.overlay_image_opacity | divided_by: 100.0
    assign overlay_image_style = 'opacity: ' | append: overlay_opacity

    case block.settings.skyline_image_position
      when 'left'
        assign skyline_focus_x = '0%'
      when 'right'
        assign skyline_focus_x = '100%'
      else
        assign skyline_focus_x = '50%'
    endcase

    assign skyline_focus_y = block.settings.skyline_image_focus_y | default: 100
    assign skyline_image_class = 'size-full max-w-none object-cover'
    assign skyline_image_style = 'object-position: ' | append: skyline_focus_x | append: ' ' | append: skyline_focus_y | append: '%'

    assign badge_desktop_class = badge_desktop_visibility | append: 'w-full h-auto object-contain'
    assign badge_mobile_class = badge_mobile_visibility | append: 'w-full h-auto object-contain'

  %}

  {% if block.settings.show_skyline_image %}
    <div
      class="pointer-events-none absolute inset-0 z-0 overflow-hidden{% if has_frame %} max-sm:hidden{% endif %}"
      aria-hidden="true"
      data-hero-bg
      data-subject-top="{{ block.settings.skyline_subject_top }}"
      data-subject-bottom="{{ block.settings.skyline_subject_bottom }}"
    >
      <picture class="block size-full">
        {% if block.settings.skyline_image_mobile %}
          {% if block.settings.skyline_image %}
            <source
              media="(min-width: 40rem)"
              srcset="{{ block.settings.skyline_image | image_url }}"
            >
          {% endif %}
          <img
            src="{{ block.settings.skyline_image_mobile | image_url }}"
            class="{{ skyline_image_class }}"
            style="{{ skyline_image_style }}"
            width="{{ block.settings.skyline_image_mobile.width }}"
            height="{{ block.settings.skyline_image_mobile.height }}"
            loading="{{ image_loading }}"
            fetchpriority="{{ image_priority }}"
            decoding="async"
            alt=""
          >
        {% elsif block.settings.skyline_image %}
          <img
            src="{{ block.settings.skyline_image | image_url }}"
            class="{{ skyline_image_class }}"
            style="{{ skyline_image_style }}"
            width="{{ block.settings.skyline_image.width }}"
            height="{{ block.settings.skyline_image.height }}"
            loading="{{ image_loading }}"
            fetchpriority="{{ image_priority }}"
            decoding="async"
            alt=""
          >
        {% endif %}
      </picture>
    </div>
  {% endif %}

  {% if block.settings.overlay_image != blank %}
    <div class="pointer-events-none absolute inset-0 z-0 overflow-hidden{% if has_frame %} max-sm:hidden{% endif %}" aria-hidden="true">
      {% if block.settings.overlay_image != blank %}
        <img
          src="{{ block.settings.overlay_image | image_url }}"
          class="{{ overlay_image_class }}"
          style="{{ overlay_image_style }}"
          width="{{ block.settings.overlay_image.width }}"
          height="{{ block.settings.overlay_image.height }}"
          loading="{{ image_loading }}"
          decoding="async"
          alt=""
        >
      {% endif %}
    </div>
  {% endif %}

  {% if has_frame %}
    <div class="pointer-events-none absolute inset-0 z-0 overflow-hidden sm:hidden" aria-hidden="true">
      <img
        src="{{ frame_bg | asset_url }}"
        class="absolute inset-0 size-full max-w-none object-cover object-top"
        width="1125"
        height="1848"
        loading="{{ image_loading }}"
        fetchpriority="{{ image_priority }}"
        decoding="async"
        alt=""
      >
    </div>
    {% if mobile_frame == 'subscribe' %}
      <img
        src="{{ 'hero-mobile-subscribe-product.png' | asset_url }}"
        class="pointer-events-none absolute top-[calc(18*var(--u))] left-0 z-[5] w-full max-w-none sm:hidden"
        width="1500"
        height="1644"
        loading="{{ image_loading }}"
        fetchpriority="{{ image_priority }}"
        decoding="async"
        alt="{{ block.settings.foreground_image_alt }}"
      >
    {% endif %}
  {% endif %}

  {% if section.settings.extend_behind_navbar %}
    <div class="h-[var(--corner-radius)]" aria-hidden="true" data-hero-spacer></div>
  {% endif %}

  {% if block.settings.foreground_image != blank %}
    <div class="pointer-events-none relative z-[5]{% if mobile_frame == 'subscribe' %} max-sm:hidden{% endif %} mb-6 w-[77%] max-w-none self-center sm:absolute sm:top-[51.5%] sm:left-[68.6vw] sm:mx-0 sm:mb-0 sm:h-[min(38.3vw,84%)] sm:w-auto sm:max-w-none sm:-translate-x-[46.84%] sm:-translate-y-1/2 sm:self-auto">
      {{
        block.settings.foreground_image
        | image_url: width: 3200
        | image_tag:
          class: 'h-auto w-full sm:h-full sm:w-auto sm:max-w-none',
          widths: '640, 960, 1280, 1600, 1920, 2400, 3200',
          sizes: '(min-width: 640px) 47vw, 77vw',
          loading: image_loading,
          fetchpriority: image_priority,
          decoding: 'async',
          alt: block.settings.foreground_image_alt
      }}
    </div>
  {% endif %}

  <div
    data-hero-content
    class="relative z-10 flex w-full flex-col gap-3 px-5 sm:grid sm:grid-cols-[47.3fr_52.7fr] sm:items-center sm:gap-x-[4.1667vw] sm:px-[5.5556vw] xl:px-[9.0278vw]"
  >
    <div class="order-2 flex w-full flex-col items-center text-center sm:order-none sm:col-start-1 sm:items-start sm:text-left">
      {% if block.settings.heading != blank %}
        <div
          data-hero-heading
          class="drop-shadow-[-1px_1px_1.7px_rgba(0,0,0,0.4)] font-[family-name:var(--font-heading--family)] font-bold text-[46px] leading-[95%] whitespace-nowrap text-[color:var(--gruns-hero-heading-color)] sm:text-[4.4444vw] xl:text-[5.9028vw]"
          style="--gruns-hero-heading-color: {{ block.settings.heading_color }};"
        >
          {{ block.settings.heading }}
        </div>
      {% endif %}

      {% if block.settings.description != blank %}
        <div
          data-hero-description
          class="{{ description_desktop_visibility }}drop-shadow-[-1px_1px_1.7px_rgba(0,0,0,0.4)] mt-[5px] font-[family-name:var(--font-heading--family)] text-[20px] leading-[1.2] tracking-normal font-semibold text-[color:var(--gruns-hero-heading-color)] sm:text-[1.6667vw] xl:text-[2.0833vw]"
          style="--gruns-hero-heading-color: {{ block.settings.heading_color }};"
        >
          {{ block.settings.description }}
        </div>
      {% endif %}

      {% if block.settings.description_mobile != blank %}
        <div
          data-hero-description
          class="{{ description_mobile_visibility }}drop-shadow-[-1px_1px_1.7px_rgba(0,0,0,0.4)] mt-4 font-[family-name:var(--font-heading--family)] text-[20px] leading-[1.3] font-semibold text-[color:var(--gruns-hero-heading-color)] sm:mt-5"
          style="--gruns-hero-heading-color: {{ block.settings.heading_color }};"
        >
          {{ block.settings.description_mobile }}
        </div>
      {% endif %}

      {% if block.settings.show_button and block.settings.button_label != blank or block.settings.show_perks %}
        <div class="mt-4 flex w-fit flex-col items-center gap-[10px] sm:mt-[2.0833vw]" data-hero-actions>
          {% liquid
            assign button_class = 'whitespace-nowrap !rounded-[30px] max-lg:sm:!px-[max(24px,2.9167vw)] max-lg:sm:!py-[max(10px,1.1111vw)] max-lg:sm:!text-[max(14px,1.5vw)] drop-shadow-[-2px_3px_2.85px_rgba(0,0,0,0.25)]'
            if has_frame
              assign button_class = button_class | append: ' !px-[calc(26*var(--u))] !py-[calc(8*var(--u))] !text-[length:calc(14*var(--u))] !leading-[calc(27*var(--u))] sm:!px-[42px] sm:!py-[16px] sm:!text-[20px] sm:!leading-[1.5]'
            else
              assign button_class = button_class | append: ' !px-[42px] !py-[16px] !text-[20px] !leading-[1.5]'
            endif
          %}
          {% if block.settings.show_button and block.settings.button_label != blank %}
            {% render 'button',
              label: block.settings.button_label,
              url: block.settings.button_link,
              background_color: block.settings.button_background_color,
              text_color: block.settings.button_text_color,
              class: button_class
            %}
          {% endif %}

          {% if block.settings.show_perks %}
            <div
              data-hero-perks
              class="flex items-center justify-center gap-[15px] text-[14px] leading-[1.5] text-[color:var(--gruns-hero-perks-color)] drop-shadow-[-1px_1px_1.7px_rgba(0,0,0,0.4)]"
              style="--gruns-hero-perks-color: {{ block.settings.perks_text_color }};"
            >
              {% for index in (1..2) %}
                {% liquid
                  assign icon_key = 'perk_' | append: index | append: '_icon'
                  assign text_key = 'perk_' | append: index | append: '_text'
                  assign perk_icon = block.settings[icon_key]
                  assign perk_text = block.settings[text_key]
                  assign style_key = 'perk_' | append: index | append: '_icon_style'
                  assign icon_style = block.settings[style_key]
                  case icon_style
                    when 'check'
                      assign default_icon = 'icon-check-guarantee.svg'
                      assign default_icon_width = 14.625
                      assign default_icon_height = 11.375
                    when 'truck'
                      assign default_icon = 'icon-no-subscription.svg'
                      assign default_icon_width = 17
                      assign default_icon_height = 13
                    else
                      assign default_icon = 'icon-one-per-customer.svg'
                      assign default_icon_width = 16.5
                      assign default_icon_height = 16.5
                  endcase
                %}
                {% if perk_text != blank %}
                  <div class="flex items-center gap-[5px] whitespace-nowrap">
                    <span class="flex h-[16.5px] w-[17px] shrink-0 items-center justify-center" data-perk-icon="{{ icon_style | default: 'box' }}"{% if perk_icon %} data-perk-custom{% endif %}>
                    {% if perk_icon %}
                      {{
                        perk_icon
                        | image_url: width: 64
                        | image_tag: class: 'h-[16.5px] w-[17px] shrink-0 object-contain', width: 17, height: 17, loading: 'lazy', alt: ''
                      }}
                    {% else %}
                      <img
                        src="{{ default_icon | asset_url }}"
                        alt=""
                        class="max-h-full max-w-full shrink-0"
                        width="{{ default_icon_width }}"
                        height="{{ default_icon_height }}"
                        loading="lazy"
                      >
                    {% endif %}
                    </span>
                    <span>{{ perk_text }}</span>
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          {% endif %}
        </div>
      {% endif %}

      <div class="gruns-hero-benefits mt-8 sm:mt-[3.4722vw]">
        {% content_for 'blocks' %}
      </div>
    </div>

    {% if block.settings.show_right_side_content %}
    {% if block.settings.can_image_1 or block.settings.can_image_2 or block.settings.can_image_3 or block.settings.cans_background_image %}
      <div class="order-1 mx-auto mb-3 w-full shrink-0 sm:order-none sm:col-start-2 sm:mb-0 sm:max-w-none">
        <div class="relative mx-auto w-full" style="aspect-ratio: 624 / 516;">
          <div
            class="absolute overflow-hidden rounded-[24px] sm:rounded-[2.5vw]"
            style="
              left: -0.24%;
              top: 0%;
              width: 98.88%;
              height: 92.44%;
            "
          >
            {% if block.settings.cans_background_image %}
              {{
                block.settings.cans_background_image
                | image_url: width: 1200
                | image_tag:
                  class: 'absolute inset-0 size-full max-w-none object-cover',
                  widths: '600, 900, 1200',
                  loading: 'lazy',
                  alt: ''
              }}
            {% endif %}
            <div
              class="pointer-events-none absolute inset-0"
              style="background-image: linear-gradient(143deg, rgba(0, 0, 0, 0.55) 3%, rgba(0, 0, 0, 0) 34%);"
            ></div>
          </div>

          {% if block.settings.show_badge %}
            <div
              class="absolute"
              style="left: 4.53%; top: 5.69%; width: 16.12%;"
            >
              {% if block.settings.badge_image %}
                {{
                  block.settings.badge_image
                  | image_url: width: 1200
                  | image_tag:
                    class: badge_desktop_class,
                    widths: '160, 240, 320, 480, 640, 960, 1200',
                    sizes: '(min-width: 1024px) 12vw, (min-width: 640px) 86px, 16vw',
                    loading: 'lazy',
                    alt: block.settings.badge_image_alt
                }}
              {% endif %}

              {% if block.settings.badge_image_mobile %}
                {{
                  block.settings.badge_image_mobile
                  | image_url: width: 1200
                  | image_tag:
                    class: badge_mobile_class,
                    widths: '160, 240, 320, 480, 640, 960, 1200',
                    sizes: '(min-width: 640px) 86px, 16vw',
                    loading: 'lazy',
                    alt: block.settings.badge_image_alt
                }}
              {% endif %}

              {% if block.settings.badge_image == blank and block.settings.badge_image_mobile == blank %}
                <img
                  src="{{ 'built-on-trust-badge.png' | asset_url }}"
                  alt="{{ block.settings.badge_image_alt }}"
                  class="w-full h-auto object-contain"
                  loading="lazy"
                  width="266"
                  height="209"
                >
              {% endif %}
            </div>
          {% endif %}

          <div class="absolute" style="left: 57.81%; top: 47.48%; width: 42.55%; height: 52.43%;">
            {% render 'gruns-hero-can-image',
              image: block.settings.can_image_3,
              alt: block.settings.can_image_3_alt,
              modifier: 'compact-back-left'
            %}
            {% render 'gruns-hero-can-image',
              image: block.settings.can_image_2,
              alt: block.settings.can_image_2_alt,
              modifier: 'compact-back-right'
            %}
            {% render 'gruns-hero-can-image',
              image: block.settings.can_image_1,
              alt: block.settings.can_image_1_alt,
              modifier: 'compact-front-center'
            %}
          </div>
        </div>
      </div>
    {% endif %}
    {% endif %}
  </div>
</div>

{% stylesheet %}
  /* Mobile Figma layout. Every value is a pixel value from the 375px-wide Figma frame (frame 670px tall,
     header 75px, the slide starts 54px into the frame because the navbar overlaps it by the corner radius),
     multiplied by --u (one Figma pixel at the current screen width). Background, product image, text and
     badges therefore scale together, so the composition is identical on every phone width and the text
     never slides over the products. */
  @media (max-width: 39.9375rem) {
    .gruns-hero-slide--frame {
      --u: calc(100vw / 375);
      display: block;
      height: calc(616 * var(--u));
      min-height: 0;
      padding: 0;
    }

    .gruns-hero-slide--frame [data-hero-spacer] {
      display: none;
    }

    .gruns-hero-slide--frame [data-hero-content] {
      position: absolute;
      top: calc(var(--frame-top) * var(--u));
      right: 0;
      left: 0;
      display: block;
      padding-inline: calc(20 * var(--u));
    }

    .gruns-hero-slide--frame [data-hero-heading] {
      max-width: calc(var(--frame-text-w) * var(--u));
      font-size: calc(38 * var(--u));
      line-height: calc(35.547 * var(--u));
      letter-spacing: normal;
    }

    .gruns-hero-slide--frame-trial [data-hero-heading] em {
      font-style: normal;
    }

    .gruns-hero-slide--frame [data-hero-description] {
      max-width: calc(var(--frame-text-w) * var(--u));
      margin-top: calc(6 * var(--u));
      white-space: nowrap;
      font-size: calc(18 * var(--u));
      line-height: 0.95;
      letter-spacing: normal;
    }

    .gruns-hero-slide--frame [data-hero-actions] {
      margin-top: calc(20 * var(--u));
      gap: calc(10 * var(--u));
    }

    .gruns-hero-slide--frame [data-hero-actions] .button {
      letter-spacing: normal;
      filter: drop-shadow(calc(-2 * var(--u)) calc(3 * var(--u)) calc(2.85 * var(--u)) rgba(0, 0, 0, 0.22));
    }

    .gruns-hero-slide--frame [data-hero-perks] {
      gap: calc(15 * var(--u));
      font-size: calc(12 * var(--u));
      line-height: 1.5;
    }

    .gruns-hero-slide--frame [data-hero-perks] > div {
      gap: calc(5 * var(--u));
    }

    .gruns-hero-slide--frame [data-perk-icon] {
      width: calc(17 * var(--u));
      height: calc(16.5 * var(--u));
    }

    .gruns-hero-slide--frame [data-perk-icon] img {
      width: auto;
      height: auto;
      max-width: 100%;
      max-height: 100%;
    }

    .gruns-hero-slide--frame [data-perk-icon='box']:not([data-perk-custom]),
    .gruns-hero-slide--frame [data-perk-icon='box']:not([data-perk-custom]) img {
      width: calc(15 * var(--u));
      height: calc(15 * var(--u));
    }

    .gruns-hero-slide--frame [data-perk-icon='truck']:not([data-perk-custom]),
    .gruns-hero-slide--frame [data-perk-icon='truck']:not([data-perk-custom]) img {
      width: calc(16 * var(--u));
      height: calc(13 * var(--u));
    }

    .gruns-hero-slide--frame [data-perk-icon='check']:not([data-perk-custom]),
    .gruns-hero-slide--frame [data-perk-icon='check']:not([data-perk-custom]) img {
      width: calc(14.625 * var(--u));
      height: calc(11.375 * var(--u));
    }

    .gruns-hero-slide--frame .gruns-hero-benefits {
      margin-top: calc(20 * var(--u));
    }

    /* Trust badge row: three columns placed exactly like the Figma frame (335 x 85.294) */
    .gruns-hero-slide--frame .gruns-hero-benefits .badge-row {
      position: relative;
      display: block;
      width: calc(335 * var(--u));
      height: calc(85.294 * var(--u));
      margin-inline: auto;
    }

    .gruns-hero-slide--frame .badge-row > * {
      position: absolute;
      top: 0;
      height: calc(85.294 * var(--u));
    }

    .gruns-hero-slide--frame .badge-row > * .trust-badge {
      position: static;
      display: block;
      width: auto;
    }

    .gruns-hero-slide--frame .badge-row .trust-badge__icon {
      position: absolute;
      margin: 0;
      filter: none;
    }

    .gruns-hero-slide--frame .badge-row .trust-badge__icon img {
      width: 100%;
      height: 100%;
    }

    .gruns-hero-slide--frame .badge-row .trust-badge > div:last-child {
      position: absolute;
      right: 0;
      bottom: 0;
      left: 0;
      filter: none;
    }

    .gruns-hero-slide--frame .badge-row .trust-badge__label {
      font-size: calc(12 * var(--u));
      font-weight: 500;
      line-height: calc(14 * var(--u));
      letter-spacing: normal;
      white-space: nowrap;
    }

    .gruns-hero-slide--frame .badge-row .trust-badge > div:last-child > p {
      margin: 0;
      font-size: calc(12 * var(--u));
      font-weight: 400;
      line-height: calc(14 * var(--u));
      letter-spacing: normal;
      white-space: nowrap;
    }

    .gruns-hero-slide--frame .badge-row > :nth-child(1) {
      left: calc(-0.5 * var(--u));
      width: calc(113 * var(--u));
    }

    .gruns-hero-slide--frame .badge-row > :nth-child(1) .trust-badge__icon {
      top: calc(-5.51 * var(--u));
      left: calc(25.23 * var(--u));
      width: calc(59.71 * var(--u));
      height: calc(58.9 * var(--u));
    }

    .gruns-hero-slide--frame .badge-row > :nth-child(2) {
      left: calc(117.5 * var(--u));
      width: calc(104 * var(--u));
    }

    .gruns-hero-slide--frame .badge-row > :nth-child(2) .trust-badge__icon {
      top: calc(-5.51 * var(--u));
      left: calc(23.93 * var(--u));
      width: calc(53.29 * var(--u));
      height: calc(62.58 * var(--u));
    }

    .gruns-hero-slide--frame .badge-row > :nth-child(3) {
      left: calc(232.5 * var(--u));
      width: calc(103 * var(--u));
    }

    .gruns-hero-slide--frame .badge-row > :nth-child(3) .trust-badge__icon {
      top: calc(6.56 * var(--u));
      left: calc(18.9 * var(--u));
      width: calc(62.4 * var(--u));
      height: calc(45.5 * var(--u));
    }
  }

  /* No badge row on this slide: drop the wrapper so its top margin does not add extra bottom space */
  .gruns-hero-benefits:not(:has(*)) {
    display: none;
  }

  /* Three equal columns so every icon sits at the center of its column (and the middle
     one at the center of the screen), whatever the width of the labels. */
  .gruns-hero-benefits .badge-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: start;
    justify-items: center;
    column-gap: 12px;
    row-gap: 16px;
  }

  .gruns-hero-benefits .trust-badge {
    width: 100%;
    min-width: 0;
  }

  /* Mobile sizes taken from the iPhone 17 export: at 12px / 11.5px every label
     and description fits its column on one line, which is what keeps the hero
     from growing past the fold. nowrap guards the fit on narrower handsets. */
  @media (max-width: 39.9375rem) {
    .gruns-hero-benefits .trust-badge__label {
      font-size: 12px;
      white-space: nowrap;
    }

    .gruns-hero-benefits .trust-badge > div > p {
      font-size: 11.5px;
      white-space: nowrap;
    }
  }

  @media (min-width: 40rem) {
    .gruns-hero-benefits .badge-row {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-end;
      justify-content: flex-start;
      column-gap: 21px;
    }

    .gruns-hero-benefits .trust-badge {
      flex: none;
      width: auto;
    }
  }
{% endstylesheet %}


