{% doc %}
  Renders a single flavor card with a full-width product image, an
  editable flavor name/description/price, static pack-size options and a
  "Shop" button linking to the selected product's page. Intended to be
  nested inside the Gruns Product List section.

  @example
  {% content_for 'block', id: block.id, type: 'product-card' %}
{% enddoc %}

<div
  class="mx-auto flex w-full max-w-full flex-col items-center gap-3 sm:max-w-[386.667px] sm:gap-[30px]"
  {{ block.shopify_attributes }}
>
  <div class="relative flex w-full items-center justify-center overflow-hidden rounded-[16px] sm:rounded-[30px]">
    {% if block.settings.image %}
      {{
        block.settings.image
        | image_url: width: 800
        | image_tag:
          class: 'size-full object-cover',
          widths: '400, 600, 800, 1000',
          alt: block.settings.image.alt | default: block.settings.flavor_name
      }}
    {% elsif block.settings.product.featured_image %}
      {{
        block.settings.product.featured_image
        | image_url: width: 800
        | image_tag:
          class: 'size-full object-cover',
          widths: '400, 600, 800, 1000',
          alt: block.settings.product.featured_image.alt | default: block.settings.flavor_name
      }}
    {% endif %}

    {% if block.settings.use_lottie_animation %}
      <dotlottie-wc
        src="{{ 'animation-ginger-lime.lottie' | asset_url }}"
        autoplay
        loop
        speed="0.5"
        useFrameInterpolation
        class="absolute inset-0 size-full object-cover"
      ></dotlottie-wc>
    {% endif %}
  </div>

  <div class="flex w-full max-w-full flex-col items-center gap-2 sm:max-w-[360px] sm:gap-5">
    {% if block.settings.flavor_name != blank or block.settings.description != blank %}
      <div class="flex flex-col items-center gap-[5px] text-center">
        {% if block.settings.flavor_name != blank %}
          <p class="text-[18px] leading-[1.2] font-medium sm:text-[32px]">
            {{ block.settings.flavor_name }}
          </p>
        {% endif %}

        {% comment %}
          {% if block.settings.description != blank %}
            <p class="text-[16px] leading-[1.3] text-[#212323]">{{ block.settings.description }}</p>
          {% endif %}
        {% endcomment %}
      </div>
    {% endif %}

    {% if block.settings.price_text != blank %}
      <p class="-mt-2 text-[14px] leading-[1.3] font-medium text-[#212323] sm:-mt-4 sm:text-[18px]">
        {{ block.settings.price_text }}
      </p>
    {% endif %}

    {% comment %}
      <div class="flex w-full flex-col items-center gap-[10px]">
        <p class="text-[16px] leading-[1.3] text-[#212323]">{{ 'products.list.available_in' | t }}</p>
        <div class="flex h-[27px] w-full items-center justify-center gap-[10px]">
          <div class="flex h-full flex-1 items-center justify-center rounded-full border border-[#212323] py-[5px]">
            <p class="text-[16px] leading-[1.3] whitespace-nowrap text-[#212323]">{{ 'products.list.pack_12' | t }}</p>
          </div>
          <div class="flex h-full flex-1 items-center justify-center rounded-full border border-[#212323] py-[5px]">
            <p class="text-[16px] leading-[1.3] whitespace-nowrap text-[#212323]">{{ 'products.list.pack_24' | t }}</p>
          </div>
          <div class="flex h-full flex-1 items-center justify-center rounded-full border border-[#212323] py-[5px]">
            <p class="text-[16px] leading-[1.3] whitespace-nowrap text-[#212323]">{{ 'products.list.pack_36' | t }}</p>
          </div>
        </div>
      </div>
    {% endcomment %}

    {% if block.settings.button_label != blank %}
      {% render 'button',
        label: block.settings.button_label,
        url: block.settings.product.url,
        background_color: block.settings.button_background_color,
        text_color: block.settings.button_text_color,
        class: 'w-full'
      %}
    {% endif %}

    {% if block.settings.product != blank %}
      <a
        href="{{ block.settings.product.url }}"
        class="text-[14px] leading-[1.3] text-[#212323] underline underline-offset-2 sm:text-[18px]"
      >
        {{ 'products.list.learn_more' | t }}
      </a>
    {% endif %}
  </div>
</div>

{% javascript %}
  if (!customElements.get('dotlottie-wc')) {
    import('https://cdn.jsdelivr.net/npm/@lottiefiles/dotlottie-wc@0.9.25/dist/dotlottie-wc.js');
  }
{% endjavascript %}

{% schema %}
{
  "name": "t:general.product_card",
  "settings": [
    {
      "type": "header",
      "content": "t:general.product"
    },
    {
      "type": "product",
      "id": "product",
      "label": "t:labels.product"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image",
      "info": "t:labels.image_info"
    },
    {
      "type": "header",
      "content": "t:general.animation"
    },
    {
      "type": "checkbox",
      "id": "use_lottie_animation",
      "label": "t:labels.use_lottie_animation",
      "info": "t:labels.use_lottie_animation_info",
      "default": false
    },
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "text",
      "id": "flavor_name",
      "label": "t:labels.flavor_name",
      "default": "Blood Orange"
    },
    {
      "type": "color",
      "id": "flavor_name_color",
      "label": "t:labels.flavor_name_color",
      "default": "#B70141"
    },
    {
      "type": "text",
      "id": "description",
      "label": "t:labels.description",
      "default": "Bright. Smooth. Golden-hour ready."
    },
    {
      "type": "text",
      "id": "price_text",
      "label": "t:labels.price_text",
      "default": "From $9.99"
    },
    {
      "type": "header",
      "content": "t:general.button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label",
      "default": "Shop Blood Orange"
    },
    {
      "type": "color",
      "id": "button_background_color",
      "label": "t:labels.button_background",
      "default": "#212323"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "t:labels.button_text_color",
      "default": "#F6F1EC"
    }
  ],
  "presets": [{ "name": "t:general.product_card" }]
}
{% endschema %}
