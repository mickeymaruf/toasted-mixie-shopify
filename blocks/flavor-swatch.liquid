{% doc %}
  Renders a single flavor swatch — a small card with a product render and
  the flavor name, linking to that flavor's own product page. Intended to
  populate the main product section's "Choose your Flavor" row.

  Shows an active border when its linked product is the product currently
  being viewed.

  @example
  {% content_for 'block', id: block.id, type: 'flavor-swatch' %}
{% enddoc %}

{% liquid
  assign swatch_image = block.settings.swatch_image | default: block.settings.product.featured_image
  assign is_active = false
  if block.settings.product and block.settings.product.id == product.id
    assign is_active = true
  endif
%}

<a
  href="{{ block.settings.product.url }}"
  class="flex w-[109px] shrink-0 min-w-0 flex-col items-center gap-[6px] sm:w-auto sm:shrink sm:gap-[10px] rounded-[10px] border-2 px-[3px] sm:px-[5px] pt-[3px] sm:pt-[5px] pb-[8px] sm:pb-[10px] {% if is_active %}bg-[#F6F1EC]{% endif %}"
  style="{% if is_active %}border-color: {{ block.settings.color }}{% else %}border-color: #C2CBD4{% endif %}"
  {{ block.shopify_attributes }}
>
  <div class="relative flex h-[100px] max-w-[109px] shrink-0 items-center justify-center overflow-hidden rounded-[8px] bg-[#F0F0F0] sm:h-[122px]">
    {% if swatch_image %}
      {{
        swatch_image
        | image_url: width: 220
        | image_tag:
          width: 220,
          height: 248,
          class: 'w-full h-full object-cover',
          alt: block.settings.flavor_name
      }}
    {% endif %}
  </div>

  {% if block.settings.flavor_name != blank %}
    <p class="text-xs sm:text-[14px] leading-none font-medium whitespace-nowrap text-[#212323]">
      {{ block.settings.flavor_name }}
    </p>
  {% elsif block.settings.product != blank %}
    <p class="text-xs sm:text-[14px] leading-none font-medium whitespace-nowrap text-[#212323]">
      {{ block.settings.product.title }}
    </p>
  {% endif %}
</a>

{% schema %}
{
  "name": "t:general.flavor_swatch",
  "settings": [
    {
      "type": "header",
      "content": "t:general.product"
    },
    {
      "type": "product",
      "id": "product",
      "label": "t:labels.product"
    },
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "text",
      "id": "flavor_name",
      "label": "t:labels.flavor_name",
      "default": "Blood Orange"
    },
    {
      "type": "image_picker",
      "id": "swatch_image",
      "label": "t:labels.swatch_image"
    },
    {
      "type": "color",
      "id": "color",
      "label": "t:labels.color",
      "default": "#212323"
    }
  ],
  "presets": [{ "name": "t:general.flavor_swatch" }]
}
{% endschema %}
