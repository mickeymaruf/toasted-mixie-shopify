{% doc %}
  Renders one full-width row of the Story Tiles section as a 3-unit grid.
  Nest story-tile-text and story-tile-image blocks inside; each cell's
  "width" setting (1 or 2 units) controls how much of the row it spans, so
  a row's cells should add up to 3 units in total (e.g. 1+1+1 or 1+2).

  @example
  {% content_for 'block', id: block.id, type: 'story-tile-row' %}
{% enddoc %}

<div
  class="story-tile-row flex w-full flex-col border-y-[3px] border-[#212323] md:grid md:grid-cols-3 lg:aspect-[3/1]"
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</div>

{% stylesheet %}
  .story-tile-row > .shopify-block {
    display: contents;
  }

  .shopify-block + .shopify-block > .story-tile-cell {
    border-top: 3px solid #212323;
  }

  @media (min-width: 48rem) {
    .shopify-block + .shopify-block > .story-tile-cell {
      border-top: none;
      border-left: 3px solid #212323;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.story_tile_row",
  "blocks": [{ "type": "story-tile-text" }, { "type": "story-tile-image" }],
  "presets": [
    {
      "name": "t:general.story_tile_row",
      "blocks": [{ "type": "story-tile-text" }, { "type": "story-tile-image" }]
    }
  ]
}
{% endschema %}
