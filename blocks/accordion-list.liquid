{% doc %}
  Groups accordion items from product metaobjects into a list of collapsible
  pills, styled identically to the faq-item blocks used in the
  faq-pills-grid section.
  Data pulled from product.metafields.custom.product_faq metaobject entries.

  Resolves the product the same way the parent product section does: uses
  the section's "product" picker setting when set (e.g. when the section is
  reused on the home page), otherwise falls back to the contextual product.
{% enddoc %}

{% liquid
  assign accordion_product = section.settings.product | default: product
  assign accordions = accordion_product.metafields.custom.product_faq.value
%}

{% if accordions != blank %}
  <div class="flex w-full flex-col gap-3" {{ block.shopify_attributes }}>
    {% for accordion in accordions %}
      <accordion-pill-item
        class="accordion-item block w-full"
        style="--accordion-item-bg: {{ block.settings.background_color }}; --accordion-item-color: {{ block.settings.text_color }};"
      >
        <div class="accordion-item__container w-full overflow-hidden">
          <button
            type="button"
            class="accordion-item__trigger flex min-h-[48px] w-full items-center justify-between gap-4 px-[18px] py-[10px] text-left transition-colors duration-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#212323]"
            aria-expanded="false"
            aria-controls="content-accordion-{{ forloop.index }}"
          >
            <span class="text-[16px] leading-[1.3] font-normal sm:text-[18px] md:text-[20px]">{{ accordion.title }}</span>
            <span class="accordion-item__icon flex items-center justify-center size-4 shrink-0 transition-transform duration-250 ease-out" aria-hidden="true">
              {{ 'icon-arrow-down-bold.svg' | inline_asset_content }}
            </span>
          </button>

          <div class="accordion-item__answer-wrap" id="content-accordion-{{ forloop.index }}" role="region">
            <div class="accordion-item__answer-inner overflow-hidden">
              {% if accordion.content != blank %}
                <div class="accordion-item__answer-content px-[18px] pt-2 pb-4 text-[16px] leading-[1.5]">
                  {{ accordion.content | metafield_tag }}
                </div>
              {% endif %}
            </div>
          </div>
        </div>
      </accordion-pill-item>
    {% endfor %}
  </div>
{% endif %}

{% stylesheet %}
  .accordion-item__container {
    background-color: var(--accordion-item-bg, #f9d5c0);
    border-radius: 24px;
  }

  .accordion-item__trigger {
    color: var(--accordion-item-color, #212323);
    cursor: pointer;
  }

  .accordion-item__trigger:hover {
    background-color: color-mix(in srgb, var(--accordion-item-bg, #f9d5c0) 85%, #212323 15%);
  }

  .accordion-item__icon {
    color: var(--accordion-item-color, #212323);
  }

  .accordion-item.is-open .accordion-item__icon {
    transform: rotate(180deg);
  }

  .accordion-item__answer-wrap {
    display: grid;
    grid-template-rows: 0fr;
    color: var(--accordion-item-color, #212323);
    transition: grid-template-rows 250ms ease;
  }

  .accordion-item.is-open .accordion-item__answer-wrap {
    grid-template-rows: 1fr;
  }

  .accordion-item__answer-content a,
  .accordion-item__answer-content u {
    text-decoration-line: underline;
    text-decoration-style: solid;
    text-decoration-thickness: from-font;
    text-underline-offset: 0.15em;
  }
{% endstylesheet %}

{% javascript %}
  class AccordionPillItem extends HTMLElement {
    connectedCallback() {
      this.trigger = this.querySelector('.accordion-item__trigger');
      this.trigger?.addEventListener('click', () => this.toggle());
    }

    toggle() {
      const isOpen = this.classList.toggle('is-open');
      this.trigger?.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    }
  }

  customElements.define('accordion-pill-item', AccordionPillItem);
{% endjavascript %}

{% schema %}
{
  "name": "t:general.accordion_list",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.faq_item_background",
      "default": "#636D90"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:labels.faq_item_text_color",
      "default": "#F6F1EC"
    }
  ],
  "presets": [
    {
      "name": "t:general.accordion_list"
    }
  ]
}
{% endschema %}
