{% doc %}
  Groups trust-badge blocks into a single wrapping row. Renders as the last
  row of the Gruns Hero section's content column, below the button; add,
  remove, and reorder the nested trust-badge blocks to control which trust
  signals are shown.

  @example
  {% content_for 'block', id: block.id, type: 'badge-row' %}
{% enddoc %}

<div
  class="badge-row grid w-full grid-cols-3 items-start gap-x-8 gap-y-6 sm:gap-x-6 sm:gap-y-4 lg:gap-x-[2.0833vw]"
  style="--badge-row-text-color: {{ block.settings.text_color }};"
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</div>

{% stylesheet %}
  @media screen and (min-width: 1440px) {
    .badge-row {
      column-gap: calc(27.84px + 0.15vw) !important;
    }
  }

  @media screen and (min-width: 1920px) {
    .badge-row {
      column-gap: 1.6vw !important;
    }
  }

  @media screen and (min-width: 2560px) {
    .badge-row {
      column-gap: calc(25px + 0.78125vw) !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.badge_row",
  "blocks": [{ "type": "trust-badge" }, { "type": "guarantee-badge" }],
  "settings": [
    {
      "type": "color",
      "id": "text_color",
      "label": "t:labels.text_color",
      "default": "#F6F1EC"
    }
  ],
  "presets": [
    {
      "name": "t:general.badge_row",
      "blocks": [
        { "type": "trust-badge", "settings": { "label": "<p>0.4mg THC</p>" } },
        { "type": "trust-badge", "settings": { "label": "<p>Non-Carbonated</p>" } },
        { "type": "trust-badge", "settings": { "label": "<p>Lab Tested</p>" } }
      ]
    }
  ]
}
{% endschema %}
