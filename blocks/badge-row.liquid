{% doc %}
  Groups trust-badge blocks into a single wrapping row. Renders as the last
  row of the Gruns Hero section's content column, below the button; add,
  remove, and reorder the nested trust-badge blocks to control which trust
  signals are shown.

  @example
  {% content_for 'block', id: block.id, type: 'badge-row' %}
{% enddoc %}

<div
  class="grid w-full grid-cols-3 items-start gap-x-8 gap-y-6 sm:gap-x-6 sm:gap-y-4 lg:gap-x-[30px]"
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</div>

{% schema %}
{
  "name": "t:general.badge_row",
  "blocks": [{ "type": "trust-badge" }, { "type": "guarantee-badge" }],
  "presets": [
    {
      "name": "t:general.badge_row",
      "blocks": [
        { "type": "trust-badge", "settings": { "label": "<p>0.4mg THC</p>" } },
        { "type": "trust-badge", "settings": { "label": "<p>Non-Carbonated</p>" } },
        { "type": "trust-badge", "settings": { "label": "<p>Lab Tested</p>" } }
      ]
    }
  ]
}
{% endschema %}
