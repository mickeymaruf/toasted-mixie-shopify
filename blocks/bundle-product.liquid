{% doc %}
  Renders a single "Add to Bundle" flavor card: a colored image card, flavor
  name, a pack-size dropdown (when the linked product has more than one
  variant), and an "Add to Bundle" button that hands the selected variant off
  to the parent bundle-builder web component (via data attributes) instead of
  submitting a form directly. Changing the pack-size dropdown updates the
  button's variant/price/title data before it's added. Falls back to the
  selected product's title/image when a custom title/image isn't set, and to
  the static pack_label setting when the product has only one variant. Must
  be nested inside a bundle-product-list block.

  @example
  {% content_for 'block', id: block.id, type: 'bundle-product' %}
{% enddoc %}

{% liquid
  assign variant = block.settings.product.selected_or_first_available_variant
  assign flavor_name = block.settings.flavor_name | default: block.settings.product.title
  assign card_image = block.settings.image | default: block.settings.product.featured_image

  case block.settings.flavor_style
    when 'berry_acai'
      assign default_image = 'card-flavor-berry-acai.png'
    when 'ginger_lime'
      assign default_image = 'card-flavor-ginger-lime.png'
    else
      assign default_image = 'card-flavor-blood-orange.png'
  endcase

  assign selling_plan = variant.selling_plan_allocations.first.selling_plan
  assign subscribe_price = variant.selling_plan_allocations.first.price

  assign has_pack_options = false
  if block.settings.product.variants.size > 1
    assign has_pack_options = true
  endif

  assign initial_title = flavor_name
  if has_pack_options
    assign initial_title = flavor_name | append: ' (' | append: variant.title | append: ')'
  endif
%}

<div
  class="group flex w-full flex-col items-center gap-3 sm:gap-[17px]"
  style="overflow: visible;"
  data-bundle-card
  {{ block.shopify_attributes }}
>
  <div
    class="relative flex w-full aspect-[202/256] items-end justify-center overflow-visible rounded-[24px] sm:rounded-[33px]"
    style="background-color: {{ block.settings.card_background_color }};"
  >
    {% if block.settings.background_image %}
      {{
        block.settings.background_image
        | image_url: width: 600
        | image_tag:
          class: 'absolute inset-0 size-full rounded-[24px] object-cover sm:rounded-[33px]',
          widths: '300, 450, 600',
          loading: 'lazy',
          alt: ''
      }}
    {% endif %}

    {% if card_image %}
      {{
        card_image
        | image_url: width: 600
        | image_tag:
          class: 'relative z-10 w-[115%] max-w-none object-contain overflow-visible transition-transform duration-400 ease-out group-hover:-translate-y-2',
          widths: '300, 450, 600',
          alt: card_image.alt | default: flavor_name
      }}
    {% else %}
      <img
        src="{{ default_image | asset_url }}"
        width="300"
        height="380"
        loading="lazy"
        class="relative z-10 w-[115%] max-w-none object-contain overflow-visible transition-transform duration-400 ease-out group-hover:-translate-y-2"
        alt="{{ flavor_name | escape }}"
      >
    {% endif %}
  </div>

  {% if flavor_name != blank %}
    <div class="flex flex-col items-center gap-0 text-center text-[#212323]">
      <p class="text-[20px] leading-[1.2] font-bold sm:text-[27px]">{{ flavor_name }}</p>
    </div>
  {% endif %}

  {% if has_pack_options %}
    <div class="relative flex w-full">
      <select
        class="w-full cursor-pointer appearance-none rounded-full border border-[#212323] bg-transparent py-[9px] pr-9 pl-4 text-center text-[14px] leading-[1.3] text-[#212323] outline-none focus:border-2 focus-visible:outline-none sm:text-[15px]"
        data-bundle-pack-select
        aria-label="{{ 'bundle_builder.pack_size' | t }}"
      >
        {% for pack_variant in block.settings.product.variants %}
          {% liquid
            assign option_subscribe_price = pack_variant.selling_plan_allocations.first.price
            assign option_selling_plan_id = pack_variant.selling_plan_allocations.first.selling_plan.id
            assign option_title = flavor_name | append: ' (' | append: pack_variant.title | append: ')'
          %}
          <option
            value="{{ pack_variant.id }}"
            data-price="{{ pack_variant.price }}"
            data-subscribe-price="{{ option_subscribe_price }}"
            data-selling-plan-id="{{ option_selling_plan_id }}"
            data-title="{{ option_title | escape }}"
            {% if pack_variant.id == variant.id %}
              selected
            {% endif %}
            {% unless pack_variant.available %}
              disabled
            {% endunless %}
          >
            {{ pack_variant.title }}
          </option>
        {% endfor %}
      </select>
      <span class="pointer-events-none absolute top-1/2 right-4 size-3 -translate-y-1/2 text-[#212323]">
        {{ 'icon-chevron-down.svg' | inline_asset_content }}
      </span>
    </div>
  {% elsif block.settings.pack_label != blank %}
    <p class="text-[13px] leading-[1.3] text-[#212323] sm:text-[15px]">{{ block.settings.pack_label }}</p>
  {% endif %}

  <div class="flex w-full flex-col items-center gap-[10px]">
    {% if variant %}
      <button
        type="button"
        class="flex w-full items-center justify-center rounded-full bg-[#212323] py-[13px] text-center text-[16px] font-medium text-[#F6F1EC] drop-shadow-[0px_0px_7.5px_rgba(0,0,0,0.1)] transition-opacity duration-150 hover:opacity-85 disabled:cursor-not-allowed disabled:opacity-30 sm:text-[20px]"
        data-bundle-add
        data-block-id="{{ block.id }}"
        data-variant-id="{{ variant.id }}"
        data-title="{{ initial_title | escape }}"
        data-image="{{ card_image | image_url: width: 200 }}"
        data-price="{{ variant.price }}"
        data-selling-plan-id="{{ selling_plan.id }}"
        data-subscribe-price="{{ subscribe_price }}"
        {% unless variant.available %}
          disabled
        {% endunless %}
      >
        {{ block.settings.button_label }}
      </button>
    {% endif %}

    {% if block.settings.product != blank %}
      <a
        href="{{ block.settings.product.url }}"
        class="text-[14px] leading-[1.3] text-[#212323] underline underline-offset-2 sm:text-[17px]"
      >
        {{ 'products.list.learn_more' | t }}
      </a>
    {% endif %}
  </div>
</div>

{% javascript %}
  document.addEventListener('change', (event) => {
    const select = event.target.closest('[data-bundle-pack-select]');
    if (!select) return;

    const option = select.selectedOptions[0];
    const button = select.closest('[data-bundle-card]')?.querySelector('[data-bundle-add]');
    if (!option || !button) return;

    button.dataset.variantId = option.value;
    button.dataset.price = option.dataset.price;
    button.dataset.subscribePrice = option.dataset.subscribePrice || '';
    button.dataset.sellingPlanId = option.dataset.sellingPlanId || '';
    button.dataset.title = option.dataset.title;
    button.disabled = option.disabled;
  });
{% endjavascript %}

{% schema %}
{
  "name": "t:general.bundle_product",
  "settings": [
    {
      "type": "header",
      "content": "t:general.product"
    },
    {
      "type": "product",
      "id": "product",
      "label": "t:labels.product",
      "info": "t:labels.product_info"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:labels.background_image",
      "info": "t:labels.background_image_info"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.can_image",
      "info": "t:labels.can_image_info"
    },
    {
      "type": "select",
      "id": "flavor_style",
      "label": "t:labels.flavor_style",
      "options": [
        { "value": "blood_orange", "label": "t:options.flavor_style.blood_orange" },
        { "value": "berry_acai", "label": "t:options.flavor_style.berry_acai" },
        { "value": "ginger_lime", "label": "t:options.flavor_style.ginger_lime" }
      ],
      "default": "blood_orange"
    },
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "text",
      "id": "flavor_name",
      "label": "t:labels.flavor_name",
      "info": "t:labels.flavor_name_info"
    },
    {
      "type": "text",
      "id": "pack_label",
      "label": "t:labels.pack_label",
      "default": "12-pack"
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "t:labels.card_background",
      "default": "#F9D5C0"
    },
    {
      "type": "header",
      "content": "t:general.button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label",
      "default": "Add to Bundle"
    }
  ],
  "presets": [{ "name": "t:general.bundle_product" }]
}
{% endschema %}
