{% doc %}
  Renders a simple product card whose colored background wraps the entire
  card (image, description and button), with a full-bleed background
  pattern, a centered fruit image, and two decorative stickers (badge +
  stylized flavor name), followed by a description and an "Add to Cart"
  button linking to the selected product's page. Fruit/badge/flavor layer
  positions are ported 1:1 from the Figma "Frame 2147236068" node (fileKey
  mPnZFgOy032whTzJGzGdND); the card container follows the "Frame 2147236155"
  node (node-id 6969-5169) from the same file. Intended to be nested inside
  the Gruns Product List Simple section.

  @example
  {% content_for 'block', id: block.id, type: 'product-card-simple' %}
{% enddoc %}

<div
  class="group relative mx-auto flex w-full max-w-full flex-row items-stretch gap-3 overflow-hidden rounded-[24px] p-3 shadow-[0px_0px_10px_0px_rgba(0,0,0,0.15)] sm:max-w-[380px] sm:flex-col sm:items-center sm:gap-[40px] sm:rounded-[48px] sm:px-[15px] sm:py-[40px]"
  style="background-color: {{ block.settings.background_color }}; --product-card-simple-text-color: {{ block.settings.text_color | default: '#F6F1EC' }};"
  {{ block.shopify_attributes }}
>
  {% if block.settings.background_image %}
    {{
      block.settings.background_image
      | image_url: width: 1200
      | image_tag:
        class: 'product-card-simple__background pointer-events-none absolute inset-0 size-full object-cover',
        loading: 'lazy',
        widths: '600, 900, 1200',
        alt: ''
    }}
  {% endif %}

  <div class="product-card-simple__media relative z-[1] aspect-square w-[46%] shrink-0 self-start sm:aspect-[380/265] sm:w-full sm:self-auto">
    {% if block.settings.image %}
      {{
        block.settings.image
        | image_url: width: 800
        | image_tag:
          class: 'product-card-simple__fruit absolute h-auto -translate-x-1/2 -translate-y-1/2 transition-transform duration-500 ease group-hover:scale-[1.05]',
          loading: 'lazy',
          widths: '400, 600, 800',
          alt: block.settings.alt_text | default: block.settings.image.alt
      }}
    {% elsif block.settings.product.featured_image %}
      {{
        block.settings.product.featured_image
        | image_url: width: 800
        | image_tag:
          class: 'product-card-simple__fruit absolute h-auto -translate-x-1/2 -translate-y-1/2 transition-transform duration-500 ease group-hover:scale-[1.05]',
          loading: 'lazy',
          widths: '400, 600, 800',
          alt: block.settings.product.featured_image.alt
      }}
    {% endif %}

    {% liquid
      assign badge_sticker_desktop = block.settings.badge_sticker | default: block.settings.badge_sticker_mobile
      assign badge_sticker_phone = block.settings.badge_sticker_mobile | default: block.settings.badge_sticker
      assign badge_sticker_desktop_widths = badge_sticker_desktop.width | append: ''
      assign badge_sticker_phone_widths = badge_sticker_phone.width | append: ''
    %}
    {% if badge_sticker_desktop %}
      {% if badge_sticker_phone != badge_sticker_desktop %}
        {{
          badge_sticker_phone
          | image_url: width: badge_sticker_phone.width
          | image_tag:
            class: 'product-card-simple__badge pointer-events-none absolute h-auto transition-transform duration-500 ease group-hover:scale-[1.05] sm:hidden',
            widths: badge_sticker_phone_widths,
            sizes: '100vw',
            loading: 'lazy',
            decoding: 'async',
            alt: ''
        }}
      {% endif %}
      {% assign badge_sticker_desktop_class = 'product-card-simple__badge pointer-events-none absolute h-auto transition-transform duration-500 ease group-hover:scale-[1.05]' %}
      {% if badge_sticker_phone != badge_sticker_desktop %}
        {% assign badge_sticker_desktop_class = badge_sticker_desktop_class | append: ' max-sm:hidden' %}
      {% endif %}
      {{
        badge_sticker_desktop
        | image_url: width: badge_sticker_desktop.width
        | image_tag:
          class: badge_sticker_desktop_class,
          widths: badge_sticker_desktop_widths,
          sizes: '100vw',
          loading: 'lazy',
          decoding: 'async',
          alt: ''
      }}
    {% endif %}

    {% liquid
      assign flavor_sticker_desktop = block.settings.flavor_sticker | default: block.settings.flavor_sticker_mobile
      assign flavor_sticker_phone = block.settings.flavor_sticker_mobile | default: block.settings.flavor_sticker
      assign flavor_sticker_desktop_widths = flavor_sticker_desktop.width | append: ''
      assign flavor_sticker_phone_widths = flavor_sticker_phone.width | append: ''
    %}
    {% if flavor_sticker_desktop %}
      {% if flavor_sticker_phone != flavor_sticker_desktop %}
        {{
          flavor_sticker_phone
          | image_url: width: flavor_sticker_phone.width
          | image_tag:
            class: 'product-card-simple__flavor pointer-events-none absolute h-auto transition-transform duration-500 ease group-hover:scale-[1.05] sm:hidden',
            widths: flavor_sticker_phone_widths,
            sizes: '100vw',
            loading: 'lazy',
            decoding: 'async',
            alt: ''
        }}
      {% endif %}
      {% assign flavor_sticker_desktop_class = 'product-card-simple__flavor pointer-events-none absolute h-auto transition-transform duration-500 ease group-hover:scale-[1.05]' %}
      {% if flavor_sticker_phone != flavor_sticker_desktop %}
        {% assign flavor_sticker_desktop_class = flavor_sticker_desktop_class | append: ' max-sm:hidden' %}
      {% endif %}
      {{
        flavor_sticker_desktop
        | image_url: width: flavor_sticker_desktop.width
        | image_tag:
          class: flavor_sticker_desktop_class,
          widths: flavor_sticker_desktop_widths,
          sizes: '100vw',
          loading: 'lazy',
          decoding: 'async',
          alt: ''
      }}
    {% endif %}
  </div>

  <div class="flex min-w-0 flex-1 flex-col items-center justify-center gap-4 sm:contents">
    {% if block.settings.description != blank %}
      <p class="relative z-[1] w-full text-center text-[15px] leading-[1.3] text-[color:var(--product-card-simple-text-color)] sm:text-[18px] lg:text-[20px]">
        {{ block.settings.description }}
      </p>
    {% endif %}

    {% if block.settings.button_label != blank %}
      {% render 'button',
        label: block.settings.button_label,
        url: block.settings.product.url,
        background_color: block.settings.button_background_color,
        text_color: block.settings.button_text_color,
        class: 'relative z-[1] w-full shadow-[0px_0px_7.5px_0px_rgba(0,0,0,0.1)] max-sm:whitespace-nowrap max-sm:!px-3'
      %}
    {% endif %}
  </div>
</div>

{% stylesheet %}
  /* Layer positions below are ported 1:1 from the Figma "Frame 2147236068"
     node (fileKey mPnZFgOy032whTzJGzGdND). No fixed widths/heights are set —
     each image keeps its natural aspect ratio at the given width. */

  .product-card-simple__fruit {
    left: calc(50% + 0.25px);
    top: calc(50% - 0.25px);
    width: 63.29%;
  }

  .product-card-simple__badge {
    top: 20.89%;
    left: 62.11%;
    width: 28.12%;
  }

  .product-card-simple__flavor {
    top: 62.6%;
    left: 8.01%;
    width: 38.63%;
  }

  /* Mobile: bigger fruit, badge and flavor sticker. Must come after the base rules above so it wins. */
  @media screen and (max-width: 639px) {
    .product-card-simple__fruit {
      width: 92%;
    }

    .product-card-simple__badge {
      top: 6%;
      left: 57%;
      width: 43.2%;
    }

    .product-card-simple__flavor {
      top: 62%;
      left: -6%;
      width: 60.8%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .product-card-simple__fruit,
    .product-card-simple__badge,
    .product-card-simple__flavor {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.product_card_simple",
  "settings": [
    {
      "type": "header",
      "content": "t:general.product"
    },
    {
      "type": "product",
      "id": "product",
      "label": "t:labels.product"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image",
      "info": "t:labels.image_info"
    },
    {
      "type": "text",
      "id": "alt_text",
      "label": "t:labels.alt_text"
    },
    {
      "type": "header",
      "content": "t:general.background"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.background_color",
      "default": "#215332"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:labels.background_image"
    },
    {
      "type": "header",
      "content": "t:general.sticker"
    },
    {
      "type": "image_picker",
      "id": "flavor_sticker",
      "label": "t:labels.sticker_image"
    },
    {
      "type": "image_picker",
      "id": "flavor_sticker_mobile",
      "label": "t:labels.sticker_image_mobile",
      "info": "t:labels.sticker_image_mobile_info"
    },
    {
      "type": "image_picker",
      "id": "badge_sticker",
      "label": "t:labels.badge_image"
    },
    {
      "type": "image_picker",
      "id": "badge_sticker_mobile",
      "label": "t:labels.badge_image_mobile",
      "info": "t:labels.badge_image_mobile_info"
    },
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:labels.title",
      "default": "Blood Orange",
      "info": "t:labels.title_info"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:labels.description",
      "default": "Bright blood orange, real fruit flavor, and a functional blend made to help you stay present."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:labels.text_color",
      "default": "#F6F1EC"
    },
    {
      "type": "header",
      "content": "t:general.button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label",
      "default": "Add to Cart"
    },
    {
      "type": "color",
      "id": "button_background_color",
      "label": "t:labels.button_background",
      "default": "#F6F1EC"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "t:labels.button_text_color",
      "default": "#212323"
    }
  ],
  "presets": [{ "name": "t:general.product_card_simple" }]
}
{% endschema %}
