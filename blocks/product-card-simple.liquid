{% doc %}
  Renders a simple product card with a single product image, title,
  description and an "Add to Cart" button linking to the selected
  product's page. Unlike product-card, this has no background color or
  floating can layering — just one flat product image. Intended to be
  nested inside the Gruns Product List Simple section.

  @example
  {% content_for 'block', id: block.id, type: 'product-card-simple' %}
{% enddoc %}

<div
  class="mx-auto flex w-full max-w-full flex-col items-center gap-4 sm:max-w-[380px] sm:gap-[30px]"
  {{ block.shopify_attributes }}
>
  <div
    class="relative w-full overflow-hidden rounded-[16px] bg-[#F0F0F0] sm:rounded-[33px]"
    style="aspect-ratio: 380 / 445;"
  >
    {% if block.settings.image %}
      {{
        block.settings.image
        | image_url: width: 800
        | image_tag:
          class: 'absolute inset-0 size-full object-cover',
          loading: 'lazy',
          widths: '400, 600, 800',
          alt: block.settings.alt_text
        | default: block.settings.image.alt
      }}
    {% elsif block.settings.product.featured_image %}
      {{
        block.settings.product.featured_image
        | image_url: width: 800
        | image_tag:
          class: 'absolute inset-0 size-full object-cover',
          loading: 'lazy',
          widths: '400, 600, 800',
          alt: block.settings.product.featured_image.alt
      }}
    {% endif %}
  </div>

  <div class="flex w-full flex-col items-center gap-[10px] text-center text-[#212323]">
    {% if block.settings.title != blank %}
      <p class="product-card-simple__title text-[24px] leading-[1.2] font-bold sm:text-[32px] lg:text-[42px]">
        {{ block.settings.title }}
      </p>
    {% endif %}

    {% if block.settings.description != blank %}
      <p class="text-[15px] leading-[1.3] sm:text-[18px] lg:text-[20px]">
        {{ block.settings.description }}
      </p>
    {% endif %}
  </div>

  {% if block.settings.button_label != blank %}
    {% render 'button',
      label: block.settings.button_label,
      url: block.settings.product.url,
      background_color: block.settings.button_background_color,
      text_color: block.settings.button_text_color,
      class: 'w-full'
    %}
  {% endif %}
</div>

{% stylesheet %}
  .product-card-simple__title {
    font-family: var(--font-heading--family);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.product_card_simple",
  "settings": [
    {
      "type": "header",
      "content": "t:general.product"
    },
    {
      "type": "product",
      "id": "product",
      "label": "t:labels.product"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image",
      "info": "t:labels.image_info"
    },
    {
      "type": "text",
      "id": "alt_text",
      "label": "t:labels.alt_text"
    },
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:labels.title",
      "default": "Blood Orange"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:labels.description",
      "default": "Bright blood orange, real fruit flavor, and a functional blend made to help you stay present."
    },
    {
      "type": "header",
      "content": "t:general.button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label",
      "default": "Add to Cart"
    },
    {
      "type": "color",
      "id": "button_background_color",
      "label": "t:labels.button_background",
      "default": "#212323"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "t:labels.button_text_color",
      "default": "#F6F1EC"
    }
  ],
  "presets": [{ "name": "t:general.product_card_simple" }]
}
{% endschema %}
