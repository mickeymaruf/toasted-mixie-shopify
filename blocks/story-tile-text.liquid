{% doc %}
  Renders a text tile cell with a heading, optional body copy, and
  configurable background/text colors. Intended to be nested inside a
  story-tile-row block in the Story Tiles section.

  @example
  {% content_for 'block', id: block.id, type: 'story-tile-text' %}
{% enddoc %}

<div
  class="story-tile-cell flex flex-col items-center justify-center gap-4 p-8 text-center sm:gap-5 sm:p-10 md:p-8 lg:gap-5 lg:p-[60px] xl:p-[100px]"
  data-tile-width="{{ block.settings.width }}"
  style="
    --story-tile-span: {{ block.settings.width }};
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
  "
  {{ block.shopify_attributes }}
>
  {% if block.settings.heading != blank %}
    <div class="story-tile-cell__heading w-full font-bold text-[28px] leading-[0.95] sm:text-[36px] md:text-[26px] lg:text-[72px] xl:text-[60px]">
      {{ block.settings.heading }}
    </div>
  {% endif %}

  {% if block.settings.body != blank %}
    <div class="story-tile-cell__body w-full text-[16px] leading-[1.5] sm:text-[18px] md:text-[20px] lg:text-[28px] xl:text-[28px]">
      {{ block.settings.body }}
    </div>
  {% endif %}

  {% if block.settings.image != blank %}
    <div class="story-tile-cell__image w-full max-w-[120px] ml-[20px]">
      {{ block.settings.image | image_url: width: 240 | image_tag }}
    </div>
  {% endif %}
</div>

{% stylesheet %}
  .story-tile-cell__heading {
    font-family: var(--font-heading--family);
  }

  .story-tile-cell__heading :where(p),
  .story-tile-cell__body :where(p) {
    margin: 0;
  }

  .story-tile-cell__body :where(p) + p {
    margin-top: 1em;
  }

  .story-tile-cell__image {
    display: flex;
    justify-content: center;
    margin-top: 1em;
  }

  .story-tile-cell__image img {
    max-width: 100%;
    height: auto;
  }

  /*
    A "one-third" width cell shares the same row height as a "two-thirds"
    cell but gets a third of the horizontal space, so it needs its own,
    smaller type scale at lg/xl to avoid the heading/body overflowing and
    getting clipped by the cell's overflow:hidden.
  */
  @media (min-width: 64rem) {
    .story-tile-cell[data-tile-width="1"] .story-tile-cell__heading {
      font-size: 72px;
    }

    .story-tile-cell[data-tile-width="1"] .story-tile-cell__body {
      font-size: 28px;
    }
  }

  @media (min-width: 80rem) {
    .story-tile-cell[data-tile-width="1"] .story-tile-cell__heading {
      font-size: 72px;
    }

    .story-tile-cell[data-tile-width="1"] .story-tile-cell__body {
      font-size: 28px;
    }
  }

  /*
    A "two-thirds" cell gets more width than a one-third cell, but when it
    carries both a heading and a body it can still overflow the row's fixed
    height at lg/xl, so it gets its own slightly reduced scale too.
  */
  @media (min-width: 64rem) {
    .story-tile-cell[data-tile-width="2"] .story-tile-cell__heading {
      font-size: 72px;
    }

    .story-tile-cell[data-tile-width="2"] .story-tile-cell__body {
      font-size: 28px;
    }
  }

  @media (min-width: 80rem) {
    .story-tile-cell[data-tile-width="2"] .story-tile-cell__heading {
      font-size: 56px;
    }

    .story-tile-cell[data-tile-width="2"] .story-tile-cell__body {
      font-size: 24px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.story_tile_text",
  "settings": [
    {
      "type": "richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "<p>More open. More present. More here.</p>"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "t:labels.body"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "header",
      "content": "t:general.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.background",
      "default": "#F9D5C0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:labels.text_color",
      "default": "#212323"
    },
    {
      "type": "header",
      "content": "t:general.layout"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:labels.width",
      "options": [
        { "value": "1", "label": "t:options.width.one_third" },
        { "value": "2", "label": "t:options.width.two_thirds" }
      ],
      "default": "1"
    }
  ],
  "presets": [{ "name": "t:general.story_tile_text" }]
}
{% endschema %}
