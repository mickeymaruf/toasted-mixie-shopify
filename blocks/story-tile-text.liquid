{% doc %}
  Renders a text tile cell with a heading, optional body copy, and
  configurable background/text colors. Intended to be nested inside a
  story-tile-row block in the Story Tiles section.

  @example
  {% content_for 'block', id: block.id, type: 'story-tile-text' %}
{% enddoc %}

{% liquid
  assign is_two_thirds = false
  if block.settings.width == '2'
    assign is_two_thirds = true
  endif

  assign heading_desktop = block.settings.heading
  assign heading_mobile = block.settings.heading_mobile
  if heading_mobile == blank
    assign heading_mobile = heading_desktop
  endif

  assign is_dark = false
  assign background_brightness = block.settings.background_color | color_brightness
  if background_brightness < 128
    assign is_dark = true
  endif

  assign body_desktop = block.settings.body
  assign body_mobile = block.settings.body_mobile
  if body_mobile == blank
    assign body_mobile = body_desktop
  endif
%}

<div
  class="story-tile-cell relative w-full lg:aspect-auto lg:h-full {% if is_two_thirds %}md:col-span-2 md:aspect-auto md:h-full{% else %}md:col-span-1 md:aspect-square{% endif %}"
  {% if block.settings.mobile_order != '0' %}style="--mobile-order: {{ block.settings.mobile_order }};"{% endif %}
  {{ block.shopify_attributes }}
>
  <div
    class="story-tile-cell__clip{% if is_dark %} story-tile-cell__clip--dark{% endif %} relative flex md:absolute md:inset-0 flex-col items-center justify-center gap-4 overflow-hidden text-center sm:gap-5 p-10 md:gap-[1.3889cqw] md:px-[1.3889cqw] md:py-[2.7778cqw]"
    style="
      background-color: {{ block.settings.background_color }};
      color: {{ block.settings.text_color }};
    "
  >
    {% if heading_mobile != blank %}
      <div class="story-tile-cell__heading story-tile-cell__heading--mobile w-full font-[family-name:var(--font-heading--family)] text-[42px] font-bold leading-[0.95] [&_p]:m-0 sm:text-[52px] md:text-[5cqw] text-center">
        {{ heading_mobile }}
      </div>
    {% endif %}

    {% if heading_desktop != blank %}
      <div class="story-tile-cell__heading story-tile-cell__heading--desktop w-full font-[family-name:var(--font-heading--family)] text-[42px] font-bold leading-[0.95] [&_p]:m-0 sm:text-[52px] md:text-[5cqw] text-center">
        {{ heading_desktop }}
      </div>
    {% endif %}

    {% if body_mobile != blank %}
      <div class="story-tile-cell__body story-tile-cell__body--mobile w-full font-[family-name:var(--font-primary--family)] text-center text-[20px] leading-[1.5] [&_p]:m-0 [&_p+p]:mt-[1em] sm:text-[16px] md:text-[2.2222cqw]">
        {{ body_mobile }}
      </div>
    {% endif %}

    {% if body_desktop != blank %}
      <div class="story-tile-cell__body story-tile-cell__body--desktop w-full font-[family-name:var(--font-primary--family)] text-[20px] leading-[1.5] [&_p]:m-0 [&_p+p]:mt-[1em] sm:text-[16px] md:text-[2.2222cqw]">
        {{ body_desktop }}
      </div>
    {% endif %}

    {% if block.settings.image != blank %}
      <div class="story-tile-cell__image flex w-[140px] ml-[20px] justify-center md:ml-[1.3889cqw] md:w-[16.6667cqw]">
        {{ block.settings.image | image_url: width: 480 | image_tag: class: 'max-w-full h-auto' }}
      </div>
    {% endif %}
  </div>

  {% render 'sticker',
    image: block.settings.sticker_image,
    image_mobile: block.settings.sticker_image_mobile,
    position: block.settings.sticker_position,
    position_mobile: block.settings.sticker_position_mobile,
    width: block.settings.sticker_width,
    width_mobile: block.settings.sticker_width_mobile,
    translate_x: block.settings.sticker_translate_x,
    translate_x_mobile: block.settings.sticker_translate_x_mobile,
    translate_y: block.settings.sticker_translate_y,
    translate_y_mobile: block.settings.sticker_translate_y_mobile,
    source_width: 1600
  %}
</div>

{% stylesheet %}
  /* Light-on-dark text renders heavier, so dark tiles use the lighter body weight */
  .story-tile-cell__clip--dark .story-tile-cell__body {
    font-weight: 350;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  .story-tile-cell__heading--desktop,
  .story-tile-cell__body--desktop {
    display: none;
  }

  .story-tile-cell__heading--mobile,
  .story-tile-cell__body--mobile {
    display: block;
  }

  @media (min-width: 48rem) {
    .story-tile-cell__heading--desktop,
    .story-tile-cell__body--desktop {
      display: block;
    }

    .story-tile-cell__heading--mobile,
    .story-tile-cell__body--mobile {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.story_tile_text",
  "settings": [
    {
      "type": "richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "<p>More open. More present. More here.</p>"
    },
    {
      "type": "richtext",
      "id": "heading_mobile",
      "label": "t:labels.heading_mobile"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "t:labels.body"
    },
    {
      "type": "richtext",
      "id": "body_mobile",
      "label": "t:labels.body_mobile",
      "info": "t:labels.body_mobile_info"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "header",
      "content": "t:general.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.background",
      "default": "#F9D5C0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:labels.text_color",
      "default": "#212323"
    },
    {
      "type": "header",
      "content": "t:general.layout"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:labels.width",
      "options": [
        { "value": "1", "label": "t:options.width.one_third" },
        { "value": "2", "label": "t:options.width.two_thirds" }
      ],
      "default": "1"
    },
    {
      "type": "select",
      "id": "mobile_order",
      "label": "t:labels.mobile_order",
      "info": "t:labels.mobile_order_info",
      "options": [
        { "value": "0", "label": "t:options.mobile_order.auto" },
        { "value": "1", "label": "t:options.mobile_order.first" },
        { "value": "2", "label": "t:options.mobile_order.second" },
        { "value": "3", "label": "t:options.mobile_order.third" }
      ],
      "default": "0"
    },
    {
      "type": "header",
      "content": "t:general.sticker_desktop"
    },
    {
      "type": "image_picker",
      "id": "sticker_image",
      "label": "t:labels.sticker_image"
    },
    {
      "type": "select",
      "id": "sticker_position",
      "label": "t:labels.sticker_position",
      "options": [
        { "value": "top_left", "label": "t:options.sticker_position.top_left" },
        { "value": "top_center", "label": "t:options.sticker_position.top_center" },
        { "value": "top_right", "label": "t:options.sticker_position.top_right" },
        { "value": "middle_left", "label": "t:options.sticker_position.middle_left" },
        { "value": "center", "label": "t:options.sticker_position.center" },
        { "value": "middle_right", "label": "t:options.sticker_position.middle_right" },
        { "value": "bottom_left", "label": "t:options.sticker_position.bottom_left" },
        { "value": "bottom_center", "label": "t:options.sticker_position.bottom_center" },
        { "value": "bottom_right", "label": "t:options.sticker_position.bottom_right" }
      ],
      "default": "top_right"
    },
    {
      "type": "range",
      "id": "sticker_width",
      "label": "t:labels.sticker_width",
      "min": 0,
      "max": 300,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "sticker_translate_x",
      "label": "t:labels.sticker_translate_x",
      "min": -100,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 0
    },
    {
      "type": "range",
      "id": "sticker_translate_y",
      "label": "t:labels.sticker_translate_y",
      "min": -100,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:general.sticker_mobile"
    },
    {
      "type": "image_picker",
      "id": "sticker_image_mobile",
      "label": "t:labels.sticker_image",
      "info": "t:labels.sticker_image_mobile_info"
    },
    {
      "type": "select",
      "id": "sticker_position_mobile",
      "label": "t:labels.sticker_position",
      "options": [
        { "value": "top_left", "label": "t:options.sticker_position.top_left" },
        { "value": "top_center", "label": "t:options.sticker_position.top_center" },
        { "value": "top_right", "label": "t:options.sticker_position.top_right" },
        { "value": "middle_left", "label": "t:options.sticker_position.middle_left" },
        { "value": "center", "label": "t:options.sticker_position.center" },
        { "value": "middle_right", "label": "t:options.sticker_position.middle_right" },
        { "value": "bottom_left", "label": "t:options.sticker_position.bottom_left" },
        { "value": "bottom_center", "label": "t:options.sticker_position.bottom_center" },
        { "value": "bottom_right", "label": "t:options.sticker_position.bottom_right" }
      ],
      "default": "top_right"
    },
    {
      "type": "range",
      "id": "sticker_width_mobile",
      "label": "t:labels.sticker_width",
      "min": 0,
      "max": 300,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "sticker_translate_x_mobile",
      "label": "t:labels.sticker_translate_x",
      "min": -100,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 0
    },
    {
      "type": "range",
      "id": "sticker_translate_y_mobile",
      "label": "t:labels.sticker_translate_y",
      "min": -100,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 0
    }
  ],
  "presets": [{ "name": "t:general.story_tile_text" }]
}
{% endschema %}
