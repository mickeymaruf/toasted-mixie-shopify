{% doc %}
  Renders a single spend milestone on the bundle discount progress bar: a
  reward pill (e.g. "$5", "Free Ship") and the bundle subtotal required to
  unlock it. The parent bundle-builder web component automatically
  highlights the pill once the shopper's current bundle subtotal reaches
  the threshold, and outlines whichever unreached milestone is next. Must
  be nested inside a bundle-milestone-list block.

  @example
  {% content_for 'block', id: block.id, type: 'bundle-milestone' %}
{% enddoc %}

{% liquid
  assign metric = block.settings.metric | default: 'spend'
  if metric == 'packs'
    assign threshold_value = block.settings.threshold
  else
    assign threshold_value = block.settings.threshold | times: 100
  endif
%}

<div
  class="flex shrink-0 flex-col items-center gap-1"
  data-bundle-milestone
  data-threshold="{{ threshold_value }}"
  data-metric="{{ metric }}"
  {{ block.shopify_attributes }}
>
  <div
    class="flex size-[30px] shrink-0 items-center justify-center rounded-full bg-white text-center text-[8px] leading-[1.1] font-medium text-[#212323] transition-all duration-200"
    data-bundle-milestone-pill
  >
    {{ block.settings.reward_label }}
  </div>
  <p class="text-center text-[10px] leading-[14px] tracking-[0.6px] whitespace-nowrap text-[#212323]">
    {%- if metric == 'packs' -%}
      {{ block.settings.threshold }} x 12 Packs
    {%- else -%}
      {% render 'format-money', cents: threshold_value %}
    {%- endif -%}
  </p>
</div>

{% schema %}
{
  "name": "t:general.bundle_milestone",
  "settings": [
    {
      "type": "select",
      "id": "metric",
      "label": "Milestone type",
      "options": [
        { "value": "spend", "label": "Spend amount ($)" },
        { "value": "packs", "label": "Number of 12 packs" }
      ],
      "default": "spend"
    },
    {
      "type": "number",
      "id": "threshold",
      "label": "t:labels.spend_threshold",
      "info": "t:labels.spend_threshold_info",
      "default": 50
    },
    {
      "type": "text",
      "id": "reward_label",
      "label": "t:labels.reward_label",
      "info": "t:labels.reward_label_info",
      "default": "$5"
    }
  ],
  "presets": [{ "name": "t:general.bundle_milestone" }]
}
{% endschema %}
