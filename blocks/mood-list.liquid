{% doc %}
  Groups mood-item blocks into a horizontal row of circular badges. Nest
  inside the Drink Better section's content column; add, remove, and
  reorder the nested mood-item blocks to control which badges are shown.

  @example
  {% content_for 'block', id: block.id, type: 'mood-list' %}
{% enddoc %}

<div class="flex w-full flex-nowrap items-start gap-x-6 gap-y-6 sm:flex-wrap sm:gap-x-[30px]" {{ block.shopify_attributes }}>
  {% content_for 'blocks' %}
</div>

{% schema %}
{
  "name": "t:general.mood_list",
  "blocks": [{ "type": "mood-item" }],
  "presets": [
    {
      "name": "t:general.mood_list",
      "blocks": [
        { "type": "mood-item", "settings": { "label": "200mg L-theanine" } },
        { "type": "mood-item", "settings": { "label": "50mg Rhodiola" } },
        { "type": "mood-item", "settings": { "label": ".4mg Hemp THC" } }
      ]
    }
  ]
}
{% endschema %}
