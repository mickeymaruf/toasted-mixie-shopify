{% doc %}
  Groups mood-item blocks into a single list. Nest inside the Drink Better
  section's content column; add, remove, and reorder the nested mood-item
  blocks to control which mood/benefit rows are shown.

  @example
  {% content_for 'block', id: block.id, type: 'mood-list' %}
{% enddoc %}

<div class="flex w-full flex-col gap-[21px]" {{ block.shopify_attributes }}>
  {% content_for 'blocks' %}
</div>

{% schema %}
{
  "name": "t:general.mood_list",
  "blocks": [{ "type": "mood-item" }],
  "presets": [
    {
      "name": "t:general.mood_list",
      "blocks": [
        {
          "type": "mood-item",
          "settings": { "title": "Supports Clarity", "subtitle": "Smooth, present focus", "icon_style": "clarity" }
        },
        {
          "type": "mood-item",
          "settings": { "title": "Balanced Mood", "subtitle": "Light, feel-good lift", "icon_style": "balanced" }
        },
        {
          "type": "mood-item",
          "settings": { "title": "Promotes Calm", "subtitle": "Easy, steady unwind", "icon_style": "calm" }
        }
      ]
    }
  ]
}
{% endschema %}
