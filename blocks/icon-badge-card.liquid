{% doc %}
  Renders a single rounded, colored icon card used in a quality/trust badge
  row (e.g. "Lab Tested", "Low Dose"). Falls back to a bundled default icon
  per `icon_style` when no custom `icon` image is uploaded.

  @example
  {% content_for 'block', id: block.id, type: 'icon-badge-card' %}
{% enddoc %}


<div
  class="flex aspect-square w-[96px] shrink-0 flex-col items-center justify-center gap-[6px] rounded-[18px] px-[8px] text-center shadow-[-2px_2px_3.5px_rgba(0,0,0,0.1)] sm:w-[110px] sm:min-w-[160px] sm:max-w-[160px] sm:gap-[10px] sm:rounded-[33px] sm:px-[10px]"
  style="background-color: {{ block.settings.background_color }}; color: {{ block.settings.text_color }};"
  {{ block.shopify_attributes }}
>
  {% if block.settings.icon %}
    <div class="size-[40px] shrink-0 sm:size-[70px] lg:size-[85px]">
      {{
        block.settings.icon
        | image_url: width: 170
        | image_tag: width: 170, height: 170, class: 'size-full object-contain', alt: block.settings.label
      }}
    </div>
  {% endif %}

  {% if block.settings.label != blank %}
    <p class="text-[11px] leading-[1.3] font-medium sm:text-[14px] sm:leading-[1.5] sm:whitespace-nowrap">
      {{ block.settings.label }}
    </p>
  {% endif %}
</div>

{% schema %}
{
  "name": "t:general.icon_badge_card",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "t:labels.label",
      "default": "Lab Tested"
    },
    {
      "type": "image_picker",
      "id": "icon",
      "label": "t:labels.icon"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.card_background",
      "default": "#636D90"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:labels.text_color",
      "default": "#F6F1EC"
    }
  ],
  "presets": [{ "name": "t:general.icon_badge_card" }]
}
{% endschema %}
