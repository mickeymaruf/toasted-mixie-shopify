{% doc %}
  Renders a single rounded, colored icon card used in a quality/trust badge
  row (e.g. "Lab Tested", "Low Dose"). Falls back to a bundled default icon
  per `icon_style` when no custom `icon` image is uploaded.

  @example
  {% content_for 'block', id: block.id, type: 'icon-badge-card' %}
{% enddoc %}


<div
  class="flex min-w-0 shrink-0 flex-col items-center justify-center gap-[10px] rounded-[18px] px-[10px] py-[15px] text-center shadow-[-2px_2px_3.5px_rgba(0,0,0,0.1)] sm:gap-[15px] sm:rounded-[33px] sm:py-[20px]"
  style="background-color: {{ block.settings.background_color }}; color: {{ block.settings.text_color }}; width: var(--icon-badge-card-width, auto); height: var(--icon-badge-card-height, auto); aspect-ratio: var(--icon-badge-card-aspect-ratio, auto);"
  {{ block.shopify_attributes }}
>
  {% if block.settings.icon %}
    <div class="size-[56px] shrink-0 sm:size-[70px] lg:size-[85px]">
      {{
        block.settings.icon
        | image_url: width: 170
        | image_tag: width: 170, height: 170, class: 'size-full object-contain', alt: block.settings.label
      }}
    </div>
  {% endif %}

  {% if block.settings.label != blank %}
    <p class="w-full whitespace-nowrap text-[14px] leading-[1.3] font-medium sm:text-[15px] sm:leading-[1.5]">
      {{ block.settings.label }}
    </p>
  {% endif %}
</div>

{% schema %}
{
  "name": "t:general.icon_badge_card",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "t:labels.label",
      "default": "Lab Tested"
    },
    {
      "type": "image_picker",
      "id": "icon",
      "label": "t:labels.icon"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.card_background",
      "default": "#F9D5C0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:labels.text_color",
      "default": "#636D90"
    }
  ],
  "presets": [{ "name": "t:general.icon_badge_card" }]
}
{% endschema %}
