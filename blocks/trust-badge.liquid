{% doc %}
  Renders a small circular icon with a label underneath, used to call out a
  product trust signal (e.g. potency, carbonation, lab testing).

  Falls back to a bundled default icon per `icon_style` when no custom
  `icon` image is uploaded. Intended to be nested inside a badge-row block
  (e.g. the Gruns Hero section).

  @example
  {% content_for 'block', id: block.id, type: 'trust-badge' %}
{% enddoc %}

{% liquid
  case block.settings.icon_style
    when 'carbonation'
      assign default_icon = 'icon-badge-carbonation.png'
    when 'lab'
      assign default_icon = 'icon-badge-lab-tested.png'
    else
      assign default_icon = 'icon-badge-thc.png'
  endcase
%}

<div class="flex min-w-0 flex-1 flex-col items-center gap-[5px] sm:w-auto sm:flex-none" {{ block.shopify_attributes }}>
  <div class="size-[56px] shrink-0 sm:size-[85px] lg:size-[101px]">
    {% if block.settings.icon %}
      {{
        block.settings.icon
        | image_url: width: 202
        | image_tag: width: 202, height: 202, class: 'size-full object-contain', alt: block.settings.label
      }}
    {% else %}
      <img
        src="{{ default_icon | asset_url }}"
        width="202"
        height="202"
        loading="lazy"
        class="size-full object-contain"
        alt="{{ block.settings.label | escape }}"
      >
    {% endif %}
  </div>

  {% if block.settings.label != blank or block.settings.description != blank %}
    <div class="flex flex-col items-center gap-[2.64px]">
      {% if block.settings.label != blank %}
        <p class="text-center text-[13px] leading-[1.5] font-medium text-[#212323] sm:whitespace-nowrap lg:text-[14px]">
          {{ block.settings.label }}
        </p>
      {% endif %}

      {% if block.settings.description != blank %}
        <p class="text-center text-[12px] leading-[1.5] font-normal text-[#212323] sm:whitespace-nowrap lg:text-[14px]">
          {{ block.settings.description }}
        </p>
      {% endif %}
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "t:general.trust_badge",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "t:labels.label",
      "default": "0.4mg THC"
    },
    {
      "type": "text",
      "id": "description",
      "label": "t:labels.description"
    },
    {
      "type": "select",
      "id": "icon_style",
      "label": "t:labels.icon_style",
      "options": [
        { "value": "thc", "label": "t:options.icon_style.thc" },
        { "value": "carbonation", "label": "t:options.icon_style.carbonation" },
        { "value": "lab", "label": "t:options.icon_style.lab" }
      ],
      "default": "thc"
    },
    {
      "type": "image_picker",
      "id": "icon",
      "label": "t:labels.custom_icon"
    }
  ],
  "presets": [{ "name": "t:general.trust_badge" }]
}
{% endschema %}
