{% doc %}
  Renders a small circular icon with a label underneath, used to call out a
  product trust signal (e.g. potency, carbonation, lab testing).

  Intended to be nested inside a badge-row block (e.g. the Gruns Hero
  section).

  @example
  {% content_for 'block', id: block.id, type: 'trust-badge' %}
{% enddoc %}

<div class="flex min-w-0 flex-1 flex-col items-center gap-[8px] sm:w-auto sm:flex-none sm:gap-[5px]" {{ block.shopify_attributes }}>
  <div class="size-[72px] shrink-0 sm:size-[85px] lg:size-[101px]">
    {% if block.settings.icon %}
      {{
        block.settings.icon
        | image_url: width: 202
        | image_tag: width: 202, height: 202, class: 'size-full object-contain', alt: block.settings.label
      }}
    {% endif %}
  </div>

  {% if block.settings.label != blank or block.settings.description != blank %}
    <div class="flex flex-col items-center gap-[2.64px]">
      {% if block.settings.label != blank %}
        <p
          class="text-center text-[14px] leading-[1.5] font-medium text-[#212323] sm:text-[13px] sm:whitespace-nowrap lg:text-[14px] {% if block.settings.label_mobile != blank %}hidden sm:block{% endif %}"
        >
          {{ block.settings.label }}
        </p>
      {% endif %}

      {% if block.settings.label_mobile != blank %}
        <p class="block text-center text-[14px] leading-[1.5] font-medium text-[#212323] sm:hidden">
          {{ block.settings.label_mobile }}
        </p>
      {% endif %}

      {% if block.settings.description != blank %}
        <p class="text-center text-[13px] leading-[1.5] font-normal text-[#212323] sm:text-[12px] sm:whitespace-nowrap lg:text-[14px]">
          {{ block.settings.description }}
        </p>
      {% endif %}
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "t:general.trust_badge",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "t:labels.label",
      "default": "0.4mg THC"
    },
    {
      "type": "text",
      "id": "label_mobile",
      "label": "t:labels.label_mobile",
      "info": "t:labels.label_mobile_info"
    },
    {
      "type": "text",
      "id": "description",
      "label": "t:labels.description"
    },
    {
      "type": "image_picker",
      "id": "icon",
      "label": "t:labels.custom_icon"
    }
  ],
  "presets": [{ "name": "t:general.trust_badge" }]
}
{% endschema %}
