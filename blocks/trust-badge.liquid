{% doc %}
  Renders a small circular icon with a label underneath, used to call out a
  product trust signal (e.g. potency, carbonation, lab testing).

  Intended to be nested inside a badge-row block (e.g. the Gruns Hero
  section).

  @example
  {% content_for 'block', id: block.id, type: 'trust-badge' %}
{% enddoc %}

<div class="trust-badge flex min-w-0 flex-1 flex-col items-center sm:w-auto sm:flex-none" {{ block.shopify_attributes }}>
  <div class="trust-badge__icon size-[56px] shrink-0 mb-[4px] drop-shadow-[-2px_3px_5.7px_rgba(0,0,0,0.22)] sm:mb-0 sm:size-[78px] lg:size-[5.4167vw]">
    {% if block.settings.icon %}
      {{
        block.settings.icon
        | image_url: width: 202
        | image_tag: width: 202, height: 202, class: 'size-full object-contain', alt: block.settings.label
      }}
    {% endif %}
  </div>

  {% if block.settings.label != blank or block.settings.description != blank %}
    <div class="flex flex-col items-center">
      {% if block.settings.label != blank %}
        <div
          class="trust-badge__label text-center text-[18px] leading-[normal] font-semibold text-[#212323] sm:text-[13px] sm:whitespace-nowrap lg:text-[0.9722vw] {% if block.settings.label_mobile != blank %}hidden sm:block{% endif %}"
        >
          {{ block.settings.label }}
        </div>
      {% endif %}

      {% if block.settings.label_mobile != blank %}
        <div class="trust-badge__label block text-center text-[18px] leading-[normal] font-medium text-[#212323] sm:hidden">
          {{ block.settings.label_mobile }}
        </div>
      {% endif %}

      {% if block.settings.description != blank %}
        <p class="mt-1 text-center text-[14px] leading-[1] font-normal text-[#212323] sm:mt-0 sm:text-[12px] sm:whitespace-nowrap lg:text-[0.9722vw]">
          {{ block.settings.description }}
        </p>
      {% endif %}
    </div>
  {% endif %}
</div>

{% stylesheet %}
  .trust-badge__label p {
    margin: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.trust_badge",
  "settings": [
    {
      "type": "richtext",
      "id": "label",
      "label": "t:labels.label",
      "default": "<p>0.4mg THC</p>"
    },
    {
      "type": "richtext",
      "id": "label_mobile",
      "label": "t:labels.label_mobile",
      "info": "t:labels.label_mobile_info"
    },
    {
      "type": "text",
      "id": "description",
      "label": "t:labels.description"
    },
    {
      "type": "image_picker",
      "id": "icon",
      "label": "t:labels.custom_icon"
    }
  ],
  "presets": [{ "name": "t:general.trust_badge" }]
}
{% endschema %}
