{% doc %}
  Groups product-highlight blocks into a responsive 2-column grid. Rendered
  as a fixed region in the main product section, between the description and
  the "Choose your Flavor" row; add, remove, and reorder the nested
  product-highlight blocks to control which highlights are shown.

  @example
  {% content_for 'block', id: block.id, type: 'highlight-grid' %}
{% enddoc %}

<div class="grid w-full grid-cols-2 gap-x-6 gap-y-4 sm:grid-cols-[repeat(2,max-content)]" {{ block.shopify_attributes }}>
  {% content_for 'blocks' %}
</div>

{% schema %}
{
  "name": "t:general.highlight_grid",
  "blocks": [{ "type": "product-highlight" }],
  "presets": [
    {
      "name": "t:general.highlight_grid",
      "blocks": [
        { "type": "product-highlight", "settings": { "label": "<p>0.4mg hemp-derived THC</p>" } },
        { "type": "product-highlight", "settings": { "label": "<p>L-theanine + Rhodiola</p>" } },
        { "type": "product-highlight", "settings": { "label": "<p>Non-carbonated</p>" } },
        { "type": "product-highlight", "settings": { "label": "<p>COA available</p>" } }
      ]
    }
  ]
}
{% endschema %}
