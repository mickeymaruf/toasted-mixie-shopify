{% doc %}
  Renders a horizontal "shop this flavor" card: a small can/pack render, a
  flavor name, and a "Shop" button linking to the selected product. Falls
  back to a bundled default render per `flavor_style` when no custom
  `card_image` is uploaded.

  @example
  {% content_for 'block', id: block.id, type: 'flavor-shop-card' %}
{% enddoc %}

{% liquid
  case block.settings.flavor_style
    when 'berry_acai'
      assign default_image = 'card-flavor-berry-acai.png'
    when 'ginger_lime'
      assign default_image = 'card-flavor-ginger-lime.png'
    else
      assign default_image = 'card-flavor-blood-orange.png'
  endcase

  assign flavor_name_desktop = block.settings.flavor_name
  assign flavor_name_mobile = block.settings.flavor_name_mobile
  assign flavor_name_plain = flavor_name_desktop | strip_html | strip
  if flavor_name_plain == blank
    assign flavor_name_plain = block.settings.product.title
  endif

  assign button_label = block.settings.button_label
  if button_label == blank and flavor_name_plain != blank
    assign button_label = 'products.list.shop_flavor' | t: flavor: flavor_name_plain
  endif
%}

<div
  class="flex w-full items-center gap-3 overflow-hidden rounded-[33px] border-[3px] px-2 pb-4 pt-6 shadow-[-2px_2px_3.5px_rgba(0,0,0,0.1)] md:w-[calc(50%_-_7.5px)] md:justify-center lg:w-auto lg:min-w-[260px] lg:flex-1 lg:gap-5 xl:w-[calc(33.333%_-_10px)] xl:flex-none"
  style="background-color: {{ block.settings.card_background }}; border-color: {{ block.settings.border_color }};"
  {{ block.shopify_attributes }}
>
  <div class="h-[72px] w-auto shrink-0 sm:h-[140px] md:h-[100px] xl:h-[130px]">
    {% if block.settings.card_image %}
      {{
        block.settings.card_image
        | image_url: width: 320
        | image_tag: width: 320, height: 189, class: 'h-full w-auto object-contain object-bottom', alt: flavor_name_plain
      }}
    {% else %}
      <img
        src="{{ default_image | asset_url }}"
        width="320"
        height="189"
        loading="lazy"
        class="h-full w-auto object-contain object-bottom"
        alt="{{ flavor_name_plain | escape }}"
      >
    {% endif %}
  </div>

  <div class="flex min-w-0 flex-1 flex-col items-start gap-[10px]">
    {% if flavor_name_desktop != blank %}
      <div class="flavor-shop-card__name flavor-shop-card__name--desktop">
        {{ flavor_name_desktop }}
      </div>
    {% elsif flavor_name_plain != blank %}
      <div class="flavor-shop-card__name flavor-shop-card__name--desktop">
        <p>{{ flavor_name_plain }}</p>
      </div>
    {% endif %}

    {% if flavor_name_mobile != blank %}
      <div class="flavor-shop-card__name flavor-shop-card__name--mobile">
        {{ flavor_name_mobile }}
      </div>
    {% elsif flavor_name_desktop != blank %}
      <div class="flavor-shop-card__name flavor-shop-card__name--mobile">
        {{ flavor_name_desktop }}
      </div>
    {% elsif flavor_name_plain != blank %}
      <div class="flavor-shop-card__name flavor-shop-card__name--mobile">
        <p>{{ flavor_name_plain }}</p>
      </div>
    {% endif %}

    {% if button_label != blank %}
      {% render 'button',
        label: button_label,
        url: block.settings.product.url,
        background_color: block.settings.button_background_color,
        text_color: block.settings.button_text_color,
        class: '!w-fit !max-w-full !text-[13px] !px-6 py-2 sm:!text-[14px] sm:!px-8 sm:py-4 !font-medium whitespace-nowrap'
      %}
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .flavor-shop-card__name {
    color: #212323;
    font-size: 1.3125rem;
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.15;
  }

  .flavor-shop-card__name p {
    margin: 0;
  }

  .flavor-shop-card__name--desktop {
    display: none;
  }

  .flavor-shop-card__name--mobile {
    display: block;
  }

  @media (min-width: 40rem) {
    .flavor-shop-card__name {
      font-size: 1.5rem;
      letter-spacing: -0.0375rem;
    }
  }

  @media (min-width: 48rem) {
    .flavor-shop-card__name--desktop {
      display: block;
    }

    .flavor-shop-card__name--mobile {
      display: none;
    }
  }

  @media (min-width: 64rem) {
    .flavor-shop-card__name {
      font-size: 1.25rem;
    }
  }

  @media (min-width: 80rem) {
    .flavor-shop-card__name {
      font-size: 1.5rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.flavor_shop_card",
  "settings": [
    {
      "type": "header",
      "content": "t:general.product"
    },
    {
      "type": "product",
      "id": "product",
      "label": "t:labels.product"
    },
    {
      "type": "richtext",
      "id": "flavor_name",
      "label": "t:labels.flavor_name_desktop",
      "info": "t:labels.flavor_name_info"
    },
    {
      "type": "richtext",
      "id": "flavor_name_mobile",
      "label": "t:labels.flavor_name_mobile",
      "info": "t:labels.flavor_name_mobile_info"
    },
    {
      "type": "header",
      "content": "t:general.image"
    },
    {
      "type": "select",
      "id": "flavor_style",
      "label": "t:labels.flavor_style",
      "options": [
        { "value": "blood_orange", "label": "t:options.flavor_style.blood_orange" },
        { "value": "berry_acai", "label": "t:options.flavor_style.berry_acai" },
        { "value": "ginger_lime", "label": "t:options.flavor_style.ginger_lime" }
      ],
      "default": "blood_orange"
    },
    {
      "type": "image_picker",
      "id": "card_image",
      "label": "t:labels.card_image"
    },
    {
      "type": "header",
      "content": "t:general.button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label",
      "info": "t:labels.button_label_info"
    },
    {
      "type": "color",
      "id": "button_background_color",
      "label": "t:labels.button_background",
      "default": "#212323"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "t:labels.button_text_color",
      "default": "#C7AA9A"
    },
    {
      "type": "header",
      "content": "t:general.colors"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "t:labels.card_background",
      "default": "#F9D5C0"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:labels.border_color",
      "default": "#212323"
    }
  ],
  "presets": [{ "name": "t:general.flavor_shop_card" }]
}
{% endschema %}
