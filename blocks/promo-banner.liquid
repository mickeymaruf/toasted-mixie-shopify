{% doc %}
  Renders a promotional banner with image, heading, button, and feature list.
  Placed as a flexible block in the product section, below the accordion.

  @example
  {% content_for 'block', type: 'promo-banner', id: 'promo-banner' %}
{% enddoc %}

{% if block.settings.heading != blank %}
  <div
    class="relative flex w-full flex-col items-center gap-[15px] rounded-2xl shadow-[-2px_2px_3.5px_rgba(0,0,0,0.1)] sm:h-[205px] sm:flex-row"
    style="background-color: {{ block.settings.background_color }};"
    {{ block.shopify_attributes }}
  >
    {% if block.settings.background_image %}
      <div class="pointer-events-none absolute inset-0 overflow-hidden rounded-2xl" aria-hidden="true">
        {{
          block.settings.background_image
          | image_url: width: 800
          | image_tag: class: 'absolute size-full object-cover rounded-2xl', widths: '400, 600, 800', alt: '', style: 'opacity: 0.05;'
        }}
      </div>
    {% endif %}
    {% if block.settings.image %}
      <div class="relative z-10 w-full p-4 sm:w-1/2">
        {{
          block.settings.image
          | image_url: width: 2000
          | image_tag:
            width: nil,
            height: nil,
            class: 'mx-auto w-full h-auto object-contain',
            alt: block.settings.heading,
            widths: '400, 600, 800, 1200, 1600, 2000',
            sizes: '(min-width: 640px) 50vw, 100vw'
        }}
      </div>
    {% endif %}

    <div class="relative z-10 flex w-full flex-col items-center gap-[10px] px-3 pt-0 pb-4 text-center sm:w-1/2 sm:pt-4 sm:pr-8 sm:pb-4 sm:pl-0">
      <p class="text-[20px] leading-[1.3] font-medium sm:text-[20px] lg:text-[24px]" style="color: {{ block.settings.heading_color }};">{{ block.settings.heading }}</p>

      {% if block.settings.button_label != blank %}
        <a href="{{ block.settings.button_link }}" class="relative z-10 flex w-full items-center justify-center px-[46px] py-[16px] rounded-[30px] text-[15px] leading-[1.5] font-medium whitespace-nowrap shadow-[0px_0px_7.5px_rgba(0,0,0,0.1)] sm:text-[14px]" style="background-color: {{ block.settings.button_background_color }}; color: {{ block.settings.button_text_color }};">
          {{ block.settings.button_label }}
        </a>
      {% endif %}

      {% if block.settings.feature_1_text != blank or block.settings.feature_2_text != blank or block.settings.feature_1_icon or block.settings.feature_2_icon %}
        <div class="flex flex-wrap items-center justify-center gap-x-[10px] gap-y-2 sm:justify-start sm:gap-x-[15px]" style="color: {{ block.settings.feature_text_color }};">
          {% if block.settings.feature_1_text != blank or block.settings.feature_1_icon %}
            <div class="flex items-center gap-[5px]">
              {% if block.settings.feature_1_icon %}
                <span class="block size-[15px] shrink-0">
                  {{
                    block.settings.feature_1_icon
                    | image_url: width: 30
                    | image_tag: width: 30, height: 30, class: 'size-full object-contain', alt: ''
                  }}
                </span>
              {% else %}
                <span class="block size-[15px] shrink-0">{{ 'icon-package.svg' | inline_asset_content }}</span>
              {% endif %}
              <span class="text-[13px] leading-[1.5] whitespace-nowrap sm:text-[12px]">
                {{- block.settings.feature_1_text -}}
              </span>
            </div>
          {% endif %}

          {% if block.settings.feature_2_text != blank or block.settings.feature_2_icon %}
            <div class="flex items-center gap-[5px]">
              {% if block.settings.feature_2_icon %}
                <span class="block h-[13px] w-[17px] shrink-0">
                  {{
                    block.settings.feature_2_icon
                    | image_url: width: 34
                    | image_tag: width: 34, height: 26, class: 'size-full object-contain', alt: ''
                  }}
                </span>
              {% else %}
                <span class="block h-[13px] w-[17px] shrink-0">
                  {{- 'icon-shipping.svg' | inline_asset_content -}}
                </span>
              {% endif %}
              <span class="text-[13px] leading-[1.5] whitespace-nowrap sm:text-[12px]">
                {{- block.settings.feature_2_text -}}
              </span>
            </div>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "t:general.promo_banner",
  "settings": [
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Can't Pick Just One?"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label",
      "default": "Get My Trial Pack"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:labels.button_link"
    },
    {
      "type": "color",
      "id": "button_background_color",
      "label": "t:labels.button_background",
      "default": "#D4941F"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "t:labels.button_text_color",
      "default": "#F6F1EC"
    },
    {
      "type": "text",
      "id": "feature_1_text",
      "label": "t:labels.feature_1_text",
      "default": "Free 3-flavor trial pack."
    },
    {
      "type": "text",
      "id": "feature_2_text",
      "label": "t:labels.feature_2_text",
      "default": "Just Pay Shipping"
    },
    {
      "type": "image_picker",
      "id": "feature_1_icon",
      "label": "t:labels.feature_1_icon"
    },
    {
      "type": "image_picker",
      "id": "feature_2_icon",
      "label": "t:labels.feature_2_icon"
    },
    {
      "type": "header",
      "content": "t:general.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.card_background",
      "default": "#9AB2D5"
    },
    {
      "type": "color",
      "id": "feature_text_color",
      "label": "t:labels.feature_text_color",
      "default": "#212323"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "t:labels.heading_color",
      "default": "#212323"
    },
    {
      "type": "header",
      "content": "t:general.image"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:labels.background_image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    }
  ]
}
{% endschema %}
