{% doc %}
  Renders a promotional banner with image, heading, button, and feature list.
  Placed as a flexible block in the product section, below the accordion.

  @example
  {% content_for 'block', type: 'promo-banner', id: 'promo-banner' %}
{% enddoc %}

{% if block.settings.heading != blank %}
  <div
    class="relative flex w-full flex-col items-center gap-3 overflow-hidden rounded-2xl sm:flex-row sm:gap-6 sm:p-4"
    style="background-color: {{ block.settings.background_color }};"
    {{ block.shopify_attributes }}
  >
    {% if block.settings.image %}
      <div class="relative aspect-square w-full sm:aspect-[166/150] sm:w-[140px] sm:shrink-0 lg:w-[166px] overflow-hidden rounded-xl">
        {{
          block.settings.image
          | image_url: width: 400
          | image_tag: width: 400, height: 362, class: 'size-full object-cover', alt: block.settings.heading
        }}
      </div>
    {% endif %}

    <div class="relative flex flex-1 flex-col items-center md:items-start gap-[10px] p-3 sm:p-0">
      <p class="text-[16px] sm:text-[20px] font-medium text-[#212323]">{{ block.settings.heading }}</p>

      {% if block.settings.button_label != blank %}
        {% render 'button',
          label: block.settings.button_label,
          url: block.settings.button_link,
          class: '!w-auto whitespace-nowrap'
        %}
      {% endif %}

      {% if block.settings.feature_1_text != blank or block.settings.feature_2_text != blank %}
        <div class="flex flex-wrap items-center gap-x-[10px] gap-y-2 sm:gap-x-[15px] text-[#212323]">
          {% if block.settings.feature_1_text != blank %}
            <div class="flex items-center gap-[5px]">
              <span class="block size-[15px] shrink-0">{{ 'icon-package.svg' | inline_asset_content }}</span>
              <span class="text-[12px] leading-[1.5] whitespace-nowrap">
                {{- block.settings.feature_1_text -}}
              </span>
            </div>
          {% endif %}

          {% if block.settings.feature_2_text != blank %}
            <div class="flex items-center gap-[5px]">
              <span class="block h-[13px] w-[17px] shrink-0">
                {{- 'icon-shipping.svg' | inline_asset_content -}}
              </span>
              <span class="text-[12px] leading-[1.5] whitespace-nowrap">
                {{- block.settings.feature_2_text -}}
              </span>
            </div>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "t:general.promo_banner",
  "settings": [
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Can't Pick Just One?"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label",
      "default": "Get My Trial Pack"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:labels.button_link"
    },
    {
      "type": "text",
      "id": "feature_1_text",
      "label": "t:labels.feature_1_text",
      "default": "Free 3-flavor trial pack."
    },
    {
      "type": "text",
      "id": "feature_2_text",
      "label": "t:labels.feature_2_text",
      "default": "Just Pay Shipping"
    },
    {
      "type": "header",
      "content": "t:general.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.card_background",
      "default": "#9AB2D5"
    },
    {
      "type": "header",
      "content": "t:general.image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    }
  ]
}
{% endschema %}
