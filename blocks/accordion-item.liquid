{% doc %}
  Renders a single collapsible row for the main product section's accordion
  list — e.g. "What is Toasted?", "Ingredients & Allergies", "What to Expect",
  "Lab Results". Content expands smoothly from bottom with plus/minus icon.

  @example
  {% content_for 'block', id: block.id, type: 'accordion-item' %}
{% enddoc %}

<div class="accordion-item w-full" data-accordion-item {{ block.shopify_attributes }}>
  <button
    type="button"
    class="flex w-full cursor-pointer items-center justify-between gap-4 py-5 text-[18px] font-medium text-[#212323] hover:opacity-70 transition-opacity duration-200"
    data-accordion-trigger
    aria-expanded="false"
    aria-controls="content-{{ block.id }}"
  >
    {{ block.settings.title }}
    <span class="block size-5 shrink-0 transition-transform duration-300 flex items-center justify-center" data-accordion-icon>
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="12" y1="5" x2="12" y2="19"></line>
        <line x1="5" y1="12" x2="19" y2="12"></line>
      </svg>
    </span>
  </button>

  {% if block.settings.content != blank %}
    <div
      id="content-{{ block.id }}"
      class="accordion-content overflow-hidden transition-all duration-300 ease-out"
      data-accordion-content
      style="max-height: 0;"
    >
      <div class="pb-5 text-[16px] leading-[1.6] text-[#212323]/85">
        {{ block.settings.content }}
      </div>
    </div>
  {% endif %}
</div>

{% stylesheet %}
  .accordion-item {
    width: 100%;
  }

  .accordion-content {
    overflow: hidden;
  }

  .accordion-item.open [data-accordion-icon] {
    transform: rotate(45deg);
  }
{% endstylesheet %}

{% javascript %}
  (function() {
    const items = document.querySelectorAll('[data-accordion-item]');

    items.forEach(item => {
      const trigger = item.querySelector('[data-accordion-trigger]');
      const content = item.querySelector('[data-accordion-content]');

      if (!trigger || !content) return;

      trigger.addEventListener('click', () => {
        const isOpen = item.classList.contains('open');

        if (isOpen) {
          content.style.maxHeight = '0px';
          trigger.setAttribute('aria-expanded', 'false');
          item.classList.remove('open');
        } else {
          const height = content.querySelector('div').offsetHeight;
          content.style.maxHeight = height + 'px';
          trigger.setAttribute('aria-expanded', 'true');
          item.classList.add('open');
        }
      });
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "t:general.accordion_item",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:labels.title",
      "default": "What is Toasted?"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "t:labels.content"
    }
  ],
  "presets": [{ "name": "t:general.accordion_item" }]
}
{% endschema %}
