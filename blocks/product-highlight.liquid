{% doc %}
  Renders a single icon + label highlight, used in the main product
  section's 2x2 highlight grid (e.g. THC content, adaptogens, carbonation,
  lab testing).

  @example
  {% content_for 'block', id: block.id, type: 'product-highlight' %}
{% enddoc %}

<div class="flex flex-1 items-center gap-[11px]" {{ block.shopify_attributes }}>
  <div class="size-[40px] shrink-0 text-[#212323]">
    {% if block.settings.icon %}
      {{
        block.settings.icon
        | image_url: width: 80
        | image_tag: width: 80, height: 80, class: 'size-full object-contain', alt: block.settings.label
      }}
    {% endif %}
  </div>

  {% if block.settings.label != blank %}
    <div
      class="product-highlight__label flex-1 text-[14px] leading-[1.3] text-[#212323] {% if block.settings.label_mobile != blank %}hidden sm:block{% endif %}"
    >
      {{ block.settings.label }}
    </div>
  {% endif %}

  {% if block.settings.label_mobile != blank %}
    <div class="product-highlight__label block flex-1 text-[14px] leading-[1.3] text-[#212323] sm:hidden">
      {{ block.settings.label_mobile }}
    </div>
  {% endif %}
</div>

{% stylesheet %}
  .product-highlight__label p {
    margin: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.product_highlight",
  "settings": [
    {
      "type": "richtext",
      "id": "label",
      "label": "t:labels.label",
      "default": "<p>0.4mg hemp-derived THC</p>"
    },
    {
      "type": "richtext",
      "id": "label_mobile",
      "label": "t:labels.label_mobile",
      "info": "t:labels.label_mobile_info"
    },
    {
      "type": "image_picker",
      "id": "icon",
      "label": "t:labels.custom_icon"
    }
  ],
  "presets": [{ "name": "t:general.product_highlight" }]
}
{% endschema %}
