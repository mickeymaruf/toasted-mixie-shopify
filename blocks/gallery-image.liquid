{% doc %}
  Renders a single framed, rounded-corner portrait image with a cream
  border used as a slide inside the Gruns Gallery section's scrolling
  carousel.

  @example
  {% content_for 'block', id: block.id, type: 'gallery-image' %}
{% enddoc %}

<div
  class="gruns-gallery__slide shrink-0 snap-start w-full max-w-[320px] pl-4 lg:pl-[23px]"
  {{ block.shopify_attributes }}
>
  <div class="aspect-[225.6/329.39] w-full overflow-hidden rounded-[22.113px] shadow-[-3px_4px_10px_0px_rgba(0,0,0,0.15)]">
    {% if block.settings.image %}
      {{
        block.settings.image
        | image_url: width: 600
        | image_tag:
          class: 'size-full object-cover',
          widths: '160, 200, 220, 252, 400, 600',
          sizes: '(min-width: 64rem) 252px, (min-width: 48rem) 220px, (min-width: 40rem) 200px, 160px',
          alt: block.settings.alt_text
        | default: block.settings.image.alt
      }}
    {% else %}
      <div class="flex size-full items-center justify-center bg-[#D9D9D9] px-4 text-center text-sm font-medium text-[#6D6D6D]">
        {{ block.settings.placeholder_text }}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "t:general.gallery_image",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "text",
      "id": "alt_text",
      "label": "t:labels.alt_text"
    },
    {
      "type": "text",
      "id": "placeholder_text",
      "label": "t:labels.placeholder_text",
      "info": "t:labels.placeholder_text_info",
      "default": "Image coming soon"
    }
  ],
  "presets": [{ "name": "t:general.gallery_image" }]
}
{% endschema %}
