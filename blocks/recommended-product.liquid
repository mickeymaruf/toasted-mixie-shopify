{% doc %}
  Renders one product card in the cart drawer's recommendations carousel:
  star rating, review count, title, price, and an "Add" button that adds
  the product's first available variant to the cart via the drawer's own
  AJAX (see the `CartDrawer` custom element in `sections/cart-drawer.liquid`).

  @example
  {% content_for 'block', id: block.id, type: 'recommended-product' %}
{% enddoc %}

{% liquid
  assign product = block.settings.product
  assign variant = product.selected_or_first_available_variant
  assign rating_rounded = block.settings.rating | round
%}

{% if product != blank %}
  <div
    class="flex w-[280px] shrink-0 items-center gap-4 rounded-2xl border border-[#DED9D4] bg-[#F6F1EC] p-4"
    {{ block.shopify_attributes }}
  >
    <div class="w-[64px] shrink-0">
      {{
        product.featured_image
        | image_url: width: 200
        | image_tag: width: 200, height: 200, class: 'size-full object-contain', alt: product.featured_image.alt
      }}
    </div>

    <div class="flex min-w-0 flex-1 flex-col items-start gap-2">
      <div class="flex w-full items-center justify-between gap-2">
        <div class="flex items-center gap-[2px] text-[#212323]" role="img" aria-label="{{ 'products.main.rating_label' | t: rating: block.settings.rating }}">
          {% for i in (1..5) %}
            <span class="block size-3 {% unless i <= rating_rounded %}opacity-20{% endunless %}" aria-hidden="true">
              {{ 'icon-star.svg' | inline_asset_content }}
            </span>
          {% endfor %}
        </div>

        {% if block.settings.review_count != blank %}
          <p class="shrink-0 text-[12px] whitespace-nowrap text-[rgba(33,35,35,0.75)]">{{ block.settings.review_count }}</p>
        {% endif %}
      </div>

      <p class="w-full truncate text-[18px] leading-[1.3] font-medium text-[#212323]">{{ product.title }}</p>

      <div class="flex w-full items-center justify-between gap-2">
        <p class="text-[20px] leading-[1.5] text-[#212323]">{{ variant.price | money }}</p>

        <button
          type="button"
          class="shrink-0 rounded-md bg-[#212323] px-4 py-2 text-[14px] tracking-[0.6px] text-[#F6F1EC] disabled:opacity-30"
          data-cart-add
          data-variant-id="{{ variant.id }}"
          {% unless variant.available %}
            disabled
          {% endunless %}
        >
          {% if variant.available %}
            {{ 'cart_drawer.add' | t }}
          {% else %}
            {{ 'products.main.sold_out' | t }}
          {% endif %}
        </button>
      </div>
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "t:general.recommended_product",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "t:labels.product"
    },
    {
      "type": "range",
      "id": "rating",
      "label": "t:labels.rating",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "default": 5
    },
    {
      "type": "text",
      "id": "review_count",
      "label": "t:labels.review_count"
    }
  ],
  "presets": [{ "name": "t:general.recommended_product" }]
}
{% endschema %}
