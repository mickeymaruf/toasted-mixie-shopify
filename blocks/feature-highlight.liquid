{% doc %}
  Renders a single icon + title feature. Falls back to the bundled leaf icon
  when no custom `icon` image is uploaded. Intended to be nested inside a
  `feature-column` block in the Ingredient Highlights section.

  @example
  {% content_for 'block', id: block.id, type: 'feature-highlight' %}
{% enddoc %}

<div class="flex w-full flex-col items-center gap-[10px]" {{ block.shopify_attributes }}>
  <div class="size-[60px] shrink-0 text-[#D4941F] sm:size-[72px] lg:size-[85px]">
    {% if block.settings.icon %}
      {{
        block.settings.icon
        | image_url: width: 170
        | image_tag: width: 170, height: 170, class: 'size-full object-contain', alt: block.settings.title
      }}
    {% else %}
      <span class="block size-full">{{ 'icon-leaf.svg' | inline_asset_content }}</span>
    {% endif %}
  </div>

  {% if block.settings.title != blank %}
    <p class="w-full text-center text-sm leading-[1.5] font-medium text-[#212323] sm:text-[20px] lg:text-[24px]">
      {{ block.settings.title }}
    </p>
  {% endif %}
</div>

{% schema %}
{
  "name": "t:general.feature_highlight",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:labels.title",
      "default": "L-Theanine"
    },
    {
      "type": "image_picker",
      "id": "icon",
      "label": "t:labels.custom_icon"
    }
  ],
  "presets": [{ "name": "t:general.feature_highlight" }]
}
{% endschema %}
