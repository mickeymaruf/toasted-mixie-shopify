{% doc %}
  Renders a rounded ingredient card with a title and short description, used
  to explain what an ingredient does. Intended to be nested inside the Chill
  ingredients section.

  @example
  {% content_for 'block', id: block.id, type: 'ingredient-card' %}
{% enddoc %}

<div
  class="flex w-full flex-col items-start justify-center gap-[15px] rounded-[16.5px] p-5 text-[#212323] sm:p-[25px]"
  style="background-color: {{ block.settings.background_color }};"
  {{ block.shopify_attributes }}
>
  {% if block.settings.title != blank %}
    <h3 class="w-full text-[24px] leading-[1] font-bold capitalize sm:text-[32px] sm:leading-[0.8]">
      {{ block.settings.title }}
    </h3>
  {% endif %}

  {% if block.settings.text != blank %}
    <p class="w-full text-[16px] leading-[1.3] sm:text-[20px]">
      {{ block.settings.text }}
    </p>
  {% endif %}
</div>

{% schema %}
{
  "name": "t:general.ingredient_card",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:labels.title",
      "default": "Ingredient"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:labels.text",
      "default": "Describe what this ingredient does."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.card_background",
      "default": "#F9D5C0"
    }
  ],
  "presets": [{ "name": "t:general.ingredient_card" }]
}
{% endschema %}
