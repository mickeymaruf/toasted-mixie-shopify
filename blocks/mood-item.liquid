{% doc %}
  Renders a single "mood" row: a small icon paired with a title and
  subtitle (e.g. "Supports Clarity" / "Smooth, present focus").

  @example
  {% content_for 'block', id: block.id, type: 'mood-item' %}
{% enddoc %}

<div class="flex w-full items-center gap-[35px] sm:gap-[25px]" {{ block.shopify_attributes }}>
  <div class="mood-item__icon shrink-0">
    {% if block.settings.icon %}
      {{
        block.settings.icon
        | image_url: width: 1600
        | image_tag: width: nil, height: nil, class: 'size-full object-contain', alt: block.settings.title
      }}
    {% endif %}
  </div>

  {% if block.settings.title != blank or block.settings.subtitle != blank %}
    <div class="flex flex-col gap-[2.638px]">
      {% if block.settings.title != blank %}
        <p class="text-[22px] leading-normal font-medium whitespace-nowrap sm:text-[20px]">{{ block.settings.title }}</p>
      {% endif %}

      {% if block.settings.subtitle != blank %}
        <p class="text-[18px] leading-normal whitespace-nowrap sm:text-[20px]">{{ block.settings.subtitle }}</p>
      {% endif %}
    </div>
  {% endif %}
</div>

{% stylesheet %}
  .mood-item__icon {
    width: 80px;
    aspect-ratio: 1 / 1;
  }

  @media (min-width: 40rem) {
    .mood-item__icon {
      width: 55px;
    }
  }

  @media (min-width: 64rem) {
    .mood-item__icon {
      width: 63px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.mood_item",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:labels.title",
      "default": "Supports Clarity"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "t:labels.subtitle",
      "default": "Smooth, present focus"
    },
    {
      "type": "image_picker",
      "id": "icon",
      "label": "t:labels.icon"
    }
  ],
  "presets": [{ "name": "t:general.mood_item" }]
}
{% endschema %}
