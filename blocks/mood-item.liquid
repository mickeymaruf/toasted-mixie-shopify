{% doc %}
  Renders a single circular badge icon with a caption underneath it (e.g. a
  "200mg L-theanine" badge graphic paired with its caption text).

  @example
  {% content_for 'block', id: block.id, type: 'mood-item' %}
{% enddoc %}

<div class="mood-item flex min-w-0 flex-1 flex-col items-center gap-[5px] sm:flex-none" {{ block.shopify_attributes }}>
  <div class="mood-item__icon size-[72px] shrink-0 sm:size-[90px] lg:size-[110px]">
    {% if block.settings.icon %}
      {{
        block.settings.icon
        | image_url: width: 220
        | image_tag: width: 220, height: 220, class: 'size-full object-contain', alt: block.settings.label
      }}
    {% endif %}
  </div>

  {% if block.settings.label != blank %}
    <p class="text-center text-[14px] leading-[1.5] font-medium sm:whitespace-nowrap">{{ block.settings.label }}</p>
  {% endif %}
</div>

{% schema %}
{
  "name": "t:general.mood_item",
  "settings": [
    {
      "type": "image_picker",
      "id": "icon",
      "label": "t:labels.icon"
    },
    {
      "type": "text",
      "id": "label",
      "label": "t:labels.label",
      "default": "200mg L-theanine"
    }
  ],
  "presets": [{ "name": "t:general.mood_item" }]
}
{% endschema %}
