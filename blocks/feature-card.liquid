{% doc %}
  Renders a rounded feature card with a photo, a bold title and a short
  subtitle. Intended to be nested inside the Gruns Feature Grid section.

  @example
  {% content_for 'block', id: block.id, type: 'feature-card' %}
{% enddoc %}

<div
  class="flex flex-1 flex-col items-center gap-[50px] rounded-[20px] px-[15px] pt-5 pb-[50px]"
  style="background-color: {{ block.settings.background_color }};"
  {{ block.shopify_attributes }}
>
  <div class="aspect-[352/241] w-full overflow-hidden rounded-[15px]">
    {% if block.settings.image %}
      {{
        block.settings.image
        | image_url: width: 800
        | image_tag:
          class: 'size-full object-cover',
          widths: '352, 500, 700, 800',
          sizes: '(min-width: 64rem) 33vw, (min-width: 40rem) 50vw, 100vw',
          alt: block.settings.alt_text
        | default: block.settings.image.alt
      }}
    {% endif %}
  </div>

  <div class="flex flex-col items-center justify-center gap-[5px] text-center text-[#212323]">
    {% if block.settings.title != blank %}
      <p class="text-[32px] leading-[1.2] font-bold sm:text-[42px]">
        {{ block.settings.title }}
      </p>
    {% endif %}

    {% if block.settings.subtitle != blank %}
      <p class="text-[18px] leading-[1.3] sm:text-[24px]">
        {{ block.settings.subtitle }}
      </p>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "t:general.feature_card",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.card_image"
    },
    {
      "type": "text",
      "id": "alt_text",
      "label": "t:labels.alt_text"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:labels.title",
      "default": "Title"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "t:labels.subtitle",
      "default": "Subtitle"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.card_background",
      "default": "#C2CBD4"
    }
  ],
  "presets": [{ "name": "t:general.feature_card" }]
}
{% endschema %}
