{% doc %}
  Groups flavor-swatch blocks into a wrapping row, under an editable
  "Choose your Flavor" heading. Rendered as a fixed region in the main
  product section, between the highlight grid and the quantity picker; add,
  remove, and reorder the nested flavor-swatch blocks to control which
  flavors are listed.

  @example
  {% content_for 'block', id: block.id, type: 'flavor-swatch-row' %}
{% enddoc %}

<div class="flex w-full flex-col gap-[15px]" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <p id="flavor-heading-{{ block.id }}" class="text-[16px] leading-[1.3] font-medium text-[#212323]">
      {{ block.settings.heading }}
    </p>
  {% endif %}

  <div
    class="flex flex-nowrap items-center gap-2 md:gap-[15px] overflow-x-auto"
    role="group"
    aria-labelledby="flavor-heading-{{ block.id }}"
  >
    {% content_for 'blocks' %}
  </div>
</div>

{% schema %}
{
  "name": "t:general.flavor_swatch_row",
  "blocks": [{ "type": "flavor-swatch" }],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Choose your Flavor"
    }
  ],
  "presets": [
    {
      "name": "t:general.flavor_swatch_row",
      "blocks": [
        { "type": "flavor-swatch", "settings": { "flavor_name": "Blood Orange" } },
        { "type": "flavor-swatch", "settings": { "flavor_name": "Berry Acai" } },
        { "type": "flavor-swatch", "settings": { "flavor_name": "Ginger Lime" } }
      ]
    }
  ]
}
{% endschema %}
