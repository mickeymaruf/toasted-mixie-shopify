          },
          "blocks": {}
        },
        "faq_item_M4tzzy": {
          "type": "faq-item",
          "settings": {
            "question": "When is the best time for Toasted?",
            "answer": "<p>Anytime you want to take the edge off without losing yourself. Stay in, go out, or anywhere in between.</p>",
            "initially_open": false
          },
          "blocks": {}
        },
        "faq_item_VDEagE": {
          "type": "faq-item",
          "settings": {
            "question": "What does it feel like?",
            "answer": "<p>Light, relaxed, and feel-good. Designed to keep you clear, present, and in control.</p>",
            "initially_open": false
          },
          "blocks": {}
        },
        "faq_item_MLchJJ": {
          "type": "faq-item",
          "settings": {
            "question": "Will it make me anxious or paranoid?",
            "answer": "<p>Toasted is intentionally low-dose and made with calming ingredients for a gentle, approachable experience.</p>",
            "initially_open": false
          },
          "blocks": {}
        },
        "faq_item_yALbR8": {
          "type": "faq-item",
          "settings": {
            "question": "Is it like an edible?",
            "answer": "<p>Not at all. The experience is lighter, faster, and shorter-lasting—making it a natural fit for social occasions.</p>",
            "initially_open": false
          },
          "blocks": {}
        },
        "faq_item_9mcXAR": {
          "type": "faq-item",
          "settings": {
            "question": "Are these drinks legal?",
            "answer": "<p>Yes. Toasted is formulated to meet federal requirements. Availability varies by state and is limited to adults 21+.</p>",
            "initially_open": false
          },
          "blocks": {}
        }
